  ex:hasUsage "每服10丸，汤饮送下。" .

<medicine:风痫抵住丸> a ex:Medicine;
  ex:hasFunction "杂病癫痫。";
  ex:hasName "风痫抵住丸";
  ex:hasPreparation "上为细末，面糊为丸，朱砂为衣。";
  ex:hasPrescription "皂角（烧存性），苍耳根茎叶（晒干）4两，密陀僧末1两。";
  ex:hasUsage "方中皂角用量原缺。" .

<medicine:风痫汤> a ex:Medicine;
