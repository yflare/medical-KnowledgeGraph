  ex:hasUsage "水煎服。" .

<medicine:二海丸> a ex:Medicine;
  ex:hasFunction "气瘿。";
  ex:hasName "二海丸";
  ex:hasPreparation "上药为末，炼蜜为丸，如杏仁大。";
