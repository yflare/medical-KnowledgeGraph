  ex:hasUsage "用竹管频吹喉中。加牛黄5分更佳。" .

<medicine:代参膏> a ex:Medicine;
  ex:hasFunction "补益。主";
  ex:hasName "代参膏";
  ex:hasPreparation "切片熬膏，1火收成，滴纸不化；用白茯苓10斤，春末，水飞去浮，只取沉者，蒸晒10次，沾手如胶，与术膏搅匀。";
  ex:hasPrescription "于术10斤（白米泔水浸3昼夜，洗净浮皮，蒸晒10次，有脂沾手为度）。";
  ex:hasUsage "每服2许，米汤送下。" .

<medicine:代天宣化丸> a ex:Medicine;
