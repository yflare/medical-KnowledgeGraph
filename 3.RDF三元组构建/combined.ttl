  ex:hasPreparation "上为末，炼蜜为丸，如梧桐子大。";
  ex:hasPrescription "干姜、厚朴各等分。";
  ex:hasUsage "任下30丸。" .

<medicine:姜朴汤> a ex:Medicine;
  ex:hasFunction "霍乱腹痛欲呕。";
  ex:hasName "姜朴汤";
