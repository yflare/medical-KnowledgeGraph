  ex:hasPrescription "黄连（去须）1两。";
  ex:hasUsage "每浆水3盏，煎至1盏，去滓，分温4服，空心、食前服，1日服尽。" .

<medicine:黄连油膏> a ex:Medicine;
  ex:hasFunction "急性湿疹。";
  ex:hasName "黄连油膏";
  ex:hasPrescription "黄连25g，蓖麻油75g。";
  ex:hasUsage "混合。外用。" .

<medicine:黄连泻心汤> a ex:Medicine;
  ex:hasAlias "泻心汤";
  ex:hasFunction "一切火热壅肿疮疡。";
  ex:hasName "黄连泻心汤";
  ex:hasPreparation "上锉1剂。";
  ex:hasPrescription "黄连、黄芩、甘草。";
  ex:hasUsage "加大枣2枚，水煎服。" .

<medicine:黄连泻火汤> a ex:Medicine;
  ex:hasFunction "目暴发赤肿疼痛。";
  ex:hasName "黄连泻火汤";
  ex:hasPrescription "黄连8分，黄芩1钱（俱酒炒），生地1钱，升麻5分，柴胡7分。";
  ex:hasUsage "水煎服。" .

<medicine:黄连洗汤> a ex:Medicine;
  ex:hasFunction "眼漠漠。";
  ex:hasName "黄连洗汤";
  ex:hasNote "忌猪肉。";
  ex:hasPrescription "黄连3两，秦皮2两，蕤仁半两。";
