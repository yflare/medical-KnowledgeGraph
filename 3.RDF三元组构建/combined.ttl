  ex:hasUsage "以水8升，清酒2升，煮取3升，分3次服。" .

<medicine:杜仲酒> a ex:Medicine;
  ex:hasAlias "杜仲浸酒";
  ex:hasFunction "肾虚冷或感寒湿，腰脚冷痹，或为疼痛。";
