  ex:hasName "芦叶汤";
  ex:hasPrescription "芦叶1两（锉），糯米半两。";
  ex:hasUsage "以水1大盏，入竹茹1分，煎至6分，后入蜜半合，生姜汁半合，煎2-3沸，去滓放温，时时呷之。" .

<medicine:芦吸散> a ex:Medicine;
  ex:hasFunction "肺受风寒，久嗽不愈。";
  ex:hasName "芦吸散";
  ex:hasNote "肺热者禁用。";
