  ex:hasAlias "马齿矾石丸";
  ex:hasFunction "小儿胎寒？？啼，惊痫腹胀，不嗜食，大便青黄。并大人虚冷内冷，或有实不可吐下。";
  ex:hasName "马齿矾丸";
