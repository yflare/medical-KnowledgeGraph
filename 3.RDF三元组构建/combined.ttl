  ex:hasName "假苏散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "荆芥 陈皮 香附 麦芽（炒）瞿麦 木通 赤茯苓各等分";
  ex:hasUsage "每服9克，开水送下。" .

<medicine:假补中益气汤> a ex:Medicine;
