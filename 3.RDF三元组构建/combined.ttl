  ex:hasPrescription "头2蚕茧黄不拘多少。";
  ex:hasUsage "每服3钱，桂元汤送下。" .

<medicine:保胎方> a ex:Medicine;
  ex:hasAlias "保胎散";
  ex:hasFunction "清热安胎。主孕妇出痘腰痛。";
