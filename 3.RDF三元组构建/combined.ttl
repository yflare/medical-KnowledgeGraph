<medicine:补肉药> a ex:Medicine;
  ex:hasAlias "补肉膏";
  ex:hasFunction "跌扑闪挫，面伤青黑，伤重者。";
  ex:hasName "补肉药";
  ex:hasPreparation "熬膏。";
