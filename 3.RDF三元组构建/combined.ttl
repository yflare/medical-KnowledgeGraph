  ex:hasUsage "九宝饮（《诚书》卷十二）。" .

<medicine:九宝汤> a ex:Medicine;
  ex:hasFunction "和中化痰，快脾胃。主";
  ex:hasName "九宝汤";
  ex:hasPreparation "上为粗末。";
  ex:hasPrescription "真厚朴（去粗皮）3两，半夏3两（沸汤泡9次，切片焙干，作粗末），2味和作一处，用生姜12两，净洗，和粗皮捣令细，同厚朴、半夏罨一宿，晒干，却入下药：甘草（炙），桔梗1两（去芦头，切碎，酒炒金黄色），藿香3两，陈皮3两，人参1两，紫苏叶3两。";
  ex:hasUsage "每服3大钱，水1盏，加紫苏10叶，煎至6分，去滓，不拘时服。" .

<medicine:九宝饮> a ex:Medicine;
  ex:hasAlias "九味理中汤";
  ex:hasFunction "调理脾胃，止泄泻。主痘疮已出而利者。";
  ex:hasName "九宝饮";
  ex:hasPrescription "人参1钱，白术1钱，干姜（炮）1钱，诃子（去核）1钱，茯苓1钱，木香1钱，藿香（去土）1钱，炙甘草1钱，肉豆蔻（面煨）1钱。";
  ex:hasUsage "九味理中汤（《准绳·幼科》卷五）。本方方名，《景岳全书》引作“九宝丹”。" .

<medicine:九宝饮子> a ex:Medicine;
  ex:hasFunction "分利水谷，止泄泻。主";
  ex:hasName "九宝饮子";
  ex:hasPrescription "罂粟壳（蜜炙）1两2钱，青皮1两2钱，陈皮1两2钱，木通1两2钱，赤茯苓2钱半，车前子（略炒）2钱半，黄耆（微炒）2钱半，制厚朴2钱半，粉甘草2钱半。";
  ex:hasUsage "上(口父)咀。每服3钱，水1盏煎，温服。" .

<medicine:九宫汤> a ex:Medicine;
  ex:hasFunction "痉病，手足牵掣，口眼歪张。";
  ex:hasName "九宫汤";
  ex:hasPrescription "人参1两，巴戟天5钱，葳蕤5钱，半夏1钱，乌药1钱，秦艽1钱，陈皮5分，附子5分，天麻5分。";
  ex:hasUsage "水煎服。" .

<medicine:九房散> a ex:Medicine;
  ex:hasAlias "久房散";
  ex:hasFunction "小便多或不禁。";
  ex:hasName "九房散";
  ex:hasPreparation "上药治下筛，并鸡肶胵中黄皮3两，同为散。";
  ex:hasPrescription "菟丝子3两，黄连3两，蒲黄3两，消石1两，肉苁蓉2两。";
  ex:hasUsage "久房散（《千金翼》卷十九）。《千金翼》久房散用法下注“一方有五味子三两”。" .

<medicine:九月束胎丸> a ex:Medicine;
  ex:hasFunction "束胎。主";
  ex:hasName "九月束胎丸";
  ex:hasPreparation "粥为丸。";
  ex:hasPrescription "白术、枳壳、黄芩、甘草。";
  ex:hasUsage "每服30丸，饮送下。" .

<medicine:九月肉片> a ex:Medicine;
  ex:hasFunction "清热，明目，祛风，平肝，养血，益寿。适用于虚风上作之头昏头痛、花干涩等症。并可作为高血压、冠心病患者之膳食。身体虚弱或无病者常食，能健身益寿，美人肤色。中老年人最为适宜。";
  ex:hasName "九月肉片";
  ex:hasPreparation "将猪瘦肉去皮、筋后切成簿片；菊花瓣用清水轻轻洗净,用凉水漂上；姜、葱洗净后都切成指甲片；鸡蛋去黄留清。";
  ex:hasPrescription "菊花瓣（鲜）100克，猪瘦肉600克，鸡蛋3个，鸡汤150克，食盐3克，白砂糖3克，绍酒20克，胡椒粉2克。";
  ex:hasUsage "佐餐食。" .

<medicine:九气拈痛丸> a ex:Medicine;
  ex:hasFunction "理气止痛。主心胃疼痛。";
  ex:hasName "九气拈痛丸";
  ex:hasNote "孕妇禁用。";
  ex:hasPreparation "上为末，醋为丸。";
  ex:hasPrescription "当归4两，良姜4两，五灵脂4两，莪术4两，槟榔4两，青皮4两，元胡2两，郁金2两，木香2两，陈皮2两，姜黄2两，香附5两，甘草1两5钱。";
  ex:hasUsage "每服3钱，白开水送下。" .

<medicine:九气汤> a ex:Medicine;
  ex:hasFunction "舒畅经络。主诸般气疾。";
  ex:hasName "九气汤";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "香附子（炒，去毛），甘草1两（炙），姜黄1分，山药半两，木香半钱，蓬术1钱（炮），缩砂仁半两（一方加益智仁1分）。";
  ex:hasUsage "《普济方》引本方有甘松一分。" .

<medicine:九气饮> a ex:Medicine;
  ex:hasFunction "寒在脾肾，冷泻冷痢，脉迟而细小者。";
  ex:hasName "九气饮";
  ex:hasPrescription "熟地、干姜、附子、肉蔻、吴萸、补骨脂、荜茇、五味、炙草。";
  ex:hasUsage "水煎服。" .

<medicine:九江太守散> a ex:Medicine;
  ex:hasFunction "延年益寿，轻身明目，强筋骨，愈折伤。主男子五劳七伤，妇人产后余疾，五脏六腑诸风。";
  ex:hasName "九江太守散";
  ex:hasNote "禁房室、猪、鱼、生冷。";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "知母3分，人参3分，茯苓3分，蜀椒半两（汗，去目闭口者），栝楼1两半，防风3两，白术3两，泽泻2两，干姜1两，附子1两（炮、去皮），桂心1两，细辛1两。";
  ex:hasUsage "以每服方寸匕，酒送下，1日2次；饮酒，常令有酒色，勿令大醉。" .

<medicine:九江散> a ex:Medicine;
  ex:hasFunction "白癜风，及260种大风。";
  ex:hasName "九江散";
  ex:hasPreparation "上30味，诸虫皆去足翅，熬炙令熟，为散。";
  ex:hasPrescription "当归7分，石南6分，踯躅4两，秦艽4两，菊花4两，干姜4两，防风4两，雄黄4两，麝香4两，丹砂4两，斑蝥4两，蜀椒8分，鬼箭羽8分，连翘8分，石长生8分，知母8分，蜈蚣3枚，虻虫10枚，地胆10枚，附子4两，鬼臼11分，人参12分，石斛12分，天雄12分，王不留行12分，乌头12分，独活12分，防己12分，莽草12分，水蛭百枚。";
  ex:hasUsage "每服方寸匕，酒送下，1日2次。" .

<medicine:九灵汤> a ex:Medicine;
  ex:hasFunction "腰眼生疽疼痛。";
  ex:hasName "九灵汤";
  ex:hasPrescription "熟地2两，山茱萸1两，白术2两，防己1钱，紫花地丁1两，荆芥（炒黑）3钱，生地5钱，丹皮5钱，生甘草3钱。";
  ex:hasUsage "水数碗，煎1碗服。" .

<medicine:九炁丹> a ex:Medicine;
  ex:hasFunction "治脾肾虚寒，或暴伤生冷，或受时气寒湿，或酒湿伤脾，腹痛泄泻；或饮食失宜，呕恶痛泻等症征情较重者。";
  ex:hasName "九炁丹";
  ex:hasPreparation "上药为细末，炼自空为丸，或山药糊丸，如梧桐子大。";
  ex:hasPrescription "熟地24O克 制附子120克 肉豆蔻（面炒）60克 焦姜 吴茱萸 补骨脂（酒炒）荜茇（炒）五味子（炒）各60克 粉甘草（炒）30克";
  ex:hasUsage "每服 60～100丸，温开水送下。" .

<medicine:九熏丹> a ex:Medicine;
  ex:hasFunction "癣，疥。";
  ex:hasName "九熏丹";
  ex:hasPreparation "上药以好烧酒拌之，须不干不湿，涂于粗工碗底内，翻转合地上，以砖垫，露1线，下以蕲艾熏之，候干再拌再熏，如此9次，少亦要7次，约以青色带黑为度，然后再研细，将烧酒拌做成锭子。";
  ex:hasPrescription "上好铜青2、3两（研细）。";
  ex:hasUsage "用时以醋磨搽，每日3-5次。3-5日后，若觉干裂，以菜油少许润之，7日可愈矣。" .

<medicine:九物五膈丸> a ex:Medicine;
  ex:hasFunction "治忧隔、气隔、食隔、寒隔、饮隔等五隔。";
  ex:hasName "九物五膈丸";
  ex:hasNote "忌海藻、菘菜、猪肉、冷水、生葱、生菜。";
  ex:hasPreparation "上药为末，炼蜜为丸，如弹子大。";
  ex:hasPrescription "麦门冬（去心）蜀椒（汗）各90克 远志90克（去心）甘草150克（炙）附子30克（炮）干姜90克 人参120克 桂心90克 细辛90克（夏月可酌加麦门冬、甘草、人参的用量）";
  ex:hasUsage "每服1丸，含化，日三至四次，夜一至二次。若不能含者，可一大丸作二小丸，尽服之。" .

<medicine:九物大黄薄贴> a ex:Medicine;
  ex:hasAlias "大黄薄贴";
  ex:hasFunction "痈疽发背。";
  ex:hasName "九物大黄薄贴";
  ex:hasNote "忌生冷、热面、大酢。";
  ex:hasPreparation "上药治下筛，以3合投粉糜2升中和之。";
  ex:hasPrescription "大黄3两，黄芩3两，白芷2两，寒水石5两，白蔹5两，黄柏2两，石膏3两，赤石脂3两，黄连3两。";
  ex:hasUsage "大黄薄贴（《普济方》卷二八三）。" .

<medicine:九物牛黄丸> a ex:Medicine;
  ex:hasAlias "九精丸";
  ex:hasFunction "男子得鬼魅欲死，所见惊怖欲走，时有休止。";
  ex:hasName "九物牛黄丸";
  ex:hasPreparation "上药治下筛，蜜为丸，如小豆大。";
  ex:hasPrescription "牛黄1两，荆实1两，曾青1两，玉屑1两，雄黄1两，空青1两，赤石脂1两，玄参1两，龙骨1两。";
  ex:hasUsage "九精丸（《圣济总录》卷一○○）。" .

<medicine:九物金锁丹> a ex:Medicine;
  ex:hasFunction "去风，闭精，固元阳。主虚损。";
  ex:hasName "九物金锁丹";
  ex:hasPreparation "上为末，面糊为丸，如梧桐子大。";
  ex:hasPrescription "龙齿半两，败龟（酥炙）半两，雄蚕蛾（未对者）半两，巴戟天（去心）半两，白莲花（叶）半两，莲子心1两，肉苁蓉1两，雄鸡肝1分，山芋2两。";
  ex:hasUsage "每服10丸，空心温酒送下。" .

<medicine:九物饮> a ex:Medicine;
  ex:hasFunction "诸饮食伤。";
  ex:hasName "九物饮";
  ex:hasPrescription "神曲（炒）、麦芽、山楂、香附、青皮、干姜（炮）、木香、厚朴、槟榔各等分。";
  ex:hasUsage "加生姜，水煎服。" .

<medicine:九珍散> a ex:Medicine;
  ex:hasFunction "一切痈疽、疮疖、肿毒，因气壅血热而生者；兼治妇人乳痈。";
  ex:hasName "九珍散";
  ex:hasPrescription "赤芍、白芷、当归、川芎、大黄、甘草、生地、瓜蒌、黄芩各等分。";
  ex:hasUsage "上(口父)咀。每服4钱，水2盏，酒1盏，煎至2盏，去滓热服。" .

<medicine:九生丸> a ex:Medicine;
  ex:hasFunction "头风。";
  ex:hasName "九生丸";
  ex:hasPreparation "上为末，生韭汁、飞罗面为丸。";
  ex:hasPrescription "半夏、南星、大草乌、川芎、白芷、硬石膏、细辛各等分。";
  ex:hasUsage "每服10丸，生姜汤送下。" .

<medicine:九疸秦王散> a ex:Medicine;
  ex:hasAlias "秦王散、九疸秦椒散";
  ex:hasFunction "胃瘅、心瘅、肾瘅、脾瘅、肺瘅、舌瘅、肉瘅、髓瘅、肝瘅。";
  ex:hasName "九疸秦王散";
  ex:hasNote "忌桃、李、雀肉等。";
  ex:hasPrescription "栀子仁、葛根、葶苈子、栝楼、秦椒（汗）、瓜蒂、石钟乳、凝水石、牡蛎、泽泻、白术各等分。";
  ex:hasUsage "秦王散（原书同卷）、九疸秦椒散（《普济方》卷一九六）。《外台》：胃瘅，食多喜饮，栀子仁主之；心瘅，烦心，心中热，葛根主之；肾瘅，其人唇干，葶苈子主之；脾瘅，溺赤出少，心惕惕若恐，栝楼主之；肺瘅，饮少小便多，秦椒（汗）、瓜蒂主之（一云膏疸）；舌瘅，渴而数便，石钟乳主之；肉瘅，其人小便白，凝水石主之；髓瘅，目眶深，多嗜卧，牡蛎、泽泻主之；肝瘅，胃热饮多水激肝，白术主之。上十一味，随病所在加2分。" .

<medicine:九痛丸> a ex:Medicine;
  ex:hasAlias "附子丸";
  ex:hasFunction "九种心痛，兼治卒中恶，腹胀痛，口不能言；又治连年积冷，流注心胸痛，并冷冲上气，落马坠车血疾等。";
  ex:hasName "九痛丸";
  ex:hasNote "忌猪肉、芦笋。";
  ex:hasPreparation "上为末，炼蜜为丸，如梧桐子大。";
  ex:hasPrescription "附子3两（炮），生狼牙1两（炙香），巴豆1两（去皮心，熬，研如脂），人参1两，干姜1两，吴茱萸1两。";
  ex:hasUsage "附子丸（《外台》卷七引《经心录》）。《外台》引《必效方》：疗九种心痛。一，虫心痛；二，注心痛；三，气心痛；四，悸心痛；五，食心痛；六，饮心痛；七，冷心痛；八，热心痛；九，去来心痛。方中生狼牙，《千金》作“生狼毒”。" .

<medicine:九痛圆> a ex:Medicine;
  ex:hasFunction "治九种心痛：一、虫心痛；二、疰心痛；三、风心痛；四、悸心痛；五、食心痛；六、饮心痛；七、冷心痛；八、热心痛；九、去来心痛。";
  ex:hasName "九痛圆";
  ex:hasPrescription "狼毒（炙香）一两，附子（炮.去皮.脐）三两，干姜（炮）、巴豆（去皮.心膜.炒干.取霜）、人参、吴茱萸（汤洗七次），各一两。";
  ex:hasUsage "每服空腹温酒下一圆。" .

<medicine:九盏汤> a ex:Medicine;
  ex:hasFunction "下痢。无问冷热、赤白、谷滞、休息、久下者。";
  ex:hasName "九盏汤";
  ex:hasPreparation "上切。";
  ex:hasPrescription "黄连（长3寸）30枚（秤重2两半），龙骨（如棋子）4枚（重4分），附子（大者）1枚，干姜1两半，胶1两半。";
  ex:hasUsage "先以水5合，着铜器中，去火3寸，煎沸便下，着生土上，沸止，又上水5合；如此9上9下，纳诸药，着火止，沸辄下，着土上，沸止又复，9上9下，度可得1升，顿服即止。" .

<medicine:九蒸苍术散> a ex:Medicine;
  ex:hasFunction "湿痰腹痛。";
  ex:hasName "九蒸苍术散";
  ex:hasPreparation "上为极细末。";
  ex:hasPrescription "苍术（9蒸9晒）。";
  ex:hasUsage "每服1钱，浆水调下。" .

<medicine:九虫丸> a ex:Medicine;
  ex:hasFunction "百虫。";
  ex:hasName "九虫丸";
  ex:hasPreparation "上药治下筛，炼蜜为丸，如大豆大。";
  ex:hasPrescription "牙子、贯众、蜀漆、芜荑、雷丸、橘皮各等分。";
  ex:hasUsage "每服30丸，浆送下，1日2次。令虫下。" .

<medicine:九虫散> a ex:Medicine;
  ex:hasFunction "诸虫。";
  ex:hasName "九虫散";
  ex:hasPreparation "上药治下筛。";
  ex:hasPrescription "藿芦2两（炙），贯众1两，干漆2两（炙），狼牙1两。";
  ex:hasUsage "以羊肉羹汁服1合，1日3次。" .

<medicine:九蜜煎> a ex:Medicine;
  ex:hasFunction "产后阳气虚寒，或阴邪入脏，心腹疼痛，呕吐不食，四肢厥冷。";
  ex:hasName "九蜜煎";
  ex:hasPrescription "当归3钱，熟地3钱，芍药（酒炒焦）钱半，茯苓钱半，炙甘草1钱，干姜（炒）1钱，肉桂1钱，北细辛1钱，吴茱萸（制）5分。";
  ex:hasUsage "水2钟，煎服。" .

<medicine:九转丹> a ex:Medicine;
  ex:hasAlias "九一丹、九一散";
  ex:hasFunction "提毒祛脓脱腐。主";
  ex:hasName "九转丹";
  ex:hasPreparation "上为细末，研至无声。";
  ex:hasPrescription "净红升2两，煅石青4两，雄黄2钱（水飞），桃丹2钱。";
  ex:hasUsage "放膏药上贴之。" .

<medicine:九转大降丹> a ex:Medicine;
  ex:hasFunction "痈疽、发背、疔毒、恶疮、蛇伤、犬咬。";
  ex:hasName "九转大降丹";
  ex:hasPreparation "先将上药9味，除水银外，都研细，放于阳城罐内，然后放下水银，上则放1小砂盆，缝处先用桑皮纸搓软，嵌于缝道内；又将光粉打潮湿，用以封口，极要留心，不可走气，外又将桑皮纸满糊。放于八卦炉中，然后举火，合五九四根半香为度，结胎时炷香3根6寸，合四九之数，用文火，谓之结胎。只须3小块，中匀炭火，不可旺也。炭火当设1总炉，以便换炭，四九之香数毕，炉中取出冷定，其胎自成。切忌开看，恐伤封口出气，即走炉也。后乃另取一小脚缸，注入水，只须齐小砂盆口下，再将预备铁丝做就的载火器套在阳城罐底，约露底1寸8分，然后取总火炉内旺炭，攒围罐底，随少随添，用扇搧拂；又炷9寸香，降乃毕矣。取出，择一净室中冷定，次日开看，砂盆内所有之霜，即大降也。另将瓷瓶收贮待用，愈陈愈妙。";
  ex:hasPrescription "白马（即火消）1两，黑铅2钱，青盐3钱，胆矾4钱，雄精5钱，明矾1两，大红硇7分，汞（即水银）1两，辰砂（即朱砂，如豆色紫佳）9分。";
  ex:hasUsage "每用药厘许，以津唾调点毒上，以膏药盖之，毒气收聚顶上，自然结成黑肉1块，3-4日即脱落矣。" .

<medicine:九转灵丹> a ex:Medicine;
  ex:hasFunction "诸肿。";
  ex:hasName "九转灵丹";
  ex:hasNote "忌生冷、油荤。";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "黑丑5两，白丑5两，槟榔5两，大黄2两，芜荑1两，雷丸1两。";
  ex:hasUsage "每服3-4钱，木香汤送下。晚食米粥，次服双和饮。" .

<medicine:九转灵砂丹> a ex:Medicine;
  ex:hasFunction "诸虚痼冷，上盛下虚，或眩晕喘促，或痰涎壅塞，一切真气上逆脱厥。";
  ex:hasName "九转灵砂丹";
  ex:hasNote "忌咸猪肥肉、湿面并房事7日。";
  ex:hasPreparation "上2味，用文火炒成砂子，入水火鼎中、炼成为末。";
  ex:hasPrescription "水银3两，硫黄3两。";
  ex:hasUsage "米饮送服1钱，或用参汤更妙。" .

<medicine:九转神丹> a ex:Medicine;
  ex:hasFunction "多骨痈。";
  ex:hasName "九转神丹";
  ex:hasPrescription "白矾2钱，茯苓1两，车前子5钱，黄柏3钱，紫花地丁5钱，连翘3钱，牛蒡子3钱，穿山甲1片，萆薢5钱。";
  ex:hasUsage "水煎服。四剂骨消，再用加味四君子汤调理。" .

<medicine:九转长生神鼎玉液膏>
  a ex:Medicine;
  ex:hasFunction "轻身延年，悦泽颜色。主";
  ex:hasName "九转长生神鼎玉液膏";
  ex:hasNote "忌食桃、李、雀、蛤、海味等。";
  ex:hasPrescription "白术2斤（秋冬采，去粗皮），赤术（即苍术）16两（秋冬采，去粗皮）。";
  ex:hasUsage "二药用木石臼捣碎，入缸中，用千里水浸1日夜，山泉亦好；次入砂锅煎汁1次，收起再煎1次，绢滤滓汁，去滓，将汁用桑柴火缓缓炼之，熬成膏，磁罐盛贮，封好入土，埋1-2日出火气。3钱1次，白汤调下，或含化。" .

<medicine:九转黄精丹> a ex:Medicine;
  ex:hasAlias "黄精丹、九转黄精丸";
  ex:hasFunction "补气养血。主身体衰弱，面黄肌瘦，饮食减少。";
  ex:hasName "九转黄精丹";
  ex:hasPreparation "上药用黄酒320两入罐内，浸透加热，蒸黑为度。晒干。研为细末，炼蜜为丸，重3钱。";
  ex:hasPrescription "当归320两，黄精320两。";
  ex:hasUsage "黄精丹（原书）、九转黄精丸（《中药制剂汇编》引《北京市中成药规范》）。" .

<medicine:九还金液丹> a ex:Medicine;
  ex:hasFunction "男妇痰盛气急，中风不语，口眼歪斜，左瘫右痪，牙关紧急；及小儿急惊风，手足抽搐，不省人事，痰多气急。";
  ex:hasName "九还金液丹";
  ex:hasPreparation "小麦面炒熟，炼蜜为丸,如芡实大，金箔为衣，黄蜡区收藏。";
  ex:hasPrescription "胆星（九制者）2两，朱砂（飞）1两，生牛黄5钱，僵蚕5钱（炒），牙皂（去皮弦，炒焦）3钱，冰片5分，麝香5分。";
  ex:hasUsage "如大人牙关紧急，先以通关散开其窍，随用淡姜汤化下1-2丸；若治小儿，用薄荷汤化下1丸。" .

<medicine:九金六马散> a ex:Medicine;
  ex:hasFunction "马面、马腿、马挪，痈疽肿疡，乳痈、胁痈，便毒，头风，风核。";
  ex:hasName "九金六马散";
  ex:hasPrescription "铁马鞭、白马骨、地马梢、紫金藤、马蹄藤、金星草、金惊根、金银花、山红花根、马蹄金、紫金皮、金凉伞根、金脑香、山乌豆、鸡屎子、毛里金钗、水滚子根、穿山蜈蚣。";
  ex:hasUsage "水煎，入酒和服。" .

<medicine:九阳丹> a ex:Medicine;
  ex:hasFunction "补益。主虚冷。";
  ex:hasName "九阳丹";
  ex:hasPreparation "上将禹余粮末一半铺盒子底，次用辰砂，次用雄黄，次用硫黄，次用雌黄，又将禹余粮末一半在上；次用阳起石，上铺纸1张，用柜头药：槐花、黄芩、马鞭草、草决明为末；次用赤石脂末固缝；又用纸、盐和泥固济，窨干，醋拌灰冢盒子，用纸火1斤烧，欲耗，再添熟炭火1斤，欲耗，再添炭火3斤，烧煅候冷，闻鸡子香取出，去火毒1宿，开，收药研1日、以细为妙；除前6味烧煅外，石燕子、紫石英、牡蛎研为细末，并钟乳粉共四味，与鹿茸等药不入火，后与烧者药同研匀，用醋煮半夏曲糊为丸，如皂角子大，朱砂为衣。";
  ex:hasPrescription "辰砂1两，雄黄1两，雌黄1两，阳起石1两，硫黄1两，石燕子1两，禹余粮1两，牡蛎1两，紫石英（并研）1两，钟乳粉1两，鹿茸1两，天雄半两，木香半两，舶上茴香半两，蛤蚧1对，桑螵蛸半两，麝香1分。";
  ex:hasUsage "每服1丸，空心温酒送下，盐汤亦得；虚惫者每服3丸，空心温酒或盐汤送下；气壮人用冷水送下。后以软羊肉压之，又吃酒亦佳。" .

<medicine:九霄丸> a ex:Medicine;
  ex:hasFunction "妇人月经不断，崩漏带下。";
  ex:hasName "九霄丸";
  ex:hasPreparation "上为末，酒为丸。";
  ex:hasPrescription "艾叶（酒浸一宿，煮干为度）1两，牡蛎（盐泥包煨）1两，龙骨（煅）1两，赤石脂（醋煅7次）1两5钱，吴茱萸（炮）7钱，当归（酒蒸）7钱。";
  ex:hasUsage "每服30-40丸，酒送下；或淡盐汤亦可。" .

<medicine:九风汤> a ex:Medicine;
  ex:hasFunction "诸风疾。";
  ex:hasName "九风汤";
  ex:hasPrescription "天台乌药、沉香（少许）、香附子、甘草、陈皮、青皮、木香、木通、槟榔、厚朴、桂皮、人参、藿香、白茯苓、半夏、菖蒲各等分。";
  ex:hasUsage "水1盏半，加生姜3片，大枣2个，煎8分，不拘时候，通口服，滓再煎服。" .

<medicine:九香如意丸> a ex:Medicine;
  ex:hasFunction "平肝和胃。主";
  ex:hasName "九香如意丸";
  ex:hasPreparation "上为末，水为丸，檀香末为衣。";
  ex:hasPrescription "檀香2两，降香2两，沉香6钱，木香3两，丁香6钱，藿香5钱，砂仁2两，乌药3两，厚朴2两，广皮2两，苍术2两。" .

<medicine:九香膏> a ex:Medicine;
  ex:hasFunction "疏气和血，通腠开窍。主痈疽发背，乳中结核；一切无名肿毒，贴之末成易消，已成易溃，已溃易敛。";
  ex:hasName "九香膏";
  ex:hasPreparation "上为极细末，用清凉膏1斤4两，滚化和匀。";
  ex:hasPrescription "麝香5分，冰片1钱，白及1两，白芷1两，乳香（去油）1两，没药（去油）1两，丁香5钱，辰砂3钱。";
  ex:hasUsage "用法中清凉膏，即原书“太乙清”。" .

<medicine:九香虫酒> a ex:Medicine;
  ex:hasFunction "补肾壮阳，理气止痛。主治因肾虚所致的阳痿，以及胸隔气滞等症。";
  ex:hasName "九香虫酒";
  ex:hasPrescription "九香虫40g 白酒400ml";
  ex:hasUsage "每次10～20ml，每日2次，将酒温热空腹服用。" .

<medicine:九鸟散> a ex:Medicine;
  ex:hasFunction "麻醉整骨。主";
  ex:hasName "九鸟散";
  ex:hasPreparation "上为细末，以麻酒饮服。";
  ex:hasPrescription "蔓陀罗花1钱，露蜂房3分5厘，鸠粪3分5厘，反鼻1钱（一方无反鼻）。";
  ex:hasUsage "实人9分，虚人8分，昏沉不醒者，与浓煎茗1碗为妙。" .

<medicine:九黄丹> a ex:Medicine;
  ex:hasFunction "提毒拔脓，去瘀化腐。治一切痈疽已溃。脓流不畅。腐肉不脱者。";
  ex:hasName "九黄丹";
  ex:hasPreparation "上药研极细末。";
  ex:hasPrescription "乳没药6克 川贝 雄黄各6克 升丹9克 辰砂3克 月石6克 梅片0.9克 石膏（煅）18克";
  ex:hasUsage "掺疮口，上以膏药盖贴。" .

<medicine:九龙丸> a ex:Medicine;
  ex:hasAlias "九仙丹";
  ex:hasFunction "男女八般头风，一切头痛。";
  ex:hasName "九龙丸";
  ex:hasPreparation "上为末，韭汁为丸，如梧桐子大。";
  ex:hasPrescription "川芎半两，石膏半两，白芷半两，川乌头半两，草乌头半两，半夏半两，南星半两，细辛2钱半，全蝎2钱半。";
  ex:hasUsage "九仙丹（《简明医彀》卷五）。" .

<medicine:九龙丹> a ex:Medicine;
  ex:hasAlias "九龙败毒丸（《经验奇方》卷上）。";
  ex:hasFunction "跌打损伤。";
  ex:hasName "九龙丹";
  ex:hasPreparation "预于三四日前为细末，至五月五日午时修合，置瓷瓶内。";
  ex:hasPrescription "牛黄3分，冰片1钱5分，当门子1钱5分，月石1钱，朱砂（水飞）2钱，雄黄（水飞）2钱，火消1钱2分，荜茇4分，金页10张。";
  ex:hasUsage "用者取少许吹鼻、点眼角，男先左，女先右；甚者冷水冲服。" .

<medicine:九龙定风针> a ex:Medicine;
  ex:hasFunction "跌打损伤，或手足肩腰疯痛，年久不愈，酸痛隐在骨节筋间，非膏药煎剂之力所能到者。";
  ex:hasName "九龙定风针";
  ex:hasPrescription "生草乌3钱，生川乌3钱，北细辛3钱，闹羊花3钱，漂苍术3钱5分，瑶桂心4钱，白芷2钱5分，艾绒5钱，麝香8分。";
  ex:hasUsage "上药各为细末，和匀，再研极细。姜汁炼作条。如不好做，以白及研细末，滚姜汁搅作糊，捣药搓条，每条长寸许，如细笔杆粗，晒干，储锡瓶，封口，勿今泄气受蒸。临医时，先用竹筷头点酸痛之处，墨圈记之，令病人切勿稍动，以免墨圈移位，再以竹纸，春8、夏12、秋10，冬6层，纸放墨圈患上，将药条向灯火燃着，一头用力挂纸上。看准隔墨圈患处，1次呼吸之间火灭。纸面层见焦，余层如故。少顷针处起泡，用铁针挑破，火炮药搽之。无论患穴多少，凡竹筷头点之，觉甚酸痛者，均宜针之。1-2旬后，患泡两愈，永不复发。" .

<medicine:九龙控心散> a ex:Medicine;
  ex:hasFunction "小儿惊风发热，涎盛喉内鸣。";
  ex:hasName "九龙控心散";
  ex:hasPreparation "上为末，研和匀，用瓷盒盛，放地上5日。";
  ex:hasPrescription "蜈蚣1条（酥炙），硼砂1钱，铅白霜1钱，雄黄1钱，乳香1钱，蜡茶末1钱，天竺黄1钱，全蝎1钱，甘草1钱。";
  ex:hasUsage "每服1字至半钱，奶汁调下；急慢惊风，薄荷自然汁调下。" .

<medicine:九龙控涎丹> a ex:Medicine;
  ex:hasAlias "九龙控心散";
  ex:hasFunction "小儿蕴热，痰塞经络，头目仰视，名为天吊者。";
  ex:hasName "九龙控涎丹";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "滴乳香1钱（别研），天竺黄2钱半，雄黄（别研）1钱，腊茶1钱，白矾（煅）1钱，甘草（炙）2钱，荆芥穗（炒）2钱，绿豆100粒（半生半炒），赤足蜈蚣1条（酒浸，炙）。";
  ex:hasUsage "九龙控心散（《普济方》卷三七二）。" .

<medicine:九龙散> a ex:Medicine;
  ex:hasFunction "诸般障眼，翳膜攀睛。";
  ex:hasName "九龙散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "羌活（酒浸）1两，龙胆草1两，甘草1两，菊花1两，荆芥1两，苍术（米泔浸）1两，秦皮1两，海螵蛸1两，木贼（去节，童子小便浸一宿）1两。";
  ex:hasUsage "每服2钱，米泔水调服；茶、酒亦可。" .

<medicine:九龙汤> a ex:Medicine;
  ex:hasFunction "时行疫疠，痢疾，遍身发丹痒。";
  ex:hasName "九龙汤";
  ex:hasPrescription "荆芥、防风、升麻、白芷、葛根、苏叶、川芎、赤芍、苍术。";
  ex:hasUsage "加生姜、葱，水煎服。后服9味槐花散。" .

<medicine:九龙膏> a ex:Medicine;
  ex:hasFunction "鱼口，便毒，悬痈，横痃，初起未成脓者。";
  ex:hasName "九龙膏";
  ex:hasPreparation "上为细末，用归尾3两，红花3两，酒煎膏为丸，如梧桐子大。";
  ex:hasPrescription "儿茶、血竭、乳香、没药、青木香、山甲各等分。";
  ex:hasUsage "每服2钱，空心热酒送下。" .

<medicine:九龙针> a ex:Medicine;
  ex:hasAlias "观音针";
  ex:hasFunction "无名疮毒，痰核，发背。";
  ex:hasName "九龙针";
  ex:hasPreparation "上将硫黄、火消2味熔化，众药为末入内，成薄片令碎。";
  ex:hasPrescription "川乌尖7厘，草乌尖7厘，穿山甲7厘，麝香1分，朱砂半分，蝎梢3个，蜈蚣1分，火消2分，硫黄1钱4分。";
  ex:hasUsage "遇不明大疮，不知阴阳疼痛，痰核，发背，恶毒，用药1片，认准病头，安顶上或痛处，用香火点着，2、3、5、7灸。" .

<medicine:乞力伽散> a ex:Medicine;
  ex:hasFunction "治妇人血虚肌热，小儿脾虚，蒸热羸瘦，不能饮食。";
  ex:hasName "乞力伽散";
  ex:hasPreparation "上药研为细末。";
  ex:hasPrescription "白术 白茯苓 白芍药各30克 甘草15克";
  ex:hasUsage "每服6克，用生姜、大枣煎服。" .

<medicine:买子木汤> a ex:Medicine;
  ex:hasFunction "伤折，瘀血聚于腹中，不便，结颗块冲心。";
  ex:hasName "买子木汤";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "买子木1两，当归1两（锉，微炒），桃仁（汤浸，去皮尖双仁，麸炒微黄）1两，红雪1两半，赤芍药1两半，东向桃枝3两（锉）。";
  ex:hasUsage "每服4钱，以水1盏，入生姜半分，煎至6分，去滓温服，日3-4服。" .

<medicine:乱发拭方> a ex:Medicine;
  ex:hasFunction "小儿口疮赤烂。";
  ex:hasName "乱发拭方";
  ex:hasPrescription "父母乱发（净洗）。";
  ex:hasUsage "上缠桃枝，蘸井华水，以拭口中。" .

<medicine:乱发散> a ex:Medicine;
  ex:hasFunction "胞转，小便不通。";
  ex:hasName "乱发散";
