  ex:hasPreparation "为末，枣肉、砂糖捣和为丸，如弹子大。";
  ex:hasPrescription "葶苈 知母 贝母各30克";
  ex:hasUsage "每用绵裹1丸含之，徐徐咽下。" .

<medicine:含明散> a ex:Medicine;
  ex:hasAlias "金明散";
  ex:hasFunction "补肝脏劳极。主";
  ex:hasName "含明散";
  ex:hasPreparation "上为细末。";
