  ex:hasName "白杏膏";
  ex:hasPreparation "捣烂。";
  ex:hasPrescription "轻粉1钱，杏仁7个（去皮）。";
  ex:hasUsage "将疮去痂，先抹猪胆汁，后涂药。" .

<medicine:白杨汤> a ex:Medicine;
  ex:hasFunction "风毒攻肌肉，皮肤浮肿。";
  ex:hasName "白杨汤";
  ex:hasPrescription "白杨皮（取东南面皮，去地3尺以来，去苍皮，勿令见风，细切）半斤。";
  ex:hasUsage "用水1升，煎至7分，去滓热洗。以肿消为度。" .

<medicine:白杨皮散> a ex:Medicine;
  ex:hasFunction "齿龈疼肿。";
  ex:hasName "白杨皮散";
  ex:hasPreparation "上为散。";
