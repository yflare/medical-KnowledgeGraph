  ex:hasUsage "每服方寸匕，连服勿废，日尽1剂。" .

<medicine:避岚气方> a ex:Medicine;
  ex:hasFunction "清头目，避岚气。主";
  ex:hasName "避岚气方";
  ex:hasPreparation "上为细末。";
