  ex:hasPreparation "研碎。";
  ex:hasPrescription "萝卜子1合。";
  ex:hasUsage "水煎，食后服。" .

<medicine:萝卜子饮> a ex:Medicine;
  ex:hasFunction "水病浮肿。";
