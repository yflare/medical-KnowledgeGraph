<medicine:八室丹> a ex:Medicine;
  ex:hasFunction "拔毒长肉。主";
  ex:hasName "八室丹";
  ex:hasPrescription "熟石膏1两，冰片1分，西黄7分，血竭3钱。" .

<medicine:八将丹> a ex:Medicine;
  ex:hasAlias "八将散";
  ex:hasClinicalApplication "结核性外科疾患：用八将丹加减治疗结核性溃疡、阴疽、寒性脓疡各一例，疗程分别为六日、半月和一年。认为本方对结核性的寒性脓疡和瘘管有很好的治疗作用。";
  ex:hasFunction "一切痈疽。";
  ex:hasName "八将丹";
  ex:hasNote "疔毒不宜用。";
