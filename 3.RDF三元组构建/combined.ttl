  ex:hasUsage "水煎服。" .

<medicine:菊苗粥> a ex:Medicine;
  ex:hasFunction "清目宁心。主";
  ex:hasName "菊苗粥";
  ex:hasNote "脾胃虚寒、慢性腹泻者不宜服。";
  ex:hasPreparation "将菊苗洗净切细，煎水取汁，约100克，入北粳米、冰糖，再加水400克，煮成稀薄粥。";
  ex:hasPrescription "甘菊（新长嫩头，从生叶，洗净）。";
  ex:hasUsage "细切，入盐同米煮粥食之。" .

<medicine:菊藻丸> a ex:Medicine;
