  ex:hasPrescription "天冬1钱5分，麦冬1钱5分，生地5钱（切），人参1钱，沙参4钱，龟版8钱，玉竹3钱，石斛3钱，茜草根2钱，蒌皮3钱，山药3钱，贝母2钱，杏仁3钱，淡竹叶10张，鸡子清1个，藕3两（煎汤代水）。";
  ex:hasUsage "每服3钱。" .

<medicine:金水煎> a ex:Medicine;
  ex:hasFunction "延年益寿，填精补髓。久服发白变黑，返老还童。主";
  ex:hasName "金水煎";
  ex:hasPreparation "用无灰酒浸之，冬6日，夏3三日，于砂盆内研令极细，然后以布袋绞取汁，与前浸酒一同慢火熬成膏，于净瓷器内封贮，重汤煮之。";
  ex:hasPrescription "枸杞子不拘多少（红熟者）。";
  ex:hasUsage "每服1匙，入酥油少许，温酒调下。" .

<medicine:金水膏> a ex:Medicine;
  ex:hasFunction "两目厚翳。";
  ex:hasName "金水膏";
  ex:hasPreparation "上药除蜜外，先研令极细，却同蜜一处拌匀，入新竹筒内，用油纸数量，以线紧扎，勿令水入，于净锅内，用水煮，自早至午，水干则添，取出倾药，以绵绢滤去滓，入净器中，埋地上1宿。";
  ex:hasPrescription "乳香（研）半字，硇砂（研）半字，白矾（飞过，研）半字，当归半钱，黄连1钱（去须），白沙蜜4两，青盐（透明者，研）1字，麝香（研）1字。";
  ex:hasUsage "取出点之。点毕以温水洗眼，翳薄者点3-5次。点药箸用金为之最妙，多点则取效尤速。" .

<medicine:金汁蜜> a ex:Medicine;
  ex:hasFunction "伤寒衄血，数日不止。";
  ex:hasName "金汁蜜";
  ex:hasPreparation "上和匀，微暖过。";
  ex:hasPrescription "生地黄汁小半盏，白蜜小半盏，蒲黄半两。";
  ex:hasUsage "每服半茶脚许，不拘时候。" .

<medicine:金汞灵丹> a ex:Medicine;
  ex:hasFunction "滋养五脏，补益真元，通流关节，祛逐风邪，强健筋骨，壮者不老。主卒暴中风，奄忽不省，手足亸曳，口面斜，舌强痰盛，搐搦战掉，或角弓反张，目睛直视，口噤闭绝。";
  ex:hasName "金汞灵丹";
  ex:hasPreparation "上为末，却连前5味末拌和，入安息香膏搜和，再入臼中杵五百下，每1两作10丸。";
  ex:hasPrescription "金箔2钱半（以火煅过，用法酒淬50次为度，细剪如丝），水银半两，辰砂半两，好硫黄1两，自然铜4两（捣为末，用锅子1个盛之，瓦盖不封，于地炉内以炭一秤煅之，火尽放冷，取出研细，水飞候干，却同4味一处入乳钵内，研如面细，不见水银星子为度），生犀角半两，羚羊角3分（并镑），干蝎（炒）半两，白僵蚕（炒，去丝）半两，天南星（炮，去皮脐）半两，藿香叶半两，白花蛇3两（法酒浸软，去皮骨，培干秤），乌蛇3两（法酒浸软，去皮骨，焙干秤），官桂1两，白术3分，白芷3分，川芎3分，破故纸（炒）3分，葫芦巴（炒）3分，白附子（炒）3分，荜澄茄3分，羌活（去芦）3分，当归（炒，一云酒浸）3分，牛膝（酒浸1宿，焙干）3分，防风（去芦）3分，鹿茸（火燎去毛，切片涂酥炙）3分，附子（炮，去皮脐）1两1分，川乌（炮，去皮尖）1两1分，沉香半两，天麻1两半，木香3钱3分，安息香半两（别研）。";
  ex:hasUsage "每服1丸，空心细嚼，温酒送下，1日3次。如中风数年不能步履，服至10丸复旧；新得中风，至3服可无事；常服半丸。" .

<medicine:金沉膏> a ex:Medicine;
  ex:hasFunction "一切瘤子，瘰疬。";
  ex:hasName "金沉膏";
  ex:hasPreparation "用滚水数碗，淋灰水12碗，入砂锅内熬百十余沸，先下斑蝥、红娘子，再滚百十余沸，下川山甲、海金沙，再滚百十余沸，熬至3碗，滤去滓，再入锅内熬，却下乳香、没药、血竭，再滚百十余沸，熬成膏子，用瓷器盛顿，牢封口。";
  ex:hasPrescription "云里砂、斑蝥20个，红娘子30个，川山甲5钱（锉），海金沙5钱，乳香3钱（研），没药5钱（研），血竭3钱，桑柴灰5斤，枣柴灰5斤（上二灰一处和）。";
  ex:hasUsage "方中云里砂剂量原缺。" .

<medicine:金沙五淋丸> a ex:Medicine;
  ex:hasFunction "清热解毒，利尿止淋。主火淋、气淋、血淋、砂淋、花柳淋等症及小便频数，尿管疼痛，尿后淋漓，混浊不清。";
  ex:hasName "金沙五淋丸";
  ex:hasNote "忌食五辛及酸物。";
  ex:hasPreparation "上为极细末，水为小丸。";
  ex:hasPrescription "当归、雄黄、川牛膝、大黄、广木香、海金沙各等分。";
  ex:hasUsage "每服1钱或5分，黄酒送下。" .

<medicine:金沙五苓散> a ex:Medicine;
  ex:hasFunction "五淋痛涩。";
  ex:hasName "金沙五苓散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "海金沙2钱，肉桂2钱，甘草（炙）2钱，赤茯苓3钱，猪苓3钱，白术3钱，芍药3钱，泽泻半两，滑石7钱，石韦1钱。";
  ex:hasUsage "每服3钱，水1盏，灯心30茎，煎7分，空心服。" .

<medicine:金沙散> a ex:Medicine;
  ex:hasAlias "金沙益元散";
  ex:hasFunction "淋。";
  ex:hasName "金沙散";
  ex:hasNote "忌酒荤。";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "海金沙草（阴干）。";
  ex:hasUsage "每服2钱，煎生甘草汤调下。甚者不过3-4服。" .

<medicine:金沙汤> a ex:Medicine;
  ex:hasFunction "吐血，咯血。";
  ex:hasName "金沙汤";
  ex:hasPreparation "上为粗末。";
  ex:hasPrescription "紫金沙（野蜂窠蒂是）半两，贝母（去心，生用）2钱，芦荟1钱。";
  ex:hasUsage "每服2钱匕，水半盏，入蜜少许，煎1-2沸，去滓。细呷，空心、食后临卧服。" .

<medicine:金沙流湿丸> a ex:Medicine;
  ex:hasFunction "小便不通，伤酒、酒疸，痢疾，妇人血气不调，肢节疼痛，心痛，膈气，中风。";
  ex:hasName "金沙流湿丸";
  ex:hasNote "忌湿面。";
  ex:hasPreparation "上为细末，滴水为丸，如梧桐子大。";
  ex:hasPrescription "木通1两（去皮），泽泻1两半，木香1两，白茯苓（去皮）1两半，大黄（去皮）1两半，滑石5两，海金沙5钱，牵牛头末5两，郁李仁1两。";
  ex:hasUsage "每服50-80丸，生姜汤送下；如小便不通，灯草汤送下；如伤酒，生姜汤送下；酒疸食黄，萝卜汤送下；痢疾，高良姜汤送下；妇人血气不调，当归汤送下；肢节疼痛，温酒送下；心痛者，韭根汤送下；膈气，枳实汤送下；中风，槐角汤送下。" .

<medicine:金沙益散> a ex:Medicine;
  ex:hasFunction "小儿乳伤脾胃，致使清浊不分，尿如白浊者。";
  ex:hasName "金沙益散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "真川郁金2钱，海金沙2钱。";
  ex:hasUsage "每服1钱，灯心汤调服，加六一散3钱。" .

<medicine:金沸汤> a ex:Medicine;
  ex:hasFunction "伤风膈热致衄。";
  ex:hasName "金沸汤";
  ex:hasPrescription "旋覆花7分，前胡7分，荆芥穗（炒焦）1钱，甘草1钱，半夏5钱，赤芍5钱，茅花2钱。" .

<medicine:金沸草散> a ex:Medicine;
  ex:hasAlias "金沸草汤";
  ex:hasClinicalApplication "临床主要用于治疗感冒看咳嗽、咳嗽变异性哮喘、小儿喉源性咳嗽、慢性阻塞性肺疾病等病症。";
  ex:hasFunction "热多，头目昏重，痰涎壅塞，大便坚而渴。";
  ex:hasName "金沸草散";
  ex:hasNote "煎液用细绢滤过，免毛射肺，致咳嗽不已。";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "荆芥4两，旋覆花3两，前胡3两，麻黄3两，甘草1两半，半夏1两半，赤芍药1两半，细辛1两半，五味子1两半，杏仁1两半。";
  ex:hasUsage "每服3钱，加生姜3片，大枣1枚煎服。" .

<medicine:金沸草汤> a ex:Medicine;
  ex:hasFunction "伤风，鼻塞声重，发热咳嗽，痰多脉弦者。";
  ex:hasName "金沸草汤";
  ex:hasPrescription "金沸草1钱半（绢包），嫩前胡1钱半，北细辛5分，荆芥穗1钱半，法半夏1钱半，白通草1钱半，生甘草8分，鲜生姜2片，细白葱1根。";
  ex:hasUsage "水煎，去滓温服。" .

<medicine:金波散> a ex:Medicine;
  ex:hasFunction "时行赤眼，肿痛成翳，有热多泪。";
  ex:hasName "金波散";
  ex:hasNote "忌酒荤3-5日。";
  ex:hasPreparation "除玄明粉、麝香，余7味锉晒为末，仍入玄明粉、麝香乳钵内，同前药末杵匀。";
  ex:hasPrescription "净黄连1两，硼砂2钱，寒水石2钱，大黄2钱，海螵蛸1钱，铜青1钱，玄明粉2钱半，麝香1字，全蝎7尾（去尖毒）。";
  ex:hasUsage "每用1字至半钱，温净汤或凉水调化，澄清去滓，频洗，不拘时候。" .

<medicine:金泥煎> a ex:Medicine;
  ex:hasFunction "小儿心热，多惊悸。";
  ex:hasName "金泥煎";
  ex:hasPreparation "上件药，水银、金箔同研如泥，又别研麝香、虎睛、牛黄、青黛4味如粉，其余药捣筛为散，入银锅中，先以水2升，文火煎取半升，以新绵滤去滓，再入锅内，下酥、蜜及金泥，并研了药等，慢火煎，不住手以柳篦搅如稠饧，入瓷盒内盛。";
  ex:hasPrescription "金箔75片，水银1两半，远志1两（去心），菖蒲3分，钩藤3分，龙胆3分（去芦头），龙齿3分，人参3分（去芦头），赤茯苓3分，青黛1分，蚱蝉3枚（去翅足），麝香1分，虎睛1对（微炙），牛黄1分，甘草2分（炙微赤，锉），酥4两，蜜3斤。";
  ex:hasUsage "每服取2大豆许，以温水调服，1日3-4次。" .

<medicine:金泥膏> a ex:Medicine;
  ex:hasFunction "小儿一切无名肿毒，焮热，诸般丹瘤，热瘭湿烂。亦治大人。";
  ex:hasName "金泥膏";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "阴地蚯蚓粪（少），朴硝（多）。";
  ex:hasUsage "新汲水浓调，厚敷患处，1日3-4次。" .

<medicine:金海排石汤> a ex:Medicine;
  ex:hasClinicalApplication "输尿管结石：胡某某，女，30岁，农民，一九七八年十月二日初诊。曾经南昌某医院检查，诊断为输尿管结石，建议手术治疗。因患者恐惧，由南昌返回，试服中药。症见尿急尿频，尿道刺痛，尿中带血，小腹作胀，排尿时尿道如有砂石感，舌质红，苔黄腻，脉濡数，以金海排石汤治之。连服五剂。二诊，尿频明显减轻，尿色较前清亮，少腹微胀痛，排尿仍然刺痛，腰酸膝软，神疲乏力，舌质红，苔薄黄，脉细数，应以运化结石，导其外泄。上方加生地10g，服后从尿道排出一块结石，形如小蚕豆大。诸症顿消，病愈康复，免去了手术之苦。";
  ex:hasFunction "清热，利湿，排石。主输尿管结石，湿热蕴结下焦证。";
  ex:hasName "金海排石汤";
  ex:hasPrescription "金钱草50g，海金沙15g，苡仁12g，甘草梢10g，冬葵子12g，乳香9g，牛膝15g，鸡内金10g，萆薢9g，木通5g，琥珀末1.5g（另包，吞服）。";
  ex:hasUsage "水煎服，每日1剂。" .

<medicine:金消丸> a ex:Medicine;
  ex:hasFunction "咽喉肿痛。";
  ex:hasName "金消丸";
  ex:hasPreparation "上为末，炼蜜为丸，如樱桃大。";
  ex:hasPrescription "黄柏、荆芥、射干、黄芩各等分。";
  ex:hasUsage "每用1丸，含化。" .

<medicine:金液丸> a ex:Medicine;
  ex:hasFunction "瘦胎。主将产，忽见横倒者，盖不能忌口，恣情多食，五脏气滞，六腑不和，胎气既肥，则用力太早，胎受惊触。";
  ex:hasName "金液丸";
  ex:hasPreparation "上为细末，用粽子角为丸，如绿豆大。";
  ex:hasPrescription "飞生毛（火烧，如腋下毛尤佳）半钱，血余（无病女人发，烧灰）半钱，公母羊粪（烧灰）半钱，灶中心土1钱，黑铅3钱（用小铫子火上溶，投水银半钱，急搅成砂子，倾出，细研），朱砂半钱（别研）。";
  ex:hasUsage "遇难产急难，以倒流水吞下5丸，儿身自顺正产，子母活矣。" .

<medicine:金液丹> a ex:Medicine;
  ex:hasFunction "脏腑积冷，腰脚疼痛，四时虚羸，下气衰惫。";
  ex:hasName "金液丹";
  ex:hasPreparation "上以童子小便1斗，烧磁石赤，于小便中淬，以尽为度，候干，入硫黄同研令细，却入瓶子中，以六一泥固济，阴干，坐于灰池中，常以火半斤，养7日，满即更。常以灰5斤，烧7日，日足，放冷出之，以熟绢包裹，纳于井底一伏时，出火毒，候干，研为末，用蒸饼为丸，如麻子大。";
  ex:hasPrescription "磁石半斤，硫黄。";
  ex:hasUsage "每服7丸，空腹以温酒送下。" .

<medicine:金液五精丸> a ex:Medicine;
  ex:hasFunction "补虚助阳，壮神气，暖丹田，增颜色，和五脏，润六腑，除烦热，治淋浊，消积块，暖子宫。主";
  ex:hasName "金液五精丸";
  ex:hasPreparation "上为末，酒糊为丸，如梧桐子大。";
  ex:hasPrescription "秋石10两（金精），白茯苓2两（水精），莲肉8两（水精），川椒2两（火精），小茴香5两（土精）。";
  ex:hasUsage "每服20丸，空心酒送下，或椒盐汤送下，以干物压之。" .

<medicine:金液含化灵丹> a ex:Medicine;
  ex:hasFunction "去疾补益，延驻却老。主";
  ex:hasName "金液含化灵丹";
  ex:hasNote "忌羊血。";
  ex:hasPreparation "上先铺银末1两于瓷盒子内，即排朱砂块子，勿令相着。上以银末盖之令匀，又市朱砂块子，又以银末盖之，候朱砂尽，即以盐花盖上，令满盒子口，实按如法，固济，入灰池中，盒子上灰厚4寸。常以2两火养7日7夜，勿令火猛，但令盒子热，可通人手为度。日满取出，重翻排过，一依前法重固济，以火4两养20日；后加火至2-3斤，烧可一炊，久放令极冷，取出细研，入龙脑半分，同研入粉，以糟汁和丸，如粟米大。";
  ex:hasPrescription "山泽银朱8两，朱砂1两5（金汁中浸5日了，逐块子用金箔裹两重）。";
  ex:hasUsage "每日空心含3丸，津液咽之。如要作油，每1两以桂心末1钱，大羊肾（月区）脂炼成者，如弹子大，入龙脑1钱，和研2日久，入银盒子中，埋于糠甑中，蒸三伏，当自化为油。每日含如豇豆大。" .

<medicine:金液戊土丹> a ex:Medicine;
  ex:hasFunction "解膏梁金石药毒，杀三尸，除劳热，安神志，辟瘴辟瘟。主脱疽及疔毒发背，先因纵食膏粱厚味法酒，又或丹石补药，勉力入房，多致积毒脏腑，久则胃汁中干，肾水枯竭，不能上制心火，以致消渴、消中、消肾。饶食多干，能食多瘦，九窍不通。惊悸健忘。见此诸症，后必发疽，多难治疗。宜预服此，可转重就轻，移深居浅。";
  ex:hasName "金液戊土丹";
  ex:hasPreparation "上药各为净末，配准前数，共入乳钵内，再研千转，于端午七夕，或二至、二分吉辰，在净室中先将乌梅、地黄二膏捣极烂，和药；渐加炼蜜少许，徐徐添捣，软硬得中，每药1两，分作10丸，金箔为衣。";
  ex:hasPrescription "人中黄1两，乌梅肉1两，茯神1两，胡黄连1两，五味子1两，石菖蒲3钱，辰砂3钱，雄黄3钱，远志3钱，消石3钱，牛黄1钱，冰片1钱，金箔20张（为衣）。";
  ex:hasUsage "每服1丸，用人乳、童便共1大杯化药，随病上下，食后服之。此药用蜡封固收藏，不泄药味，愈久愈效。" .

<medicine:金液汤> a ex:Medicine;
  ex:hasFunction "外障。";
  ex:hasName "金液汤";
  ex:hasNote "如体虚者，须用加减地黄丸，空心服。饭后用金液散，此法最妙，如服金液汤，须饭后热服。每日只服1剂，不可骤进，恐伤胃气；服至42日，自愈。如外障等症，多是有余，不可妄投补剂，恐助邪，为害不浅。";
  ex:hasPrescription "软前胡1钱，白桔梗8分，直防风1钱，川独活3分，京芍药1钱，肥知母5分，荆芥穗5分，苏薄荷6分，蔓荆子7分（炒），北柴胡1钱（炒），片黄芩5分（炒）。";
  ex:hasUsage "上咀片，水煎，热服。如初发赤眼，服药6-7剂可愈，且无后患。如屡发者，风邪积热，入在经络、遇寒即发，服金液汤10余剂后，或作散，或作丸服，调理34日，外用玉华丹日点1次，即愈。" .

<medicine:金漆丸> a ex:Medicine;
  ex:hasFunction "妇人夙血积滞，每至月水来时，脐下（疒丂）痛。";
  ex:hasName "金漆丸";
  ex:hasPreparation "先将水银砂子及巴豆为末，以酽醋1升半熬金漆令稠，下诸药末为丸，如绿豆大。";
  ex:hasPrescription "金漆1两，硫黄1两，水银半两（与硫黄结为砂子，细研），硇砂半两（细研），没药1两（细研），鬼箭羽1两，当归1两（锉，微炒，捣末），狗胆4枚（干者；捣末），巴豆1分（去皮心，研，纸裹，压去油）。";
  ex:hasUsage "每服5丸，食前以温酒送下。" .

<medicine:金灯照眼> a ex:Medicine;
  ex:hasFunction "杨梅疮。";
  ex:hasName "金灯照眼";
  ex:hasPreparation "上药各为细末。";
  ex:hasPrescription "白锡1钱（煎化，入水银），水银1钱，乳香3钱，没药3钱，白丁香3钱，辰砂3钱，线香3钱，轻粉3钱，自然铜1钱，麝香3分。";
  ex:hasUsage "将皮纸卷条，每条7分，用香油润湿，燃灯，照眼观灯，口含凉水，灯用帽匣盛之。先要服通圣散10剂，照后亦要服10数服。" .

<medicine:金灵散> a ex:Medicine;
  ex:hasFunction "肾疳时久，骨沉力弱，项细头重，致天柱骨倒，不能擎举抬头。";
  ex:hasName "金灵散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "白僵蚕不拘多少（拣直者，去丝嘴，炒焦）。";
  ex:hasUsage "每服半钱，或1字1钱，薄荷酒调下，1日3次。须臾用生力散涂之。" .

<medicine:金灵散合龙胆泻肝汤>
  a ex:Medicine;
  ex:hasFunction "宣解风热，化湿活络，平肝泻脾。主风热夹湿，肝脾郁热，壅滞所致。";
  ex:hasName "金灵散合龙胆泻肝汤";
  ex:hasPrescription "薄荷10克，防风8克，杭菊花10克，生山栀7克，龙胆草6克，金银花15克，白僵蚕13克，宣木瓜13克，重楼8克，天麻8克，川芎8克。";
  ex:hasUsage "水煎服，每日1剂，日服2次。" .

<medicine:金煎药> a ex:Medicine;
  ex:hasFunction "麻疯病。肺经受病，其色白，初起粉色，眉毛先落，面若虫行，遍身起癣如鳞。";
  ex:hasName "金煎药";
  ex:hasNote "忌酒面生冷，咸味油腻。";
  ex:hasPrescription "升麻6分，连翘6分，桔梗5分，黄芩5分，生地7分，苏木5分，黄柏5分，黄耆3分，全蝎3分，人参3分，白豆蔻4分，甘草2分，地龙（去土，焙干）5分，桃仁3分，虻虫3分（去头翅），梧桐泪1分，川归4分，水蛭3分（炒烟尽），黄连3分，寸香少许。";
  ex:hasUsage "上药除黄连、连翘、梧桐泪、豆蔻等，先将寸香、水蛭、虻虫亦研为末，余药都作1服，水2杯，酒1钟，入连翘同煎去滓，入梧桐泪、白蔻、寸香再煎至7分，稍热服。" .

<medicine:金煎药方> a ex:Medicine;
  ex:hasFunction "麻风。";
  ex:hasName "金煎药方";
  ex:hasNote "忌酒面生冷、咸味油腻。";
  ex:hasPrescription "升麻6分，连翘6分，桔梗5分，黄芩5分，生地7分，苏木5分，黄柏5分，黄耆3分，全蝎3分，人参3分，白豆蔻4分，甘草2分，地龙（去土，焙干）5分，桃仁3分，虻虫3分（去头翅），梧桐泪1分，川归4分，水蛭3分（炒烟尽），黄连3分，寸香少许。";
  ex:hasUsage "上药除黄连、连翘、梧桐泪、豆蔻等外，先将寸香、水蛭、虻虫亦研为末，余药都作1服，水2杯，酒1钟，入连翘同煎去滓。入梧桐泪、白蔻、寸香再煎至7分，稍热服。" .

<medicine:金牙散> a ex:Medicine;
  ex:hasFunction "带之能杀鬼气，逐尸疰。主江南三十六症，人病经年，羸瘦垂死，诸恶疠不祥。";
  ex:hasName "金牙散";
  ex:hasNote "忌猪肉、生血物、生菜、冷水、大醋、芦笋。";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "金牙（研）1两，曾青（研）1两，消石（研）1两，石（泥裹烧半日）1两，石膏（研）1两，莽草1两，玉支（1作玉泉）1两，雄黄（研）1两，朱砂（研）1两，寒水石1两，龙骨1两，蛇蜕皮（炙）1两，芫青（熬）1两，当归1两，龙胆1两，大黄1两，细辛1两，防风1两，大戟1两，芫花（熬）1两，野葛（炙）1两，苁蓉1两，天雄（炮）1两，茯苓1两，附子（炮）1两，乌啄（炮）1两，干姜1两，人参1两，桔梗1两，桂心1两，椒（去目，汗）1两，贯众1两，巴豆（去心皮，熬）1两，狸骨（炙）1两，蜂房（炙）1两，鹳骨（灸）1两（一方加蜈蚣、蜥蜴、雌黄、监鼻、麝香、毒公，合42味）。";
  ex:hasUsage "每服1钱匕，渐增5分匕，酒调下，1日3次。并以三角绛囊贮散方寸匕，以系头及心上。" .

<medicine:金牙石汤> a ex:Medicine;
  ex:hasFunction "消渴，小便浓浊如面汁，此为肾冷。";
  ex:hasName "金牙石汤";
  ex:hasPreparation "上9味，先捣8味为粗末，次入金牙石再研匀。";
  ex:hasPrescription "金牙石（捣碎，研）1两半，厚朴（去粗皮，涂生姜汁炙熟）1两半，石菖蒲1两半，贝母（煨，去心）1两，乌梅（去核，微炒）3分，葶苈子（炒，别捣如膏）3分，桂（去粗皮）半两，高良姜半两，菟丝子（酒浸2宿，晒干，微炒，别捣）半两。";
  ex:hasUsage "每服3钱匕，水1盏，加大枣2枚（去核）煎7分，去滓，早晚食前温服。" .

<medicine:金牙酒> a ex:Medicine;
  ex:hasFunction "积年八风五疰，举身亸曳，不得转侧，行步跛，不能收摄；又暴口噤失音，言语不正，四肢背脊筋急肿痛，流走不常；劳冷积聚少气，乍寒乍热，三焦不调，脾胃不磨，饮澼结实，逆害饮食，酢咽呕吐，食不生肌，医所不能治者。";
  ex:hasName "金牙酒";
  ex:hasPreparation "上(口父)咀。盛以绢袋，以酒4斗，瓷罃中渍，密闭头，勿令泄气，春夏3-4宿，秋冬6-7宿，酒成去滓。";
  ex:hasPrescription "金牙（碎如米粒，用小绢袋盛）4两，细辛4两，地肤子（无子用茎）4两，附子4两，干地黄4两，防风4两，莽草4两，蒴藋根4两，蜀椒4合，羌活1斤。";
  ex:hasUsage "日服1合。此酒无毒，及可小醉，常令酒气相接，不尽1剂。" .

<medicine:金牛排石汤> a ex:Medicine;
  ex:hasFunction "清热渗湿，化瘀通淋。主尿路结石。";
  ex:hasName "金牛排石汤";
  ex:hasPrescription "金钱草2两，冬葵子5钱，飞滑石4钱，海金沙4钱，川牛膝3钱，川红花1钱半。";
  ex:hasUsage "肾结石，加核桃肉4钱，鸡内金2钱，王不留行3钱，车前仁4钱；输尿管结石，加尿珠子、腊瓜各2两；膀胱结石，加石韦4钱；尿路结石，加火消1钱；气虚，去红花，加党参、黄耆各5钱；肾阳虚，加补骨脂4钱，菟丝子4钱，或肉桂1钱半，附子3钱；肾阴虚，加熟地、枸杞、核桃肉各4钱；脾虚，加山药、茯苓各4钱；如结石久不移动，舌苔，脉象均无虚象者，重用清利之药，并加一些行气活血的药，如桃仁、红花、山甲、当归等；腰痛腿痛，加桑寄生、川续断各4钱；尿道痛，加甘草梢3钱；血尿加白茅根2两；有感染者，加黄芩4钱，紫花地丁或蒲公英1两；大便结，加生川军2钱；绞痛发作或持续甚者，加玄胡、香附、广木香各3钱。" .

<medicine:金牛汤> a ex:Medicine;
  ex:hasFunction "咳嗽，痰气闭结，语音不出，此为塞金不鸣。";
  ex:hasName "金牛汤";
  ex:hasPrescription "郁金2钱，牛蒡子3钱（炒，研），陈麻黄4分（蜜水炒），瓜蒌皮3钱，苏子1钱半，芥子1钱，沉香5分，贝母2钱，杏仁3钱，橘红1钱，半夏1钱，桑皮2钱，枇杷叶2张（刷毛，蜜炙）。" .

<medicine:金犀丸> a ex:Medicine;
  ex:hasFunction "退风壅，化痰。主风痰气厥，攻击头痛，痰逆恶心。";
  ex:hasName "金犀丸";
  ex:hasPreparation "上为细末，拌和再研匀，入煮枣肉为丸，如梧桐子大。";
  ex:hasPrescription "金箔30片，犀角（镑）1两，龙脑（研）1钱，麝香（研）1分，丹砂（研，水飞过）2两，胆南星1两，半夏2两（洗去滑，焙），天麻半两，白矾1两（枯过），丁香1分。";
  ex:hasUsage "每服15丸，以温生姜汤送下，不拘时候。" .

<medicine:金狗汤> a ex:Medicine;
  ex:hasAlias "金狗散";
  ex:hasFunction "经来10日半月不止，乃血热妄行也。";
  ex:hasName "金狗汤";
  ex:hasPrescription "金毛狗脊1钱，川续断1钱，阿胶1钱，地榆1钱，川芎1钱，当归1钱，白芷1钱，白芍8分，黄芩8分，熟地黄2钱。";
  ex:hasUsage "金狗散（《女科秘要》卷三）。" .

<medicine:金玉丸> a ex:Medicine;
  ex:hasFunction "小儿杂病，蛔虫及胎毒。";
  ex:hasName "金玉丸";
  ex:hasPreparation "上为末，糊为丸，如芥子大，辰砂为衣。";
  ex:hasPrescription "红花2钱5分，鼹鼠霜2钱5分，巴豆1钱5分，轻粉5分，牵牛子1钱5分，积雪草5钱，海人草3钱，大黄2钱5分。";
  ex:hasUsage "自儿初出至3岁服6-7丸，空心白汤送下，1日3次。随病浅深，丸数止20丸。" .

<medicine:金玉保和汤> a ex:Medicine;
  ex:hasFunction "感燥下利，咽干作渴，腹痛，下利白滞。";
  ex:hasName "金玉保和汤";
  ex:hasPrescription "金石斛4钱，玉竹3钱，蒌皮3钱，黄芩1钱（酒炒），当归1钱5分，茯苓2钱，山药3钱，广皮1钱，枳壳1钱，苡仁4钱，荷叶1角，陈粳米1撮（煎汤代水）。" .

<medicine:金玉散> a ex:Medicine;
  ex:hasFunction "诸般咳嗽喘急。";
  ex:hasName "金玉散";
  ex:hasPreparation "上为散。每料5钱，加生姜3片，乌梅1枚，好醋和匀浸1宿，挤去醋，文火炒干，以前醋拌炒，醋尽为度，待干，研极细末听用。";
  ex:hasPrescription "人参、白术、茯苓、干葛、紫苏、半夏、荆芥穗、桔梗、杏仁（去皮尖）、麻黄（去节）、防风、陈皮、甘草、桑白皮、枳壳、前胡各等分。";
  ex:hasUsage "每服1-2钱，照后汤调服：心嗽面赤流汗，加干姜汤；肝嗽眼中泪出，加乌粟米汤；肺嗽上喘气壅，加桑白皮汤；脾嗽不思饮食，加生姜汤；胆嗽令人不卧，加姜汁调白汤；冷嗽，加葱白汤；暮嗽涕唾稠粘，加生姜汤；热嗽目胀闷，蜜水调下；气嗽胸腹胀满，加青皮汤；伤风流涕，加防风荆芥汤；痰结成块，加五味子汤；劳嗽四肢羸弱，加秦艽汤；血嗽连声不止，加当归汤；产后嗽背痛，加黄蜡泡汤。" .

<medicine:金玉膏> a ex:Medicine;
  ex:hasFunction "神经性皮炎。";
  ex:hasName "金玉膏";
  ex:hasPreparation "投前4味药于麻油内浸3天，以文火炸为微黄，滤滓，再加入白蜡，待化净，微凉时加入轻粉及冰片即成。外用。";
  ex:hasPrescription "当归身31g，白芷9g，甘草31g，姜黄9g，轻粉6g，冰片3g，白蜡93g（夏）-125g（冬），胡麻油1250ml。" .

<medicine:金珠丸> a ex:Medicine;
  ex:hasFunction "化涎痰，利胸膈烦热，止咳嗽。主小儿惊悸心忪。";
  ex:hasName "金珠丸";
  ex:hasPreparation "上为细末，薄荷汁同水打糊为丸，如绿豆大，金箔为衣。";
  ex:hasPrescription "天南星（炮）半两，白矾（焙）半两，半夏（汤洗7遍）半两，朱砂（研细）半两，人参1钱，干山药1钱，腻粉2钱，金箔10片。";
  ex:hasUsage "每服1丸，食后生姜汤送下。量力服。" .

<medicine:金珠化痰丸> a ex:Medicine;
  ex:hasFunction "清痰热，安神志，除头痛。主头痛眩运，心忪恍惚，胸膈烦闷，涕唾稠粘，痰实咳嗽，咽喉不利。";
  ex:hasName "金珠化痰丸";
  ex:hasPreparation "上以半夏、皂荚子仁为末，与诸药同拌研匀，生姜汁煮曲糊为丸，如梧桐子大。";
  ex:hasPrescription "皂荚仁（炒）1两，天竺黄1两，白矾（光明者，放石铁器内熬汁尽，放冷，研）1两，铅白霜（细研）1两，半夏（汤洗7次，用生姜2两洗，刮去皮，同捣细作饼子，微炙黄色）4两，生白龙脑（细研）半两，辰砂（研，飞）2两，金箔（为衣）20片。";
  ex:hasUsage "每服10-15丸，生姜汤送下，食后、临卧服。" .

<medicine:金珠化痰圆> a ex:Medicine;
  ex:hasFunction "治痰热，安神志，除头痛眩运，心忪恍惚，胸膈烦闷，涕唾稠粘，痰实咳嗽，咽嗌不利。";
  ex:hasName "金珠化痰圆";
  ex:hasPrescription "皂荚仁（炒）、天竺黄、白矾（光明者.放石.铁器内熬汁尽.放冷.研）、铅白霜（细研），各一两；半夏（汤洗七次.用生姜二两，洗.刮去皮.同捣细.作饼子.炙微黄色）四两，生白龙脑（细研）半两，辰砂（研飞）二两，金箔（为衣）二十片。";
  ex:hasUsage "每十圆至十五圆，生姜汤下，食后，临卧服。" .

<medicine:金瓜丸> a ex:Medicine;
  ex:hasAlias "黄连丸、金粟丸";
  ex:hasFunction "肥孩儿，解肌。主小儿疳热，身多壮热，黄瘦。";
  ex:hasName "金瓜丸";
  ex:hasPreparation "上为细末，研入麝香少许，和匀，以豮猪胆和，却入胆内盛，用线子系定，于石器内，浆水煮5-7沸，取出，风头吊1宿，取出为丸，如绿豆大。";
  ex:hasPrescription "黄连、黄柏、甘草（微炙）、青皮（去白）各等分。";
  ex:hasUsage "黄连丸（《圣济总录》卷一七二）、金粟丸（《普济方》卷三八○）。" .

<medicine:金生丸> a ex:Medicine;
  ex:hasFunction "清热解毒，泻肺胃实火。主肺胃实热，咽喉肿痛，口舌生疮，大便干燥，小便短赤，头痛，牙疼。";
  ex:hasName "金生丸";
  ex:hasPreparation "上为细末，炼蜜为丸，重8分半，金衣纸包。";
  ex:hasPrescription "大黄60两，连翘30两，生石膏30两，甘草9两，枳实9两，九菖蒲15两，牛蒡子（炒）15两，厚朴15两，金银花15两，生地15两，白芍15两，黄芩15两，生栀子15两，天花粉15两，麦冬15两，菊花15两，石决明15两，蝉蜕15两，白芷15两，细辛15两，玄参15两，黄连15两，青黛9两，玄明粉30两。";
  ex:hasUsage "每服2丸，温开水送下。" .

<medicine:金甲散> a ex:Medicine;
  ex:hasFunction "大麻风。";
  ex:hasName "金甲散";
  ex:hasPrescription "川山甲1只（全者），生漆1斤。";
  ex:hasUsage "每日将山甲漆数次，漆完用瓦器将山甲炙灰，如病人要头身先好，即服川山甲头身起1钱；足先好，即服川山甲足4只起，兑陈酒服完即愈。" .

<medicine:金疮丹> a ex:Medicine;
  ex:hasFunction "止血，住痛生肌。主金疮出血。";
  ex:hasName "金疮丹";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "龙骨（煅）2钱，乳香（去油）3钱，没药（去油）3钱，白矾（半生，半枯）1两，无名异1两，五倍子（半生，半焙）2两。";
  ex:hasUsage "干掺。不作脓，不怕风。" .

<medicine:金疮奇验续指方> a ex:Medicine;
  ex:hasFunction "续筋接骨。主金疮断指。";
  ex:hasName "金疮奇验续指方";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "真障香（切片，火上炙，去油）、荔枝核、血竭各等分。";
  ex:hasUsage "敷患处。" .

<medicine:金疮如圣散> a ex:Medicine;
  ex:hasFunction "金疮。";
  ex:hasName "金疮如圣散";
  ex:hasPreparation "共捣极烂作饼。";
  ex:hasPrescription "陈石灰、无毛老鼠、韭菜根。";
  ex:hasUsage "《青囊秘传》本方用量：小肉老鼠（打烂）十只，陈石灰三两，韭菜汁一杯。" .

<medicine:金疮必效散> a ex:Medicine;
  ex:hasFunction "金疮。";
  ex:hasName "金疮必效散";
  ex:hasPreparation "上为细末，研匀，瓷瓶密贮。";
  ex:hasPrescription "龙骨（煅）5钱，乳香（制，去油）5钱，没药（制，去油）5钱，花蕊石（火煅红，放地上冷定后再燃，凡7次）5钱，真降香节（炒油干，碾细）5钱，紫草5钱，白芷3钱，紫苏叶3钱，儿茶3钱，白蜡1两（煅），麝香3分。" .

<medicine:金疮收口药> a ex:Medicine;
  ex:hasFunction "金刃伤。";
  ex:hasName "金疮收口药";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "小皂子树（独棍者，晒干不见火）、龙骨2钱（酒煅1次），血竭1钱，凤尾脱1钱，松香1钱，乳香1钱，没药1钱，葛苎1钱，马屁勃1个。";
  ex:hasUsage "用撒疮口。" .

<medicine:金疮散> a ex:Medicine;
  ex:hasFunction "金疮。";
  ex:hasName "金疮散";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "干姜1两，甘草（炙）1两，桂心1两，当归3两，川芎4两，蜀椒3两（汗）。";
  ex:hasUsage "以酒服方寸匕，1日3次。" .

<medicine:金疮止血散> a ex:Medicine;
  ex:hasFunction "止血。主金疮。";
  ex:hasName "金疮止血散";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "钓掉根3两，当归1两，芎1两，干地黄1两，续断1两，鹿茸半两（炙），龙骨2两。";
  ex:hasUsage "以敷，血即止。酒服1钱匕，日5夜3。" .

<medicine:金疮生肌散> a ex:Medicine;
  ex:hasFunction "生肌。主金疮。";
  ex:hasName "金疮生肌散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "甘草1斤（炙），黄柏8两，当归4两。";
  ex:hasUsage "以封疮上，1日2次。" .

<medicine:金疮神效方> a ex:Medicine;
  ex:hasAlias "金疮神效散、金疮琢合散";
  ex:hasFunction "金疮。";
  ex:hasName "金疮神效方";
  ex:hasPreparation "上各炒焦，出火毒后研为末。";
  ex:hasPrescription "五倍子、降真香各等分。";
  ex:hasUsage "金疮神效散（《外科大成》卷四）、金疮琢合散（《青囊秘传》）。" .

<medicine:金疮粉散> a ex:Medicine;
  ex:hasFunction "止血，止痛，生肌，辟风水，续筋骨。主金疮。";
  ex:hasName "金疮粉散";
  ex:hasPreparation "上药捣取汁，和石灰作饼子，晒干，末如粉。";
  ex:hasPrescription "石灰、地菘苗、细辛、旋覆根、葛叶、猪膏、青蒿、麦门冬苗、益母苗不拘多少（切）。";
  ex:hasUsage "以敷伤疮上。" .

<medicine:金疮膏> a ex:Medicine;
  ex:hasAlias "败毒膏";
  ex:hasFunction "诸般疼，刀砍斧伤。";
  ex:hasName "金疮膏";
  ex:hasPreparation "上药先下净锅内，文武火熬，看白芷嫩黄色，下当归3两，白芷老黄色，下黄松香8两，次下黄蜡4两，次下乳香3两，次下没药2两，次下血竭2两，文武进退火熬，棒桃珠似珀色，入水中不散，拈方好；用麻布滤去余药，扯拔黄色为度，用水养之。";
  ex:hasPrescription "桐油2斤，紫金皮半斤，白芷半斤，赤芍药4两，白芍药4两，独活1斤。";
  ex:hasUsage "贴患处。" .

<medicine:金疮膏药> a ex:Medicine;
  ex:hasFunction "跌扑刀剪所伤，臁疮湿疮破者。";
  ex:hasName "金疮膏药";
  ex:hasPreparation "上各为细末，将油熬化，放入白及、芸香，次入樟脑，取起候冷，再入乳、没、儿茶，冷极方下轻粉成膏。";
  ex:hasPrescription "生猪油4两，芸香2两，樟脑2两，白及（炒）1两，儿茶1钱，轻粉1钱，乳香1钱，没药1钱。";
  ex:hasUsage "凡遇创时血流未止，即便敷上扎定，微痛片时即愈。" .

<medicine:金疮至宝膏> a ex:Medicine;
  ex:hasFunction "跌打损伤，闪腰折骨，刀斧破伤，咽喉血出疼痛；或手指斩落，刑杖肉尽见骨。";
  ex:hasName "金疮至宝膏";
  ex:hasNote "切忌见风。";
  ex:hasPreparation "文武火熬，滴水成珠。将药慢慢入内，冰、麝待微温时入，收贮瓷器听用。";
  ex:hasPrescription "乳香2钱，没药2钱，血竭2钱，儿茶2钱，龙骨（煅）2钱，轻粉2钱，大黄1钱，水银1钱，冰片1钱，樟脑1钱，麝香1钱，麻油4两。";
  ex:hasUsage "敷患处；手指斩落，涂膏凑上。油纸包。" .

<medicine:金疮草药灵散> a ex:Medicine;
  ex:hasFunction "金疮。";
  ex:hasName "金疮草药灵散";
  ex:hasPreparation "上药于5月5日取，不用棍，洗择净，同捣烂如泥；次入绢筛石灰不拘多少，再捣令十分匀，捏作饼子，以瓦盆盛贮，安置静室中，至6月6日晒令极干收。";
  ex:hasPrescription "韭菜1斤，刺蓟草1斤，试剑草1斤。";
  ex:hasUsage "如常用之。" .

<medicine:金疮蜜药方> a ex:Medicine;
  ex:hasFunction "化腐生肌，止痛活血。主一切金疮溃烂。";
  ex:hasName "金疮蜜药方";
  ex:hasPreparation "先将油熬开，再入当归炸至枯焦，过灯花棉纸淋净，去滓，再熬开，入二蜡融化，熬15分钟，端下凉透，入罐听用。";
  ex:hasPrescription "真香油8两，肥当归1两，黄蜡1两，白蜡3两。" .

<medicine:金疮铁扇散> a ex:Medicine;
  ex:hasAlias "铁扇散";
  ex:hasFunction "刀石破伤。";
  ex:hasName "金疮铁扇散";
  ex:hasNote "忌卧热处。";
  ex:hasPreparation "上为极细末，贮瓷罐中。";
  ex:hasPrescription "象皮5钱（切薄片，用小锅焙黄色以干为度，勿令焦），龙骨5钱（用上白者，生研），老材香1两（山陕等省无漆，民间棺殓俱用松香、黄蜡涂于棺内，数10年后，有迁葬者，棺朽另易新棺，其朽棺内之香蜡即谓之老材香。东南各省无老材香，即以数百年陈石灰1两代之，其效与老材香同），寸柏香1两（即松香中的黑包者），松香10两（与寸柏香一同熔化，搅匀，倾入冷水，取出凉干），飞矾1两（将白矾入锅熬透便是）。";
  ex:hasUsage "遇有刀石破伤者，用药敷伤口，以扇向伤口处扇之。如伤口处发肿，煎黄连水用翎毛蘸涂之即消。" .

<medicine:金白散> a ex:Medicine;
  ex:hasFunction "牙根臭烂、黑色，有虫。";
  ex:hasName "金白散";
  ex:hasPreparation "研。";
  ex:hasPrescription "鸡内金（焙干）1两，白芷5钱，铜绿1钱，麝香1分。";
  ex:hasUsage "搽。" .

<medicine:金盖散> a ex:Medicine;
  ex:hasFunction "痘腐烂不收，和皮脱去。";
  ex:hasName "金盖散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "黄牛粪尖（晒燥，砻糠火煅黑存性）。";
  ex:hasUsage "以此散撒在褥席上，令儿眠上；若以绢袋盛之，通身扑之亦可。" .

<medicine:金真丸> a ex:Medicine;
  ex:hasFunction "三焦气壅，结痞心胸，大便不通，伤寒下症，已服承气不利，服此百粒，安稳而通。";
  ex:hasName "金真丸";
  ex:hasPreparation "上为细末，滴水为丸，如梧桐子大。";
  ex:hasPrescription "川大黄（锉碎，微炒）、商枳实（面炒）、槟榔、黑牵牛（一半生，一半熟）各等分。";
  ex:hasUsage "每服50-70丸，米饮送下。以大便和利为度。" .

<medicine:金石凌> a ex:Medicine;
  ex:hasFunction "金石热发。";
  ex:hasName "金石凌";
  ex:hasPreparation "熟沸水5升，渍朴消、芒消令消，澄1宿，旦取澄消安铜器中，粗捣寒水石、石膏纳其中，仍纳金5两，微火煎之，频以筯头柱看，着筯成凌云，泻置铜器中，留着水盆中凝1宿皆成凌，停3日以上，皆干也。";
  ex:hasPrescription "上朴消1斤，上芒消1斤，石膏4两，凝水石2两。";
  ex:hasUsage "若热病及石发，皆以蜜水和服半鸡子大。" .

<medicine:金石散> a ex:Medicine;
  ex:hasFunction "休息痢。";
  ex:hasName "金石散";
  ex:hasPreparation "上3味；将前2味慢火炒一炊久，入糯米同研令细。";
  ex:hasPrescription "石灰1分，铅丹1分，糯米1合（炒黑）。";
  ex:hasUsage "每服2钱匕，空心陈米饮调下。" .

<medicine:金石清心饮> a ex:Medicine;
  ex:hasFunction "清心神，凉血清热，豁痰消食。主妇人气血两虚，多怒而动肝火，今经行去血过多，风热乘之，客热与内火而相搏，心神昏闷，登高而歌，去衣而走，妄言谵语，如风鬼神。";
  ex:hasName "金石清心饮";
  ex:hasPrescription "石莲肉、金箔、郁金、麦冬、丹皮、赤苓、赤芍、石菖蒲、生地、甘草、木通、半夏、神曲、枳壳。" .

<medicine:金砂丸> a ex:Medicine;
  ex:hasFunction "风癫，精神不宁，言语错乱。";
  ex:hasName "金砂丸";
  ex:hasNote "忌羊血。";
  ex:hasPreparation "上以金屑置鼎子中，作一坑子，安朱砂于坑子内，上又以金屑盖之，用六一泥固济，缓火养7日，后取出朱砂，又作一地坑子，纳入朱砂，出火毒，7日后取出，为极细末，以粟米饭为丸，如绿豆大。";
  ex:hasPrescription "金10两（细锉为屑），朱砂3两（光明者）。";
  ex:hasUsage "每服5丸，以热水送下，不拘时候。" .

<medicine:金砂丹> a ex:Medicine;
  ex:hasFunction "中风涎潮，失音不语，面赤，脉大数急，迷闷，口眼斜，俱系风热之疾，半身亸曳；或伤寒刚痉瘈疭，妇人产后角弓反张。";
  ex:hasName "金砂丹";
  ex:hasPreparation "上为细末，真石脑油为丸，每两作10丸，瓷盒内收。";
  ex:hasPrescription "白花蛇（酒浸，去皮骨取肉）1两，乌蛇（酒浸，去皮骨取肉）1两，蝎梢（炒）1两，白僵蚕（炒）1两，犀角屑1两，玳瑁屑1两，天麻1两，人参1两，白茯神1两，甘草（炙）1两，龙脑（研）1分，麝香（研）1分，朱砂（研）5两，牛黄（研）1分，雄黄（研）1分，珍珠（研）1分，天竺黄（研）1分，金箔230片，银箔230片，铁粉（研）1分。";
  ex:hasUsage "每服1丸，人参汤化下；或竹叶汤、新汲水亦得。" .

<medicine:金砂散> a ex:Medicine;
  ex:hasFunction "疔疮。";
  ex:hasName "金砂散";
  ex:hasPreparation "上为细末，生蜜调合，用角盒子收贮。";
  ex:hasPrescription "硇砂（好者）、雄黄（好者）各等分。";
  ex:hasUsage "先将银篦桃破疮口，挤出恶血，然后用药1豆大入疮口内，以纸花贴定。若毒气入腹，已多呕吐欲死者，即服内托香粉散。" .

<medicine:金科猪肚丸> a ex:Medicine;
  ex:hasFunction "一切疳积，面黄肌瘦，腹内痞癖气块，五疳多虫，骨蒸，疳寒热，瘦悴，面浮，无辜，丁奚。";
  ex:hasName "金科猪肚丸";
  ex:hasPreparation "上为末。先用雄猪肚1个，以使君子肉1升，糯米2-3合，粳米2合，人猪肚内，蒸熟捣烂糊，再入猪胆汁3-4个研匀，却入众药，搜作饼子，臼中杵捣百遍，视色和匀为细丸，如麻子大。";
  ex:hasPrescription "使君子1升，青皮（炒）、三棱（煨）、莪术（煨）、黄连、胡黄连、川楝子、芜荑（炒，研）、枳壳（炒）、黄梗皮、青木香、麦芽（炒）、槟榔（炒）、香附子、陈皮、杏仁（研）、茴香（炒）、吴茱萸（炒）、轻粉、巴豆（去心，去油）、神曲（炒）、龙胆草、石榴皮、诃子、肉豆蔻、南木香、芦荟、虾蟆（炙）、谷芽（炒）、青黛、白曲、干姜、玄胡索（炙）、朱砂、姜（炒）、郁金、皂角（烧）、山茱萸、没石子、良姜、干漆（炒令烟尽）、丁香各等分（一方加黄丹、鸡子黄、米粉）。";
  ex:hasUsage "每服20-30丸，空心饭饮吞下。" .

<medicine:金竹衣麦门冬汤> a ex:Medicine;
  ex:hasFunction "一切痨瘵痰饮，声哑不出，难治者。";
  ex:hasName "金竹衣麦门冬汤";
  ex:hasPrescription "金竹衣（取竹内衣膜，鲜者）1钱，竹茹弹子大1丸（即金竹青皮也，割取之），竹沥（即取金竹者）、麦冬2钱，甘草5分，橘红5分，茯苓1钱，桔梗1钱，杏仁7枚（去皮尖，研）。";
  ex:hasUsage "上用水1钟半，加竹叶14片，煎7分，入竹沥1杯，和匀服。" .

<medicine:金笔丸> a ex:Medicine;
  ex:hasFunction "难产。";
  ex:hasName "金笔丸";
  ex:hasPreparation "上和停，用蜡为丸，如梧桐子大，作1服。";
  ex:hasPrescription "金箔3片，兔毫笔头3个（烧为灰）。";
  ex:hasUsage "温酒送下。" .

<medicine:金简煎> a ex:Medicine;
  ex:hasFunction "辟谷固气，却灭三尸，消荡九虫，安和五脏，镇守三田，轻身强志，拘魂制魄，延永胎根。主";
  ex:hasName "金简煎";
  ex:hasPreparation "上6味，将蜜分作9分，每1分拌乳香等，入新竹筒内盛，大竹可3-4枚盛了；次用新桑白皮扎塞定筒口，令密，以黑豆、大麦水拌，铺在大甑底，上坐竹筒，次又以豆麦盖覆过，竹筒再盖覆如法，慢火炊1日，3-4次添水，炊至夜，取出筒，倾药出，以瓷器盛了，入焙笼内火焙1夜，或未干又焙，令极干；再取蜜1分拌药令匀，又以新桑白皮塞口了，再入水洒拌豆麦令匀，又依前再炊1日，如前用热水洒3-4次，炊1日至夜，依前取焙之；如此九炊九焙，放干成煎。";
  ex:hasPrescription "乳香4两，牛乳1斗（银石器中盛，并乳香于重汤内煮，旋旋浇牛乳汁，以乳香化为度），赤石脂半斤（细研，水飞过，于纸箱内沙上渗干，入夹绢袋，盛于饭上炊9次，每次出焙干，又炊以饭熟为度），丹砂4两（研，水飞过，纸箱内盛，泣干），甘草半斤（为末），蜜（银器盛，重汤内熬，以绢袋滤过）4斤。";
  ex:hasUsage "每服抄1大匙许，仍须先均作120服，须先服药床；如要服药床，即忌盐醋；如要治中风瘫痪，半身不遂，口眼斜，语涩神昏者，分作140服，亦须先服药床。" .

<medicine:金箍散> a ex:Medicine;
  ex:hasAlias "青露散";
  ex:hasFunction "一切大毒。";
  ex:hasName "金箍散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "胆矾2钱，硼砂2钱，水银2钱，明雄2钱，黑铅2钱。";
  ex:hasUsage "火酒调敷。如不粘，加飞面6钱。" .

<medicine:金箍膏> a ex:Medicine;
  ex:hasFunction "肿毒。";
  ex:hasName "金箍膏";
  ex:hasPreparation "上为末，米醋为膏。";
  ex:hasPrescription "凤仙花子10两，大黄10两，五倍子10两（为细末），人中白（如无，皮消1两5钱代之），陈小粉13两（3年者，共入铁锅内炒至黄焦色）。";
  ex:hasUsage "肿毒初起围之。" .

<medicine:金箔丸> a ex:Medicine;
