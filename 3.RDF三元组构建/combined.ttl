  ex:hasName "左金丸";
  ex:hasPreparation "上为末，水丸或蒸饼为丸。";
  ex:hasPrescription "黄连180克 吴茱萸30克或15克";
  ex:hasUsage "白汤下50丸。" .

<medicine:左金汤> a ex:Medicine;
  ex:hasFunction "治霍乱吐泻转筋，手足寒，心烦热渴。";
  ex:hasName "左金汤";
  ex:hasPrescription "川连（或生，或炒，随酌）吴茱萸（汤泡）制半夏 茯苓 陈皮 甘草 枳壳 竹茹";
  ex:hasUsage "加藿香，水煎服。" .

<medicine:巨圣散> a ex:Medicine;
  ex:hasFunction "小儿急惊，手足瘛疭，咽膈涎盛。";
