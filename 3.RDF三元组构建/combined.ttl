  ex:hasUsage "每日1次，温服，疗程不限。" .

<medicine:苁蓉丸> a ex:Medicine;
  ex:hasAlias "木瓜丸、肉苁蓉丸";
  ex:hasFunction "肾脏虚冷，腰膝无力，小便不禁，或溺白色。";
  ex:hasName "苁蓉丸";
  ex:hasNote "老人夏月宜服。";
