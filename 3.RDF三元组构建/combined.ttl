  ex:hasUsage "方中高茶末用量原缺，《医统》用陈茶叶一撮。" .

<medicine:丁胡三建汤> a ex:Medicine;
  ex:hasFunction "痘后元气不足，忽然凹陷。";
  ex:hasName "丁胡三建汤";
