  ex:hasUsage "每服半钱，以粥饮调下，日3-4次。" .

<medicine:龙骨汤> a ex:Medicine;
  ex:hasAlias "龙骨散";
  ex:hasFunction "新久泻痢。";
  ex:hasName "龙骨汤";
