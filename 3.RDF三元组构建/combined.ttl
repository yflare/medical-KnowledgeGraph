  ex:hasUsage "每服3至5丸，温水送下。" .

<medicine:大麦敷方> a ex:Medicine;
  ex:hasFunction "蠼螋尿疮。";
  ex:hasName "大麦敷方";
  ex:hasPrescription "大麦1合。";
  ex:hasUsage "上药细嚼，涂疮上。" .

<medicine:大麦汤> a ex:Medicine;
  ex:hasFunction "老人烦渴不止，饮水不定，转渴，舌卷干焦。";
  ex:hasName "大麦汤";
  ex:hasPrescription "寒食残大麦2升，赤饧2合。";
  ex:hasUsage "以水7升，煎取5升，去滓，下饧调之。渴即服。" .

<medicine:大麦煎散> a ex:Medicine;
