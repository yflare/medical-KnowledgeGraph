  ex:hasUsage "每服1-2钱，薄荷汤调下。" .

<medicine:甘乳膏> a ex:Medicine;
  ex:hasFunction "收干生肌。主";
  ex:hasName "甘乳膏";
  ex:hasPrescription "乳香2钱，水飞甘石粉2钱，龙骨2钱，石脂2钱，海螵蛸2钱，凡士林4两。";
  ex:hasUsage "直接外涂，或涂于纱布上再外敷。" .

<medicine:甘乳药捻> a ex:Medicine;
