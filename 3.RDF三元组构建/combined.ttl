<medicine:葵根敷方> a ex:Medicine;
  ex:hasFunction "刀斧伤疮，或至筋断。";
  ex:hasName "葵根敷方";
  ex:hasPrescription "葵菜根。";
  ex:hasUsage "捣敷之。" .

<medicine:葵根汤> a ex:Medicine;
  ex:hasFunction "一年渴，饮1石以上，小便利；及饮酒渴、伤寒渴。";
