  ex:hasUsage "每服4钱，水1盏半，煎8分，去滓，空心温服。" .

<medicine:地肤煎> a ex:Medicine;
  ex:hasFunction "雷头风肿，不省人事。";
  ex:hasName "地肤煎";
  ex:hasPrescription "落帚子。";
  ex:hasUsage "同生姜研烂，热酒冲服，取汗即愈。" .

<medicine:地肤酒> a ex:Medicine;
  ex:hasFunction "疔毒，吹乳。";
  ex:hasName "地肤酒";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "地肤子（即扫帚子）。";
