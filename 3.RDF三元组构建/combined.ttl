  ex:hasFunction "治梦泄遗精。";
  ex:hasName "斩梦丹";
  ex:hasPreparation "上药为末，白水和丸。";
  ex:hasPrescription "知母30克 黄柏30克（去皮）滑石90克";
  ex:hasUsage "空腹时温酒送下。" .

<medicine:断下丸> a ex:Medicine;
