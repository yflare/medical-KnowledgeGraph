<medicine:龙蜕散> a ex:Medicine;
  ex:hasAlias "催生龙蜕散";
  ex:hasFunction "催生。主";
  ex:hasName "龙蜕散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "蝉退1两（烧存性），大蛇蜕（火烧存性）1条，滑石半两，葵子1两（微炒）。";
  ex:hasUsage "催生龙蜕散（《明医指掌》卷九）。" .

<medicine:龙蜕饼子> a ex:Medicine;
  ex:hasAlias "消毒饼子";
