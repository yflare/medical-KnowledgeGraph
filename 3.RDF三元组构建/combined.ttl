  ex:hasPrescription "赤芍15g，丹参15g，桃仁9g，三棱3-6g，莪术3-6g。";
  ex:hasUsage "水煎服，每日1剂，日服2次。" .

<medicine:宫外孕方> a ex:Medicine;
  ex:hasClinicalApplication "临床主要用于治疗异位妊娠、人工流产后延迟出血等病症。";
  ex:hasName "宫外孕方" .

<medicine:宫外孕I号方> a ex:Medicine;
