  ex:hasUsage "每服2丸，温开水送下，日2次。" .

<medicine:达生散> a ex:Medicine;
  ex:hasAlias "束胎散（《丹溪心法》卷五）、束胎饮（《丹溪治法心要》卷七）。";
  ex:hasFunction "安胎利产。主";
  ex:hasName "达生散";
