  ex:hasPrescription "青嫩瓜蒌。";
  ex:hasUsage "每用1小盏，倾茶瓯中，白滚汤，不拘时候。" .

<medicine:瓜蒌贝母饮> a ex:Medicine;
  ex:hasFunction "乳房结核，焮肿。";
  ex:hasName "瓜蒌贝母饮";
  ex:hasPrescription "瓜蒌实3钱，土贝母（去心）3钱，甘草节3钱。";
  ex:hasUsage "水煎服。" .

<medicine:瓜蒌酒> a ex:Medicine;
  ex:hasFunction "肿毒初起。";
