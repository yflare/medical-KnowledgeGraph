  ex:hasUsage "活血丹（《全生指迷方》卷二）。" .

<medicine:鸡心丸> a ex:Medicine;
  ex:hasFunction "小儿肝疳，面青黄，揉鼻揩眼，咬甲吃水。";
  ex:hasName "鸡心丸";
  ex:hasPreparation "上为末，蒸饼为细丸。";
  ex:hasPrescription "槟榔（去脐）3个，赤芍药2钱，龙胆草（去芦）2钱，羌活2钱，独活2钱，川芎2钱，皂荚（烧存性）3钱。";
  ex:hasUsage "百沸水送下。" .

<medicine:鸡心散> a ex:Medicine;
  ex:hasFunction "肾脏风，发疮疥。";
  ex:hasName "鸡心散";
  ex:hasPreparation "上为末，加轻粉半钱，麝香少许，青黛末半钱，于瓷器内收。";
  ex:hasPrescription "鸡心槟榔2个（破开，以黄丹3钱合在内，用湿纸裹煨），全蝎6个，明硫黄4钱。";
  ex:hasUsage "每用少许，清油调抹两掌揜外肾，女以两掌揜两乳，各睡至醒，次日又用。" .

<medicine:鸡心膏> a ex:Medicine;
  ex:hasFunction "小儿斑疮，浮翳入目；大人赤目后翳如丁者。";
  ex:hasName "鸡心膏";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "天竺黄1钱，朱砂1钱，雄黄1钱，蔚金1钱，大黄2两。";
  ex:hasUsage "每服半钱，用鸡子清调药，巴豆3枚（去皮），同盛在鸡子壳内，湿布裹，慢火煨熟，抹去巴豆不用，细嚼，米泔送下。小儿研烂，米泔调下。" .

<medicine:鸡心酸枣汤> a ex:Medicine;
  ex:hasFunction "饮服石后阳多，肾虚发热，积日不食，胃中虚热，饮食不已，气入百脉，心脏虚甚，令人失常。";
  ex:hasName "鸡心酸枣汤";
  ex:hasPreparation "上切。";
  ex:hasPrescription "鸡心10枚，酸枣半升，人参1两，茯神2两，芍药2两，白薇2两，枳实（炙）2两，知母2两，甘草（炙）2两，栝楼2两，生地黄8两。";
  ex:hasUsage "以水1斗煮药半熟，纳鸡心，煮取3升，分3次冷服。" .

<medicine:鸡毛散> a ex:Medicine;
  ex:hasFunction "肠痈。";
  ex:hasName "鸡毛散";
  ex:hasPreparation "上药烧作末。";
  ex:hasPrescription "雄鸡顶上毛、雄鸡屎。";
  ex:hasUsage "空心酒调下。" .

<medicine:鸡汁粥> a ex:Medicine;
  ex:hasFunction "滋养五脏，补益气血。主年老体弱，病后羸瘦，气血亏损所引起的一切衰弱病证。";
  ex:hasName "鸡汁粥";
  ex:hasNote "体质壮实的老人，以及伤风感冒或生病发热期间不宜食用。";
  ex:hasPreparation "将鸡剖洗干净，浓煎鸡汁，以原汁鸡汤分次同粳米煮粥，先用旺火煮沸，再改用文火煮至粥稠即可。";
  ex:hasPrescription "母鸡1只（3-4斤，重者，剖洗干净后，浓煎取汁），粳米2两。";
  ex:hasUsage "以原汁鸡汤分次同粳米煮粥，先用旺火煮沸，再改用微火煮到粥稠即可。可供早晚餐或点心，温热服食。" .

<medicine:鸡清丸> a ex:Medicine;
  ex:hasFunction "理脾厚肠，和胃止泻。主湿热凝滞，红白痢疾，滞下不爽，日夜无度。";
  ex:hasName "鸡清丸";
  ex:hasNote "忌食鱼、肉、凉、粘、梗、辣食物。";
  ex:hasPreparation "上为极细末，面糊为小丸。";
  ex:hasPrescription "广木香2两，黄连2两5钱，肉豆蔻7个。";
  ex:hasUsage "每服1钱，空心米汤送下。" .

<medicine:鸡清散> a ex:Medicine;
  ex:hasFunction "痈疽发背，丹毒恶肿，时行热毒，发作赤色，瘰疬初发，吹奶肿痛。";
  ex:hasName "鸡清散";
  ex:hasPreparation "上为细未。";
  ex:hasPrescription "赤小豆、黄药子、大黄、盆消、皂角（去皮弦，酥炙）、木鳖子各等分。";
  ex:hasUsage "用鸡卵清调，鹅翎蘸药敷之。" .

<medicine:鸡清膏> a ex:Medicine;
  ex:hasFunction "小儿涎鸣喘急，服药不退，气实者。";
  ex:hasName "鸡清膏";
  ex:hasPrescription "无雄鸡子1个。";
  ex:hasUsage "取清，入轻粉，抄10钱拌和，银器盛，汤瓶上顿熟，3岁尽食。当吐痰或泻，即愈。" .

<medicine:鸡白散> a ex:Medicine;
  ex:hasFunction "膀胱虚热，下沙石，水道涩痛。";
  ex:hasName "鸡白散";
  ex:hasPreparation "上同研令细。";
  ex:hasPrescription "鸡粪白1两（微炒），雄鸡胆半两。";
  ex:hasUsage "每服1钱，食前以温酒调下。以利为度。" .

<medicine:鸡白汤> a ex:Medicine;
  ex:hasAlias "鸡屎白汤";
  ex:hasFunction "霍乱转筋，闷绝欲死。";
  ex:hasName "鸡白汤";
  ex:hasPreparation "上锉，如麻豆大。";
  ex:hasPrescription "鸡粪白1合（熬），胡椒20粒，高良姜1两1分，桂（去粗皮）1两1分，白术1两1分，木瓜2两，生姜（切，焙）6分。";
  ex:hasUsage "每服5钱匕，水1盏半，煎取8分，去滓温服，不拘时候。" .

<medicine:鸡白调散> a ex:Medicine;
  ex:hasFunction "小儿伤寒伤风，发寒热似疟，久不愈，渐变骨间蒸热。";
  ex:hasName "鸡白调散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "朱砂（水飞）1钱，白矾（枯）1钱，铁华粉1钱，粉霜1钱，铅白霜1钱，轻粉2钱，白附子2钱，蝎梢6个，龙脑、麝香各少许。";
  ex:hasUsage "每服半钱，入鸡子白、井花水共约1茶脚，调匀服，不拘时候。" .

<medicine:鸡眼膏> a ex:Medicine;
  ex:hasFunction "鸡眼。";
  ex:hasName "鸡眼膏";
  ex:hasPreparation "捶碎，桐油熬枯去滓，滴水成珠，不散为度，加雄黄少许搅匀，收贮。";
  ex:hasPrescription "鲜白果外面绿皮不拘多少。";
  ex:hasUsage "先将鸡眼热水泡软，贴上1伏时，揭下，内有红丝拔出。" .

<medicine:鸡矢醴> a ex:Medicine;
  ex:hasAlias "牵牛妙酒、鸡醴饮、牵牛酒、鸡矢酒";
  ex:hasFunction "一切肚腹、四肢发肿，不问水肿、气肿、湿肿。";
  ex:hasName "鸡矢醴";
  ex:hasPrescription "鸡矢。";
  ex:hasUsage "牵牛妙酒（《摄生众妙方》卷六）、鸡醴饮（《古今医鉴》卷六引刘同知方）、牵牛酒（《本草纲目》卷四十八引《积善堂经验方》）、鸡矢酒（《仙拈集》卷一）。按：《圣济总录》本方用法：鸡屎（干者）为末。每用醇酒调一钱匕，食后、临卧服。《奇效良方》本方用法：鸡矢白半升，以好酒一斗渍七日，每服1盏，食后、临卧时温服。《摄生众妙方》本方用法：用于鸡屎一升，锅内炒黄，以好酒三碗淬下，煮作一碗，滤去渣，令病人饮之。少顷腹中气大转动作鸣，大便利下，于脚膝及脐上下先作皱起，渐渐消复。如利未尽，再服一剂。以田螺二枚，滚酒内绰熟，食之即止，后以温粥调理，安好如常。峨眉有一僧以此方治一人浮肿，一二日即愈，自能牵牛来谢，故名。" .

<medicine:鸡矾散> a ex:Medicine;
  ex:hasFunction "阴蚀疮。";
  ex:hasName "鸡矾散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "鸡屎1分，矾火煎茶1分。";
  ex:hasUsage "先用桑枝、葱白、豉汤洗，后贴药，每日3次。" .

<medicine:鸡粪白散> a ex:Medicine;
  ex:hasFunction "小儿5-6岁石淋，茎中有沙石子不可出者；遗尿。";
  ex:hasName "鸡粪白散";
  ex:hasPreparation "上为细散。";
  ex:hasPrescription "鸡粪白1两（炒令黄）。";
  ex:hasUsage "以水1大盏，露1宿。每用此水1合，调散半钱服之，1日3-4次。当下沙石。" .

<medicine:鸡粪酒> a ex:Medicine;
  ex:hasAlias "鸡屎白豆淋酒、鸡矢酒";
  ex:hasFunction "产后中风及百病，并男子中一切风。";
  ex:hasName "鸡粪酒";
  ex:hasPreparation "上以清酒3升半，先淋鸡粪，次淋豆取汁。";
  ex:hasPrescription "鸡粪1升（熬令黄），乌豆1升（熬令声绝，勿焦）。";
  ex:hasUsage "鸡屎白豆淋酒（《圣济总录》卷一三九）、鸡矢酒（《济阴纲目》卷十二）。本方方名，《准绳·女科》引作“鸡矢醴”。" .

<medicine:鸡翅灰散> a ex:Medicine;
  ex:hasFunction "阴疝肿缩。";
  ex:hasName "鸡翅灰散";
  ex:hasPreparation "上为细散。";
  ex:hasPrescription "鸡翅（左右俱用）不限多少（烧灰）。";
  ex:hasUsage "每服2钱匕，温酒调下，不拘时候。" .

<medicine:鸡翎散> a ex:Medicine;
  ex:hasFunction "阴卒肿。";
  ex:hasName "鸡翎散";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "鸡翎6茎（烧灰），蛇床子1两（炒）。";
  ex:hasUsage "每服1钱，温酒调下。如左旁肿即取右翎，右旁肿取左翎。" .

<medicine:鸡翎酒> a ex:Medicine;
  ex:hasFunction "妊娠胎漏，尿不知出时；妊娠下血，疼痛不止。";
  ex:hasName "鸡翎酒";
  ex:hasPrescription "鸡翎（烧灰末）。";
  ex:hasUsage "每服方寸匕，温酒调下。" .

<medicine:鸡翮散> a ex:Medicine;
  ex:hasFunction "食诸肉骨鲠。";
  ex:hasName "鸡翮散";
  ex:hasPreparation "烧灰，为细末。";
  ex:hasPrescription "白雄鸡左右翮1茎，大毛1茎。";
  ex:hasUsage "《圣济总录》本方用法：每服一钱，米饮调下。" .

<medicine:鸡肉丸> a ex:Medicine;
  ex:hasFunction "小儿疳痨壮热，形体羸瘦，眼闭不开，四肢渐小，肚腹渐大。";
  ex:hasName "鸡肉丸";
  ex:hasNote "禁冷物、鱼、乌、醋、酒、房事等。";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "黄连（姜炒）1两，柴胡1两，鹤虱1两，秦艽1两，知母（酒炒）1两，黄芩（酒炒）1两，使君子（炒）1两，芦荟1两，芜荑5钱。";
  ex:hasUsage "用黄雌鸡1只，以大麻子饲之，七日缢死，去毛净，尾上开一孔，取肠净拭干，入前药末于内，缝密，以小甑先用黑豆铺底，安鸡上，又以黑豆盖之，厚3寸，早晨蒸至晚，俟冷去骨，捣烂为丸，如干加酒少许，如麻子大。每服10丸，5岁20丸，白滚汤送下。" .

<medicine:鸡肉煎丸> a ex:Medicine;
  ex:hasAlias "蒸鸡丸";
  ex:hasFunction "食疳。";
  ex:hasName "鸡肉煎丸";
  ex:hasNote "忌猪肉。";
  ex:hasPreparation "上为末拌和，将雌鸡一只去毛令净，于臀后开孔，去肠秽，净，拭干，入前药在鸡腹，以线缝好。取小甑，先以黑豆铺底三寸，然后放鸡，亦以黑豆围裹，上亦以黑豆三寸，自卯蒸至酉，俟冷，去鸡骨，将肉研细，酒煮面糊为丸。";
  ex:hasPrescription "芦荟3钱，人参3钱，柴胡3钱，使君子3钱，黄连（炒）3钱，芜荑（去壳，炒）3钱，胡黄连3钱。";
  ex:hasUsage "米汤送下。" .

<medicine:鸡肉膏> a ex:Medicine;
  ex:hasFunction "梅毒疳痼疾。";
  ex:hasName "鸡肉膏";
  ex:hasPrescription "大黄3两，黄芩3两，黄连3两，肉桂3两，土茯苓。";
  ex:hasUsage "①嗅药方：水银一钱，黑铅三分（纳土器上，武火沸时纳硫黄少许，则为黑霜），肉桂五分，甘草二分。上药和调，而更和陈艾六分，中令分捻而为七住，犹灯心状，纳盏浸香油灯，于方灯檠中嗅之。每日一炷，七日嗅尽之。嗅法：方灯檠四面上下以纸塞之，令气勿泄。一面穿小孔，令患人含水当鼻而嗅之。②方中土茯苓用量原缺。" .

<medicine:鸡肝丸> a ex:Medicine;
  ex:hasFunction "小儿睡中遗尿不自觉。";
  ex:hasName "鸡肝丸";
  ex:hasNote "忌冷水发物等。愈后以参、苓、白术、陈皮补脾之药调理。";
  ex:hasPreparation "上以桂末同肝捣烂如泥，为丸如小豆大。";
  ex:hasPrescription "雄鸡肝、桂心各等分。";
  ex:hasUsage "每服10丸，酒送下，日3次。" .

<medicine:鸡肝散> a ex:Medicine;
  ex:hasFunction "小儿肚大眼蒙，一切疳症。";
  ex:hasName "鸡肝散";
  ex:hasNote "忌食茶汤、油腻。";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "猪牙皂荚（煅令烟尽，存性）。";
  ex:hasUsage "以生鸡肝1个，男雄女雌，将皂荚末入内，以金银扁簪用青布擦热，搅肝，簪冷再擦热搅之，其肝化如水样，量投砂糖入内，与儿食之。重者2服即效。" .

<medicine:鸡肝粥> a ex:Medicine;
  ex:hasFunction "五劳七伤，阴萎气弱。";
  ex:hasName "鸡肝粥";
  ex:hasPrescription "雄鸡肝1具（切细），菟丝子末半两，粟米2合。";
  ex:hasUsage "以水2大盏半，入五味及葱，煮作粥，空心食之。" .

<medicine:鸡肝药> a ex:Medicine;
  ex:hasAlias "鸡肝散";
  ex:hasFunction "小儿疳疾。";
  ex:hasName "鸡肝药";
  ex:hasNote "忌猪肝及猪、牛、犬肉，不忌损目。";
  ex:hasPreparation "先将鸡肝剖开，取二黄药末放于肝内，合好；再用酒酿半钟，将鸡肝浸酒酿内，隔汤炖熟，晒干研末。";
  ex:hasPrescription "鸡肝1具，雄黄半分，牛黄半分。";
  ex:hasUsage "调服；或就热淡食亦可。" .

<medicine:鸡肝饼> a ex:Medicine;
  ex:hasFunction "小儿疳积。";
  ex:hasName "鸡肝饼";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "五谷虫（瓦上焙干）1两，全蝎1两（去毒），人参3钱，龙胆草3钱，谷精草5钱。";
  ex:hasUsage "每用2分，将陈酒糟1撮，雄鸡肝1具，共捣成饼。放饭上蒸熟，以酒食之。轻者5-6服，重者10服痊愈。" .

<medicine:鸡肠散> a ex:Medicine;
  ex:hasAlias "鸡肠草散、鸡肠草汤";
  ex:hasFunction "膀胱有热，服冷药过多，小便不能禁止，或遗尿病。";
  ex:hasName "鸡肠散";
  ex:hasPreparation "上为粗散。";
  ex:hasPrescription "鸡肠草1两，牡蛎粉3分，龙骨半两，麦门冬（去心，焙）半两，白茯苓半两，桑螵蛸半两。";
  ex:hasUsage "鸡肠草散（《卫生总微》卷十六）、鸡肠草汤（《赤水玄珠》卷十五）。" .

<medicine:鸡肠粉> a ex:Medicine;
  ex:hasFunction "温肾止遗。适用于小儿遗尿。";
  ex:hasName "鸡肠粉";
  ex:hasPreparation "将公鸡肠剖开洗净，放在文火上焙干研成细末即可。";
  ex:hasPrescription "公鸡肠1副";
  ex:hasUsage "用温开水送服，每次10克，1日2次，连服7～10天。" .

<medicine:鸡肠草散> a ex:Medicine;
  ex:hasFunction "解诸毒。主";
  ex:hasName "鸡肠草散";
  ex:hasPreparation "上药治下筛。";
  ex:hasPrescription "鸡肠草3分，荠苨4分，升麻4分，芍药1分，当归1分，甘草1分，篮子1合，坌土1分。";
  ex:hasUsage "每服方寸匕，水送下，多饮水为佳。若为峰蛇等众毒虫所螫，以针刺螫上，血出，着药如小豆许于疮中，令湿愈。为射罔箭所中，削竹如钗股长1尺5寸，以绵缠绕，水沾令湿，取药纳疮中，随疮深浅令至底止，有好血出即休。若服药有毒，水服方寸匕，毒解痛止愈。" .

<medicine:鸡肠菜羹> a ex:Medicine;
  ex:hasFunction "小便数。";
  ex:hasName "鸡肠菜羹";
  ex:hasPrescription "鸡肠草1斤。";
  ex:hasUsage "上于豉汁中煮，调和作羹食之；作粥亦得。" .

<medicine:鸡肠酒> a ex:Medicine;
  ex:hasFunction "小便数。";
  ex:hasName "鸡肠酒";
  ex:hasPrescription "鸡肠1具。";
  ex:hasUsage "上洗如常法，锉碎，炒作臛，以酒着椒、葱、五味食之。" .

<medicine:鸡肫丸> a ex:Medicine;
  ex:hasFunction "理脾化滞，消积止痛。主小儿脾胃不和，饮食难消，积滞痞块，腹痛胀满。";
  ex:hasName "鸡肫丸";
  ex:hasPreparation "上为细末，过罗。用冷开水泛为小丸。";
  ex:hasPrescription "三棱（炒）20两，莪术（炙）20两，茯苓20两，白术（炒）20两，神曲（炒）20两，麦芽（炒）20两，青皮（炒）20两，砂仁20两，橘皮20两，香附（炙）20两，莱菔子（炒）20两，枳壳（炒）20两，厚朴（炙）20两，干蟾（烧）40两，山楂40两，鸡内金（炒）810两，全蝎10两，木香5两。";
  ex:hasUsage "每服1钱，温开水送下，1日2次，3岁以下小儿酌情递减。" .

<medicine:鸡肫化滞丸> a ex:Medicine;
  ex:hasFunction "开胃健脾，消滞宽中，化积杀虫。主小儿五疳瘦弱，过食油腻生冷，停滞不化，或吐或泻，或疼或胀，痰积腹疼。";
  ex:hasName "鸡肫化滞丸";
  ex:hasNote "忌腥、冷、硬物。";
  ex:hasPreparation "上为极细末，水泛为小丸。";
  ex:hasPrescription "炒白术4两，陈皮4两，连翘4两，茯苓3两，枳壳3两，桔梗3两，香附3两，炒神曲3两，京三棱3两，莪术3两，炒麦芽2两，厚朴2两，炙甘草2两，鸡内金2两。";
  ex:hasUsage "每服2钱，白开水送下。" .

<medicine:鸡肺散> a ex:Medicine;
  ex:hasFunction "疳疾眼，生白膜白翳。";
  ex:hasName "鸡肺散";
  ex:hasPreparation "上共研细如膏，用无灰酒炖滚搅匀。";
  ex:hasPrescription "雄鸡1只（1斤3-4两者。取其搭脊脊血1块，即名鸡肺，将肺同后药共研烂），辰砂3分（研细），冰片3厘（研细）。";
  ex:hasUsage "食之即愈。" .

<medicine:鸡胆丸> a ex:Medicine;
  ex:hasFunction "小儿腹中有虫，喜食土器壁土，或马粪等。";
  ex:hasName "鸡胆丸";
  ex:hasPreparation "上为末，糊为丸，如梧桐子大。";
  ex:hasPrescription "鸡胆、黄连、大黄、槟榔各等分。";
  ex:hasUsage "每服5分，白汤送下。" .

<medicine:鸡胫丸> a ex:Medicine;
  ex:hasFunction "常服少病儿肥。主小儿惊疳黄瘦，咬牙，肌热盗汗，食积肚大，脚细，长大不能行。";
  ex:hasName "鸡胫丸";
  ex:hasPreparation "上为细末，水糊为丸，如麻子大。";
  ex:hasPrescription "天门冬1两，麦门冬（各去心）1两，秦艽1两，雄黄1两，雌黄1两，瓜蒌根1两，黄芩1两，柴胡（茸）1两，枯白矾1两，防风1两，桂1两，茯苓1两，桑白皮1两，雄鸡胫1对（炙），雌鸡胫1对（炙）。";
  ex:hasUsage "每服20丸，米饮粥送下，1日2次，不拘时候。" .

<medicine:鸡胵汤> a ex:Medicine;
  ex:hasFunction "气郁成臌胀，兼治脾胃虚而且郁，饮食不能运化。";
  ex:hasName "鸡胵汤";
  ex:hasPrescription "生鸡内金4钱（去净瓦石糟粕，捣碎），于术3钱，生杭芍4钱，柴胡2钱，广陈皮2钱，生姜3钱。";
  ex:hasUsage "水煎服。" .

<medicine:鸡胵茅根汤> a ex:Medicine;
  ex:hasFunction "水臌气臌并病，兼单腹胀，及单水臌胀，单气臌胀。";
  ex:hasName "鸡胵茅根汤";
  ex:hasPrescription "生鸡内金5钱（去净瓦石糟粕，轧细），生于术（分量用时斟酌）、鲜茅根2两（锉细）。";
  ex:hasUsage "先将茅根煎汤数茶钟（不可过煎，1-2沸后慢火温至茅根沉水底，汤即成），先用1钟半，加生姜5片，煎鸡内金末，至半钟时，再添茅根汤1钟，7-8沸后，澄取清汤（不拘1钟或1钟多）服之。所余之滓，仍用茅根汤煎服。日进1剂，早、晚各服药1次。初服小便即多，数日后大便亦多。若至日下2-3次，宜减鸡内金1钱，加生于术1钱。又数日，胀见消，大便仍勤，可减鸡内金1钱，加于术1钱。又数日，胀消强半，大便仍勤，可再减鸡内金1钱，加于术1钱。如此精心随病机加减，仰其补破之力，适与病体相宜，自能全愈。若无鲜茅根，可用药房中干茅根1两代之。无鲜茅根即可不用生姜。所煎茅根汤，宜当日用尽，煎药后若有余剩，可当茶温饮之。" .

<medicine:鸡胸丸> a ex:Medicine;
  ex:hasFunction "小儿鸡胸、龟背。";
  ex:hasName "鸡胸丸";
  ex:hasPreparation "上为末，炼蜜为丸。如芡实大。";
  ex:hasPrescription "大黄1钱（煨），天门冬5钱（去心），百合5钱，木通5钱，枳壳5钱（炒），杏仁5钱（去皮尖，炒），朴硝5钱，桑白皮5钱（蜜炙），葶苈5钱（炒）。";
  ex:hasUsage "每用1丸，温汤化下。" .

<medicine:鸡脑丸> a ex:Medicine;
  ex:hasFunction "小儿夜多惊啼，欲成痫候。";
  ex:hasName "鸡脑丸";
  ex:hasPreparation "上将当归为末，以鸡脑、丹砂等和匀为丸，如黍米大。";
  ex:hasPrescription "雄鸡脑1分，丹砂（研细）半两，牛黄（研细）1分，当归（切，焙）1分。";
  ex:hasUsage "100日儿每服1丸，薄荷汤送下，1日2次。" .

<medicine:鸡腊丸> a ex:Medicine;
  ex:hasFunction "小儿瓜瓤休息痢。";
  ex:hasName "鸡腊丸";
  ex:hasPrescription "黄腊1块如指大。";
  ex:hasUsage "上药入杓内，火上熔化，次入生鸡子黄白1个炒熟，空心服。" .

<medicine:鸡腰膏> a ex:Medicine;
  ex:hasFunction "小儿胎毒及头、面、耳前、耳后一切湿疮，并羊须疮。";
  ex:hasName "鸡腰膏";
  ex:hasPrescription "大鸡腰子1对（蒸熟去皮），枯矾3分。";
  ex:hasUsage "共捣融，加顶上冰片1-2分，敷之。" .

<medicine:鸡膍胵丸> a ex:Medicine;
  ex:hasFunction "小便数而多。";
  ex:hasName "鸡膍胵丸";
  ex:hasPreparation "上为末，炼蜜为丸，如梧桐子大。";
  ex:hasPrescription "鸡膍胵2两（微炙），黄耆2两（锉），龙骨1两，黄连半两（去须），麦门冬1两（去心，焙），土瓜根半两，熟干地黄1两。";
  ex:hasUsage "本方原名鸡膍胵散，与剂型不符，据《普济方》改。" .

<medicine:鸡膍胵散> a ex:Medicine;
  ex:hasFunction "膀胱虚冷，小便滑数，漏精，白浊如泔。";
  ex:hasName "鸡膍胵散";
  ex:hasPreparation "上为细散，用丹雄鸡汤三具，纳散在肠中，缝系了，于甑内蒸一炊久，取出焙干，为散。";
  ex:hasPrescription "鸡膍胵1两（微炙），熟干地黄1两，牡蛎1两（烧为粉），白龙骨1两（烧过），鹿茸1两（去毛，涂酥炙微黄），黄耆3分（锉），赤石脂1两，桑螵蛸3分（微炒），肉苁蓉1两（酒浸1宿，刮去皴皮，炙令干）。";
  ex:hasUsage "每服2钱，食前以温酒调下。" .

<medicine:鸡膍胵汤> a ex:Medicine;
  ex:hasFunction "产后小便数。";
  ex:hasName "鸡膍胵汤";
  ex:hasPrescription "鸡膍胵20具，鸡肠3具（洗），干地黄2两，当归2两，甘草2两，麻黄4两，厚朴3两，人参3两，生姜5两，大枣20枚。";
  ex:hasUsage "方中麻黄，《千金方衍义》作“蒲黄”。" .

<medicine:鸡膍骨丸> a ex:Medicine;
  ex:hasFunction "反胃，大便难，肌肤干瘦。";
  ex:hasName "鸡膍骨丸";
  ex:hasPreparation "上二味为末，与麻仁同研，炼蜜为丸，如梧桐子大。";
  ex:hasPrescription "鸡膍骨（慢火炙）3两，大黄（锉，炒）5两，大麻仁（研如膏）4两。";
  ex:hasUsage "每服20丸，食前米饮送下、日3次。" .

<medicine:鸡膏> a ex:Medicine;
  ex:hasFunction "素禀血燥，肺经有火，难服参料者。";
  ex:hasName "鸡膏";
  ex:hasPrescription "陈鸡1只（去筋膜皮骨及颈和脊，只取肩脚及腹下坚肉），生桔梗1条，生姜2两，官桂5钱，山楂20个，黄栗10个。";
  ex:hasUsage "贫家遇虚证，而难办参料，以此代用。" .

<medicine:鸡臛> a ex:Medicine;
  ex:hasFunction "妊娠四肢虚肿喘急，兼呕逆不下食。";
  ex:hasName "鸡臛";
  ex:hasPreparation "上四味，锉后三味，与鸡同煮，候鸡熟，去药取鸡留汁，将鸡细擘去骨，将汁入五味调和，入鸡肉再煮，令滋味相入了。";
  ex:hasPrescription "黄雌鸡1只（去头足及皮毛肠胃等，洗净去血，于沸汤中掠过，去腥水），高良姜1两，桑根白皮（刮净，锉）1两半，黄香（锉，拣）1两。";
  ex:hasUsage "随性食之，不计早、晚食。不妨别服药饵。" .

<medicine:鸡舌丹> a ex:Medicine;
  ex:hasFunction "新旧诸般打扑。";
  ex:hasName "鸡舌丹";
  ex:hasPreparation "上为细末，用密绢罗筛出。";
  ex:hasPrescription "桂心末40钱，丁子1钱，肉桂2钱，糯米2合。";
  ex:hasUsage "陈酱汁和匀，鸡翎扫搽患处。" .

<medicine:鸡舌散> a ex:Medicine;
  ex:hasFunction "狐臭。";
  ex:hasName "鸡舌散";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "鸡舌香2两，藿香2两，青木香2两，胡粉2两。";
  ex:hasUsage "纳腋下，绵裹之。常作愈。" .

<medicine:鸡舌香丸> a ex:Medicine;
  ex:hasAlias "鸡舌香煎";
  ex:hasFunction "上气心腹胀满，呕逆痰唾。";
  ex:hasName "鸡舌香丸";
  ex:hasNote "忌食猪肉。";
  ex:hasPreparation "上为细末，拌和令匀，炼蜜为丸，如樱桃大。";
  ex:hasPrescription "鸡舌香1两，沉香（锉）1两，木香1两，槟榔（锉）1两，白术1两，丁香1两，厚朴（去粗皮，生姜汁炙）半两，丹砂（细研）1两半，人参3分，当归（切，焙）半两，芍药1分，枳壳（去瓤，麸炒）1分，甘草（炙）半两。";
  ex:hasUsage "每服1丸，细嚼，空心、食前生姜盐汤送下。" .

<medicine:鸡舌香散> a ex:Medicine;
  ex:hasFunction "风冷乘于齿间，发歇疼痛，口气宣露。";
  ex:hasName "鸡舌香散";
  ex:hasNote "忌生冷。";
  ex:hasPreparation "上二味为散，再入麝香拌和令匀。";
  ex:hasPrescription "鸡舌香1两，射干1两，麝香（细研）1分。";
  ex:hasUsage "每用少许揩齿良久，以温汤漱口。" .

<medicine:鸡舌香汤> a ex:Medicine;
  ex:hasFunction "脾胃虚弱，久积寒痰，呕逆涎沫，哕逆恶心，宿食不消，胸膈痞闷，咳逆喘息，目眩头旋，不欲饮食，肢体倦怠。";
  ex:hasName "鸡舌香汤";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "人参、黄橘皮2分，鸡舌香、半夏1钱，甘草、神曲4钱，生姜6钱，草豆蔻3个。";
  ex:hasUsage "每服2钱，沸汤点下。" .

<medicine:鸡艾汤> a ex:Medicine;
  ex:hasFunction "妊娠二月，始阴阳踞经，有寒多坏不成，有热即萎悴，中风寒有所动摇，心满脐下悬急，腰背强痛，卒有所下，乍寒乍热。";
  ex:hasName "鸡艾汤";
  ex:hasPrescription "艾叶2两，丹参2两，当归2两，麻黄2两，人参3两，阿胶3两，甘草1两，生姜6两，大枣12个。";
  ex:hasUsage "上(口父)咀。用乌雌鸡1只，宿肥者，治如食法，割头取血，纳3升酒中相和，鸡以水1斗2升先煮，取汁，去鸡纳药煎，取3升，纳血、酒并胶煎，取3升，分3次温服。" .

<medicine:鸡苏七味汤> a ex:Medicine;
  ex:hasFunction "积热劳累而致吐血，但觉心中悁悁似欲取吐，背上烦热者。";
  ex:hasName "鸡苏七味汤";
  ex:hasPreparation "上切。";
  ex:hasPrescription "鸡苏5两，生地黄（切）1升，青竹茹1升，生姜6两，桑白皮6两，小蓟根（切）6合，生葛根（切）6合。";
  ex:hasUsage "以水9升，煮取3升，去滓，分3次温服，服后相去如人行10里久。若1剂得力，欲重合服，至4-5剂尤佳，隔3-4日服1剂。" .

<medicine:鸡苏丸> a ex:Medicine;
  ex:hasFunction "润肺止嗽，化痰定喘。主肺经湿热，咳嗽痰盛，经久不止，喘息气促，睡卧不宁。";
  ex:hasName "鸡苏丸";
  ex:hasPreparation "上为细末，过罗，用生姜160两，红枣160两煎，水泛为小丸，每16两用滑石、细粉4两为衣，以外上墨汁衣闯亮。";
  ex:hasPrescription "远志（去心，炙）320两，五爪橘红160两，紫菀160两，知母160两，白芍160两，甘草160两，麦冬160两，冬花160两，五味子（炙）160两，葶苈子160两，沙参160两，兜铃160两，天冬160两，瓜蒌仁（炒）160两，桑皮160两，百合160两，法半夏160两，黄芩160两，桔梗160两，前胡160两，橘皮160两，苏叶320两，苏子320两，麻黄640两，生石膏320两，杏仁（去皮，炒）640两。";
  ex:hasUsage "每服2钱，温开水送下，1日2次。" .

<medicine:鸡苏人参汤> a ex:Medicine;
  ex:hasFunction "上焦有热，津液燥少，喉咽干痛。";
  ex:hasName "鸡苏人参汤";
  ex:hasPreparation "上为粗末。";
  ex:hasPrescription "鸡苏叶1两，恶实（炒）1两，玄参1两，甘草（炙，锉）1两，防风（去叉）半两，人参半两，天门冬（去心，焙）半两。";
  ex:hasUsage "每服3钱匕，水1盏，加梨2片，同煎至6分，去滓，食后温服。" .

<medicine:鸡苏吹喉散> a ex:Medicine;
  ex:hasFunction "治疫喉初起，肿痛腐烂，或白或黄者。";
  ex:hasName "鸡苏吹喉散";
  ex:hasPreparation "为细末。";
  ex:hasPrescription "鸡苏薄荷 僵蚕各1.5克 硼砂 芒消各3克 马勃0.9克 冰片0.3克";
  ex:hasUsage "吹患处。" .

<medicine:鸡苏散> a ex:Medicine;
  ex:hasAlias "鸡苏饮";
  ex:hasFunction "妇人血淋。";
  ex:hasName "鸡苏散";
  ex:hasPreparation "上为粗散。";
  ex:hasPrescription "鸡苏叶2两，滑石3两，刺蓟根1两（锉），木通2两（锉），生干地黄2两。";
  ex:hasUsage "鸡苏饮（《圣济总录》卷九十八）。" .

<medicine:鸡苏汤> a ex:Medicine;
  ex:hasFunction "小便出血不绝。";
  ex:hasName "鸡苏汤";
  ex:hasPreparation "上为粗末。";
  ex:hasPrescription "鸡苏（去土）2两，石膏2两，竹叶（锉）1两。";
  ex:hasUsage "每服4钱匕，水1盏半，煎至1盏，去滓温服，不拘时候。" .

<medicine:鸡苏涂方> a ex:Medicine;
  ex:hasFunction "火丹热毒之气，五色无定。";
  ex:hasName "鸡苏涂方";
  ex:hasPreparation "上药捣，厚涂之。";
  ex:hasPrescription "生鸡苏。";
  ex:hasUsage "宜先宣转，然后用药。" .

<medicine:鸡苏羌活丸> a ex:Medicine;
  ex:hasFunction "风邪鼓作，头目眩运，目系急痛，甚则倒仆。";
  ex:hasName "鸡苏羌活丸";
  ex:hasPreparation "上为末，炼蜜为丸，如梧桐子大。";
  ex:hasPrescription "鸡苏叶2两，羌活（去芦头）1两半，芎1两半，羚羊角（镑）1两，防风（去叉）1两，天麻1两，人参1两，丹砂（研）1两，白僵蚕（微炒）半两，天南星（炮）半两，干蝎（去土，微炒）半两，牛黄（研）半两，麝香（研）半两，龙脑（研）半两，犀角（镑）1两。";
  ex:hasUsage "每服20丸，食后、临卧腊茶清送下。" .

<medicine:鸡苏饮> a ex:Medicine;
  ex:hasFunction "衄血不止。";
  ex:hasName "鸡苏饮";
  ex:hasPreparation "上锉，如麻豆大。";
  ex:hasPrescription "鸡苏1两半，白茯苓（去黑皮）1两半，射干1两半，白芷1两，桔梗1两，天门冬（去心，焙）1两，当归（切，焙）1两，大黄（锉，炒）1两，甘草（炙）1两，桂（去粗皮）半两。";
  ex:hasUsage "上(口父)咀。每服2钱匕，以水1盏，加生姜3片，煎取6分，去滓，空腹温服。" .

<medicine:鸡苏饮子> a ex:Medicine;
  ex:hasAlias "鸡苏散、鸡苏汤、鸡苏饮";
  ex:hasFunction "血淋不绝。";
  ex:hasName "鸡苏饮子";
  ex:hasNote "忌芜荑、蒜、面、炙肉等。";
  ex:hasPreparation "上切。";
  ex:hasPrescription "鸡苏1握，竹叶1握（切），石膏8分（碎），生地黄1升（切），蜀葵子4分（末，汤成下）。";
  ex:hasUsage "上除蜀葵子末外，以水6升，煮取2升，去滓，和葵子末，分2次温服。如人行4-5里久进1服。" .

<medicine:鸡苏饼> a ex:Medicine;
  ex:hasAlias "鸡苏饼子";
