  ex:hasUsage "水2盏，加竹叶20片，煎1盏，温服。" .

<medicine:白豆顶> a ex:Medicine;
  ex:hasFunction "一切痰证。";
  ex:hasName "白豆顶";
  ex:hasPreparation "上为细末，面糊为丸，分作10丸。";
  ex:hasPrescription "白扁豆3钱5分，雨茶3钱5分，白信1钱5分，陀僧1钱5分。";
  ex:hasUsage "每服1丸，冷浓茶送下。" .

<medicine:白连散> a ex:Medicine;
  ex:hasFunction "聍耳，出脓汁,浸淫疮。";
  ex:hasName "白连散";
