  ex:hasUsage "每服5丸，以热酒送下，不拘时候。" .

<medicine:白草散> a ex:Medicine;
  ex:hasFunction "口舌生疮，或咽喉痛者。";
  ex:hasName "白草散";
  ex:hasPrescription "甘草5文，白矾10文。";
  ex:hasUsage "上为细末，含化。" .

<medicine:白草枇杷饮> a ex:Medicine;
