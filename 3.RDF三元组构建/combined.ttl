  ex:hasName "揩齿细辛散";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "细辛（去苗叶）1分，升麻1分，白芷1分，藁本（去苗土）1分，沉香（锉）1分，丁香1分，石膏（研）1分。";
  ex:hasUsage "每日用柳枝咬头令软，点药揩齿。" .

<medicine:揩齿胡桃灰散> a ex:Medicine;
  ex:hasAlias "胡桃灰散";
