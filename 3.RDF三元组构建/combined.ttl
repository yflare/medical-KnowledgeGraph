  ex:hasUsage "每帖用河水2钟，加葱头2个，或加砂仁、生姜、黑枣亦可，煎8分，平时饥时服，产时温服。如不及早服，临产时加入秋葵子末1钱。" .

<medicine:达生汤> a ex:Medicine;
  ex:hasFunction "滑胎易产。主";
  ex:hasName "达生汤";
  ex:hasPrescription "当归2钱5分（酒洗），川芎6分，益母草1钱（忌铁器），车前子5分（炒，研末），甘草3分（炙），冬葵子1钱（炒，研末），白术1钱（米泔水浸，炒），大腹皮（滚水洗数次）4分，牛膝6分（酒浸1宿），枳壳5分（麸炒），木香3分（另磨），生姜1片。";
  ex:hasUsage "水煎，食远服。怀孕至8-9月之后，连服数贴。" .

<medicine:达营汤> a ex:Medicine;
  ex:hasClinicalApplication "周期性精神病：44例周期性精神病（情感性精神病及精神分裂症）患者，经服用达营汤、丸，临床结果表明：有效40例，无效4例，治愈率为90.9%。随访中有8例复发，经首次治疗而缓解后停药1～3年间，再次用药症状缓解，长者达10年，未复发者32例。";
  ex:hasFunction "周期性精神病。";
  ex:hasName "达营汤";
  ex:hasNote "孕妇及月经过多、易出血者忌用。";
  ex:hasPrescription "三棱60g，莪术60g，赤芍30g，生大黄30g。";
  ex:hasUsage "本方改为丸剂，名“达营丸”（见原书）。" .

<medicine:达郁汤> a ex:Medicine;
  ex:hasFunction "火丹。";
  ex:hasName "达郁汤";
  ex:hasPrescription "升麻2钱，元参9钱，干葛8钱，青蒿4钱，黄耆3钱。";
  ex:hasUsage "水煎服。" .

<medicine:过关散> a ex:Medicine;
  ex:hasFunction "通心经。主婴孩斑疮、水痘，心躁发渴，及小便赤色，口舌生疮。";
  ex:hasName "过关散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "山栀子仁1分，车前子1分，木通1分，甘草1分，瞿麦1分，赤茯苓1分，人参1分，滑石1分，大黄1钱，萹蓄半两（取嫩枝叶）。";
  ex:hasUsage "入灯心草略煎4-5沸服。" .

<medicine:过夜消> a ex:Medicine;
  ex:hasFunction "一切喉证。";
  ex:hasName "过夜消";
  ex:hasPreparation "上为末，次将霜梅捣烂，入药和匀为丸，如龙眼大。";
  ex:hasPrescription "冰片1分，牛黄1分，硼破8分，雄黄8分，孩儿茶8分，山豆根2钱，胆矾3分，陈霜梅（去核）3个。";
  ex:hasUsage "临卧含口中，过夜即消。" .

<medicine:过期饮> a ex:Medicine;
  ex:hasClinicalApplication "临床主要用于治疗经闭、月经过少等病症。";
  ex:hasFunction "补血行气。主血虚气滞之经水过期不行。";
  ex:hasName "过期饮";
  ex:hasPrescription "熟地黄2钱，白芍药2钱，当归2钱，香附2钱，川芎1钱，红花7分，桃仁泥6分，蓬莪术5分，木通5分，甘草4分，肉桂4分。";
  ex:hasUsage "《金鉴》有木香。" .

<medicine:过气丸> a ex:Medicine;
  ex:hasFunction "脾胃气虚，肾水流溢，四肢作肿。";
  ex:hasName "过气丸";
  ex:hasPreparation "上药同苡仁末煮糊为丸，如梧桐子大。";
  ex:hasPrescription "大蒜5枚（剥去皮，碎），附子1枚（去脐，切作块），赤小豆（拣）5两（上3味，同于砂锅内，用水5升，煮干为度，只取附子为末，余不用，却入后药），白花商陆根半两，沉香2钱，木香3钱，车前子3钱半。";
  ex:hasUsage "每服50丸，空心薏苡汤送下，日3次。" .

<medicine:过街笑> a ex:Medicine;
  ex:hasFunction "闪腰痛。";
  ex:hasName "过街笑";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "木香1钱，麝香3厘。";
  ex:hasUsage "吹鼻，右边吹左鼻，左边吹右鼻。令病人手上下和之。" .

<medicine:近侍汤> a ex:Medicine;
  ex:hasFunction "和脾胃。主";
  ex:hasName "近侍汤";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "缩砂仁2两，丁香1分，甘草3钱，盐1两。";
  ex:hasUsage "每服2钱、白汤点服。" .

<medicine:近制清暑益气汤> a ex:Medicine;
  ex:hasFunction "夏月外感湿热，四肢困倦，精神短少，懒于动作，胸满气促，肢节沉痛，或气高而喘，身热而烦，心下膨痞，小便黄而少，大便清而频，或痢出黄糜，或如泔色，或渴或不渴，不思饮食，自汗体重，或汗少，脉洪缓者。";
  ex:hasName "近制清暑益气汤";
  ex:hasPrescription "人参、白术、麦门冬、五味子、陈皮、甘草（炙）、黄柏（炒）、黄耆（蜜炙）、当归身。";
  ex:hasUsage "加生姜、大枣，水煎服。" .

<medicine:近效汤> a ex:Medicine;
  ex:hasFunction "麻疹多服凉剂，变症百出，或神目昏暗，或手足瘛疭，或寒热乍发，或吐泻交作，舌虽黑而有液，唇虽焦而带凉，实热化为虚寒者。";
  ex:hasName "近效汤";
  ex:hasPrescription "大川附（熟附不用）、漂白术（焦术不用）、炙甘草。";
  ex:hasUsage "生姜3片，红枣4个为引。" .

<medicine:返元丸> a ex:Medicine;
  ex:hasFunction "紫云疯，形如紫云。";
  ex:hasName "返元丸";
  ex:hasNote "忌酒色劳碌，猪、羊、鲜鱼、油腻、生冷、动气、发风之物，只吃白鸭、鲞鱼，食淡更妙，重者半年，轻者三月。";
  ex:hasPreparation "上除血竭、牛黄、枫子三味另研，余药为末，入三味和匀，老米粉糊为丸。";
  ex:hasPrescription "川芎5钱，羌活5钱，独活5钱，细辛5钱，白芷5钱，当归5钱，黄耆5钱，牛膝5钱，蝉退5钱，狗脊5钱，首乌5钱，全蝎5钱，防风20两，苦参1斤，大枫子20两，牛黄2钱，血竭5两。";
  ex:hasUsage "每服50丸，渐加至100丸为度，清茶送下。如未全愈，再服防风通圣散。" .

<medicine:返元汤> a ex:Medicine;
  ex:hasFunction "产后恶露上逆，神昏不省，二便不通，脉洪。";
  ex:hasName "返元汤";
  ex:hasPrescription "当归5钱，川芎3钱，五灵脂钱半，桃仁钱半，大黄2钱，芍药1钱，肉桂6分，人参5分。";
  ex:hasUsage "水煎，加童便、沙糖、酒送服。" .

<medicine:返本丸> a ex:Medicine;
  ex:hasFunction "补诸虚百损。主";
  ex:hasName "返本丸";
  ex:hasPreparation "上为末，每半斤牛肉，入药末1斤，以红枣蒸熟去皮，和捣为丸，如梧桐子大。";
  ex:hasPrescription "黄犍牛肉（去筋膜，切片，河水洗数遍，仍浸1宿，次日再洗3遍，水清为度，用无灰好酒同入坛内，重泥封固，桑柴文武火煮一昼夜，取出，如黄沙为佳，焦黑无用，焙干为末听用）4两，山药（盐炒过）4两，莲肉（去心，盐炒过，并去盐）4两，白茯苓4两，小茴香（炒）4两。";
  ex:hasUsage "每服50丸、空心酒送下，日3次。" .

<medicine:返正汤> a ex:Medicine;
  ex:hasFunction "大疟在腑，3日1作者。";
  ex:hasName "返正汤";
  ex:hasPrescription "当归2钱，茯苓2钱，白术1钱，炮姜5分，葛根2钱，广皮1钱，半夏1钱5分，贝母2钱，砂仁1钱，青皮1钱。" .

<medicine:返汗化水汤> a ex:Medicine;
  ex:hasFunction "利水消火。主小肠热极，心头上一块出汗，不啻如雨，四肢他处又复无汗。";
  ex:hasName "返汗化水汤";
  ex:hasPrescription "茯苓2两，猪苓3钱，刘寄奴3钱。";
  ex:hasUsage "水煎服。1剂而汗止，不必再剂。" .

<medicine:返火汤> a ex:Medicine;
  ex:hasFunction "冬月伤寒，大汗气喘不能息，面如珠红，口不能言，呼水自救，却仅能一口而不欲多饮，为上热下寒之戴阳症者。";
  ex:hasName "返火汤";
  ex:hasPrescription "熟地3两，山萸肉1两，肉桂3钱。";
  ex:hasUsage "水煎服。" .

<medicine:返睛丸> a ex:Medicine;
  ex:hasFunction "心肾虚耗，水火不交，渐生内障者。";
  ex:hasName "返睛丸";
  ex:hasPreparation "上为末，炼蜜为丸。";
  ex:hasPrescription "川芎1两，白蒺藜5钱，白术（土炒）5钱，木贼5钱，羌活5钱，细辛5钱，防风1两，熟地2两，独活5钱，白芷5钱，荆芥5钱，枸杞5钱，石决明5钱，甘草3钱，天麻2两，菊花5钱，蕤仁4钱，生地5钱，车前子（炒）1两，青葙子5钱，菟丝子5钱，草决明5钱。";
  ex:hasUsage "每服30-50丸，空心盐汤送下。" .

<medicine:返精丸> a ex:Medicine;
  ex:hasAlias "养血返精丸";
  ex:hasFunction "高年服之嗜欲不衰，髭须如漆，长生。主";
  ex:hasName "返精丸";
  ex:hasPreparation "上为细末，用没药半两（捶破），以无灰煮酒浸，高没药一指许，候如稠饧状，搜前二味为丸，如梧桐子大。";
  ex:hasPrescription "破故纸2两（隔纸炒令香熟），白茯苓1两（去皮）。";
  ex:hasUsage "养血返精丸（《医部全录》卷三三二引《集验方》。" .

<medicine:返蛰汤> a ex:Medicine;
  ex:hasFunction "主胃气上逆，蛔虫不安，腹痛时作时止。";
  ex:hasName "返蛰汤";
  ex:hasPrescription "当归6克 茯苓6克 白术3克 苡仁12克 广皮3克 鹤虱4.5克 雷丸3克 乌药3克砂仁3克 厚朴3克 开口花椒24粒";
  ex:hasUsage "水煎服。" .

<medicine:返蜇汤> a ex:Medicine;
  ex:hasFunction "胃气反逆，长虫不安，作痛，陡然而来，截然而止。";
  ex:hasName "返蜇汤";
  ex:hasPrescription "当归2钱，茯苓2钱，白术1钱，苡仁4钱，广皮1钱，鹤虱1钱5分，雷丸1钱，乌药1钱，砂仁1钱，厚朴1钱，开口花椒24粒。" .

<medicine:返阴丸> a ex:Medicine;
  ex:hasFunction "助阳消阴。主伤寒阴盛，手足多冷，脉沉细。";
  ex:hasName "返阴丸";
  ex:hasPreparation "上为末，同入铫子内，熬成汁为度，放冷细研，用水浸炊饼为丸，如梧桐子大。";
  ex:hasPrescription "硫黄半两，消石半两，阳起石半两，太阴玄精石半两，白矾半两，石膏半两（碎）。";
  ex:hasUsage "煎艾汤下15丸。" .

<medicine:返阴丹> a ex:Medicine;
  ex:hasAlias "破阴丹";
  ex:hasFunction "阴毒伤寒，心神烦躁、头痛，四肢逆冷，面青腹胀，脉沉伏者；或气虚阳脱，体冷无脉，气息欲绝，不省人事，及伤寒阴厥，百药不效。";
  ex:hasName "返阴丹";
  ex:hasPreparation "上药取前三味同研，于瓷瓶内慢火熔成汁后放冷，重研令细；后三味捣罗为末，与前药同研令匀，用软饭和丸，如梧桐子大。";
  ex:hasPrescription "硫黄半两，太阴玄精石半两，消石半两，附子（炮裂，去皮脐）半两，干姜（炮裂，锉）半两，桂心半两。";
  ex:hasUsage "破阴丹（《杂病源流犀烛》卷十九）。《三因》本方用法：上用铁铫，先铺玄精，次下消末各一半，中间铺硫黄末，又将二石余末盖上，以小盏合着，熟炭火三斤，烧令得所，勿令烟出，急取瓦盆合着地上，四面灰盖，勿令烟出，候冷取出研细，入后药为末，同研匀，米糊为丸，如梧桐子大。每服20-30丸，煎艾汤送下，顿服，汗出为度。未退，乃大着艾炷，炙脐下丹田，气海；更不退，则以葱馅熨之。" .

<medicine:返阴散> a ex:Medicine;
  ex:hasFunction "伤寒四肢厥冷，脉微自汗、心胸痞满，及阴毒。";
  ex:hasName "返阴散";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "阳起石1两，石膏1两，寒水石（三味同烧令赤，出火毒，细研入诸药）1两，附子（炮裂，去皮脐）1两，干姜（炮）1两，甘草（炙、锉）1两，硫黄（研）半两。";
  ex:hasUsage "每服2钱匕，生姜汁温水调下。" .

<medicine:返魂丸子> a ex:Medicine;
  ex:hasFunction "小儿急惊风。";
  ex:hasName "返魂丸子";
  ex:hasPreparation "上为末，用猪胆汁并蟾酥如豇豆大，和为丸，如粟米大。";
  ex:hasPrescription "独角仙2个（去翅足，于瓷盒内烧，勿令烟出，研为末），白僵蚕半两（微炒），牛黄半两（细研），白附子半两（炮裂），天南星半两（炮裂），青黛半两（研入），干姜半两（炮裂），甜葶苈半两（炒令紫色），乌蛇肉半两（炙令黄），朱砂半两（细研、水飞过）。";
  ex:hasUsage "先以酒化1丸，滴在鼻中，即以酒或水送下2丸。若不嚏，则不再下药。" .

<medicine:返魂丹> a ex:Medicine;
  ex:hasAlias "益母丸、济阴丹";
  ex:hasFunction "小儿慢惊风，及天钓夜啼。";
  ex:hasName "返魂丹";
  ex:hasNote "忌生梨。";
  ex:hasPreparation "上为细散，入人中白等、同研令匀，炼蜜为丸，如绿豆大。";
  ex:hasPrescription "蝙蝠1个（去翼脂肚，炙令焦黄），人中白1分（细研），干蝎1分（微炒），麝香1钱（细研）。";
  ex:hasUsage "每服3丸，以乳汁研下。" .

<medicine:返魂夺命丹> a ex:Medicine;
  ex:hasFunction "跌打伤损，牙关紧闭，不省人事。";
  ex:hasName "返魂夺命丹";
  ex:hasPrescription "银丝草1两（即山橄叶，长白毛者佳），小鸡1只（过1个月者，不去毛）。";
  ex:hasUsage "上共捣烂如泥，热酒冲和，以布滤过，调猴骨末2钱服。服过再用棱莪散。" .

<medicine:返魂散> a ex:Medicine;
  ex:hasFunction "喉咙肿痛，饮食不下，喘息不通，头项俱肿，命欲临死者。";
  ex:hasName "返魂散";
  ex:hasNote "量病势大小，使药轻吹，吹重则人闷绝。";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "消石1两，牵牛1两，半夏3分，僵蚕（去头丝）1两，天南星1两。";
  ex:hasUsage "以旧笔管盛1钱，吹在痛处，停候片刻，吐出涎后，喘息已通，即便停药；若气未通，肿处未消未破，更进吹1钱半，待气通即住，若未通，加药吹之，以气通为度。若喉中喘息已通，更服下方。麻黄、荆芥穗、羌活、牡丹皮（去心）、射干、僵蚕（去丝）、连翘、消石各1分，大黄、牵牛各半两，半夏3铢，上为细末，用白面大小相滚，熟水为丸，如梧桐子大。每服50丸，食后煎葱汤送下；若作散，每服3钱，水1盏3分，煎1-2沸，食后合滓服；若服时吐逆，即浓煎去滓，服1-2盏，以通取转为度。" .

<medicine:返魂汤> a ex:Medicine;
  ex:hasAlias "秘传返魂汤";
  ex:hasFunction "调和荣卫，顺气调血，扶植胃本。主血气逆于肉理，壅结而成痈疽。";
  ex:hasName "返魂汤";
  ex:hasPrescription "赤芍5分，木通5分，白芷5分，何首乌5分，枳壳5分，小茴香5分，乌药5分，当归5分，甘草5分。";
  ex:hasUsage "秘传返魂汤（《松崖医径》卷下）。《松崖医径》本方用法：上细切，各等分。每服四钱，用水酒各1盏煎，去滓服。" .

<medicine:返魂浆> a ex:Medicine;
  ex:hasFunction "喉风不拘，双单蛾风，及诸证临危者。";
  ex:hasName "返魂浆";
  ex:hasNote "切忌热毒物。";
  ex:hasPrescription "土牛膝（红肿节者佳）。";
  ex:hasUsage "上洗净捣烂，入浓糯米泔3茶匙，同取出汗来，再将茶子仁捣烂，入妇人乳2茶匙，同取出汗来调和。右喉风灌左鼻；左喉风油右鼻；双蛾风两鼻俱灌，3-5次毕竟，吐痰而愈。或单用土牛膝与奶乳同汁，灌鼻亦妙。" .

<medicine:返魂神白散> a ex:Medicine;
  ex:hasAlias "返魂散";
  ex:hasFunction "打扑伤损及伤中；妇人产后血晕。";
  ex:hasName "返魂神白散";
  ex:hasPreparation "上用瓷盆子一个，先入蕊石一层，次入硫黄一层，重重铺尽，上用鸭舌草盖之，赤石脂和涂盒子口缝，又用盐泥固济，勿令有小缝纹，用新砖一块，上安盒子，用炭火2斤煅之，耗及三分，渐渐去之，取出盒子，地坑内埋一宿，细研为末。";
  ex:hasPrescription "花蕊石5斤（捶碎、如皂子大），硫黄6两（捶碎，如皂子大）。";
  ex:hasUsage "返魂散（《鸡峰》卷二十二）。方中硫黄用量原缺，据《鸡峰》补。" .

<medicine:还元丸> a ex:Medicine;
  ex:hasFunction "固精，补元气，悦颜色，实丹田。主";
  ex:hasName "还元丸";
  ex:hasPreparation "上为末，煮熟鸡卵黄为丸，如梧桐子大。";
  ex:hasPrescription "木香2两，干莲子（去心）2两，沉香（末）2两，天雄（长大者，汤浸1食久，新水又浸两食久，去皮脐，候干，文武火炮裂，地坑子内碗合1复时）2两，龙骨（为末，研千遍，用粗甘草半两，煎水1升，飞过，更研）2两。";
  ex:hasUsage "本方方名，《普济方》引作“还元丹”。" .

<medicine:还元丹> a ex:Medicine;
  ex:hasAlias "不老丹、延年益寿不老丹、延年益嗣丹、延寿不老丹、延年益寿丹";
  ex:hasFunction "补血行瘀。主产后亡血过多，头目眩晕，自汗心跳，或恶露不净，腹疼发烧，四肢倦怠。";
  ex:hasName "还元丹";
  ex:hasNote "老人尤宜常服。";
  ex:hasPreparation "上为极细末，炼蜜为丸，2钱重。";
  ex:hasPrescription "益母草8两，泽兰2两，茯苓4两，香附6两，当归4两，熟地4两，白芍3两，川芎3两。";
  ex:hasUsage "每服1丸，黄酒或姜汤送下。" .

<medicine:还元保真汤> a ex:Medicine;
  ex:hasFunction "温补气血。治气血两虚，悬痈已溃，疮口开张，脓水淋漓，不能收敛者。";
  ex:hasName "还元保真汤";
  ex:hasPrescription "当归 川芎 白芍 熟地 白术 茯苓 人参 黄耆各3克 牡丹皮 枸杞子各2，4克 甘草（炙）熟附子各1.5克 肉桂 泽泻各0.9克";
  ex:hasUsage "用水400毫升，加煨姜3片，大枣2枚，煎取120毫升，空腹时服。" .

<medicine:还元复气丹> a ex:Medicine;
  ex:hasFunction "疹不出，或痘不出，或将出被风寒所阻。";
  ex:hasName "还元复气丹";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "升麻、紫草、麻黄、糯米、红花子。";
  ex:hasUsage "每服随人大小用葱白汤送下。取微汗甚效。" .

<medicine:还元明目汤> a ex:Medicine;
  ex:hasClinicalApplication "云雾移睛症：晁某之母，五十三岁，素性暴躁，因怒气伤肝，肝火上冲于脑，自觉头摇目眩，视如黑花乱动，屡治不愈，后又令余治疗。按其脉，六脉虚数，惟少阴为甚，是知心血耗散，肾水不足，而邪火挟虚上升，搅乱于脑，以致视力不稳，满目如蝇飞、旗展之状。处方：针刺上星、承泣；内服还元明目汤十余剂，黑花减少，而昏花如故。又以益智安神汤隔日晚服，半年余移睛之弊而愈。";
  ex:hasFunction "云雾移睛症，两眼黑白稍分，不疼不红，惟瞳孔微大，常见黑花浮游移荡。";
  ex:hasName "还元明目汤";
  ex:hasPrescription "大熟地8钱，生地3钱，萸肉3钱，远志3钱，枣仁3钱（炒），黄耆5钱，菟丝子4钱，川芎2钱，蔓荆子3钱，蒺藜3钱（炒），知母3钱，甘草1钱，生磁石2钱。";
  ex:hasUsage "水煎服。" .

<medicine:还元水> a ex:Medicine;
  ex:hasFunction "咳血、吐血，及产后血运，阴虚久嗽，火蒸如燎。";
  ex:hasName "还元水";
  ex:hasPrescription "童便。";
  ex:hasUsage "取11-12岁无病童子，不茹荤辛，清彻如水者，去头尾。热饮，冬则用汤温之，或加藕汁、阿胶和服。" .

<medicine:还元煎> a ex:Medicine;
  ex:hasFunction "返元气。主小产后，元气困弱危极者。";
  ex:hasName "还元煎";
  ex:hasPrescription "艾叶、阿胶各上，白术、人参、炒黑干姜各中，炙甘草下。";
  ex:hasUsage "水1盏半，煎7分，去滓，入童便半盏，再温，顿服。" .

<medicine:还元秋石乳酥丸> a ex:Medicine;
  ex:hasAlias "还元秋石丸";
  ex:hasFunction "安五脏，消百病，令瘦者肥，补虚损，实精髓，固元气。主";
  ex:hasName "还元秋石乳酥丸";
  ex:hasNote "脾胃虚弱，阳虚内寒，痰湿内盛者忌服。";
  ex:hasPreparation "上为末，炼蜜为丸，如梧桐子大。";
  ex:hasPrescription "秋石半斤（只同乳粉等分，收秋露数晚，复晒干听用），乳粉4两（晒制之法，乳汁若干，即下铜锅内煎熬成膏，用大瓷盘取起，盛于日下晒之，以水浸于盘下易干），白茯苓1斤（为末，以水掏去浮面心梗），天门冬（洗净，去心，晒干）4两，人参（去芦）4两，熟地（酒浸洗，烘干）4两，生地（酒浸洗，烘干）4两，麦门冬（洗净，去心，晒干）4两，甘州枸杞（净）4两。";
  ex:hasUsage "还元秋石丸（《医学入门》卷七）。" .

<medicine:还元酒> a ex:Medicine;
  ex:hasFunction "男子劳伤而得瘵疾，渐见疲瘦，并传尸劳瘵。";
  ex:hasName "还元酒";
  ex:hasPrescription "獖猪腰1对。";
  ex:hasUsage "用童便2盏、无灰酒1盏，以新瓦瓮贮之，密封，慢火煮熟。至终夜五更初，温热，饮酒，食腰子。病笃1月效。平日瘦怯者，亦可服。" .

<medicine:还光丸> a ex:Medicine;
  ex:hasFunction "一切眼疾。";
  ex:hasName "还光丸";
  ex:hasPreparation "上切，炒黄色，为末，炼蜜为丸，如龙眼大，朱砂为衣。";
  ex:hasPrescription "白芷。";
  ex:hasUsage "每服1丸，食后清茶送下，或荆芥茶尤妙。" .

<medicine:还光散> a ex:Medicine;
  ex:hasFunction "暴生赤白翳膜。";
  ex:hasName "还光散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "菊花（炒）、羌活、防风、蝉蜕（去足翅）、蒺藜（炒）、川芎、当归、甘草（炙）各等分。";
  ex:hasUsage "食后茶调下。" .

<medicine:还光饮> a ex:Medicine;
  ex:hasFunction "大补肝肾。主人有患时眼之后，其目不痛，而色淡红，然羞明恶日，与目痛时无异。";
  ex:hasName "还光饮";
  ex:hasPrescription "熟地1两，山茱萸4钱，枸杞3钱，甘菊3钱，同州蒺藜3钱，玄参3钱，麦冬3钱，葳蕤5钱，肉桂3分。";
  ex:hasUsage "水煎服。10剂痊愈。" .

<medicine:还原再造丹> a ex:Medicine;
  ex:hasFunction "杨梅结毒恶疮，烂去鼻准，并烂脱阳物。";
  ex:hasName "还原再造丹";
  ex:hasPreparation "上药各为细末，再研匀，老米饭为丸，如绿豆大。";
  ex:hasPrescription "首产男胎紫河车1具（先用竹刀刮去血，新汲水洗净，炙干，再用甘草8两，人参5钱煎水3碗，慢火煎至1碗，将河车放瓷器内收干，即将瓷器封好，外用黄泥固济，入炭火煅红，冷定，取出如乌金纸色收贮。每用1钱），朱砂4钱，珍珠2钱，大冰片1分，真琥珀2钱，滴乳石3分（煅）。";
  ex:hasUsage "每服3分，用土茯苓4两煎汤送下。服至1月，鼻长如旧矣，但必须先刻成一端正细木鼻子式，外以黄蜡熔化，浇木鼻上，俟微干，即将蜡鼻取起用火供微烊，即粘在土星处，待1月药完，鼻自生矣。如阳物烂去，亦如此。" .

<medicine:还原蛋> a ex:Medicine;
  ex:hasFunction "多年痔漏。";
  ex:hasName "还原蛋";
  ex:hasPrescription "鸡蛋（白煮）、真象牙（末）。";
  ex:hasUsage "以蛋蘸象牙末空心食之，每日2个，分2次食之。" .

<medicine:还命千金丸> a ex:Medicine;
  ex:hasFunction "心腹枳聚坚结，胸胁逆满咳吐，宿食不消，中风鬼疰入腹，面目青黑不知人。";
  ex:hasName "还命千金丸";
  ex:hasPreparation "上为末，炼蜜为丸，如小豆大。";
  ex:hasPrescription "雄黄（研）4分，鬼臼4分，徐长卿4分，礜石（泥裹烧半日）4分，瓜丁4分，雌黄（研）4分，干姜4分，野葛7分（炙），斑蝥20枚（去足翅，熬），蜀椒4分（去目汗），地胆15枚（去翅，熬），射肉2分，丹参4分。";
  ex:hasUsage "先食服1丸，每日3次。不知渐增，以知为度。若百毒所螫、牛触践、马所蹋啮，痈肿瘰疬，以1丸于掌中，唾和涂痛上，立愈。正月旦，以椒酒率家中大小各服1丸，终岁无病。" .

<medicine:还少丹> a ex:Medicine;
  ex:hasAlias "还少丸（《杨氏家藏方》卷九）、滋阴大补丸（《医学正传》卷三）。";
  ex:hasClinicalApplication "临床主要用于治疗血管性痴呆、男性不育症、更年期综合征等病症。";
  ex:hasFunction "益精补髓，壮元阳，却病延年，发白返黑。主虚损。";
  ex:hasName "还少丹";
  ex:hasNote "忌莱菔、猪血、羊肉。";
  ex:hasPreparation "上俱勿犯铁器，为细末，炼蜜为丸，如梧桐子大。";
  ex:hasPrescription "何首乌（黑豆蒸）半斤，牛膝6两，生地黄（酒蒸）6两，肉苁蓉（酒蒸）6两，黄柏（酒浸，炒褐色）3两5钱，补骨脂（酒浸，水蒸）3两5钱，车前子（微炒）3两5钱，柏子仁（微炒）3两5钱，干山药（微炒）3两5钱，秦当归2两5钱（酒洗），菟丝子（水淘，去砂，酒煮，捣成饼，晒干）2两，人参1两，五味子1两。";
  ex:hasUsage "每服60丸，空心盐汤、白汤、酒任下。" .

<medicine:还少乳乌丸> a ex:Medicine;
  ex:hasFunction "补精养血，益智安神，增液润燥。治中老年人精血亏虚，津液不足，须发早白，精神衰减，形体消瘦，肌肤枯燥。";
  ex:hasName "还少乳乌丸";
  ex:hasNote "阳虚内寒和脾胃虚弱者忌服。";
  ex:hasPreparation "上各味，共为细末，炼蜜为丸，如梧桐子大。";
  ex:hasPrescription "何首乌60克 枸杞子30克 牛膝30克（酒浸）茯苓30克 黄精30克 甘桑椹30克 天门冬（去心）30克 麦门冬（去心）30克 生地黄120克（酒浸，晒干）熟地黄30克（酒浸）";
  ex:hasUsage "每服100丸，用温水或盐汤送下，日进三次。" .

<medicine:还明丸> a ex:Medicine;
  ex:hasFunction "小儿疳眼，白睛遮睛，并雀目。";
  ex:hasName "还明丸";
  ex:hasPreparation "上为末，煎黄蜡炼丸，如鸡头子大。";
  ex:hasPrescription "夜明沙、井泉石、谷精草、蛤粉各等分。";
  ex:hasUsage "3岁1丸，猪肝1片切开，放药在内，麻扎定，沙瓶内煮熟，先熏眼，后食之。" .

<medicine:还明散> a ex:Medicine;
  ex:hasFunction "小儿目病。";
  ex:hasName "还明散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "草决明（炒）2钱，白蒺藜（炒，去刺）4钱，防风2钱。";
  ex:hasUsage "用猪肝1块，竹刀薄剖，入末药在内，饭上蒸熟，去药食之。" .

<medicine:还津丸> a ex:Medicine;
  ex:hasFunction "生津止渴。主消渴。";
  ex:hasName "还津丸";
  ex:hasPreparation "上为极细末，为丸。";
  ex:hasPrescription "霜梅25个，乌梅25个（俱去核），苏薄荷末1两，冰片1分5厘，硼砂1钱5分。";
  ex:hasUsage "每含1丸，津液立至。" .

<medicine:还源汤> a ex:Medicine;
  ex:hasFunction "肾中之火冲入咽喉，而火不得下归于命门，火沸为痰而上升，而心火又欺肺金之弱，复来相刑，是水之中，兼有火之气，致痰中吐血如血丝，日间则少，夜间则多，咳嗽不已，多不能眠。";
  ex:hasName "还源汤";
  ex:hasPrescription "熟地1两，山茱萸5钱，炒黑荆芥3钱，地骨皮5钱，麦冬3钱，天门冬2钱，甘草3分，贝母3分，桔梗5分。";
  ex:hasUsage "水煎服。30剂愈。" .

<medicine:还真二七丹> a ex:Medicine;
  ex:hasFunction "壮颜容，健筋骨，添精补髓，乌须黑发。主";
  ex:hasName "还真二七丹";
  ex:hasPreparation "上除蜜另炼外，以诸汁熬，将成膏方入蜜搅匀，然后下人参等六味末药，又和匀，以新瓷瓶收贮。";
  ex:hasPrescription "何首乌（忌铁器）、黑椹子、生地黄、旱莲草（以上四味俱用鲜者，以石臼内捣）各取汁半斤，鹿角胶半斤，生姜汁半斤，白蜜半斤，黄精（9蒸9晒）4两，人参4两，白茯苓4两，小茴香4两，枸杞子4两，鹿角霜4两，秦椒1两（共为末）。";
  ex:hasUsage "随时以温热酒调下2-3匙，夏月以白汤调。" .

<medicine:还真散> a ex:Medicine;
  ex:hasFunction "毒痢初得时，先发寒热，吃通神散寒热已退，赤痢已消者。";
  ex:hasName "还真散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "诃子5个（用面裹，火煨热，不要生，不要焦，得所去面不使，就热咬诃子破，去核不用，只使皮，焙干）。";
  ex:hasUsage "每服2钱，以米汤1盏半，同药炼取1盏吃，若吐出1-2口涎便住。如此吃经数盏，大腑渐安，出后减少，便修合舶上硫黄丸吃。" .

<medicine:还睛丸> a ex:Medicine;
  ex:hasAlias "明目还睛丸";
  ex:hasFunction "男子、女人风毒上攻，眼目赤肿，怕日羞明，多饶眵泪，隐涩难开，眶痒赤痛，睑眦红烂，瘀肉侵睛；或患暴赤眼，睛疼不可忍者；偏正头痛，一切头风，头目眩运。";
  ex:hasName "还睛丸";
  ex:hasNote "忌热面、荤辛、生冷。";
  ex:hasPreparation "上为细末，炼蜜为丸，如弹子大。";
  ex:hasPrescription "白术（生用）、菟丝子（酒浸，别研）、青葙子（去土）、防风（去芦）、甘草（炙）、羌活（去苗）、白蒺藜（炒，去尖）、密蒙花、木贼（去节）各等分。";
  ex:hasUsage "明目还睛丸（《全国中药成药处方集》杭州方）。" .

<medicine:还睛丹> a ex:Medicine;
  ex:hasFunction "远年近日，久患双目不见光明，内外气障，拳毛倒睫，一切眼疾。";
  ex:hasName "还睛丹";
  ex:hasPreparation "上为末，炼蜜为丸，如弹子大。";
  ex:hasPrescription "羌活1两半，白芷1两半，干菜子1两半，细辛1两半，苍术1两半，川芎1两半，火麻子1两半，防风1两半，藁本1两半，当归1两半，栀子仁1两半，黄连1两半，桔梗1两半，甘草1两半，菊花1两半，薄荷1两半，连翘1两半，石膏1两半，密蒙花1两半，川椒1两半，枸杞1两半，天麻1两半，荆芥穗1两半，乌药1两半，木贼1两半，黄芩1两半。";
  ex:hasUsage "每服2丸，嚼细，食后温酒化下。" .

<medicine:还睛圆> a ex:Medicine;
  ex:hasFunction "治男子、女人风毒上攻，眼目赤肿，怕日羞明，多饶眵泪，隐涩难开，眶痒赤痛，睑眦红烂，瘀肉侵睛，或患暴赤眼，睛疼不可忍者，并服立效。";
  ex:hasName "还睛圆";
  ex:hasPrescription "白术（生用）、菟丝子（酒浸.别研）、青葙子（去土）、防风（去芦）、甘草（炙）、羌活（去苗）、白蒺藜（炒.去尖）、密蒙花、木贼（去节），各等分。";
  ex:hasUsage "每服一圆，细嚼，白汤吞下，空心，食前，日三服。" .

<medicine:还睛夜明丸> a ex:Medicine;
  ex:hasFunction "滋阴养血，清散肝火。治血虚火郁，黑睛赤色，痛涩，莫敢开视，见人则两眉紧斗，眵泪并流，丝脉纵横。";
  ex:hasName "还睛夜明丸";
  ex:hasPreparation "共为末，蜜丸。";
  ex:hasPrescription "人参 熟地 枸杞 当归 山药 肉苁蓉各60克 菟丝 枣仁（炒）茯神 麦冬（去心）五味 蕤仁（去壳）刺蒺藜 沙蒺藜各45克 川芎 防风 白菊 牛膝 石斛 羚羊角各30克 犀角 黄连各15克" .

<medicine:还睛散> a ex:Medicine;
  ex:hasFunction "枣花翳内障，初患之时，微有头旋眼涩，渐渐昏暗，时时痒痛，脑热有花。黄黑不定。";
  ex:hasName "还睛散";
  ex:hasNote "忌一切鸡鱼厚味及荞麦面。";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "人参2两，茯苓2两，车前子2两，黑参2两，防风2两，茺蔚子2两，知母2两，黄芩1两半（去皮）。";
  ex:hasUsage "每服1钱，以水1盏，煎至5分，去滓温服。此状宜令针治诸穴脉，然后宜服本方。" .

<medicine:还睛明目芦荟丸> a ex:Medicine;
  ex:hasAlias "芦荟丸";
  ex:hasFunction "眼内障针开后。";
  ex:hasName "还睛明目芦荟丸";
  ex:hasPreparation "上为末，入牛胆，研令匀，炼蜜为丸，如梧桐子大。";
  ex:hasPrescription "芦荟半两，人参半两（去芦头），柏子仁1两，羚羊角屑2两，细辛1两，茺蔚子1两，车前子1两，青葙子1两，干牛胆半两（细研）。";
  ex:hasUsage "芦荟丸（《普济方》卷七十九）。" .

<medicine:还睛汤> a ex:Medicine;
  ex:hasFunction "退翳膜，去风毒。主内外障眼。";
  ex:hasName "还睛汤";
  ex:hasPreparation "上为粗末。";
  ex:hasPrescription "甘菊花半两，蔓青子半两，蒺藜子（炒，去角）半两，谷精草半两，牡蛎（烧）半两，芎半两，仙灵脾半两，生地黄半两，蛇蜕5条，羌活（去芦头）1两，防风（去叉）1两，桑叶1两，蝉蜕（洗）1两，地骨皮（洗）1两。";
  ex:hasUsage "每服2钱匕，水1盏，加竹叶2片，荆芥2穗，煎至7分，去滓，食后、临卧温服。" .

<medicine:还睛神明酒> a ex:Medicine;
  ex:hasClinicalApplication "失明：晋大夫于公失明经十二余年，不辨明夜，两目俱损，无瞳子，时年七十，服此酒一百日，万病除，两目明，见物益明。";
  ex:hasFunction "目盲，瞳子俱损，翳如云，赤白肤肉如乳头。";
  ex:hasName "还睛神明酒";
  ex:hasNote "忌热面、鲊、葵、秽臭五辛，鸡、鱼、猪、马、驴肉、生冷粘滑、入房、恚怒、大忧愁、大劳、大寒热悉慎之。";
  ex:hasPreparation "上（口父）咀，绢囊盛，用好酒5斗，瓮中浸之，春、秋14日，夏7日，冬21日。";
  ex:hasPrescription "黄连5两，石决明3两，草决明3两，生姜3两，石膏3两，蕤仁3两，黄消石3两，山茱萸3两，当归3两，黄芩3两，沙参3两，车前子3两，淡竹叶3两，朴消3两，甘草3两，芍药3两，柏子仁3两，川乌头3两，泽泻3两，桂心3两，荠子3两，地肤子3两，桃仁（去皮尖双仁者）3两，防风3两，辛夷3两，人参3两，川芎3两，白芷3两，细辛3两，瞿麦3两，龙脑3钱，丁香半两，珠子（生）25颗，秦皮3两。";
  ex:hasUsage "食后服半合。勿使醉吐，稍稍增之。100日后，目明如旧。" .

<medicine:还睛紫金丹> a ex:Medicine;
  ex:hasFunction "目眶岁久赤烂。眼生倒睫拳毛，两目紧盖，内伏火热而攻阴气。";
  ex:hasName "还睛紫金丹";
  ex:hasPreparation "上将白沙蜜于沙石器内，慢火去沫，下甘石，次下丹，以柳枝搅，次下余药，以粘手为度，为丸如鸡头大。";
  ex:hasPrescription "白沙蜜20两，甘石10两（烧7遍，碎，连水浸拌之），黄丹6两（水飞），拣连3两（小便浸，碎为末），南乳香3钱，当归3钱，乌鱼骨2钱，硇砂（小盏内放于瓶口上熏干）1钱，麝香1钱，白丁香（直者）5分，轻粉1字。";
  ex:hasUsage "治目眶岁久赤烂，当以三棱针刺目眶外，以泻湿热；如眼生倒睫拳毛，法当去其热内火邪，眼皮缓则毛立出，翳膜亦退，用手法攀出，内睑向外，以针刺之出血。" .

<medicine:还睛膏> a ex:Medicine;
  ex:hasFunction "眼疾。";
  ex:hasName "还睛膏";
  ex:hasPreparation "上为细末，炼蜜为丸，如龙眼大。";
  ex:hasPrescription "白蒺藜（炒，去刺）半两，青葙子半两，白术半两，菟丝子1两，木贼（去节）1两，北五味子3钱半，羌活3钱半，防风2钱半。";
  ex:hasUsage "本方方名，据剂型，当作“还睛丸”。" .

<medicine:还睛菩萨水> a ex:Medicine;
  ex:hasFunction "青盲。";
  ex:hasName "还睛菩萨水";
  ex:hasPreparation "上以新瓷盒盛，甑上蒸两次，研令极烂，以新绵重滤过，入别瓷盒内，再以雪水隔盒子窨一夜，又将脑子少许，乳钵内先研为细末，却入前蒸雪水药，再研匀。";
  ex:hasPrescription "草龙胆1钱，槐角（洗，切碎）1钱，雪水少许，生珍珠27粒（别研，为细末），白沙蜜少许，竹上露水少许（须用天水，时以瓷器内服）。";
  ex:hasUsage "每日日中时用新笔抄如米粒大，以新汲水蘸湿，点入眼中，闭眼，俟药行泪出方醒，连使2次。" .

<medicine:还睛补肝丸> a ex:Medicine;
  ex:hasFunction "眼目羞明多泪，翳膜侵珠，时歇时作，久病不愈。";
  ex:hasName "还睛补肝丸";
  ex:hasPreparation "上为末，炼蜜为丸，如梧桐子大。";
  ex:hasPrescription "白芍（酒炒）2两，熟地2两，当归（酒洗）2两，天冬2两，五味子2两，炙甘草2两，白术2两，白茯苓2两，官桂2两，车前子（微炒）2两，白菊花2两，青葙子2两，玄参2两，川芎1两，羌活（去芦）1两，防风（去芦）1两，人参1两，骨皮1两，黄芩（酒炒）1两，柴胡1两，细辛1两，决明子1两，苦参1两，黄连（姜汁炒）5钱。";
  ex:hasUsage "每服3钱，临睡白汤送下。久久服之，永不再发。" .

<medicine:还睛补肾丸> a ex:Medicine;
  ex:hasFunction "肾虚目暗生花，不能久视；肾虚内障，两目黄昏不见。";
  ex:hasName "还睛补肾丸";
  ex:hasPreparation "上为末，炼蜜为丸。";
  ex:hasPrescription "人参1两，白术1两，茯苓1两，蒺藜1两，羌活1两，木贼1两，菊花1两，防风1两，甘草1两，川芎1两，山药1两，肉苁蓉1两，密蒙花1两，青葙子1两，牛膝1两，菟丝子1两。";
  ex:hasUsage "或煎服亦妙。" .

<medicine:还睛退云散> a ex:Medicine;
  ex:hasFunction "眼内障，外障赤肿。";
  ex:hasName "还睛退云散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "人参5钱，杏仁5钱，肉苁蓉5钱，杜仲5钱，牛膝5钱，石斛5钱，枸杞5钱，菊花5钱，菟丝子5钱，当归5钱，熟地5钱，黄柏5钱，青葙子5钱，枳壳5钱，白茯苓5钱，蒺藜（炒）5钱，草决明5钱，山药5钱，犀角4钱，防风4钱，羚羊角4钱，天门冬1两5钱，麦门冬1两5钱，川芎3钱5分，黄连3钱5分，五味子3钱5分，炙甘草3钱5分，知母1两。";
  ex:hasUsage "每服2钱，白水送下。" .

<medicine:还神散> a ex:Medicine;
  ex:hasFunction "痘疹内虚寒，外灰白陷伏者。";
  ex:hasName "还神散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "人参2钱，麦冬2钱，附子1片，黄耆2钱，甘草1钱。";
  ex:hasUsage "每服1钱，防风汤下。" .

<medicine:还神汤> a ex:Medicine;
  ex:hasFunction "妇女一切生产血晕，不省人事，乃气血虚极。";
  ex:hasName "还神汤";
  ex:hasPrescription "生耆5钱，潞参5钱，熟地炭5分，姜炭5分，茯神1钱半，归身5钱。";
  ex:hasUsage "童便、水、黄酒煎服。" .

<medicine:还神至圣汤> a ex:Medicine;
  ex:hasFunction "呆病。终日不言不语，不饮不食，忽笑忽歌，忽愁忽哭，与之美馔则不受，与之粪秽则无辞，与之衣不服，与之草木之叶则反喜，其起于肝气之郁，终于胃气之衰。";
  ex:hasName "还神至圣汤";
  ex:hasPrescription "人参1两，白术2两，茯神5钱，生枣仁5钱，广木香3钱，天南星3钱，荆芥3钱，甘草1钱，良姜1钱，附子1钱，枳壳1钱，菖蒲5分。";
  ex:hasUsage "水煎灌之，听其自卧，醒来前症如失。" .

<medicine:还童丹> a ex:Medicine;
  ex:hasAlias "保灵丹、延寿丹、阴阳丹";
  ex:hasFunction "壮气血筋力，助脾胃，进饮食，益颜色，添精髓，固元阳。主";
  ex:hasName "还童丹";
  ex:hasNote "服药期间，忌食葱、蒜、萝卜。";
  ex:hasPreparation "上为细末，酒糊为丸。";
  ex:hasPrescription "沉香1两，白茯苓1两，木通1两，熟地黄1两，晚蚕蛾1两，桑螵蛸1两，巴戟（酒浸，去心）1两，安息香（研）1两，益智仁1两，牛膝（酒浸）1两，胡芦巴（酒浸）1两，木香1两半，红花5钱，没药（研）5钱，莲心5钱，莲肉（净）5钱，细墨（烧烟）5钱，五色龙骨（煅）5钱，朱砂5钱，菟丝子（酒浸）7钱半，苁蓉1两2钱（酒浸），破故纸7钱（酒浸），青盐3钱，麝香1钱，海马1对（微酥炙炒），母丁香7钱。";
  ex:hasUsage "每服30丸，加至50丸，空心酒送下。此药不湿不燥，老少可服，大通气血，驻颜生精，服之7日见效。夏月茶清下妙，干物压之。" .

<medicine:还童散> a ex:Medicine;
  ex:hasFunction "外固，壮阳气。主";
  ex:hasName "还童散";
  ex:hasPreparation "上为粗末。";
  ex:hasPrescription "丁香1两，麝香叶1两，官桂（去粗皮）1两，露蜂房（烧烟尽）1两，川椒（去目，微炒）1两，牡蛎（烧）1两，吴茱萸（炒）1两，零陵香1两，木鳖子（去皮）1两，马蔺花1两，韶脑（别研）1两，白矾灰1两，紫稍花2两，蛇床子2两。";
  ex:hasUsage "每用药3匙，水1碗半，煎至1碗，滤去滓，乘热熏，俟汤通手时，自少腹以下淋浴，临睡用。" .

<medicine:还童汤> a ex:Medicine;
  ex:hasFunction "补壮元阳。主";
  ex:hasName "还童汤";
  ex:hasPreparation "上为粗末。";
  ex:hasPrescription "藿香叶半两，吴茱萸（汤洗，焙干，炒）半两，桂（去粗皮）半两，干姜（炮）半两，肉苁蓉（去皴皮）半两，白附子1分，蝉蜕1分，天南星1分，菟丝子（酒浸一宿，别捣，为末）1分，莎草根1分，零陵香3分。";
  ex:hasUsage "每用5钱匕，水半碗，煎3-5沸，热洗，以软帛干裹，避风。" .

<medicine:还童酒> a ex:Medicine;
  ex:hasFunction "久饮能添精补髓，强壮筋骨，驱风活经络，大补气血。主";
  ex:hasName "还童酒";
  ex:hasPreparation "上绢袋盛贮，用陈酒50斤，好烧酒亦可，汤煮3炷香，埋土中7日。";
  ex:hasPrescription "熟地3两，生地4两，全当归4两，川萆薢2两，羌活1两，独活1两，淮牛膝2两，秦艽3两，苍术2两，块广皮2两，川断2两，麦冬3两，枸杞2两，川桂皮5钱，小茴香1两，乌药1两，丹皮2两，宣木瓜2两，五加皮4两。";
  ex:hasUsage "早、晚饮3-5杯。" .

<medicine:还精地黄丸> a ex:Medicine;
  ex:hasFunction "肾水虚，见瞳子之翳下陷虚薄。";
  ex:hasName "还精地黄丸";
  ex:hasPreparation "上为细末，炼蜜为丸，如梧桐子大。";
  ex:hasPrescription "大生地（酒浸，炒）3两，山萸肉3两（酒炒），白茯苓（乳制）2两，甘枸杞（酒炒）2两，知母（蜜炒）2两，白菊花（去梗）2两，青盐2两，黄柏（制）2两，桑白皮（蜜制）2两，牡蛎（煅）2两，蒙花（去梗）2两，石膏（煅）2两，川黄连（酒炒）1两，大麦冬（去心）1两，山药（炒）1两，黄芩（酒炒）1两，丹皮（酒浸）1两，泽泻1两，青葙子1两，大川芎1两，桔梗1两，木贼（去节）5钱，蔓荆子（去膜，炒）5钱，草决明5钱，薄荷（酒炒）5钱，石决明（煅）5钱，防风5钱，归尾5分，荆芥穗5分，健猪肝10两（用竹刀切小头大，火焙，去血），党参5钱。";
  ex:hasUsage "每服2钱，空心淡盐汤送下，临卧白水送下。" .

<medicine:还素汤> a ex:Medicine;
  ex:hasFunction "目赤，恶风流泪羞明，不能开视，甚且作痛，脉浮数。";
  ex:hasName "还素汤";
  ex:hasPrescription "荆芥、菊花、蝉衣、桑叶、青葙子、谷精珠、薄荷、夏枯草。" .

<medicine:还肌散> a ex:Medicine;
  ex:hasFunction "小儿疳泻，及洞泻谷不化。";
  ex:hasName "还肌散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "肉豆蔻1个，诃子2个（去核），没石子1个（三味各用大麦面裹，慢火煨焦黄香透，勿令有烟出），木香半皂子大。";
  ex:hasUsage "每服半钱，米饮调下，如人行5里久，更进1服。仍须用陈米饮调服。" .

<medicine:还肌煎> a ex:Medicine;
  ex:hasFunction "大风耳穴鼻梁倒坏。";
  ex:hasName "还肌煎";
  ex:hasPreparation "上和根茎叶细锉，置锅内，旋入无灰酒5斗，煮令稠，滤去滓，再熬成膏，入新瓷器盛。";
  ex:hasPrescription "杜落崖1秤（亦名克颇草）。";
  ex:hasUsage "更取桑东南根汁，别收之。有患者，与前膏各1匙许，以无灰热酒调下。厚衣被盖出汗，仍于密室内服药，至醉醒后，以温桑枝水洗其坏肉，着锦衣，勿令当风。" .

<medicine:还肾汤> a ex:Medicine;
  ex:hasFunction "中暑热之气，徒泻其暑热，暑散而肾火不能下归，两足冰冷，上身火热，烦躁不安，饮水即吐。";
  ex:hasName "还肾汤";
  ex:hasPrescription "熟地3两，甘草1钱，肉桂5分，牛膝5钱。";
  ex:hasUsage "水煎服。" .

<medicine:还阳丹> a ex:Medicine;
  ex:hasFunction "补益。主";
  ex:hasName "还阳丹";
  ex:hasPreparation "上为细末，熬酒膏子为丸，如梧桐子大。";
  ex:hasPrescription "川楝子1两，巴戟1两，葫芦巴1两，破故纸1两，肉苁蓉2两（酒浸，焙干）1两，苍术1斤（泔浸3宿，去黑皮，细切，饭内煎7遍，取出用）1两，巴豆1两（去皮，同苍术炒紫色，去巴不用）。";
  ex:hasUsage "每服2-3丸，空心温酒送下，日进加。" .

<medicine:还阳散> a ex:Medicine;
  ex:hasFunction "伤寒阴毒，面色青，四肢逆冷，心躁腹痛。";
  ex:hasName "还阳散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "硫黄。";
  ex:hasUsage "新汲水调下2钱，良久，或寒一起，或热一起，更看紧慢再服，汗出愈。" .

<medicine:还阳汤> a ex:Medicine;
  ex:hasFunction "伤寒阴毒，四肢厥冷，时有汗。";
  ex:hasName "还阳汤";
  ex:hasPreparation "上为粗末。";
  ex:hasPrescription "不灰木1两，延胡索半两，太阴玄精石1分。";
  ex:hasUsage "每服2钱匕，水1盏，加葱白1寸，同煎至6分，去滓温服，不拘时候。" .

<medicine:还阴解毒汤> a ex:Medicine;
  ex:hasFunction "治梅疮余毒未清，蒸灼肝肾，神水窄小，兼有赤丝，黑白混浊不清，看物昏眊不明。";
  ex:hasName "还阴解毒汤";
  ex:hasPrescription "川芎 当归（酒洗）生地黄 金银花（去叶）连翘 黄芩（酒炒）土茯苓 细甘草（减半）黄连（酒炒）苦参 麦门冬（去心）白芍药（酒洗）玄参各等分";
  ex:hasUsage "上药锉末，用水400毫升，煎至320毫升，去滓温服。" .

<medicine:还阴退翳丸> a ex:Medicine;
  ex:hasFunction "滋阴清热，散风退翳。治肝肾伏热，瞳神内生白翳，自上而下者。";
  ex:hasName "还阴退翳丸";
  ex:hasPreparation "炼蜜为丸。";
  ex:hasPrescription "黄芩 玄参 生地 知母各9克 茺蔚子 细辛各3克 防风 车前子 桔梗各4.5克";
  ex:hasUsage "每服9～12克，白开水冲服。" .

<medicine:还魂丸> a ex:Medicine;
  ex:hasFunction "发背痈疽，一切脓肿。";
  ex:hasName "还魂丸";
  ex:hasNote "忌海藻、菘菜、野猪肉、芦笋、生血物。";
  ex:hasPreparation "上将巴豆单复排铫底，以三物按上巴豆令平，以瓷盏盖之，四面湿纸搭合，勿令气泄，炭火四向缓烧之，时于水中蘸挑底，少顷又烧又蘸，其盏上底内，滴水一点如大豆，干则复滴，以三滴干为度，候冷研，陈米饭为丸，作23丸。";
  ex:hasPrescription "腻粉1分，水银1分，硫黄1分（同研），巴豆仁40粒。";
  ex:hasUsage "每服1丸，熟水送下。疏下恶物，以白粥补之。此药1丸治1人，曾无失者，才取下即时不痛，其疮亦干。" .

<medicine:还魂丹> a ex:Medicine;
  ex:hasFunction "小儿急、慢惊风。";
  ex:hasName "还魂丹";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "蜈蚣2寸，麝香1分，白芷4两，天麻4两，黄花子2钱。";
  ex:hasUsage "吹鼻。即苏。" .

<medicine:还魂汤> a ex:Medicine;
  ex:hasAlias "还魂散、追魂汤";
  ex:hasFunction "初得痘疹，病起即便手足厥冷，不省人事，痰喘气急，身体无汗。";
  ex:hasName "还魂汤";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "麻黄（去根节）1两5钱，杏仁（去皮尖，研）7-8粒，甘草（炙）5钱，独活1两，陈皮1两，厚朴1两，前胡1两，苏叶8分，枳壳1两。";
  ex:hasUsage "上药大人作3帖，中人作6帖，小人作9帖。水煎，去滓温服。取汗。" .

<medicine:进退四物汤> a ex:Medicine;
  ex:hasFunction "调经。主";
  ex:hasName "进退四物汤";
  ex:hasPrescription "熟地5钱，当归3钱，酒炒白芍1钱5分，川芎1钱。";
  ex:hasUsage "水煎服。" .

<medicine:进退大承气汤> a ex:Medicine;
  ex:hasFunction "大瘕泄，有太阴、阳明二经证者。";
  ex:hasName "进退大承气汤";
  ex:hasPrescription "大承气汤。";
  ex:hasUsage "《保命集》：泄有虚实寒热，虚则无力粘衣，不便已泄出，谓不能禁固也。实则数至圊而不能便，俗云虚坐努责故也，里急后重，进退大承气汤主之。" .

<medicine:进退黄连汤> a ex:Medicine;
  ex:hasFunction "握运中枢透达。主关格。";
  ex:hasName "进退黄连汤";
  ex:hasPrescription "黄连（姜汁炒）1钱5分，干姜（炮）1钱5分，人参（人乳拌蒸）1钱5分，桂枝1钱，半夏（姜制）1钱5分，大枣2枚。";
  ex:hasUsage "进法用本方7味，俱不制，水2茶盏，煎1半，温服；退法不用桂枝，黄连减半，或加肉桂5分，如上逐味制熟，煎服法同，但空朝服崔氏八味丸3钱，半饥服煎剂耳。" .

<medicine:进食丸> a ex:Medicine;
  ex:hasFunction "一切酒食所伤，以致心腹满闷，时呕酸水。胸膈食积。";
  ex:hasName "进食丸";
  ex:hasPreparation "上为末，水为丸。";
  ex:hasPrescription "牵牛1两，巴豆3粒（去油心膜）。";
  ex:hasUsage "每服20-30丸，食后随所伤物送下。" .

<medicine:进食丹> a ex:Medicine;
  ex:hasFunction "开胃健脾，消化积滞，止恶心呕酸。主";
  ex:hasName "进食丹";
  ex:hasPreparation "姜糊为丸，如梧桐子大。";
  ex:hasPrescription "木香1两，丁香1两，肉豆蔻1两，黄橘皮3分，人参3分，藿香3分，白术3分，神曲3分，麦糵3分，荗3分，槟榔1个，半夏5分。";
  ex:hasUsage "每服30丸，食后用姜汤送下。" .

<medicine:进食四物汤> a ex:Medicine;
  ex:hasFunction "健脾理气。治脾气不和，胸中饱闷。";
  ex:hasName "进食四物汤";
  ex:hasPreparation "上药锉末。";
  ex:hasPrescription "白芍（酒炒）3克 川芎2.1克 香附3克 砂仁2.4克 陈皮2.4克 枳实（麸炒）2.1克 槟榔2.1克 乌药2.1克 青皮（去瓤）2.1克 莲肉2.1克 白豆蔻（去壳）青木香各1.5克";
  ex:hasUsage "加生姜3片，水煎，温服。" .

<medicine:进食圆> a ex:Medicine;
  ex:hasFunction "治乳食不消，心腹胀满，壮热喘粗，呕吐痰逆，肠鸣泄泻，米谷不化；或下痢赤白，腹痛后重，及食症乳癖，倂气痞结，并皆治之。";
  ex:hasName "进食圆";
  ex:hasPrescription "代赭石（烧醋淬.研）、当归（去芦.微炒）、朱砂（研.飞）、枳壳（去瓤.麸炒微黄）、木香，各半两；麝香（细研）一分，巴豆霜半分。";
  ex:hasUsage "每一岁儿服一圆，温米饮下，更量虚实加减服之，食后服。" .

<medicine:进食平胃丸> a ex:Medicine;
  ex:hasFunction "顺气利隔，进食平胃。主脾胃气不和，不思饮食。";
  ex:hasName "进食平胃丸";
  ex:hasPreparation "上为细末，炼蜜为丸，如梧桐子大。";
  ex:hasPrescription "厚朴（去粗皮，姜汁涂炙令香）2两半，甘草（炙）1两半，苍术（米泔水浸2日，刮去皮）4两，陈皮（去白）2两半，人参1两，茯苓1两。";
  ex:hasUsage "每服10丸，空心盐汤嚼下。" .

<medicine:进食散> a ex:Medicine;
  ex:hasAlias "理脾散";
  ex:hasClinicalApplication "脾虚不食：李潜在真州治贾使君女子，已五十余日，病脾多呕，都不进食，医绝无验。潜投此药一服，遂食蒸饼半枚，明日百味皆思。潜云：此药进食极神速。予疑此药太热，潜云不然，用之三十年，无不效者。";
  ex:hasFunction "醒脾和胃。主疹后不食。";
  ex:hasName "进食散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "神曲（炒）、麦芽（炒）、砂仁、山楂。";
  ex:hasUsage "上为散服。" .

<medicine:进食煎> a ex:Medicine;
  ex:hasFunction "小儿伤食腹痛。";
  ex:hasName "进食煎";
  ex:hasPreparation "上为细末，煮面糊为丸，如黄米大。";
  ex:hasPrescription "木香4两，枳壳4两，当归4两，朱砂4两，麝香1两，巴豆1两。";
  ex:hasUsage "每服3-5丸，食后以米饮送下。" .

<medicine:远志丸> a ex:Medicine;
  ex:hasFunction "固摄精气，交通心肾，宁神定志。治因事有所大惊，夜多异梦，神魂不安，惊悸恐怯。";
  ex:hasName "远志丸";
  ex:hasPreparation "上药研细末，炼蜜为丸，如梧桐予大，辰砂为衣。";
  ex:hasPrescription "远志（去心，姜汁淹）石菖蒲各60克 茯神（去皮、木）人参 龙齿 白茯苓各30克";
  ex:hasUsage "每服70丸，食后、临卧用温开水送下。" .

<medicine:远志圆> a ex:Medicine;
  ex:hasFunction "治丈夫、妇人心气不足，肾经虚损，思虑太过，精神恍惚，健忘多惊，睡卧不宁，气血耗败，遗沥泄精，小便白浊，虚汗盗汗，耳或聋鸣，悉主之。";
  ex:hasName "远志圆";
  ex:hasPrescription "远志（去心.姜汁炒）、牡蛎（煅.取粉），各二两；白茯苓（去皮）、人参、干姜（炮）、辰砂（别研），各一两；肉苁蓉（净洗.切片.焙干）四两。";
  ex:hasUsage "每服三十粒，空心，食前，煎灯心盐汤下，温酒亦可。" .

<medicine:远志散> a ex:Medicine;
  ex:hasFunction "治虚劳。心虚劳损，羸瘦，四肢无力，心神昏闷。";
  ex:hasName "远志散";
  ex:hasNote "服药期间，忌鲤鱼、苋菜。";
  ex:hasPreparation "上药捣细罗为散。";
  ex:hasPrescription "远志30克（去心）白术30克 肉桂45克（去皱皮）人参30克（去芦头）鳖甲45克（涂酥炙令黄，去裙襕）天门冬30克（锉去心，焙）杜仲30克（去粗皮，微炙令黄，锉）川椒30克（去目及闭口者，微炒去汗）牛膝30克（去苗）白茯苓30克 薯蓣30克 山茱萸30克 柏子仁30克 生干地黄30克 石斛30克（去根，锉）黄耆30克（锉）甘草15克（炙微赤，锉）";
  ex:hasUsage "每服3克，以温酒调下。空腹时服，一日二次。" .

<medicine:远志汤> a ex:Medicine;
  ex:hasFunction "治心经受病，多汗恶风，善怒，口不能言，其状但得偃卧，不可倾侧，闷乱冒绝汗出，风中于心也，唇色正赤，尚犹可治，急灸心腧百壮；或青黄不定，面色（目亭）（目亭）战栗动者，不可治。";
  ex:hasName "远志汤";
  ex:hasPrescription "远志（去心.二钱半） 人参（去芦.半两） 石菖蒲（半两） 羌活（去芦.半两） 细辛（洗.去苗.半两） 麻黄（去根.半两） 赤芍药（一两） 白术（一两）";
  ex:hasUsage "上为细末，每服二钱，煎小麦汤调下，不拘时服。日服二次。" .

<medicine:远志流浸膏> a ex:Medicine;
  ex:hasFunction "祛痰药。用于咳痰不爽。";
  ex:hasName "远志流浸膏";
  ex:hasUsage "口服，一次0.5～2ml，一日1.5～6ml。" .

<medicine:远志莲粉粥> a ex:Medicine;
  ex:hasFunction "补中，益心志，聪耳明目。适用于健忘、怔忡、失眠等症。";
  ex:hasName "远志莲粉粥";
  ex:hasPreparation "先将远志泡去心皮与莲子均研为粉，再煮粳米粥，候熟入远志和莲子粉，再煮一二沸。";
  ex:hasPrescription "远志30克 莲子15克 粳米50克";
  ex:hasUsage "随意食用。" .

<medicine:远志酊> a ex:Medicine;
  ex:hasFunction "祛痰药。用于咳痰不爽。";
  ex:hasName "远志酊";
  ex:hasUsage "口服，一次2～5ml，一日6～15ml。" .

<medicine:连壳丸> a ex:Medicine;
  ex:hasFunction "解络脉之结。主内伤经络便血。";
  ex:hasName "连壳丸";
