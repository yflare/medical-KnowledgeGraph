  ex:hasUsage "每服1小盏，频频温服。" .

<medicine:刻效散> a ex:Medicine;
  ex:hasFunction "发背。";
  ex:hasName "刻效散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "黄瓜蒌1枚（连皮子煅过），白矾1钱。";
  ex:hasUsage "醋调敷，乳汁尤妙。" .

<medicine:刻欢丸> a ex:Medicine;
