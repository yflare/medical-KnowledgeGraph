  ex:hasName "参连开噤汤";
  ex:hasPrescription "人参1钱，藿香3钱（浙），陈皮1钱，冬瓜仁3钱，陈仓米半合包，川连1钱，石莲肉3钱，石菖蒲1钱，吴萸1钱，荷叶蒂1枚。";
  ex:hasUsage "煎服。" .

<medicine:参连散> a ex:Medicine;
  ex:hasFunction "急劳。寒热潮发，肌热，心烦不安。";
