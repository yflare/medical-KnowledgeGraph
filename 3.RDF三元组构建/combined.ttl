  ex:hasUsage "浆水饮（《会约》卷十）。" .

<medicine:浆水渍方> a ex:Medicine;
  ex:hasFunction "代指肿痛。";
  ex:hasName "浆水渍方";
  ex:hasPrescription "浆水。";
  ex:hasUsage "上取1升，以盐半两，和煎令沸。温浸患指，日3-5度。" .

<medicine:浆水粥> a ex:Medicine;
