  ex:hasName "酒制神芎丸";
  ex:hasPreparation "用无灰酒为丸，如黍米大。";
  ex:hasPrescription "大黄（酒蒸）4钱，黄芩（酒洗）2钱，黑丑（半生半熟，取头末）4钱，滑石4钱，黄连（酒洗）5钱，薄荷5钱，川芎5钱。";
  ex:hasUsage "每服5丸、15丸，温水送下。" .

<medicine:酒制通圣散> a ex:Medicine;
