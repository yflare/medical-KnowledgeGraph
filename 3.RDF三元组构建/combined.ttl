  ex:hasName "定惊琥珀散";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "琥珀3两，当归3两，乳香1两半，辰砂1两半。";
  ex:hasUsage "每服3钱，金箔汤送下。" .

