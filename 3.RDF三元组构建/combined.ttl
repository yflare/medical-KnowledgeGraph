  ex:hasPrescription "槟榔4两，白丑（头末）2两，黑丑（头末）2两，雷丸1两，大黄1两，贯众1两，芜荑8钱，沉香半两，木香半两。";
  ex:hasUsage "《疮疡经验全书》有知母一两；“隔宿汤”作“隔宿糖汤”。" .

<medicine:琥珀丸> a ex:Medicine;
  ex:hasAlias "和伤丸";
  ex:hasClinicalApplication "小儿善哭：华虚舟五郎，尪甚善哭，周岁中，每哭即气绝，绝而苏，一饭时许矣；至三岁外，其病日深。哭而绝，绝而苏，甚至经时，初或一月一发，后则频发，有日再发者。投以此药，人参、桂圆汤下数丸，遂愈。";
  ex:hasFunction "慢惊，兼治小儿一切虚证。";
  ex:hasName "琥珀丸";
  ex:hasNote "忌生冷、葱、苋菜、毒鱼等物。";
  ex:hasPreparation "上炼蜜为丸，朱砂为衣。";
  ex:hasPrescription "琥珀3钱，天竺黄2钱，人参3钱，茯神2钱，粉甘草3钱，朱砂1钱5分，山药1两，胆星2钱，莲肉3钱。";
  ex:hasUsage "每服1钱，人参、圆眼汤送下。" .

<medicine:琥珀丹> a ex:Medicine;
  ex:hasFunction "安心神，镇惊邪。主小儿一切惊风。";
  ex:hasName "琥珀丹";
  ex:hasPreparation "上为细末，炼蜜为丸，如芡实大。";
  ex:hasPrescription "琥珀1两，南星（腊月牛胆酿者）1两，天麻1两，朱砂（细研，水飞）1两，白僵蚕半两，白附子半两，香白芷半两（为细末），龙脑（研）1钱。";
  ex:hasUsage "每服1丸，人参薄荷汤化下。" .

<medicine:琥珀人参丸> a ex:Medicine;
  ex:hasFunction "治血蛊。";
  ex:hasName "琥珀人参丸";
  ex:hasPreparation "上药为末，浓煎苏木汁为丸。";
  ex:hasPrescription "人参 五灵脂各30克 琥珀 肉桂 附子（生）各15克 赤茯苓 川芎 沉香 穿山甲（煅）各9克";
  ex:hasUsage "每服6克，早暮用温酒各送一服。" .

<medicine:琥珀保生锭子> a ex:Medicine;
  ex:hasFunction "逐瘀血，生新血。主产后风冷袭于胞门，恶露不下，上逆冲心，发晕，额出冷汗，口噤牙紧，甚至不测。";
  ex:hasName "琥珀保生锭子";
  ex:hasPrescription "琥珀（研极细）3两，肉桂2两，五灵脂（醋炒）3两，生蒲黄3两，丁香1两，延胡索4两，红花2两，香附（醋炒）4两，大黄（酒蒸5次，须黑色为度，再入饭甑上蒸3次）4两。";
  ex:hasUsage "血晕、虚，用佛手散，热，用荆芥一味散煎汤磨服。" .

<medicine:琥珀六合汤> a ex:Medicine;
  ex:hasFunction "妊娠伤寒，太阳本病，小便赤如血状。";
  ex:hasName "琥珀六合汤";
  ex:hasPrescription "四物汤4两，琥珀5钱，茯苓5钱。";
  ex:hasUsage "《医钞类编》本方用法，每次五钱，水煎服。" .

<medicine:琥珀养心丹> a ex:Medicine;
  ex:hasFunction "气血虚弱，心神失养，惊悸怔忡，失眠健忘，气短体倦，自汗口干，头昏心烦，面色少华。心血虚，或怔忡心跳。坐卧不安，寐则易觉，多魇。四肢倦怠，精神不爽，面黄肌瘦。";
  ex:hasName "琥珀养心丹";
  ex:hasPreparation "上为细末，将牛黄、朱砂、琥珀、龙齿研极细，以猪心血为丸，如黍米大，金箔为衣。";
  ex:hasPrescription "琥珀（另研）2钱，龙齿（煅，另研）1两，远志（黑豆、甘草同煮，去骨）5钱，石菖蒲5钱，茯神5钱，人参5钱，酸枣仁（炒）5钱，当归7钱，生地黄7钱，黄连3钱，柏子仁5钱，朱砂（另研）3钱，牛黄（另研）1钱。";
  ex:hasUsage "每服50丸，灯心汤送下。" .

<medicine:琥珀养心汤> a ex:Medicine;
  ex:hasFunction "怔忡。";
  ex:hasName "琥珀养心汤";
  ex:hasPrescription "人参1钱，当归2钱，茯神3钱，枣仁1钱半（炒），远志1钱半（炙），石菖蒲1钱，琥珀1钱（研，冲服），炙草8分，麦冬2钱，龙眼3枚。" .

<medicine:琥珀分清泄浊丸> a ex:Medicine;
  ex:hasAlias "琥珀分清丸";
  ex:hasFunction "肝经湿热毒火下注，淋浊管痛，小溲不利，及下疳火盛，肿痛腐烂。";
  ex:hasName "琥珀分清泄浊丸";
  ex:hasPreparation "上为细末，用鸡蛋清24个杵为丸，如梧桐子大，朱砂为衣。";
  ex:hasPrescription "琥珀1两，锦纹大黄10两。";
  ex:hasUsage "琥珀分清丸（《全国中药成药处方集》沈阳方）。" .

<medicine:琥珀利气丸> a ex:Medicine;
  ex:hasAlias "利气丸";
  ex:hasFunction "平肝理气，消食导下。主硬块隆起，脐腹坚硬，疼痛跳动，痛有定处，脘腹气串，起伏无定，疼痛异常，忽聚忽散。";
  ex:hasName "琥珀利气丸";
  ex:hasNote "孕妇忌服。忌食辛辣。";
  ex:hasPreparation "上为细末，炼蜜为丸，每丸重2钱1分。";
  ex:hasPrescription "琥珀2两，木瓜2两，黄柏4两，青皮2两，香附4两，酒芩6两，陈皮2两，二丑4两，果仁1两，川军6两，莪术2两，郁李1两。";
  ex:hasUsage "每服1丸，白开水送下，重者日服2次。不可多服。" .

<medicine:琥珀参苓散> a ex:Medicine;
  ex:hasFunction "止痛，调气，利尿。主男子茎中刺痛，女子阴中肿痛，小便淋漓不利，胁痛气逆，各种疝痛淋痛。";
  ex:hasName "琥珀参苓散";
  ex:hasNote "忌食辛辣酒类。";
  ex:hasPreparation "上为极细末。";
  ex:hasPrescription "人参5分，茯苓5分，琥珀3分，泽泻4分，柴胡4分，当归尾5分，玄胡索7分，川楝子5分，生甘草5分。";
  ex:hasUsage "每服1钱，白开水送下。" .

<medicine:琥珀圆> a ex:Medicine;
  ex:hasFunction "治妇人或老、或少，产前、产后百病，及疗三十六种血冷，七疝八瘕，心腹刺痛，卒中瘫痪，半身不遂，八风、十二痹等，手足酸疼，乳中毒结瘀血，怀胎惊动，伤犯不安，死胎不出，并衣不下，并宜服之。";
  ex:hasName "琥珀圆";
  ex:hasPrescription "琥珀（研）、辰砂（别研）、沉香、阿胶（碎.炒）、肉桂（去粗皮）、石斛（去根）、附子（炮.去皮.脐）、五味子（拣净）、川芎，各半两；牛膝（去苗.酒浸一宿）当归（去苗.炒）、肉苁蓉（切.酒浸一宿.焙）、人参、续断、没药（研），各三分；熟干地黄、木香，各一分。";
  ex:hasUsage "每服一圆，空心，暖酒调下，午、晚食前再服，能生精血，去恶血。" .

<medicine:琥珀地黄散> a ex:Medicine;
  ex:hasAlias "琥珀散";
  ex:hasFunction "血虚多惊，及产后败血诸疾。";
  ex:hasName "琥珀地黄散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "辰砂、琥珀、没药（并研细）、当归各等分。";
  ex:hasUsage "琥珀散（《济阴纲目》卷十二）。本方名琥珀地黄丸，但方中无地黄，疑脱。《医钞类编》有生干地黄。" .

<medicine:琥珀多寐丸> a ex:Medicine;
  ex:hasFunction "清心养营，安神定魄。平肝安神。主健忘恍惚，神虚不寐。肝阳上僣，心神不守，惊悸怔忡。";
  ex:hasName "琥珀多寐丸";
  ex:hasPreparation "上为细末，猪心血和炼蜜为丸，如芡实子大，金箔为衣。";
  ex:hasPrescription "真琥珀、真羚羊角（细镑）、人参、白茯神、远志（制）、甘草各等分。";
  ex:hasUsage "《医钞类编》无白茯神，有茯苓。《外科传薪集》有白术。" .

<medicine:琥珀如意散> a ex:Medicine;
  ex:hasFunction "下疳肿痛。";
  ex:hasName "琥珀如意散";
  ex:hasPreparation "上为极细末。";
  ex:hasPrescription "炉甘石2钱5分，龙骨1钱半，石膏1钱半，没药1钱半，乳香1钱，赤石脂2钱，生大黄2钱，甘草2钱，扫盆2钱，白蜡2钱，鳖甲（炙）3钱，白芷1钱半，青黛1钱半，赤小豆4钱，地榆炭3钱，僵蚕3钱，琥珀3钱。";
  ex:hasUsage "每用药1两，加犀黄6厘，冰片1分，麝香5厘，麻油调敷或干掺。" .

<medicine:琥珀安神丸> a ex:Medicine;
  ex:hasAlias "安神丸";
  ex:hasFunction "病后虚烦不睡。";
  ex:hasName "琥珀安神丸";
  ex:hasPreparation "上为末，米糊为丸，如粟米大。";
  ex:hasPrescription "琥珀1钱，珍珠1钱，生地1钱，甘草1钱，当归3钱，黄连3钱，朱砂2钱。";
  ex:hasUsage "每服30丸，食后麦门冬汤送下。" .

<medicine:琥珀安神散> a ex:Medicine;
  ex:hasFunction "产后冲心昏晕，脉洪涩者。";
  ex:hasName "琥珀安神散";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "琥珀3两，荆芥1两半（烧灰），泽兰3两，当归3两，赤芍1两半（醋炒），肉桂1两半（去皮），砂糖3两（炒灰）。";
  ex:hasUsage "每服3钱，加益母3钱，点浓汁煎化，温服。" .

<medicine:琥珀定志丸> a ex:Medicine;
  ex:hasFunction "补益虚损。主思虑恐惧，神志不宁，疲倦善忘，寐中多梦，盗汗遗精。";
  ex:hasName "琥珀定志丸";
  ex:hasPreparation "上炼蜜为丸。";
  ex:hasPrescription "人参2两，琥珀5钱，麦冬（辰砂3钱拌）1两，冬术1两5钱，茯苓2两，远志8钱，菖蒲5钱，甘草8钱。";
  ex:hasUsage "每服3钱，桂圆汤送下。" .

<medicine:琥珀定智丸> a ex:Medicine;
  ex:hasAlias "琥珀定志丸";
  ex:hasFunction "补心生血，定魄安魂，扶肝壮胆，管辖神魂。主惊战虚弱，气乏之病。";
  ex:hasName "琥珀定智丸";
  ex:hasPreparation "上为末，炼蜜为丸，如梧桐子大。";
  ex:hasPrescription "南星半斤（先将地作坑，用炭10斤在坑内烧红，去灰净，用好酒10余斤倾在坑内，大瓦盆盖覆，周围以炭火拥定，勿令泄气，次日取出，为末），真琥珀1两（皂角水洗去油），大朱砂2两（公猪心割开，入内，用线缚住，悬胎煮酒2碗），干人乳（用姜汁制），好拣参（去芦）3两，白茯苓（去皮）3两，白茯神（去皮木）3两，石菖蒲2两（猪胆汁炒），远志（水泡过，去心）2两（猪胆煮过，晒干，再用姜汁制）。";
  ex:hasUsage "琥珀定志丸（《回春》卷四）。晒干人乳法：用人乳数碗，入瓦盘内，莫搅动，四围晒干刮一处，干则再刮。乳干以姜汁拌晒用。方中干人乳用量原缺。" .

<medicine:琥珀定痛丸> a ex:Medicine;
  ex:hasFunction "诸疮肿痛不止。";
  ex:hasName "琥珀定痛丸";
  ex:hasPreparation "上为细末，将黄占烊化为丸，如梧桐子大，朱砂为衣。";
  ex:hasPrescription "琥珀5钱，黄占5钱，乳香3钱，没药3钱，白矾1钱，大土灰5分。";
  ex:hasUsage "每服20-30丸，开水送下。" .

<medicine:琥珀导赤汤> a ex:Medicine;
  ex:hasFunction "心经之火，移于小肠，溲溺淋浊，或涩或痛。";
  ex:hasName "琥珀导赤汤";
  ex:hasPrescription "琥珀1钱，天冬1钱5分，麦冬1钱5分，生地5钱，丹参2钱，丹皮2钱，赤芍1钱，木通1钱，甘草梢5分，淡竹叶10张，灯心3尺。" .

<medicine:琥珀射星丸> a ex:Medicine;
  ex:hasFunction "痰迷心窍，癫狂。";
  ex:hasName "琥珀射星丸";
  ex:hasPreparation "上为细末，用猪心血为丸，金箔为衣，如小梧桐子大。";
  ex:hasPrescription "辰砂1钱，琥珀1钱，射干1钱，真陈胆星1钱。";
  ex:hasUsage "《青囊秘传》本方用量：每服五十丸。" .

<medicine:琥珀彻底汤> a ex:Medicine;
  ex:hasFunction "祛风镇痉止痛。主破伤风。";
  ex:hasName "琥珀彻底汤";
  ex:hasPrescription "独活9g，三角将军（即3个角的屎官牛）3个（焙干），人指甲3g（焙黄），全蝎7个，僵蚕（炒）7个，蝉蜕15g，天南星6g。";
  ex:hasUsage "水煎服。每日1剂。连服3日。服药前将朱砂粉1.5g，琥珀1.5g，赤金箔3张研细末，用开水或黄酒冲服。" .

<medicine:琥珀抱龙丸> a ex:Medicine;
  ex:hasAlias "抱龙丸（《婴童百问》卷六）。";
  ex:hasFunction "清热化痰，镇惊安神。主内热痰盛，咳嗽喘促，惊吓失魂，惊风抽搐。";
  ex:hasName "琥珀抱龙丸";
  ex:hasNote "忌食鱼腥、生冷。食乳者，乳母同忌。";
  ex:hasPreparation "上为细末，炼蜜为丸，重5分，金衣三十六开，蜡皮封固。";
  ex:hasPrescription "甘草5钱，天竺黄1两2钱，防风1两2钱，天麻1两5钱，茯苓1两5钱，羌活1两5钱，川贝母1两5钱，白附子（炙）1两5钱，蝉退1两5钱，胆星1两5钱，桔梗1两5钱，全蝎9钱，僵蚕（炒）9钱，钩藤9钱，人参（去芦）9钱（以上共为细粉，过罗），牛黄5钱，珍珠（豆腐炙）5钱，琥珀1两，明雄黄6钱，朱砂6钱，麝香9钱。";
  ex:hasUsage "每服1丸，温开水送下，1日2次。" .

<medicine:琥珀救喉散> a ex:Medicine;
  ex:hasFunction "化瘀消肿，消炎镇痛。主乳蛾，喉风，喉痹，咽喉肿痛，瘟毒结喉。";
  ex:hasName "琥珀救喉散";
  ex:hasNote "忌食鱼肉、辛辣之物。";
  ex:hasPreparation "上为极细末。";
  ex:hasPrescription "血琥珀2钱，牛黄2分，熊胆2分，梅片3分，珍珠2分，儿茶1分半。";
  ex:hasUsage "内服每用1分，白开水送下。外用苇管吹1分。" .

<medicine:琥珀散> a ex:Medicine;
  ex:hasAlias "琥珀汤";
  ex:hasFunction "接骨，化瘀血。主一切伤折，恶血不散。";
  ex:hasName "琥珀散";
  ex:hasNote "大忌生冷、油腻等物。";
  ex:hasPreparation "上为细散。";
  ex:hasPrescription "琥珀1两，生玳瑁1两，当归1两（锉，微炒），蒲黄1两，生干地黄1两，京三棱1两（煨，锉）。";
  ex:hasUsage "每服2钱，以温酒调下，不拘时候。" .

<medicine:琥珀朱砂丸> a ex:Medicine;
  ex:hasAlias "琥珀丸";
  ex:hasFunction "室女带下。妇人月水不准及难产，产后血奔，或因气与风寒暑湿所搏，以致月经不调，或瘀血刺痛。";
  ex:hasName "琥珀朱砂丸";
  ex:hasPreparation "上为末，水为丸，如龙眼核大。";
  ex:hasPrescription "琥珀4钱，木香4钱，当归4钱，没药4钱，乳香1钱，麝香2分半，朱砂2分半。";
  ex:hasUsage "琥珀丸（《郑氏家传女科万金方》卷一）。《郑氏家传女科万金方》本方用法：上为末，用人乳拌乳香，饭锅上煮化，下前药为丸，如芡实大，朱砂为衣。临服童便，姜汁、酒送下。" .

<medicine:琥珀止淋丸> a ex:Medicine;
  ex:hasFunction "清利膀胱，疏通尿道。主膀胱邪热，小便赤涩，淋沥浑浊，尿道刺痛。";
  ex:hasName "琥珀止淋丸";
  ex:hasPreparation "上为细末，用鸡子清13个，加冷开水泛为小丸，每16两用滑石细粉4两为衣，闯亮。";
  ex:hasPrescription "大黄4两，海金沙4两，甘草2两，琥珀4钱。";
  ex:hasUsage "每服2钱，温开水送下，日服2次。" .

<medicine:琥珀汤> a ex:Medicine;
  ex:hasFunction "产后水肿，及诸血毒生肿者。";
  ex:hasName "琥珀汤";
  ex:hasPreparation "上为粗末。";
  ex:hasPrescription "琥珀1钱半，商陆2钱，桂枝8分，反鼻5分，猪苓7分。";
  ex:hasUsage "水煎，分温服。" .

<medicine:琥珀泽兰煎> a ex:Medicine;
  ex:hasFunction "妇人三十八种血气，八风五痹，七症八瘕，心腹刺痛，中风瘫痪，手足酸疼，乳中结瘀，妊娠胎动，死胎不出，产衣不下，败血凑心，头旋眼花，血注四肢，浑身浮肿，冲任久虚，绝产无嗣，或因有子，经脉不调，赤白带下，恶心呕逆，身体瘦倦。";
  ex:hasName "琥珀泽兰煎";
  ex:hasPreparation "上为细末，炼蜜为丸，如弹子大。";
  ex:hasPrescription "紫巴戟（去心，糯米炒）1两，茴香（炒）1两，牡丹皮（去心）1两，刘寄奴草（去枝）1两，五味子（去梗）1两，白芷1两，五加皮（去心）1两，金钗石斛（去根，锉，酒浸，炒）1两，泽兰叶（去梗）1两，川芎1两，赤芍药1两，生干地黄（洗，去芦）1两，川当归（酒浸1宿）1两，人参（去芦）1两，白芍药1两，熟干地黄（洗去土）1两，艾叶（醋炒，糯米糊调成饼，焙干，为末）1两，附子（炮，去皮脐）1两，白术1两。";
  ex:hasUsage "每服1丸，早、晚用温酒磨下。漏胎刺痛，煮糯米饮送下；寒热往来，四肢烦疼，煎青蒿酒送下；妇人、室女经血不通，煎红花酒送下；血晕不省人事，童子小便和暖酒送下；催生，鸡子清和酒送下；血气、血块攻刺心腹，烧秤锤淬酒送下；伤寒及中风口噤，煎麻黄汤送下，用被盖出汗即愈；心惊悸及头疼，薄荷酒送下；咳嗽，煎桑白皮汤送下；血风攻注，浑身瘙痒，头面麻痹，炒黑豆浸酒送下；产前产后常服，不生诸疾。怀胎8月，1日1服，胎滑易产。" .

<medicine:琥珀清金散> a ex:Medicine;
  ex:hasFunction "止嗽化痰，清肺降逆。主咳嗽日久，时吐痰涎，胸逆气滞，倦怠，小便不利。";
  ex:hasName "琥珀清金散";
  ex:hasNote "忌辛辣发物。";
  ex:hasPreparation "上为极细末。";
  ex:hasPrescription "血琥珀1钱，川贝母1钱，茯苓1钱，百合1钱，法夏1钱，天冬1钱，京知母5钱，石膏6钱。";
  ex:hasUsage "成人每服1钱，小儿每服1分，开水送下。" .

<medicine:琥珀滋生丸> a ex:Medicine;
  ex:hasFunction "妇人胎前产后百病。脑胁疼痛，绕脐腹痛，呕逆上气，筑心痰喘，不进饮食；诸色痢疾，及赤白带下，血冷血崩，漏胎下血；泄泻不止；尿涩诸淋；血晕不知人事；上热下冷；遍身虚肿水气；产内二毒伤寒及中风角弓反张；月经不通，或间杂五色，频频而下，断续不止，饮食无味，肌瘦面赤，唇焦，乍寒乍热，四肢频痛，五心烦热，黑(黑干)血斑，赤肿走注，血风劳伤。";
  ex:hasName "琥珀滋生丸";
  ex:hasPreparation "上为细末。先将益母草8两揉碎，加水10碗，熬成一半，去滓，慢火熬成膏，和药末，少加老蜜，捣千余下，分为百份，每丸重1钱4分，朱砂为衣，阴干，再晒极干，黄蜡为壳。";
  ex:hasPrescription "琥珀1两（醋炒，灯草同研），阿胶1两（炒成珠），五味子5钱，附子（制）1两（夏5钱），肉桂（去粗皮）5钱，沉香5钱（不见火），川芎5钱，桑寄生1两，当归1两，肉苁蓉1两，人参1两，续断1两，熟地1两，没药（炙）1两，木香（不见火）1两，延胡索1两，乳香（炙）1两，牛黄3钱，朱砂1两（为衣）。";
  ex:hasUsage "每服1丸。脑胁疼痛，绕脐腹痛，及呕逆上气，筑心痰喘，不进饮食，用姜汁少许，和酒化服；诸色痢疾，及赤白带下，血冷血崩，漏胎下血，用生姜、艾叶（炒令黑色）酒煎数沸，调服；泄泻不止，陈米饮调服；尿涩诸淋，通草、灯心汤送下；血晕不知人事，童便调灌半丸，醒后当归汤服1-2丸；上热下冷，人参汤服；遍身虚肿水气，赤小豆汤调服；产内二毒伤寒及中风角弓反张，麻黄汤调服，被盖出汗；月经不通，或间杂五色，频频而下，断续不止，饮食无味，肌瘦面赤，唇焦，乍寒乍热，四肢频痛，五心烦热，黑(黑干)血斑，赤肿走注，血风劳伤，并用童便入姜汁少许服；临产，服1丸，用酒送下，易产；常服，以童便加酒一半，免恶心；怀胎临月，1日1服，至产下，不觉疼痛，或服至10日，饮食倍增。" .

<medicine:琥珀煎> a ex:Medicine;
  ex:hasFunction "产后虚羸，面色萎黄，恶血不尽，脐腹冷痛。";
  ex:hasName "琥珀煎";
  ex:hasNote "熬药及点眼忌用铁器。";
  ex:hasPreparation "上前9味为散，先将地黄汁煎熟，即下蜜、酒、酥搅候溶，入众药末，以柳篦搅不住手，候似膏，倾出瓷器盛。";
  ex:hasPrescription "琥珀（研）6两，牛膝（酒浸，切，焙）6两，当归（切，焙）6两，防风（去叉）6两，桃仁（去皮尖双仁，炒，研）6两，荜茇6两，芎6两，桂（去粗皮）4两，干姜（炮）2两，清酒1升，生地黄汁3升，酥6两，蜜3合。";
  ex:hasUsage "每服1匙，温酒调下，不拘时候。" .

<medicine:琥珀煎丸> a ex:Medicine;
  ex:hasFunction "妇人月候不通。";
  ex:hasName "琥珀煎丸";
  ex:hasPreparation "上为末，以琥珀膏为丸，如梧桐子大。";
  ex:hasPrescription "琥珀1两（细研，以醋3升熬如膏），虻虫半两（去翅足，炒黄），水蛭半两（炒黄），肉桂3两（去皴皮），桃仁1两（去皮尖双仁，别研，生用），川大黄3两（生用）。";
  ex:hasUsage "每服30丸，空心以温酒送下。" .

<medicine:琥珀煮散> a ex:Medicine;
  ex:hasFunction "妊娠堕胎后，恶血不出，小腹(疒丂)痛。";
  ex:hasName "琥珀煮散";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "琥珀（研）1钱，没药（研）半两，蒲黄（去苗，切，焙）半两，赤芍药（炒）半两，姜黄半两，红蓝花半两，土瓜根半两，牛李子半两，延胡索半两，牡丹皮半两。";
  ex:hasUsage "每服3钱，以童便、酒各半盏，同煎至7分，温服，心腹胀痛，每服2钱，温酒调下。" .

<medicine:琥珀牛黄丸> a ex:Medicine;
  ex:hasFunction "杨梅破烂，并一切疽痈久溃，脓水不干者。";
  ex:hasName "琥珀牛黄丸";
  ex:hasPreparation "上为极细末，酒糊为丸，如萝卜子大。";
  ex:hasPrescription "琥珀1钱，猪牙皂1钱，木香1钱，人中白（煅）3钱，轻粉3钱，雄黄3钱，朱砂3钱，乳香（去油）3钱，没药（去油）3钱，白芷3钱，当归2钱，西牛黄3分，槐花（炒）1两，丁香（春、夏）1钱5分（秋、冬）3钱。";
  ex:hasUsage "初服5丸，5日后服7丸，又5日后服9丸，又5日后仍服7丸，又5日后只服5丸，周而复始，俱用土茯苓、甘草煎汤送下。" .

<medicine:琥珀犀角膏> a ex:Medicine;
  ex:hasClinicalApplication "咽喉口舌生疮菌：向有一贵人，因疽而生此证，医者以为心脏绝，尽皆设辞退医，愚进此药，一日而安。";
  ex:hasFunction "咽喉口舌生疮，喉痛，木舌。痈疽之疾，初服头药失序，或不曾服内托散，又无药宣得内毒，致令热毒冲心经，甚至生红黑菌。阴火上炎之喉痛。肺与三焦积热，以致悬痈生于上腭，状若紫葡萄，亦发寒热，至口不得开，舌不得伸缩，惟欲仰卧，鼻出红涕；心肝脾三经火热上攻，以致夹疽生喉两旁；心脾壅热，舌肿粗大，渐渐硬塞满口，气不得吐，如木之不和软者。";
  ex:hasName "琥珀犀角膏";
  ex:hasPreparation "上人参、茯神、犀角为细末，入乳钵内，别研药味和匀，用炼蜜搜为膏子，以瓷瓶收贮。";
  ex:hasPrescription "真琥珀（研）1钱，生犀角屑1钱，辰砂（研）2钱，茯神（去木皮）2钱，真脑子（研）2字，人参（去芦）2钱，酸枣仁（去皮，研）2钱。";
  ex:hasUsage "《赤水玄珠》有茯苓，无茯神；《医钞类编》有杏仁，无枣仁。" .

<medicine:琥珀珍珠丸> a ex:Medicine;
  ex:hasFunction "小儿急、慢惊风，涎留心经，上逆作吐，目睛直视，手足搐搦，及风痫瘈疭，涎潮昏塞，嚼舌摇头，作声狂叫。";
  ex:hasName "琥珀珍珠丸";
  ex:hasPreparation "上为细末，以猪心血同薄荷自然汁煮面糊为丸，如萝卜子大。";
  ex:hasPrescription "巴豆7枚（取霜），附子尖14枚（半生，半炮），半夏10枚（半生，半炮），白花蛇头1枚（酒浸，焙干），白僵蚕14枚（一半生，一半用薄荷叶裹炙焦，去薄荷不用），白附子2枚（半生，半炮），全蝎14枚（一半生，一半用薄荷叶裹炙令黄，去薄荷），天南星3钱（半生，半炮），羌活（去芦头）1钱，白鲜皮1钱，琥珀（别研）1钱，天麻1钱，珍珠末（别研）1钱，朱砂（别研）1钱，龙齿（火煅）1钱，雄黄半钱（别研），麝香1字（别研）。";
  ex:hasUsage "每服10丸，煎人参汤送下，不拘时候。" .

<medicine:琥珀珍珠八宝丹> a ex:Medicine;
  ex:hasFunction "一切湿疮。";
  ex:hasName "琥珀珍珠八宝丹";
  ex:hasPreparation "上为极细末，储瓷瓶听用。";
  ex:hasPrescription "煅甘石2钱，赤石脂2钱，上血竭2钱，儿茶2钱，煅龙骨1钱，煅珍珠5分，琥珀5分，象皮5分。" .

<medicine:琥珀珍珠散> a ex:Medicine;
  ex:hasFunction "小便浑浊淋涩。";
  ex:hasName "琥珀珍珠散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "琥珀、珍珠、郁金、王不留行、当归、滑石、海金沙、石韦、甘草节各等分，朱砂减半。";
  ex:hasUsage "每服2钱，空心淡竹叶、灯心汤送下。" .

<medicine:琥珀生犀汤> a ex:Medicine;
  ex:hasFunction "安心智，定魂魄，调心气，稳睡眠。主风邪为患。";
  ex:hasName "琥珀生犀汤";
  ex:hasPreparation "上为粗末。";
  ex:hasPrescription "琥珀（研）半两，犀角（镑）半两，茯神（去木）1两，人参1两，生干地黄（焙）1两，菖蒲（石上者）1两，防风（去叉）1两，远志（去心）半两，甘草（微炙）半两。";
  ex:hasUsage "每服3钱匕，水1钟，煎至6分，去滓温服，不拘时候。" .

<medicine:琥珀碧玉散> a ex:Medicine;
  ex:hasFunction "通利。主疯犬咬伤，毒物血片填塞茎中，致小水涩滞若淋者。";
  ex:hasName "琥珀碧玉散";
  ex:hasNote "终身忌食狗肉及蚕蛹、赤豆；百日内忌见麻物，忌饮酒；三年内忌食一切毒物及房事，可常食杏仁，以防其毒。";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "滑石6两，甘草1两，琥珀5钱，青黛8分。";
  ex:hasUsage "每服3钱，灯心煎汤调下。" .

<medicine:琥珀育心丸> a ex:Medicine;
  ex:hasFunction "怔忡惊悸，日久不愈，形容渐瘦，四肢乏力。";
  ex:hasName "琥珀育心丸";
  ex:hasPreparation "上为末，炼蜜为丸，辰砂、金箔为衣，如芡实大。";
  ex:hasPrescription "茯神1两，郁金1两，远志1两，牛黄3钱，龙齿4钱，酸枣仁8钱，黄连8钱，辰砂5钱，真金箔30张。";
  ex:hasUsage "每日早、晚各1丸，灯心煎汤调下。" .

<medicine:琥珀膏> a ex:Medicine;
  ex:hasAlias "琥珀煎";
  ex:hasFunction "久服养生。主恶风疾。";
  ex:hasName "琥珀膏";
  ex:hasPreparation "上将血余、花椒、麻油煠焦，捞去滓，下黄蜡溶化尽，用夏布滤净，倾入瓷碗内，预将定粉、银朱、轻粉、琥珀4味各研极细，共合一处，徐徐下入油内，用柳枝不时搅之，以冷为度。";
  ex:hasPrescription "好松脂。";
  ex:hasUsage "以水盛釜内，甑安水傍，白茅藉甑底两层，黄沙盖茅上寸许，方布松脂于上，以桑柴火紧炊，汤减旋添，脂尽方出，新笊篱掠投冷水，沉釜者勿用，候凝结复炊，如前3次，色白如玉，研和白茯苓、柏子仁、甘菊共剂。单服亦可，酒吞，100日愈。" .

<medicine:琥珀膏贴积丸> a ex:Medicine;
  ex:hasFunction "积聚。";
  ex:hasName "琥珀膏贴积丸";
  ex:hasPreparation "上为末，以大蒜捣膏。";
  ex:hasPrescription "大黄1两，朴硝1两。";
  ex:hasUsage "贴之。" .

<medicine:琥珀茯苓丸> a ex:Medicine;
  ex:hasFunction "通闭，利尿，止痛。主小便淋漓，浑浊如膏，尿道刺痛。";
  ex:hasName "琥珀茯苓丸";
  ex:hasNote "忌辛辣动火食物。孕妇忌服。";
  ex:hasPreparation "上为细末，水泛为小丸，滑石为衣，闯亮。";
  ex:hasPrescription "琥珀3两，土茯苓4两，赤茯苓3两，黄柏3两，海金沙3两，泽泻3两，甘草3两，乌药3两，丹皮3两，半夏3两，车前子5两，大黄5两，滑石5两，木通2两。";
  ex:hasUsage "每服2钱，温开水送下。" .

<medicine:琥珀茯苓膏> a ex:Medicine;
  ex:hasFunction "精神失守，渐成心风。";
  ex:hasName "琥珀茯苓膏";
  ex:hasPreparation "上将人参膏加琥珀、茯苓末调匀，如稠甚，加蜜汁调之得所。";
  ex:hasPrescription "人参1两，陈皮半两，当归2两（酒浸，锉，3味熬稀膏1碗），白茯苓2两（为末），琥珀半两（另为末）。";
  ex:hasUsage "每服2-3匙，嚼咽下，不拘时候，临卧睡服之亦妙。" .

<medicine:琥珀药> a ex:Medicine;
  ex:hasFunction "阴囊搔痒不已，及自汗不收。";
  ex:hasName "琥珀药";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "西琥珀6钱，枯白矾1钱，黄丹7钱，麝香4钱，龙泉粉2两。";
  ex:hasUsage "每用半钱，掺在手心，于患处搽。" .

<medicine:琥珀蜡矾丸> a ex:Medicine;
  ex:hasFunction "护心膜，散毒止痛。主悬痈并一切痈疽、发背已成未成之际，恐毒不能出，必致内攻者。";
  ex:hasName "琥珀蜡矾丸";
  ex:hasPreparation "上为细末，将蜡熔化，再将末药并蜜搅匀，为丸如绿豆大，朱砂为衣。";
  ex:hasPrescription "明矾1两5钱，黄蜡1两2钱，琥珀2钱，朱砂2钱，雄黄2钱，乳香1钱，蜂蜜3钱（临用）";
  ex:hasUsage "每服30丸，白滚汤送下，病重，早晚日进2次。" .

<medicine:琥珀调经丸> a ex:Medicine;
  ex:hasFunction "调经种子。主妇人无子。";
  ex:hasName "琥珀调经丸";
  ex:hasPreparation "上为细末，用醋糊为丸，如梧酮子大。";
  ex:hasPrescription "香附子1斤（半斤童便浸，半斤好醋浸，各浸7日），好艾（择去枝梗，净者）4两（加入香附子内搅匀，再加好醋5碗，入砂锅内煮干为度，日中晒干，磨为细末），没药2两，当归2两（酒洗），川芎2两，熟地黄2两（酒蒸，另杵，入糊），生地黄2两（酒浸，另杵，入糊），芍药2两（煨），琥珀1两（另研）。";
  ex:hasUsage "方中没药用量原缺，据《医学入门》补。" .

<medicine:琥珀调经散> a ex:Medicine;
  ex:hasFunction "产后浮肿。";
  ex:hasName "琥珀调经散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "琥珀5钱，白芍3两，当归3两，没药4钱，肉桂4钱，细辛4钱，甘草1钱，麝香1钱。";
  ex:hasUsage "食远服1钱5分，酒调下。" .

<medicine:琥珀还睛丸> a ex:Medicine;
  ex:hasFunction "滋阴清热，明目退翳。主阴虚大盛，内外障翳，年老气虚，目昏多眵，瞳仁反背，视物昏花。";
  ex:hasName "琥珀还睛丸";
  ex:hasPreparation "上方纳羚羊、犀角、琥珀另研兑入，余药共研为细末，过罗，炼蜜为小丸。";
  ex:hasPrescription "麦冬4两5钱，天冬4两5钱，党参（去芦）4两5钱，熟地4两5钱，知母4两5钱，黄柏4两5钱，川芎4两5钱，菊花4两5钱，山药4两5钱，枳壳（炒）4两5钱，苁蓉（炙）4两5钱，青葙子4两5钱，当归4两5钱，菟丝子4两5钱，茯苓4两5钱，枸杞子4两5钱，杜仲炭4两5钱，杏仁（去皮，炒）4两5钱，生地9两，沙苑子6两，羚羊1两5钱，黄连1两5钱，犀角9钱，石斛4两，炙甘草2两，琥珀3两。";
  ex:hasUsage "每服3钱，温开水送下，日服2次。" .

<medicine:琥珀还睛丹> a ex:Medicine;
  ex:hasFunction "滋阴补肾，清心明目。主目内障。";
  ex:hasName "琥珀还睛丹";
  ex:hasPreparation "上为细末，炼蜜为小丸。";
  ex:hasPrescription "当归4两，生地4两，川芎4两，白芍4两，菊花4两，杞子4两，蒺藜4两，故纸2两，川连2两，黄芩2两，茯苓2两，寸冬2两，琥珀2两，复盆子2两，蒙花2两，木贼2两，青葙子1两，蔓荆子1两，楮实子1两，栀子1两，黄柏1两，知母1两，青盐1两，甘草1两，胆草1两4钱。";
  ex:hasUsage "每服3钱。" .

<medicine:琥珀通淋丸> a ex:Medicine;
  ex:hasAlias "琥珀五淋丸";
  ex:hasFunction "清热通利。主小便涩痛混浊。";
  ex:hasName "琥珀通淋丸";
  ex:hasPreparation "上为细末，后加琥珀和匀，用温沸水泛为小丸，每钱约做200粒。";
  ex:hasPrescription "飞琥珀1钱，飞滑石2钱，木通1钱，西当归1钱，广木香1钱，川郁金1钱，萹蓄1钱。";
  ex:hasUsage "每服2-3钱，1日1-2次，食前开水吞服。" .

<medicine:琥珀郁金丸> a ex:Medicine;
  ex:hasFunction "水火不既济，膀胱受心火所炽而浮，囊中积热，或癃闭不通，或遗泄不禁，或白浊如泔水，或膏淋如脓，或如栀子汁，或如砂石米粒，或如粉糊相似，疼痛不已。";
  ex:hasName "琥珀郁金丸";
  ex:hasPreparation "上为末，水泛为丸，如梧桐子大。";
  ex:hasPrescription "黑牵牛（头末）2两（炒），大黄（酒浸）2两，黄连1两，黄芩2两，郁金1两，滑石4两，真琥珀2两（研），茯苓4两。";
  ex:hasUsage "每服50丸，空心熟水送下。" .

<medicine:琥珀金丝膏> a ex:Medicine;
  ex:hasFunction "退翳除昏。主一切眼疾。";
  ex:hasName "琥珀金丝膏";
  ex:hasPreparation "上用水3升，同浸一伏时，于银石器内慢火熬至1升，退火放冷，用夹绢袋作5-7次绞取药汁，滓脚不用，于不透风处放一伏时，澄下脚滓，又去之，次日再倾取清药汁，更于银器内再以慢火熬去一半，次入白沙蜜同搅，不得住手，候有蜜香，用杖子挑出药试之，放冷再挑起，有丝为度，用夹绢袋子又滤去滓，以瓷盒盛之，方入研细生脑子1字，用膏子搅令匀。";
  ex:hasPrescription "黄连（去须）2两，草龙胆1两，黄柏（去粗皮）1两，山栀子1两（以上3味1处捣碎），青竹叶300叶（大者，剪碎），乳香1分（别研），硼砂1分（别研），白沙蜜半斤。";
  ex:hasUsage "每用少许，以铜箸点之。" .

<medicine:琥珀镇心丸> a ex:Medicine;
  ex:hasFunction "神志失守，癫狂谵妄。";
  ex:hasName "琥珀镇心丸";
  ex:hasPreparation "上炼蜜为丸，如龙眼大。";
  ex:hasPrescription "琥珀5钱，龙齿（煅，研）、川连（酒炒）、朱砂、麦冬1两，天竺黄7钱，犀角、羚羊角（研）6钱，枣仁、远志、茯神5钱，石菖蒲5钱，麝香2钱，牛黄3钱，珍珠2钱，雄黄5钱，金箔40张（为衣）。";
  ex:hasUsage "方中龙齿、川连、朱砂、犀角、枣仁、远志用量原缺。" .

<medicine:琥珀镇惊丸> a ex:Medicine;
  ex:hasFunction "小儿惊风，痰涎壅塞，天吊，牙关紧闭，昏迷不醒。";
  ex:hasName "琥珀镇惊丸";
  ex:hasNote "大便泄泻，元气衰弱者禁用。";
  ex:hasPreparation "上为细末，炼蜜为丸。";
  ex:hasPrescription "胆星8钱，竺黄5钱，雄黄4钱，辰砂4钱，麝香1钱，琥珀2钱，全虫2钱，僵虫3钱，天麻2钱，梅片1钱。";
  ex:hasUsage "小儿服半丸，4-5岁服1丸，大人服2丸。" .

<medicine:琥珀镇静汤加味> a ex:Medicine;
  ex:hasFunction "活血化瘀，升清降浊，以调肝养心。主气血逆乱，瘀血止阻。";
  ex:hasName "琥珀镇静汤加味";
  ex:hasPrescription "琥珀3克（冲服），龙齿30克（先煎），天麻9克，辰砂0.3克（冲服），豆豉9克，丁香9克，藿香9克，石菖蒲9克，丹参9克，荆芥9克，姜川连3克，参三七2克（冲服）。";
  ex:hasUsage "水煎服，每日1剂，日服2次。" .

<medicine:琥珀饮> a ex:Medicine;
  ex:hasFunction "尿血。";
  ex:hasName "琥珀饮";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "琥珀。";
  ex:hasUsage "每服2钱，加灯心1握，脑荷少许，煎汤调下。" .

<medicine:琥珀黑散> a ex:Medicine;
  ex:hasFunction "横生、逆生及胎死、胞衣不下。";
  ex:hasName "琥珀黑散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "琥珀5钱，朱砂5钱，松烟墨（各另研末）5钱，人参5钱，附子（炮）5钱，百草霜5钱，姜蚕1钱（炒），乳香1钱1分，当归3钱，黑衣（即灶突上尘）5钱。";
  ex:hasUsage "每服2钱，姜酒、童便送下。" .

<medicine:琥珀黑龙丹> a ex:Medicine;
  ex:hasAlias "黑龙丹（《三因极一病证方论》卷十八）。";
  ex:hasFunction "破瘀消肿，化痰软坚。治瘿瘤不论新久，但未穿破者。";
  ex:hasName "琥珀黑龙丹";
  ex:hasPreparation "上各为细末，和匀再研，炼蜜为丸，每丸3克重，金箔为衣，晒干密收。";
  ex:hasPrescription "琥珀30克 血竭60克 京墨 五灵脂（炒）海藻 海带 南星（姜汁拌，炒）各15克 木香9克 麝香3克";
  ex:hasUsage "每用1丸，以热酒适量，量病上下，食前、食后化服。如患在下部，服后随用美膳压之。" .

<medicine:琼液散> a ex:Medicine;
  ex:hasFunction "消肿止痛。治跌打损伤。";
  ex:hasName "琼液散";
  ex:hasPrescription "闹羊花（摘去梗、蒂、芯、叶，洗去灰沙，晒干，砂锅微焙）";
  ex:hasUsage "上药研末，每服1.5克，壮者2.1克。先饮醇酒至半酣，次用酒调药服下，再饮至大醉为度。静卧勿语，语则发麻，至次日其麻方解。连服三五次，弱者隔一日再服。" .

<medicine:琼液膏> a ex:Medicine;
  ex:hasFunction "活血止痛。治跌打损伤。";
  ex:hasName "琼液膏";
  ex:hasPreparation "上药用香油500克浸七日，熬枯去滓，入白蜡、黄蜡各30克，熔化尽，用绢滤净，稍温，再入冰片1.8克，没药、乳香末各18克，搅匀。";
  ex:hasPrescription "当归尾 闹羊花 红花 白芷 蒲黄各60克";
  ex:hasUsage "摊贴患处。" .

<medicine:琼玉膏> a ex:Medicine;
  ex:hasAlias "生地黄膏（《仁斋直指》卷十七）。";
  ex:hasClinicalApplication "方一：临床主要用于治疗肺结核，肺气肿、肺纤维化、肺癌等呼吸系统及慢性消耗性疾病属肺肾阴虚者，脾气不足者。";
  ex:hasFunction "治虚劳干咳。";
  ex:hasName "琼玉膏";
  ex:hasPreparation "先将地黄汁同蜜熬沸搅匀，用密绢滤过，再将人参等研为极细末，和蜜、汁入银、瓷瓶内，用绵纸十余层加箬封扎瓶口，入砂锅或铜锅内，以长流水浸没瓶头，用桑柴火煮三昼夜，取出，换过油，再用单蜡纸扎口悬浸井中半日，以出火气，提起仍煮半日以出水气，然后收藏。";
  ex:hasPrescription "人参360克 白茯苓450克 琥珀 沉香各15克 大生地黄5千克（洗净，银石器内杵细，取自然汁。甚忌铁器）白蜜2.5千克（熬，去沫）";
  ex:hasUsage "每日清晨及午后取5～10毫升，用温酒30毫升调服，不饮酒人，用白汤调服亦可。制此药须在净室中。" .

<medicine:琼珠散> a ex:Medicine;
  ex:hasFunction "治咳嗽，哮喘。";
  ex:hasName "琼珠散";
  ex:hasNote "服药期间，忌食煎炸、油腻、酒、咸、酸等物。";
  ex:hasPrescription "桑白皮120克 五味子60克 甘草60克（炙）陈皮60克、粟壳500克（去蒂、膜，用醋浸三宿，晒干，再入醋浸，晒干）";
  ex:hasUsage "上药为末，用冷蜜汤调服。" .

<medicine:琼珠膏> a ex:Medicine;
  ex:hasFunction "治咳嗽。";
  ex:hasName "琼珠膏";
  ex:hasPreparation "上药研为极细末，炼蜜为丸，如弹子大。";
  ex:hasPrescription "粟壳90克（去盖、筋、瓤）桑皮21克 贝母24克 五味子15克 玄参21克 薄荷15克 陈皮18克 桔梗18克 甘草12克";
  ex:hasUsage "每服1丸，临睡时用白滚汤送下。" .

<medicine:琼脂膏> a ex:Medicine;
  ex:hasFunction "滋阴补血。治阴亏血虚，皮肤枯燥；消渴。";
  ex:hasName "琼脂膏";
  ex:hasPreparation "上药先以文、武火熬地黄数沸，以绢滤取净汁；又煎二十沸，下鹿角胶，次下酥油及蜜同煎；良久，候稠如饧，以瓷器收贮。";
  ex:hasPrescription "鹿角胶500克 生地黄10千克（洗净，细捣取真汁，去滓）白沙蜜1千克（煎一二沸，掠去上沫）真酥油500克 生姜60克（捣取真汁）";
  ex:hasUsage "每服10～20毫升，空腹时用温酒调下。" .

<medicine:琼花膏> a ex:Medicine;
  ex:hasFunction "祛风除湿，清热解毒。治杨梅疮并结毒，筋骨疼痛，及一切腰腿疼痛，诸毒恶疮。";
  ex:hasName "琼花膏";
  ex:hasPreparation "上药用真麻油1.5千克浸，煎如法，再用铅粉收膏，退火毒七日后可用。";
  ex:hasPrescription "闹羊花根皮45克 五加皮 归身各60克 威灵仙30克 防风 荆芥 元参 花粉各45克 甘草30克";
  ex:hasUsage "摊贴患处。" .

<medicine:琼酥膏> a ex:Medicine;
  ex:hasFunction "治痈疽、疮疡施刀前服之不痛。";
  ex:hasName "琼酥膏";
  ex:hasPreparation "上药为末。";
  ex:hasPrescription "蟾酥3克 半夏1.8克 闹羊花1.8克 胡椒5.4克 川乌5.4克 川椒5.4克 荜茇6克";
  ex:hasUsage "每服0.15克，用黄酒调服。" .

<medicine:瑞莲丸> a ex:Medicine;
  ex:hasAlias "金莲丸（《医学入门》卷七）。";
  ex:hasFunction "滋阴养心，益肾化瘀。治思虑伤心，便下赤浊。";
  ex:hasName "瑞莲丸";
  ex:hasPreparation "上为细末，炼蜜为丸，如梧桐子大，朱砂为衣。";
  ex:hasPrescription "白茯苓（去皮）石莲肉（炒，去心）龙骨（生用）天门冬（去心）麦门冬（去心）远志（洗，去心，甘草水煎）柏子仁（炒，别研）紫石英（火煅七次，研令极细）当归（去芦，酒漫）酸枣仁（炒，去壳）龙齿各3Q克 乳香15克（别研）";
  ex:hasUsage "每腹70丸，空腹时用温酒或枣汤送下。" .

<medicine:瑞金丹> a ex:Medicine;
  ex:hasFunction "化瘀止血，滋阴降火。治虚劳吐血，瘀血内结者。";
  ex:hasName "瑞金丹";
  ex:hasPreparation "上杵为细末，煮红枣肉为丸，小豆大。";
  ex:hasPrescription "川大黄（酒拌，炒黑至黄烟起为度）真秋石各30克";
  ex:hasUsage "空腹时用薄荷汤下6克。" .

<medicine:瑞金散> a ex:Medicine;
  ex:hasFunction "温经活血。治妇人血气撮痛，经前呕吐，疼痛，及月经不通。";
  ex:hasName "瑞金散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "片子姜黄120克 牡丹皮 莪茂 红花 当归 赤芍药 川芎 桂心 延胡索各45克";
  ex:hasUsage "每服6克，用水150毫升，酒25毫升，煎至120毫升，温服，一日三次。" .

<medicine:瓜丁散> a ex:Medicine;
  ex:hasFunction "黄疸，目黄不除。";
  ex:hasName "瓜丁散";
  ex:hasPrescription "瓜丁（细末）如1大豆许。";
  ex:hasUsage "纳鼻中，令病人深吸取入。鼻中黄汁出，愈。" .

<medicine:瓜子仁汁> a ex:Medicine;
  ex:hasFunction "肠痈。壮热恶寒，微汗气急，少腹痛，小便涩，或大便如刀锥刺痛，或腹中已成脓。";
  ex:hasName "瓜子仁汁";
  ex:hasPrescription "瓜子仁3合（与水6合同研，绞取汁），当归（切，焙）1两（捣末），蛇蜕1条（烧灰，研）。";
  ex:hasUsage "上将当归、蛇蜕研末和匀，分作2服，空心、日午用瓜子汁调下。下脓血即愈。" .

<medicine:瓜子散> a ex:Medicine;
  ex:hasAlias "甜瓜子散";
  ex:hasFunction "头发早白，虚劳，脑髓空竭，胃气不和，诸脏虚绝，血气不足，故令人发早白，少而算发及忧愁早白。远视（目巟）（目巟），风泪出，手足烦热，恍惚忘误，连年下痢。";
  ex:hasName "瓜子散";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "瓜子1升，白芷（去皮）2两，当归2两，芎藭2两，甘草（炙）2两（一方有松子2两）。";
  ex:hasUsage "甜瓜子散（《圣惠》卷四十一）。" .

<medicine:瓜子眼药> a ex:Medicine;
  ex:hasFunction "明目退翳，消肿止痒。主风火目疾，老眼昏花，暴发火眼，红肿赤烂。";
  ex:hasName "瓜子眼药";
  ex:hasPreparation "上为极细末，过箩，炼老蜜和匀，制成瓜子型锭剂，重1分。";
  ex:hasPrescription "炉甘石（煅）17两，梅片4钱3分，硼砂4钱，牛黄2分，琥珀8钱，珍珠（豆腐炙）2分，熊胆1钱，麝香2分，黄连2两（熬汁浸炉甘石）。";
  ex:hasUsage "用药沾凉开水少许，点于大眼角内，每日4-5次。" .

<medicine:瓜桂散> a ex:Medicine;
  ex:hasFunction "水气。";
  ex:hasName "瓜桂散";
  ex:hasPreparation "上用着中冬瓜1枚，去瓤，以肉桂10两锉入冬瓜中，盖口湿纸裹数重，撅地坑，簇以炭火煅令存性为末。";
  ex:hasPrescription "冬瓜1枚，肉桂10两。";
  ex:hasUsage "每服2钱，米饮调下，日2次。" .

<medicine:瓜消拔毒丹> a ex:Medicine;
  ex:hasFunction "痈疡初破。";
  ex:hasName "瓜消拔毒丹";
  ex:hasPreparation "上为末收贮。";
  ex:hasPrescription "西瓜硝1两，雄黄6钱，石膏（煅）6钱，地榆（炒）5钱，蓬砂5钱，藜芦（炒）5钱，乌梅肉（炒炭）5钱，僵蚕（炒）2钱，冰片1钱，牛黄1钱。";
  ex:hasUsage "凡外疡初破，毒未化者，四围以围药围之，将此药用麻油调涂疮孔，外以提脓化毒膏贴之，早晚1换。" .

<medicine:瓜皮散> a ex:Medicine;
  ex:hasFunction "多年恶疮，伤损腰痛。";
  ex:hasName "瓜皮散";
  ex:hasPreparation "上为未。";
  ex:hasPrescription "冬瓜皮（焙）。";
  ex:hasUsage "掺之；又治伤损腰痛，每服1钱，温酒调下。" .

<medicine:瓜皮煎> a ex:Medicine;
  ex:hasFunction "因伤热而泻。";
  ex:hasName "瓜皮煎";
  ex:hasPrescription "西瓜青皮1两，绿豆青皮1两，肉蔻3钱（炒去油）。" .

<medicine:瓜皮赤豆汤> a ex:Medicine;
  ex:hasFunction "利水，消肿。适用于小儿急性肾炎所致的小便不利、全身水肿。";
  ex:hasName "瓜皮赤豆汤";
  ex:hasPreparation "先把赤小豆放入砂锅内，加入温水适量，浸泡1～2小时；再把冬瓜皮、西瓜皮、白茅根、玉米须一同放入泡赤小豆的砂锅内再加些冷水，煎沸后改用小火再煎半小时即可。";
  ex:hasPrescription "冬瓜皮 西瓜皮 白茅根各20克 玉米须15克 赤小豆200克";
  ex:hasUsage "以上为1日量，煎成后去渣，分作3次，温热饮用，直至水肿消退。" .

<medicine:瓜盐煎> a ex:Medicine;
  ex:hasFunction "霍吐泄泻。其证始因饮冷或冒寒暑，或失饥，或大怒，或弃舟车，伤动胃气，令人上吐不止，因而下泄，吐泻并作，遂成霍乱，头旋眼晕，手足转筋，四肢逆冷。";
  ex:hasName "瓜盐煎";
  ex:hasPrescription "吴茱萸5钱，木瓜5钱，食盐5钱。";
  ex:hasUsage "上炒焦，用瓷罐盛水3升，煮令100沸，却入前药，同煎至1-2升以下，倾1盏，随病人意，冷热服之。药入即醒。" .

<medicine:瓜石汤> a ex:Medicine;
  ex:hasAlias "栝石汤";
  ex:hasFunction "滋阴清热，宽胸和胃，活血通经。主阴虚胃热所引起的月经稀发后错或血涸经闭。";
  ex:hasName "瓜石汤";
  ex:hasPrescription "瓜蒌5钱，石斛4钱，玄参3钱，麦冬3钱，生地4钱，瞿麦4钱，车前子3钱，益母草4钱，马尾连2钱，牛膝4钱。";
  ex:hasUsage "栝石汤（《金鉴》卷七十五）。" .

<medicine:瓜矾散> a ex:Medicine;
  ex:hasAlias "瓜蒂甘遂丸";
  ex:hasFunction "鼻痔。";
  ex:hasName "瓜矾散";
  ex:hasPreparation "上为末，用真麻油调令软硬得所，旋丸如鼻孔大。";
  ex:hasPrescription "瓜蒂4钱，甘遂1钱，白矾（枯）5分，螺壳（煅）5分，草乌尖5分。";
  ex:hasUsage "瓜蒂甘遂丸（《明医指掌》卷八）。" .

<medicine:瓜砂丹> a ex:Medicine;
  ex:hasFunction "男子、妇人诸虚不足，心气不宁，梦寐不安，手足疼痛，腰膝拘挛，步履艰难；妇人脚气冲心，呕吐药食，不能下咽。";
  ex:hasName "瓜砂丹";
  ex:hasPreparation "以木瓜10数个，每木瓜开盖去瓤，底下根铺药末少许，中以绢片裹朱砂1两，蜜拌湿，坐于其间，仍盖药末令满，仍以木瓜盖子盖定，篾签签定，纱片裹木瓜全个不令散失，如此者20-30个。看其银合大小，坐于其中，上下仍铺药末封盖定，坐于银锅银甑中，勿用铁器，以桑柴烧文武火蒸7昼夜，再换木瓜末1次，又蒸7昼夜乃止，取出朱砂1味，摊干研细，以薏苡粉煮稀糊为丸，如梧桐子大。";
  ex:hasPrescription "朱砂4两。";
  ex:hasUsage "治疗上证，原书于本方下尚有煮药方：黄耆（炙）当归远志（去心）柏子仁川乌（炮）木香茯神（去木）益智仁人参乳香龙齿五味子石斛川椒熟地黄麦门冬白芍药仙灵脾各一两鹿茸（炙）酸枣仁（炒）附子（炮，去皮）钟乳粉各二两" .

<medicine:瓜萎散> a ex:Medicine;
  ex:hasFunction "治肝气燥急而胁痛，或发水疱。";
  ex:hasName "瓜萎散";
  ex:hasPreparation "上药研为细末，作一服。";
  ex:hasPrescription "大瓜萎（连皮捣烂）1枚 粉甘草6克 红花2.1克";
  ex:hasUsage "水煎服。" .

<medicine:瓜蒂三味散> a ex:Medicine;
  ex:hasFunction "急黄，已进秦艽牛乳2味汤药，服后不觉病退，渐加困笃，势如天行最重者。";
  ex:hasName "瓜蒂三味散";
  ex:hasNote "不可更服诸冷物。";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "瓜蒂7枚，丁香7枚，赤小豆7枚。";
  ex:hasUsage "取如大豆，分吹两鼻孔中。须臾当出黄水，正如煮黄柏汁，及出黄虫。亦可以新汲水和1方寸匕，与患人服，或利或叱吐利所出亦如煮黄柏汁。" .

<medicine:瓜蒂丸> a ex:Medicine;
  ex:hasFunction "小儿疳。";
  ex:hasName "瓜蒂丸";
  ex:hasPreparation "上为末，用粟米饭为丸，如麻子大。";
  ex:hasPrescription "瓜蒂（烧灰）半两，麝香（研）半两，蟾酥半两，乌蛇尾（酒浸，炙）1分，黄连（去须）1分，蛇蜕（烧灰）半分，熊胆半分（研）。";
  ex:hasUsage "温熟水化破2丸，滴于鼻中。虫出为效。" .

<medicine:瓜蒂二陈汤> a ex:Medicine;
  ex:hasFunction "涌吐痰涎。主痰症类伤寒。寒痰在胸中，胸满气冲，憎寒壮热，恶风自汗，胸中郁痛，饥不能食，使人揉按之，反多涎唾，甚或下利日十余行，右脉微滑，左脉反迟。";
  ex:hasName "瓜蒂二陈汤";
  ex:hasPrescription "甜瓜蒂20粒，姜半夏钱半，广橘红钱半。";
  ex:hasUsage "以水煎成，冲生莱菔汁2瓢。" .

<medicine:瓜蒂吹鼻散> a ex:Medicine;
  ex:hasFunction "黄疸。面目爪甲皆黄，心膈躁闷。";
  ex:hasName "瓜蒂吹鼻散";
  ex:hasPreparation "上为细散。";
  ex:hasPrescription "瓜蒂2-7枚，赤小豆2-7粒，秫米2-7粒，丁香2-7粒。";
  ex:hasUsage "取如豆大纳鼻中，痛搐之。须臾当出黄汁，或从口中出升余即愈。若病重者，如1豆不愈，即复纳鼻中，即效。" .

<medicine:瓜蒂散> a ex:Medicine;
  ex:hasAlias "瓜豆散";
  ex:hasClinicalApplication "临床主要用于治疗酒瘾综合征、头痛、癫狂等病症。";
  ex:hasFunction "风涎暴作，气塞倒卧，或有涎，用诸药化不下者。";
  ex:hasName "瓜蒂散";
  ex:hasNote "诸亡血虚家，老人，产妇，血虚脉微者，俱不可服。";
  ex:hasPreparation "上甜瓜蒂，日干为细末。";
  ex:hasPrescription "甜瓜蒂、轻粉。";
  ex:hasUsage "每用1-2钱匕，加轻粉1匕，以水半合，调匀灌之。候良久涎自出；如涎未出，含砂糖1块，下咽，涎即出。如吐多困，即咽麝香汤1盏即止。" .

<medicine:瓜蒂汤> a ex:Medicine;
  ex:hasFunction "诸黄,身面四肢浮肿，有虫，鼻中息肉，阴黄、黄疸及暴急黄。";
  ex:hasName "瓜蒂汤";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "瓜蒂1两，赤小豆49枚，丁香2-7枚。";
  ex:hasUsage "以水1升，煮取4合，澄清，分为两度，滴入两鼻中。" .

<medicine:瓜蒂牙消散> a ex:Medicine;
  ex:hasFunction "伤寒头痛不止。";
  ex:hasName "瓜蒂牙消散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "藜芦1钱，瓜蒂3钱，牙消2钱，脑、麝各少许。";
  ex:hasUsage "吹少许入鼻。得嚏则愈。" .

<medicine:瓜蒂神妙散> a ex:Medicine;
  ex:hasFunction "头目昏眩，偏正头痛。";
  ex:hasName "瓜蒂神妙散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "瓜蒂1分，焰消1分，雄黄1分，川芎1分，薄荷叶1分，道人头1分，藜芦1分，天竺黄1钱半（如无，以郁金代之）。";
  ex:hasUsage "方中瓜蒂原缺，据《奇效良方》补。" .

<medicine:瓜蒌丸> a ex:Medicine;
  ex:hasAlias "栝楼丸";
  ex:hasFunction "积年哮喘，偶触清寒即发。此有寒痰宿积于肺而胃气方实盛，故和缓则相安，更遇外寒触之，则阳气郁而忿争，积寒并发，气促而喘矣，此病小儿多有之者，不时喘咳，身有微热。";
  ex:hasName "瓜蒌丸";
  ex:hasPreparation "上为末，捣瓜蒌为丸。";
  ex:hasPrescription "瓜蒌1枚（用面包裹煨熟，去面用），百部4两，麻黄2两，黄芩1两，杏仁1两。";
  ex:hasUsage "清晨服。" .

<medicine:瓜蒌仁汤> a ex:Medicine;
  ex:hasFunction "七情气郁成痰，气噎痞痛，喘闷。";
  ex:hasName "瓜蒌仁汤";
  ex:hasPreparation "上为末，以姜汁糊为丸。";
  ex:hasPrescription "桔梗2两，枳壳1两，瓜蒌仁4两（另研），半夏5钱。";
  ex:hasUsage "每服50-70丸，用蜜糖汤送下，日3次。" .

<medicine:瓜蒌内托散> a ex:Medicine;
  ex:hasFunction "活血消毒。主痈发于腿外侧者。";
  ex:hasName "瓜蒌内托散";
  ex:hasPrescription "瓜蒌1个（半生半炒），人参5钱，归尾5钱，没药5钱，甘草1钱。";
  ex:hasUsage "黄酒2碗，煎1碗，食前服。" .

<medicine:瓜蒌半夏丸> a ex:Medicine;
  ex:hasFunction "咳嗽，喘满。";
  ex:hasName "瓜蒌半夏丸";
  ex:hasNote "忌生冷咸酸。";
  ex:hasPreparation "上为末，用瓜蒌汁、生姜自然汁，用水糊为丸，如梧桐子大。";
  ex:hasPrescription "瓜蒌1两，杏仁（去皮尖）1两，枯矾1两，半夏（汤泡）2两，款冬花1两半，麻黄（去根节）1两。";
  ex:hasUsage "每服30丸，食后、临卧淡茶汤下。" .

<medicine:瓜蒌大麦饼> a ex:Medicine;
  ex:hasFunction "中风斜。";
  ex:hasName "瓜蒌大麦饼";
  ex:hasPreparation "合作饼。";
  ex:hasPrescription "瓜蒌1斤（绞汁），大麦面6两。";
  ex:hasUsage "炙熟熨之。病愈即止，勿令太过。" .

<medicine:瓜蒌子散> a ex:Medicine;
  ex:hasFunction "瘰疬初肿，疼痛寒热，四肢不宁。";
  ex:hasName "瓜蒌子散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "瓜蒌子（微炒）1两，连翘1两，何首乌1两，皂荚子仁（微炒）1两，牛蒡子（微炒）1两，大黄（微炒）1两，白螺壳1两，栀子仁1两，漏芦1两，牵牛（微炒）1两，甘草（生）1两。";
  ex:hasUsage "每服2钱匕，食后温酒调下。" .

<medicine:瓜蒌实丸> a ex:Medicine;
  ex:hasFunction "噎膈。胸痞，胸中痛彻背，喘急妨闷。";
  ex:hasName "瓜蒌实丸";
  ex:hasPreparation "上为细末，姜汁打糊为丸，如梧桐子大。";
  ex:hasPrescription "瓜蒌实（别研）1两，枳壳（去瓤，麸炒）1两，半夏（汤泡7次）1两，桔梗（炒）1两。";
  ex:hasUsage "每服50丸，食后用淡姜汤送下。" .

<medicine:瓜蒌必效散> a ex:Medicine;
  ex:hasFunction "乳痈。初起肿痛发于肌表，肉色焮赤，其人表热或憎寒壮热，头痛烦渴。";
  ex:hasName "瓜蒌必效散";
  ex:hasPrescription "瓜蒌1个（捣烂），金银花5钱，当归5钱，生甘草5钱，乳香（去油）1钱，没药（去油）1钱（一方有白芷、青皮各1钱）。";
  ex:hasUsage "水煎服。" .

<medicine:瓜蒌托里散> a ex:Medicine;
  ex:hasFunction "疮疡未成易消，已成易溃，既溃则生肌。主疮疡毒盛，打扑损伤。";
  ex:hasName "瓜蒌托里散";
