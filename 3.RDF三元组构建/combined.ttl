  ex:hasUsage "水煎服，每日1剂，日服2次。" .

<medicine:麻根散> a ex:Medicine;
  ex:hasFunction "卒淋，小便不通，疼痛烦闷，坐卧不得。";
  ex:hasName "麻根散";
  ex:hasPreparation "上为粗散。";
  ex:hasPrescription "麻根1两，大麻子1两，子芩1两，乱发灰半两。";
  ex:hasUsage "本方方名，《普济方》引作“麻根汤”。" .

<medicine:麻根汁酒> a ex:Medicine;
  ex:hasFunction "打扑损疼痛。";
  ex:hasName "麻根汁酒";
  ex:hasPreparation "上锉细，捣绞取汁。";
  ex:hasPrescription "大麻根及叶（生者，去土）3斤。";
  ex:hasUsage "每服半盏，和温酒半盏服，不拘时候。无生麻根即用干者，酒煎服。" .

<medicine:麻根汤> a ex:Medicine;
  ex:hasFunction "血淋；热淋，小便赤涩。";
  ex:hasName "麻根汤";
  ex:hasPrescription "麻根10枚。";
  ex:hasUsage "上捣碎，以水2大盏，煎取1大盏，去滓，分2次服，如人行10里再服。" .

<medicine:麻根饮> a ex:Medicine;
  ex:hasFunction "金疮中风，骨痛不可忍，及堕坠打损，有瘀血在心腹，令人胀满短气者。";
  ex:hasName "麻根饮";
  ex:hasPrescription "大麻根叶无问多少。";
  ex:hasUsage "上捣研绞取汁，饮3-4合。无青者，以干者煎取汁服。" .

<medicine:麻桂二陈汤> a ex:Medicine;
  ex:hasFunction "外冒风寒，痰嗽寒热，头痛身疼，鼻塞声重。";
  ex:hasName "麻桂二陈汤";
  ex:hasPrescription "陈皮1钱半，半夏2钱，茯苓2钱，甘草1钱，桔梗1钱半，枳壳1钱，苍术1钱半，厚朴（姜炒）1钱，麻黄5-7分，桂枝1钱，白芷1钱，川芎1钱，黄芩1钱，防风1钱。";
  ex:hasUsage "上加生姜5分，水煎，热服。" .

<medicine:麻桂各半汤> a ex:Medicine;
  ex:hasFunction "皮肤瘙痒症。";
  ex:hasName "麻桂各半汤";
  ex:hasPrescription "桂枝6g，麻黄3g，赤芍9g，杏仁6g，生甘草4g，大枣6g。";
  ex:hasUsage "水煎服。" .

<medicine:麻桂术甘汤> a ex:Medicine;
  ex:hasFunction "寒湿腹胀，身重身冷无汗。";
  ex:hasName "麻桂术甘汤";
  ex:hasPrescription "麻黄、桂枝、白术、甘草。" .

<medicine:麻桂温经汤> a ex:Medicine;
  ex:hasFunction "治损伤后复感寒邪，周身关节疼痛。";
  ex:hasName "麻桂温经汤";
  ex:hasPrescription "麻黄 桂枝 红花 白芷 细辛 桃仁 赤芍 甘草";
  ex:hasUsage "水煎服。" .

<medicine:麻桂饮> a ex:Medicine;
  ex:hasFunction "治伤寒温疫，阴暑疟疾，阴寒气胜而邪不能散者。";
  ex:hasName "麻桂饮";
  ex:hasPrescription "官桂3～6克 当归9～12克 炙甘草3克 陈皮（随宜用，或不用亦可）麻黄6～9克";
  ex:hasUsage "用水300毫升，加生姜5～7片；煎至240毫升，去浮沫，不拘时服。服药后，不必厚盖，但取津津微汗透彻为度。" .

<medicine:麻油膏> a ex:Medicine;
  ex:hasAlias "乌麻油膏";
  ex:hasFunction "20-30年风赤、胎赤眼。";
  ex:hasName "麻油膏";
  ex:hasPreparation "穿地作一坑子，其形如瓶口，外小里大，先以火烧令干，于别处开一小风孔；以上药一重重布着坑中，状如灸炷，用火烧之；却将前所磨铜器盖坑口，候烟尽，即取铜器，刮取烟脂，为极细末，纳瓷合中盛。";
  ex:hasPrescription "生乌麻油半鸡子许（着铜器内，以细砺石磨之，使浓不能流乃止），熟艾2升，杏仁1升，黄连1两，鸡粪1升，盐1合，乱发如半碗许大。";
  ex:hasUsage "乌麻油膏（《圣济总录》卷一○二）。" .

<medicine:麻油酒> a ex:Medicine;
  ex:hasFunction "痈疽疔疖一切大毒。";
  ex:hasName "麻油酒";
  ex:hasNote "凡大便秘结而毒蓄于内者最宜用之，如阴疽及大便不实者都非所宜。";
  ex:hasPrescription "真芝麻油1斤。";
  ex:hasUsage "麻油截法（《外证治全书》）、麻油饮（《验方新编》卷十一）。" .

<medicine:麻煎丸> a ex:Medicine;
  ex:hasFunction "骨并鱼刺，梗在喉中。";
  ex:hasName "麻煎丸";
  ex:hasPreparation "蓖麻子仁研烂，入百药煎，成剂即止，为丸如弹子大，青黛为衣，";
  ex:hasPrescription "蓖麻子仁、百药煎。";
  ex:hasUsage "井花水磨下半丸，咽之即下。" .

<medicine:麻甘豆腐汤> a ex:Medicine;
  ex:hasClinicalApplication "袁某，女，8岁。患儿在三岁时出现气急，喉间痰鸣，至县人民医院检查，诊断为支气管哮喘。给西药治疗，症状可控制，但不久又复发，经久不愈。邀余诊治，当即给麻甘豆腐汤2剂，喘平咳止，再予2剂，诸症悉除，随访已多年未复发。";
  ex:hasFunction "清热化痰，止咳平喘。主痰热阻肺，肺失宣降，小儿哮喘。";
  ex:hasName "麻甘豆腐汤";
  ex:hasPrescription "生麻黄2g，生甘草2g（打碎），法半夏6g（打碎），杏仁6g（打碎），豆腐1小块。";
  ex:hasUsage "将豆腐放在碗内，加水至豆腐平面为止，不要超过豆腐平面，然后将麻黄插入豆腐内，余药放在豆腐面上；再将碗隔水蒸半小时，取出，将药去掉，将碗内水取出，日3次分服（豆腐亦可和入少量酱油调味，拌调后食用）。" .

<medicine:麻疹鸽蛋大米粥> a ex:Medicine;
  ex:hasFunction "预防麻疹。";
  ex:hasName "麻疹鸽蛋大米粥";
  ex:hasPreparation "先将粳米煮粥，将熟时，入鸽蛋，调匀，煮成稀粥。";
  ex:hasPrescription "鸽蛋2枚 粳米50克";
  ex:hasUsage "空腹服，每日2次，连服5天。" .

<medicine:麻痘风搐方> a ex:Medicine;
  ex:hasFunction "痘疮欲出，身热烦躁，忽发惊搐。";
  ex:hasName "麻痘风搐方";
  ex:hasPrescription "人参、羌活、防风、僵蚕（醋炒）、南星（姜制）、白附子（姜制）、甘草（炙）各等分。";
  ex:hasUsage "上加生姜3片，水煎服。其搐立止。" .

<medicine:麻石加味汤> a ex:Medicine;
  ex:hasFunction "清热解表，化痰定喘。主小儿细菌性肺炎，高热喘促，咳嗽痰鸣，躁烦不安。";
  ex:hasName "麻石加味汤";
  ex:hasPrescription "麻黄1g，生石膏9g（先煎），杏仁4.5g，甘草1.5g，牛蒡子6g，炙化橘红6g，川贝母3g（以上为3岁小儿用量）。" .

<medicine:麻石抒阳汤> a ex:Medicine;
  ex:hasFunction "春温。";
  ex:hasName "麻石抒阳汤";
  ex:hasPrescription "柴胡2钱，石膏2钱，白芍5钱，麻黄3分，陈皮3分，半夏1钱，茯苓3钱。";
  ex:hasUsage "水煎服。" .

<medicine:麻药> a ex:Medicine;
  ex:hasAlias "麻肺丹、麻沸散";
  ex:hasFunction "麻醉。主";
  ex:hasName "麻药";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "川乌、草乌、淮乌各等分。";
  ex:hasUsage "瓷瓶收用。" .

<medicine:麻药散> a ex:Medicine;
  ex:hasFunction "敷疮毒上麻木，刀针不痛。主";
  ex:hasName "麻药散";
  ex:hasNote "有切忌开刀者，断不可妄动。";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "川乌尖5钱，草乌尖5钱，生南星5钱，生半夏5钱，胡椒1两，蟾酥4钱。";
  ex:hasUsage "烧酒调敷疮症中。" .

<medicine:麻菊二陈汤> a ex:Medicine;
  ex:hasFunction "熄风化痰。治痰晕。风痰上扰，头昏目眩，见物飞动，猝然晕倒者。";
  ex:hasName "麻菊二陈汤";
  ex:hasPrescription "明天麻3克 滁菊花4.5克 钩藤钩 茯神木各12克 荆芥4.5克 川芎2.4克 姜半夏9克 广红皮3克 清炙草1.2克";
  ex:hasUsage "水煎服。" .

<medicine:麻虫膏> a ex:Medicine;
  ex:hasFunction "疔疮。";
  ex:hasName "麻虫膏";
  ex:hasPreparation "用好江茶和作饼子，如钱眼大。";
  ex:hasPrescription "麻虫1条（捣烂）。";
  ex:hasUsage "以羊角骨针挑疮头，按药在上。醋糊纸贴之，膏药亦可。其毒出为效。" .

<medicine:麻豆散> a ex:Medicine;
  ex:hasAlias "麻豆汤";
  ex:hasFunction "脾胃气弱，水谷不得下，遂成不复受食。";
  ex:hasName "麻豆散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "大麻子3升，大豆（炒黄香）。";
  ex:hasUsage "麻豆汤（《鸡峰》卷十二）。本方方名，《普济方》引作“麻仁散”。" .

<medicine:麻豆汤> a ex:Medicine;
  ex:hasFunction "遍身肿，小便涩者。";
  ex:hasName "麻豆汤";
  ex:hasPrescription "大麻2升（熬研），乌豆1斗（以水4斗，煮取汁1斗半，去豆），桑白皮（切）5升。";
  ex:hasUsage "上以豆汁纳药，煮取6升，每服1升，每日2次，3日令尽。" .

<medicine:麻豆煎> a ex:Medicine;
  ex:hasFunction "大腹水肿。";
  ex:hasName "麻豆煎";
  ex:hasNote "陈郁麻子，益增其病，慎勿用之。一切水肿，皆忌饱食，常须少饥。";
  ex:hasPreparation "上取新精者，仍净拣择，以水掏，晒令干；蒸麻子使熟，晒令干，贮净器中。";
  ex:hasPrescription "大麻1石（末，入窖不郁（火邑）者），赤小豆1石（不得1粒杂）。";
  ex:hasUsage "欲服，取5升麻子，熬之令黄香，惟须缓火，勿令焦，为细末；以水5升，研取汁，令尽，净器密贮之。明旦欲服，今夜以小豆1升，净淘渍之，至晓干，漉去水，以新水煮，未及好熟，即漉出令干，纳麻子汁中煮，令大烂熟为佳，空腹恣意食之，每日3次。" .

<medicine:麻豆膏> a ex:Medicine;
  ex:hasFunction "诸癣。";
  ex:hasName "麻豆膏";
  ex:hasPreparation "以麻油熬煎三味枯黑，去滓，却入白蜡五钱，芦荟末三钱，搅匀，瓷罐收贮。";
  ex:hasPrescription "麻油2两，巴豆14粒，蓖麻子14粒，斑蝥7粒。";
  ex:hasUsage "括破涂之。" .

<medicine:麻附五皮饮> a ex:Medicine;
  ex:hasFunction "温下发汗。主一身尽肿。";
  ex:hasName "麻附五皮饮";
  ex:hasPrescription "麻黄1钱，淡附片8分，浙苓皮3钱，大腹皮2钱，细辛5分，新会皮1钱半，五加皮3钱，生姜皮1钱。" .

<medicine:麻附细辛汤> a ex:Medicine;
  ex:hasFunction "少阴伤寒，身发热，四肢冷，指甲青，腹痛脉沉。";
  ex:hasName "麻附细辛汤";
  ex:hasPrescription "麻黄2钱，附子3钱，细辛1钱5分，甘草5分，人参2钱，黄连1钱，芍药1钱5分。" .

<medicine:麻雀粥> a ex:Medicine;
  ex:hasFunction "壮阳暖肾益精。主中老年太阳虚羸弱，阳痿，肾虚多尿，腰酸怕冷等证。";
  ex:hasName "麻雀粥";
  ex:hasPrescription "雀儿5只（如常治），粟米1合，葱白3茎。";
  ex:hasUsage "先炒雀熟，入酒1合，煮少时，入水2盏半，下葱，米，作粥食。" .

<medicine:麻风丸> a ex:Medicine;
  ex:hasFunction "大麻风。";
  ex:hasName "麻风丸";
  ex:hasNote "若一见风，必成瘫痪，最宜谨防。";
  ex:hasPreparation "上再用苦参八两，好酒打糊为丸。";
  ex:hasPrescription "鲜皂角刺2斤（好醋煮9日，晒干，取净末1斤，），番木鳖（羊油炙，得法如金色者，净末）8两，苦参（取净末）2两，紫背浮萍（晒干，取净末）1斤。";
  ex:hasUsage "空心服，每日3次。先用葱头、生姜各2斤捣烂，用麻油熬熟，将新松布包作6-7包。先将番木鳖刮去皮毛，为末，壮盛者服2分，老弱者服1分；随每人持药1包，在病人身上，周身擦过，用青布衫裤袜穿好，绵被盖紧，睡处不可透风，或生炭火，待大汗后渐渐揭下，乃起近前向火；然后服前药，自能痊可，如身若炭一般而作痒者，将石菖蒲打碎，煎汤，四周围住，不可漏风，连浴数次，黑皮脱去，平复如故。" .

<medicine:麻风膏> a ex:Medicine;
  ex:hasFunction "面上或身上风热浮肿，痒如虫行，肌肤干燥，时起白屑，时发极痒，抓破时硫黄水，或破烂见血，痛楚难堪。";
  ex:hasName "麻风膏";
  ex:hasPreparation "用香油五两，将各药浸泡五日，慢火熬枯，去药；用细布沥净渣，加黄蜡五钱，再熬数滚启起，冷透火毒。";
  ex:hasPrescription "麻黄5钱，羌活2两，升麻2钱，白檀香1钱，白及1钱，防风1钱，归身1钱。";
  ex:hasUsage "抹擦。" .

<medicine:麻风药酒> a ex:Medicine;
  ex:hasFunction "大麻风。";
  ex:hasName "麻风药酒";
  ex:hasPreparation "上用药袋盛，浸酒内，封坛口，煮香尽二支取起，水内浸一伏。";
  ex:hasPrescription "防风2两，当归2两，虎骨2两，秦艽2两，羌活2两，苦参2两，牛膝2两，僵蚕2两，松节2两，鳖甲2两，苍术2两，枸杞子2两，白茅根2两，蓖麻子仁1两，好雪酒25斤。";
  ex:hasUsage "取服数杯自效。" .

<medicine:麻风锭子> a ex:Medicine;
  ex:hasFunction "大风疠疾，眉发脱落，遍身顽麻。";
  ex:hasName "麻风锭子";
  ex:hasNote "忌盐一百日。";
  ex:hasPrescription "苍耳草（5月5日或6月6日5更带露采）。";
  ex:hasUsage "上捣取汁，熬作锭子，取半斤鲤鱼1尾，剖开（不去肚肠），入药1锭，线缝。以酒2碗，慢火煮熟，令吃。不过3-5个即愈。" .

<medicine:麻鸡丸> a ex:Medicine;
  ex:hasFunction "一切疳积，骨蒸劳热，面黄瘦削，腹内腐块等。";
  ex:hasName "麻鸡丸";
  ex:hasPreparation "用大麻子和饭饲乌鸡，经1-2个月。如用，去毛粪，以乌豆1-2升同蒸烂，去骨捣烂为丸。";
  ex:hasPrescription "大麻子（炒过）、乌鸡1只。";
  ex:hasUsage "疳用随意汤使，空心吞下。" .

<medicine:麻黄一剂饮> a ex:Medicine;
  ex:hasFunction "透发霉毒。主遍体霉疮初起，节骱酸楚。";
  ex:hasName "麻黄一剂饮";
  ex:hasPrescription "麻黄1钱，防风1钱，银花3钱，白鲜皮3钱，当归1只（切），胡麻3钱，甘草1钱，羌活1钱，秦艽1钱。";
  ex:hasUsage "用肥羊肉1斤，河水3大碗，煎至1大碗，取汁，吹去面上浮油，将前药煎至一饭碗，温服，以羊肉淡食过口。仰面睡于帐前，不可见风，取汗为度。" .

<medicine:麻黄丸> a ex:Medicine;
  ex:hasFunction "逐水。主少小胸中痰实嗽，及伤寒水气。";
  ex:hasName "麻黄丸";
  ex:hasPreparation "上为末，炼蜜为丸，如小豆大。";
  ex:hasPrescription "麻黄3分，茯苓3分，紫菀4分，五味子2分，杏仁（去皮尖）2分，细辛2分，桂心2分，干姜2分。";
  ex:hasUsage "3-4岁儿每服2-3丸，不知稍增之。" .

<medicine:麻黄二桂枝一小青龙一汤>
  a ex:Medicine;
  ex:hasFunction "寒疟。";
  ex:hasName "麻黄二桂枝一小青龙一汤";
  ex:hasPrescription "麻黄（去节）5钱，杏仁（润去皮，同白火石、乌豆煮之，从已至午，捣烂）27粒，桂枝（去皮）3钱，甘草（去头尾，酒润，炎黄色）3钱，芍药（去粗皮，蜜水蒸，晒3次）3钱，生姜（切）3钱，细辛（北地者，瓜水浸1宿，晒干）3钱7分，半夏小半合（用酽醋搅白芥子末，投半夏，洗令涎尽，再以水漂），五味子（取北地肥大者，以铜刀分作两片，用蜜浸蒸，从已至申，更以浆水浸1宿，焙干）49粒，干姜3钱。";
  ex:hasUsage "上以水3升，先煮麻黄数沸，去沫，纳诸药，煮取1升，去滓，分2次温服。未发1服，温服取微似汗，得汗停后服。" .

<medicine:麻黄二陈汤> a ex:Medicine;
  ex:hasFunction "夹痰伤寒。感寒邪而生痰，毛窍外闭，肺气逆满，邪气无从发泄，咳喘痰多，证情较重者。";
