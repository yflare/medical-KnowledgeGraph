  ex:hasPrescription "光明砂半两，恒山1两，杏仁10个。";
  ex:hasUsage "每服15丸，未发前用粥饮送下，欲发再服。" .

<medicine:光明丹> a ex:Medicine;
  ex:hasAlias "光明散";
  ex:hasFunction "远近红白翳障，迎风流泪，睫毛倒入，蟹珠凸出，视物昏花。";
  ex:hasName "光明丹";
  ex:hasPreparation "上为细末，听用。";
  ex:hasPrescription "浮水甘石（煅，研，用川连、川柏、条芩、木鳖子等分煎浓汁去滓，入甘石晒干，取净粉）3钱，老港濓珠1钱，煅石蟹1钱，煅石燕1钱，海螵蛸2钱，镜面朱砂3分，头梅3分。";
  ex:hasUsage "方中珍珠、玛瑙、雄黄、麝香、冰片用量原缺。" .

<medicine:光明夜灵散> a ex:Medicine;
  ex:hasFunction "目至夜便昏，虽有灯月，亦不能视。";
  ex:hasName "光明夜灵散";
  ex:hasPreparation "上药和匀，以竹刀切肝作2片，以药铺1片，以1片合之，用皮纸包住，又用麻皮缠定，勿令药出，淘米泔水1大碗贮瓷罐内，不犯铁器，入肝药于中煮至小半碗。";
  ex:hasPrescription "石决明（煅复煮）2钱，夜明砂（另研）2钱，猪肝1两（生用，如不食猪，以白羯羊肝代之亦可）。";
  ex:hasUsage "临卧连肝药并汁脂尽。" .

<medicine:光明拔云锭子> a ex:Medicine;
  ex:hasFunction "远年近日一切眼疾。";
  ex:hasName "光明拔云锭子";
  ex:hasPreparation "上为细末，以黄连膏子和剂捻成锭子。";
  ex:hasPrescription "炉甘石末（1斤煅过，用黄连半斤，水2碗煎5-7沸，淬7次止，取净末）2两，硼砂1两，片脑1钱，海螵蛸2钱，麝香2分，珍珠1钱，血竭3钱，乳香1钱，没药1钱。";
  ex:hasUsage "净水磨化点。" .

<medicine:光明拨云锭子> a ex:Medicine;
  ex:hasFunction "治一切眼疾。";
  ex:hasName "光明拨云锭子";
  ex:hasPreparation "前九味研极细，后十六味，水浸三日，煎成膏，合前药末捏成锭。";
  ex:hasPrescription "炉甘石500克（煅过。以黄连250克，用水400毫升，煎五七沸，淬七次，取净末60克）硼砂30克 冰片 珍珠 乳香 没药各3克 乌贼骨6克 麝香0.6克 血竭9克 黄连250克 龙胆草 当归 芍药 大黄 黄柏 黄芩 川芎 生地黄 白芷 防风 木贼 薄荷 羌活 红花 菊花各等分";
  ex:hasUsage "净水磨化点眼。" .

<medicine:光明散> a ex:Medicine;
  ex:hasFunction "目翳。";
  ex:hasName "光明散";
  ex:hasNote "忌热物。";
  ex:hasPreparation "上为细末，入于阳城罐内，用铁灯盏盖之，再用铁线扎定，外用旧草鞋烧灰和盐泥固济，用文武火升之，勿令泄气，铁灯盏上常常以水渍之，依法3炷官香时退火，候冷轻手开罐取下灵气雪白，重5钱者为佳，用瓷罐收贮入后炉甘石煅炼听用。羊脑炉甘石1两，用捶熟黄泥包封甘石在内，再将前灵气5分掺于泥上，再用青盐含黄泥捶熟．又裹于外固密，晒干用髻条铁线团团缚定，用炭火煅红，用童便渍之，依法7次，取出去土，将炉甘石研为极细末。";
  ex:hasPrescription "水银5钱，铅锡3钱（1方5钱），枯矾5钱，炒盐5钱，炒消5钱。";
  ex:hasUsage "点之立效，或加冰片少许。" .

<medicine:光明散子> a ex:Medicine;
  ex:hasFunction "一切眼疾，时热翳膜。";
  ex:hasName "光明散子";
  ex:hasPreparation "上为极细末。";
  ex:hasPrescription "制甘石（末）1两，硼砂1钱，冰片2分。";
  ex:hasUsage "点眼。" .

<medicine:光明水眼药> a ex:Medicine;
  ex:hasFunction "风热目疾，红肿作痛，痒而多泪，畏光羞明，缓翳胬肉，烂眼，一切新久风热目疾。";
  ex:hasName "光明水眼药";
  ex:hasPreparation "上为细末，用黄连膏2两调匀。";
  ex:hasPrescription "甘石1两，琥珀1钱，地栗粉2钱5分，当门子2分，熊胆8分，元明粉8分，冰片8分，飞硼砂2分，辰砂6分，海螵蛸（漂净）1两（用大黄、黄芩、黄连各2钱，煎汁制）。";
  ex:hasUsage "每用少许，点于眼角，合眼静坐半小时。" .

<medicine:光明汤> a ex:Medicine;
  ex:hasFunction "一切暴眼。";
  ex:hasName "光明汤";
  ex:hasPreparation "上药用生绢袋盛贮，顿放于瓷器内以沸汤浸，用纸封盖定，待冷。";
  ex:hasPrescription "白矾1字（捶），铜绿1钱（捶），干姜3分（捶），杏仁1钱（嚼），甘草1钱（嚼）。";
  ex:hasUsage "临卧洗之。" .

<medicine:光明油> a ex:Medicine;
  ex:hasFunction "眼中一切疾病。";
  ex:hasName "光明油";
  ex:hasPreparation "蜗牛洗净，装瓶内，入香油，每日晒之，冰片水飞同蚕皮入油内。";
  ex:hasPrescription "蜗牛100个，蚕皮3个，冰片1分，香油5两。";
  ex:hasUsage "有效期二年。" .

<medicine:光明洗眼方> a ex:Medicine;
  ex:hasFunction "风热眼眶红烂者。";
  ex:hasName "光明洗眼方";
  ex:hasPrescription "古青钱10文，黄连1钱，杏仁7枚（去皮），艾叶3片。";
  ex:hasUsage "用水1钟，煎去其半，澄清1宿，次日频频洗之。" .

<medicine:光明燥眼药> a ex:Medicine;
  ex:hasFunction "风热上炎，目红肿痛，畏光羞明，翳膜遮睛，迎风流泪，视物昏花，一切新久目疾。";
  ex:hasName "光明燥眼药";
  ex:hasNote "忌酒、葱、大蒜。";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "制甘石1两，地栗粉5钱，梅冰片2钱。";
  ex:hasUsage "每用少许，早晚点于眼角，合眼静坐半小时。" .

<medicine:光明眼药> a ex:Medicine;
  ex:hasFunction "眼目疾。";
  ex:hasName "光明眼药";
  ex:hasNote "忌食丰燥、烟、酒。";
  ex:hasPreparation "上为细末，分一半用乳汁调于碗内，将碗覆入无油铁锅底，用面固济碗口锅下用炭火烧底，待碗热取药和不煎半生药细研为末，用童便为丸，如麦子大。";
  ex:hasPrescription "熊胆1钱，片脑1钱，胆矾1钱，脑砂1钱，枯矾2钱，五灵脂3分（水飞过），老鸦翅10根（去绒，新瓦上烧灰）。";
  ex:hasUsage "用时以乳汁调开，点眼极效。" .

<medicine:光明眼药水> a ex:Medicine;
  ex:hasFunction "风火时眼，及眼目昏花。";
  ex:hasName "光明眼药水";
  ex:hasPreparation "用清冷水浸药于碗中，隔水悬煮1炷香时取起，勿开看，放洁处，停3-5日开，看针化则水可用。验针法：其针于未煮时，用线穿好放入，将线头挂于碗外，验时只须将线拉起，看针有否便知。";
  ex:hasPrescription "胆矾1钱2分，青盐4钱，明矾7钱，乌梅7钱，川椒3钱，木贼草1钱5分，白丁香6分，冰片2分，绣花针3枚。";
  ex:hasUsage "每日用新软毛笔蘸水，点入四眼角；将头抬起，少顷觉有热泪，任其流出，日4-5次。" .

<medicine:光明砂丸> a ex:Medicine;
  ex:hasFunction "小儿骨热，日渐瘦弱，不能饮食。";
  ex:hasName "光明砂丸";
  ex:hasPreparation "上为末，都研令匀，炼蜜为丸，如麻子大。";
  ex:hasPrescription "光明砂半两（细研，水飞过），古子花半两，雄黄半两（细研），槟榔3枚，桃仁1分（汤浸，去皮尖双仁，麸炒微黄），金箔30片（细研），紫石英半两（细研，水飞过），远志1分（去心）。";
  ex:hasUsage "每服5丸，以粥饮送下，日3次。" .

<medicine:克坚膏> a ex:Medicine;
  ex:hasFunction "小儿癖块，发热羸瘦。";
  ex:hasName "克坚膏";
  ex:hasPreparation "先用真香油1斤入锅内，将前药熬成灰，滤去滓，再慢火熬，滴水不散，方下黄丹8两，熬滴水成珠；再用芦荟、阿魏、硼砂、皮消、水红花子各5钱，硇砂3钱，麝香1钱，为细末，入内搅匀不熬，摊为膏药。";
  ex:hasPrescription "木鳖子8钱，川山甲8钱，川乌8钱，甘遂8钱，甘草8钱，当归8钱。";
  ex:hasUsage "贴时先用皮消水洗皮肤，以膏贴癖。2-3日后，觉肚内疾作疼。4-5日发痒，粪后有脓血之物是其验也。" .

<medicine:克坚酒> a ex:Medicine;
  ex:hasFunction "痞气，脾之积也，患居中脘，乃脾虚血瘀气滞所致。";
  ex:hasName "克坚酒";
  ex:hasPrescription "水红花3钱（净末）。";
  ex:hasUsage "上用火酒2斤浸之，时时呷服；或用水红花子熬膏，每日取2钱酒化下。外用消痞膏贴之。" .

<medicine:克应丸> a ex:Medicine;
  ex:hasFunction "妇人赤白带下。";
  ex:hasName "克应丸";
  ex:hasPreparation "上为末，醋糊为丸，如梧桐子大。";
  ex:hasPrescription "熟地黄2两，赤芍药2两，当归2两半，赤石脂（煅）1两，龙骨1两，牡蛎（煅，以酒淬）1两，茯苓1两，牡丹皮1两，川芎1两，艾叶（制，研）1两。";
  ex:hasUsage "每服50丸，空心白汤送下。" .

<medicine:克效交泰圣饼子> a ex:Medicine;
  ex:hasFunction "伤寒结胸，脉浮不可下，下之必死。";
  ex:hasName "克效交泰圣饼子";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "巴豆14粒，黄连7分（连皮用）（一方加大黄末1钱）。";
  ex:hasUsage "用津唾和成膏，填入脐下，以艾炷灸其上。腹中有声，其病去矣，不拘壮数，病去为度。才灸了，便以温汤浸手帕抗之，恐生疮。" .

<medicine:克效圣饼子> a ex:Medicine;
  ex:hasFunction "积痰停饮，留滞不散，胃中噎闷，胁肋刺痛，噫醋吞酸，不嗜饮食，及宿有沉积攻冲，膈脘痞闷。";
  ex:hasName "克效圣饼子";
  ex:hasPreparation "上件药，除研药外，为细末，和匀，用石脑油温就和丸，如绿豆大，捻作饼子。";
  ex:hasPrescription "安息香（研）1两，南乳香（研）1两，丁香1两，木香1两，川姜（炮裂）1两，石三棱（锉）半两，高良姜1两，荆三棱（炮，锉）1两，蓬莪术（炮，锉）1两，粉霜（研）1两，干漆1两（杵碎，炒令烟尽），硇砂半两（水飞）。";
  ex:hasUsage "本方方名，《普济方》引作“克效神圣饼子”。" .

<medicine:克效散> a ex:Medicine;
  ex:hasFunction "胎漏。";
  ex:hasName "克效散";
  ex:hasNote "忌甘草3日。";
  ex:hasPreparation "上研为末。";
  ex:hasPrescription "五倍子。";
  ex:hasUsage "上为末。酒调下。" .

<medicine:克效汤> a ex:Medicine;
  ex:hasFunction "潮热往来，久而不解，烦渴昏倦，肌瘦减食。";
  ex:hasName "克效汤";
  ex:hasPreparation "上锉碎。";
  ex:hasPrescription "地骨皮1两，柴胡7钱半，防风7钱半，黄芩7钱半，甘草（炙）7钱半，葛根7钱半。";
  ex:hasUsage "每服2钱，用水6分，煎至3分，不拘时服。" .

<medicine:克效饼子> a ex:Medicine;
  ex:hasFunction "腰痛及腿膝。";
  ex:hasName "克效饼子";
  ex:hasNote "妇人有胎不可服之。";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "甘遂（麸炒黄）1两，荞面1两，黑牵牛（净，4两，半生半熟，取头末）2两半。";
  ex:hasUsage "每服3钱，夜卧滴水和成饼，慢火烧黄色取出。气实者作1服，烂嚼后，煎半生半熟，葱白酒送下；气虚人作两服，先吃一多半，至明取动，再嚼一少半，亦用半生半熟，葱白酒送下，微取1行。" .

<medicine:克明亮眼药> a ex:Medicine;
  ex:hasFunction "眼目赤肿，红丝壅结。";
  ex:hasName "克明亮眼药";
  ex:hasPreparation "共研极细面。";
  ex:hasPrescription "牛黄1钱5分，珊瑚2钱5分，玛（？？）2钱5分，蕤仁霜5钱，熊胆3钱，冰片5两，珍珠5钱，海螵蛸3钱5分，麝香1钱5分，黄连1两5钱，甘石粉5两。";
  ex:hasUsage "用点眼器，沾冷开水，沾药少许点眼内，闭目休息，每日点2-3次。" .

<medicine:克疣汤> a ex:Medicine;
  ex:hasFunction "利湿清热解毒，活血软坚散结。主湿毒热邪郁结肌肤，阻遏气血运行。";
  ex:hasName "克疣汤";
  ex:hasPrescription "白花蛇舌草30克，土茯芩20克，马齿苋30克，生苡仁30克，夏枯草12克，牡蛎20克（先煎），木贼草12克，板蓝根30克，红花6克，赤芍10克，紫草12克，生甘草6克。";
  ex:hasUsage "水煎2次早晚服，每日1剂。" .

<medicine:克痞丸> a ex:Medicine;
  ex:hasFunction "脾胃虚寒，痰饮不化，胸膈(疒丂？？)闷，呕逆喘嗽，体倦头痛。";
  ex:hasName "克痞丸";
  ex:hasPreparation "上为末，用面糊为丸，如梧桐子大。";
  ex:hasPrescription "丁香5钱，藿香5钱，官桂5钱，茯芩（去皮）5钱，甘草5钱，小茴香5钱，干姜1两半，桔梗2钱半。";
  ex:hasUsage "每服70-80丸，生姜汤送下。" .

<medicine:克银癣软膏> a ex:Medicine;
  ex:hasFunction "银屑病。";
  ex:hasName "克银癣软膏";
  ex:hasPrescription "红粉5g，秦皮乙醇流浸膏15g，川槿皮乙醇流浸膏10g，补骨脂乙醇流浸膏10g，加亲水性软膏基质60g。";
  ex:hasUsage "调膏外用。" .

<medicine:兑疽膏> a ex:Medicine;
  ex:hasFunction "蚀恶肉，生好肉。主痈疽。";
  ex:hasName "兑疽膏";
  ex:hasNote "疮浅者，勿兑着疮中。";
  ex:hasPreparation "上切，纳膏中微火煎3沸，纳松脂耗令相得。";
  ex:hasPrescription "当归2两，芎2两，白芷2两，松脂2两，乌头2两，巴豆30枚（去皮），猪脂3升。";
  ex:hasUsage "以绵布绞去滓，以膏着绵絮兑头尖作兑，随病深浅兑之，每日3次，恶肉尽止。" .

<medicine:兑金丸> a ex:Medicine;
  ex:hasAlias "五色兑金丸";
  ex:hasFunction "清热去毒，消炎杀菌。主";
  ex:hasName "兑金丸";
  ex:hasNote "孕妇忌用，忌食鱼腥、油腻、生冷、面、豆等物。";
  ex:hasPreparation "上为细末，水为小丸，滑石粉、青黛、朱砂、京墨、赤金等为衣。";
  ex:hasPrescription "纹军6钱7分，黄芩3钱4分，黄柏3钱4分，山栀2钱，桔梗2钱7分，黄连2钱7分，甘草2钱7分，麝香1分4厘，梅片3分4厘，胆星7分，竺黄3钱4分，紫菀3钱4分，牛黄1分4厘，全蝎1钱3分4厘。";
  ex:hasUsage "每服7厘，白开水送下。" .

<medicine:兔肝丸> a ex:Medicine;
  ex:hasFunction "治虚劳，肝肾不足，眼目昏暗，久视无力。";
  ex:hasName "兔肝丸";
  ex:hasPreparation "上药捣罗为末，炼蜜和捣三五百杵，丸如梧桐子大。";
  ex:hasPrescription "兔肝60克（炙微黄）防风23克（去芦头）玄参30克 白茯苓30克 羚羊角屑23克 人参23克（去芦头）决明子90克 车前子30克 地骨皮15～23克 枳壳15克（麸炒微黄，去瓤）黄耆30克（锉）熟干地黄30克 甘菊花23克 麦门冬45克（去心，焙）";
  ex:hasUsage "每服30丸，食前以温粥饮送下。" .

<medicine:兔骨饮> a ex:Medicine;
  ex:hasAlias "兔骨粥（《仙拈集》卷二）。";
  ex:hasFunction "治消渴羸瘦，小便不禁。";
  ex:hasName "兔骨饮";
