<medicine:橘皮汤> a ex:Medicine;
  ex:hasAlias "橘参散、橘参饮";
  ex:hasFunction "肺热气上，咳息奔喘。";
  ex:hasName "橘皮汤";
  ex:hasNote "忌海藻、菘菜。";
  ex:hasPreparation "上为散。";
