  ex:hasName "半金丹";
  ex:hasPreparation "上为极细末。";
  ex:hasPrescription "巴豆7粒（去壳，3生4熟），明雄黄（皂子大许），蝉肚郁金1枚。";
  ex:hasUsage "每服2分，茶调下。" .

<medicine:半金散> a ex:Medicine;
