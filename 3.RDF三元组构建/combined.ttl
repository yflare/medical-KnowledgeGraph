  ex:hasUsage "吹点。" .

<medicine:米莲散> a ex:Medicine;
  ex:hasFunction "治劳心吐血。";
  ex:hasName "米莲散";
  ex:hasPreparation "上药为末。";
  ex:hasPrescription "糯米15克 莲子心7枚";
  ex:hasUsage "酒服，或以墨汁作丸服。" .

<medicine:米醋萝卜菜> a ex:Medicine;
  ex:hasFunction "辛凉解表，消食解毒。适用于流行性感冒。";
  ex:hasName "米醋萝卜菜";
  ex:hasPreparation "将萝卜洗净切片，加米醋浸数小时。";
  ex:hasPrescription "生萝卜250克 米醋适量";
  ex:hasUsage "当菜下饭。每日1剂。" .

<medicine:类从散> a ex:Medicine;
  ex:hasFunction "赤白带。";
  ex:hasName "类从散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "白马毛1钱（和椒火烧），龟甲4钱（醋炙），鳖甲5钱（醋炙），牡蛎1两半（火炙）。";
  ex:hasUsage "每服1钱，酒调下，1日3次。" .

<medicine:类倒散> a ex:Medicine;
  ex:hasFunction "大小便不通，此前后热结也。";
  ex:hasName "类倒散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "大黄6钱，滑石6钱，皂角3钱。";
  ex:hasUsage "黄酒送下。如小便不通，大黄3钱，滑石6钱；如大便不通，大黄6钱，滑石3钱。皂角3钱，大小便俱用。" .

<medicine:类圣散> a ex:Medicine;
  ex:hasFunction "治一切疔疮，恶毒，肿痛甚者。";
  ex:hasName "类圣散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "川乌 草乌 苍术 细辛 白芷 薄荷 防风 甘草各15克";
  ex:hasUsage "蛋清调涂患处，中间留顶。" .

<medicine:粉丹散> a ex:Medicine;
  ex:hasAlias "吹耳丹、吹耳散";
  ex:hasFunction "眼生翳膜。";
  ex:hasName "粉丹散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "轻粉、黄丹。";
  ex:hasUsage "吹耳丹（《赤水玄珠》卷二十八）、吹耳散（《治疹全书》卷下）。" .

<medicine:粉代散> a ex:Medicine;
  ex:hasFunction "气逆痰壅，病痫脉弦者。";
  ex:hasName "粉代散";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "轻粉3钱，代赭3两（煅），白矾3两。";
  ex:hasUsage "每服3钱，米饮调下。" .

<medicine:粉姜散> a ex:Medicine;
  ex:hasFunction "小儿急中卒风不语。";
  ex:hasName "粉姜散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "粉、干姜。";
  ex:hasUsage "安少许在舌上，时时用之，立效。" .

<medicine:粉散> a ex:Medicine;
  ex:hasFunction "大病后，身体虚肿汗出。";
