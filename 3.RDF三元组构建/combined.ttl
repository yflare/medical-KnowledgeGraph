  ex:hasUsage "上(口父)咀。水煎，食远温服。" .

<medicine:降火清金汤> a ex:Medicine;
  ex:hasFunction "火喘。";
  ex:hasName "降火清金汤";
  ex:hasPrescription "黄芩（炒）1钱半，山栀（炒）1钱半，知母（炒）1钱，贝母（去心）1钱，桑白皮1钱，麦门冬（去心）1钱，桔梗1钱，橘红8分，茯苓1钱，甘草4分。";
  ex:hasUsage "水2钟，煎8分。食后服。" .

<medicine:降火膏> a ex:Medicine;
  ex:hasFunction "口疮口疳。";
  ex:hasName "降火膏";
  ex:hasPreparation "上为末。";
