  ex:hasName "桂心白术散";
  ex:hasPrescription "桂心、白术、附子、川芎、甘草";
  ex:hasUsage "加生姜、大枣，水煎服。" .

<medicine:桂心白术汤> a ex:Medicine;
  ex:hasFunction "治伤寒阴痉，手足厥冷，筋脉拘急，汗出不止者。";
  ex:hasName "桂心白术汤";
