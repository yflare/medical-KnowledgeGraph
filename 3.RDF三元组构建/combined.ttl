  ex:hasNote "忌生冷，生葱。";
  ex:hasPreparation "上为粗末。";
  ex:hasPrescription "高良姜（锉）半两，桂（去粗皮）1两，木瓜（干者，去瓤）2两。";
  ex:hasUsage "每服3钱匕，以水1盏，煎取7分，去滓温服，不拘时候。" .

<medicine:高良姜理中丸> a ex:Medicine;
  ex:hasFunction "霍乱吐泻，心腹疼痛。";
  ex:hasName "高良姜理中丸";
  ex:hasPreparation "上为细末，炼蜜为丸，如梧桐子大。";
  ex:hasPrescription "高良姜2两，白术1两，官桂半两，甘草1分。";
  ex:hasUsage "每服1丸，煎生姜、橘皮汤送下，不拘时候。" .

<medicine:高良姜粥> a ex:Medicine;
  ex:hasFunction "老人冷气，心痛郁结，两胁胀满。";
  ex:hasName "高良姜粥";
  ex:hasPrescription "高良姜2两（切，以水2升.煎取1升半汁），青粱米4合（研淘）。";
  ex:hasUsage "上以姜汁煮粥，空心食之，日1服。" .

<medicine:高良姜羊肉汤> a ex:Medicine;
  ex:hasFunction "寒疝心腹痛，及胁肋里急，不下饮食。";
  ex:hasName "高良姜羊肉汤";
  ex:hasPreparation "除羊肉外，上为末。";
  ex:hasPrescription "高良姜1两（锉），赤芍药1两（锉），当归1两（锉，微炒），羊肉1斤半（细切），桂心1两。";
  ex:hasUsage "以水5大盏，都煮取2盏半，去滓，稍热服1小盏，不拘时候。" .

<medicine:高良姜酒> a ex:Medicine;
  ex:hasAlias "高良姜饮";
  ex:hasFunction "霍乱吐痢，腹痛气恶。乳石发，转筋气急。";
  ex:hasName "高良姜酒";
  ex:hasPrescription "高良姜。";
  ex:hasUsage "高良姜饮（《圣济总录》卷一八四）。" .

<medicine:高良苦三味饮子> a ex:Medicine;
  ex:hasAlias "高良姜散";
  ex:hasFunction "湿霍乱，吐痢无限。";
  ex:hasName "高良苦三味饮子";
  ex:hasNote "忌生葱。";
  ex:hasPreparation "上切。";
  ex:hasPrescription "高良姜2两，豆蔻子12枚，桂心2两（1方有干姜、人参）。";
  ex:hasUsage "高良姜散（《普济方》卷二○二）。" .

<medicine:鬼仙丹> a ex:Medicine;
  ex:hasFunction "男子嗜欲太过，精血不固而多热。";
  ex:hasName "鬼仙丹";
  ex:hasPreparation "上将金樱子熬成膏，搅上3味末为丸。";
  ex:hasPrescription "莲须10两，芡实10两，石莲子10两（研末），金樱子3斤。";
  ex:hasUsage "每服30-50丸，空心盐水送下。" .

<medicine:鬼代丹> a ex:Medicine;
  ex:hasAlias "神让散";
  ex:hasFunction "临刑拷打不痛。主";
  ex:hasName "鬼代丹";
  ex:hasPreparation "上为末，炼蜜为丸，如弹子大。";
  ex:hasPrescription "乳香、没药、自然铜、无名异、骨碎补、地龙、土鳖虫各等分。";
  ex:hasUsage "临刑用好老酒化1丸。如不打，吃葱即解；吃素者，甘草汤解。" .

<medicine:鬼代散> a ex:Medicine;
  ex:hasAlias "鬼代丹";
  ex:hasFunction "杖疮。";
  ex:hasName "鬼代散";
  ex:hasPreparation "上为细末。每服3钱，温酒调下。后用黄蜡为丸，如梧桐子大。";
  ex:hasPrescription "地龙（去土，炒）。";
  ex:hasUsage "鬼代丹（《普济方》卷三○五）。" .

<medicine:鬼哭丹> a ex:Medicine;
  ex:hasAlias "豉破丸";
  ex:hasFunction "疟，2-3日一发者。";
  ex:hasName "鬼哭丹";
  ex:hasNote "忌热物半日。";
  ex:hasPreparation "上为末，用鸡子清和面糊为丸，如梧桐子大。";
  ex:hasPrescription "常山1斤（醋浸，春5、夏3、秋7、冬10日），槟榔4两，半夏2两，贝母2两。";
  ex:hasUsage "每服30丸，隔夜、临睡冷酒吞服，次日早再进1服。" .

<medicine:鬼哭散> a ex:Medicine;
  ex:hasAlias "鬼哭饮";
  ex:hasFunction "一切寒热疟疾。";
  ex:hasName "鬼哭散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "人参（去芦头）半两，常山1两，茯苓（去皮）1两，甘草1两（生用），肉桂（去粗皮）1两。";
  ex:hasUsage "每服4钱，用无灰酒8分1盏，冷调下，当发日空心服。" .

<medicine:鬼哭饮子> a ex:Medicine;
  ex:hasFunction "传尸劳，不时冷热羸瘦。";
  ex:hasName "鬼哭饮子";
  ex:hasNote "忌苋菜。";
  ex:hasPrescription "槟榔2个（1生1熟），鳖甲半两（涂醋，炙令微黄，去裙襕），甘草1截（如病人中指长），桃仁7粒（去皮尖），杏仁7粒（去皮尖），青蒿1握（长2寸），阿魏少许，东南桃枝7茎，东南柳枝7茎（长3寸，和心用）。";
  ex:hasUsage "上以童便1大盏半，煎取1盏，去滓，食前分温2服。以吐利出恶物为度。" .

<medicine:鬼头顶> a ex:Medicine;
  ex:hasFunction "4日两头疟，哮病。";
  ex:hasName "鬼头顶";
  ex:hasPreparation "上为细末，炼蜜为丸，如绿豆大。";
  ex:hasPrescription "白信5钱（用豆腐1大方块，中挖一池，放信于池内，以原豆腐盖好，煮1炷香，去腐用信），雄黄5钱，陀僧5钱，生半夏1两。";
  ex:hasUsage "每服6丸，姜汤送下。壮者7丸，弱者4-5丸。" .

<medicine:鬼疟神效丸> a ex:Medicine;
  ex:hasFunction "鬼疟。";
  ex:hasName "鬼疟神效丸";
  ex:hasPreparation "上药各为末，蒸饼为丸，如梧桐子大。";
  ex:hasPrescription "砒霜半两，朱砂半两，乳香半两，麝香、阿魏、安息香、绿豆粉、猢狲头骨。";
  ex:hasUsage "方中麝香、阿魏、安息香、绿豆粉、猢狲头骨用量原缺。" .

<medicine:鬼督邮丸> a ex:Medicine;
  ex:hasFunction "恶注心痛闷绝。";
  ex:hasName "鬼督邮丸";
  ex:hasPreparation "上先将安息香煎成膏，拌前药为丸，如梧桐子大。";
  ex:hasPrescription "鬼督邮（末）1两，安息香1两（酒浸，细研，滤去滓，慢火煎成膏）。";
  ex:hasUsage "每服15丸，空心煎吴茱萸醋汤送下。" .

<medicine:鬼箭丸> a ex:Medicine;
  ex:hasFunction "妇人脉不通，手足心热，腹满喘急，不欲睡卧，心神烦闷。";
  ex:hasName "鬼箭丸";
  ex:hasPreparation "上为末，炼蜜为丸，如梧桐子大。";
  ex:hasPrescription "鬼箭羽1两，川芒消1两，柴胡1两（去苗），水蛭1分（炒微黄），虻虫1分（炒令微黄，去翅足），川大黄3分（锉，微炒），赤茯苓3分，干漆半两（捣碎，炒令烟出），川椒1分（去目及闭口者，微炒去汗），甜葶苈1两（隔纸炒令紫色），杏仁3分（汤浸，去皮尖双仁，麸炒微黄），桃仁3分（汤浸，去皮尖双仁，麸炒微黄），牡丹3分。";
  ex:hasUsage "每服20丸，食前以温酒送下。" .

<medicine:鬼箭散> a ex:Medicine;
  ex:hasAlias "鬼箭羽散";
  ex:hasFunction "妇人月水久不通，经数年以来，羸瘦少食，诸方不效者。";
  ex:hasName "鬼箭散";
  ex:hasPreparation "上为粗散。";
  ex:hasPrescription "鬼箭羽半两，赤芍药半两，川大黄半两（微炒），桂心半两，鳖甲半两（涂醋炙令黄，去裙襕），当归半两（锉，微炒），牛膝半两（去苗），琥珀1两（细研），土瓜根半两，水蛭1分（炒微黄），川朴消1两，虎杖3分，桃仁3分（汤浸，去皮尖双仁，麸炒微黄），虻虫1分（炒微黄）。";
  ex:hasUsage "每服3钱，以水1中盏，加生差半分，煎至5分，去滓，食前温服。" .

<medicine:鬼箭汤> a ex:Medicine;
  ex:hasFunction "风疹。";
  ex:hasName "鬼箭汤";
  ex:hasNote "慎外风。";
  ex:hasPreparation "上为粗末。";
  ex:hasPrescription "鬼箭1两，白蔹1两，白术1两，矾石（熬令汁枯）1两，甘草（锉，炙）1两，防风（去叉）2两。";
  ex:hasUsage "每服5钱匕，以水1盏半，加粟米粉2钱匕，同煎至7分，去滓，食后温服，兼用粉身。" .

<medicine:鬼箭羽丸> a ex:Medicine;
  ex:hasFunction "避伤寒瘟疫瘴疠。主时气瘴疫。";
  ex:hasName "鬼箭羽丸";
  ex:hasNote "忌羊血。";
  ex:hasPreparation "上为末，炼蜜为丸，如豇豆大。";
  ex:hasPrescription "鬼箭羽1两，鬼臼1两（去毛），赤小豆半分（炒熟），朱砂半两（细研，水飞过），雄黄半两（细研，水飞过）。";
  ex:hasUsage "本方方名，《普济方》引作“赤小豆丸”。" .

<medicine:鬼箭羽十味丸> a ex:Medicine;
  ex:hasFunction "疟疾经用吐利后，其源尚在，如更吐利，又虑尫赢者。";
  ex:hasName "鬼箭羽十味丸";
  ex:hasNote "忌海藻、菘菜、桃、李、雀肉、生葱。";
  ex:hasPreparation "上为末，炼蜜为丸，如梧桐子大。";
  ex:hasPrescription "细辛4两，橘皮4两，鬼箭羽（折看之如金黄色者）2两，白术5两，桂心4两，地骨皮4两，蜀漆2两，甘草3两（炙），当归5两，丁香3两。";
  ex:hasUsage "初服15丸，稍加至30丸，煮乌梅饮下之，每日2次。经3-5日后，若觉热甚，每服药后良久，任吃2-3口粥饮压之。" .

<medicine:鬼箭羽散> a ex:Medicine;
  ex:hasAlias "鬼箭羽汤";
  ex:hasFunction "鬼疟，寒热日发。";
  ex:hasName "鬼箭羽散";
  ex:hasPreparation "上为细散。";
  ex:hasPrescription "鬼箭羽1分（为细末），砒霜（研）1钱，五灵脂（研）1两。";
  ex:hasUsage "每服半钱匕，临发时冷茶清调下。" .

<medicine:鬼箭羽汤> a ex:Medicine;
  ex:hasFunction "心疼中恶，绕脐刺痛，自出汗。";
  ex:hasName "鬼箭羽汤";
  ex:hasPreparation "上锉细，如麻豆大。";
  ex:hasPrescription "鬼箭羽1两，桃仁（去皮尖双仁，炒）1两，干姜（炮）1分，甘草（炙，锉）半分，厚朴（去粗皮，生姜汁炙）半两，当归（切，焙）半两，桂（去粗皮）半两，芎藭半两。";
  ex:hasUsage "每服5钱匕，以水1盏半，煎至8分，去滓温服。" .

<medicine:鬼胆丸> a ex:Medicine;
  ex:hasFunction "远年日近诸般积物。";
  ex:hasName "鬼胆丸";
  ex:hasPreparation "上为细末，研浓墨水为丸，如皂龟子大。";
  ex:hasPrescription "皂角4两（去皮子），巴豆20个（好者，去皮心油，生用，研碎）。";
  ex:hasUsage "每服3丸，临卧浆水送下。大便显出积物为效。" .

<medicine:鬼臼丸> a ex:Medicine;
  ex:hasFunction "鬼疟。";
  ex:hasName "鬼臼丸";
  ex:hasPreparation "上为细末，醋煮面糊为丸，如梧桐子大，丹砂为衣。";
  ex:hasPrescription "鬼臼1两，常山1两，甘草（炙，锉）1两，绿豆粉1两，鳖甲（醋炙，去裙襕）3分，雄黑豆250粒（汤浸，去皮，焙），砒霜半两（研，生使）。";
  ex:hasUsage "每服1丸，日未出面东，用桃心7枚，同新汲水送下。" .

<medicine:鬼臼汁> a ex:Medicine;
  ex:hasFunction "黑黄。";
  ex:hasName "鬼臼汁";
  ex:hasPrescription "生鬼臼1两。";
  ex:hasUsage "上捣绞取汁1小盏，服之即愈。如无生鬼臼，即用干者为末，每服2钱匕，新汲水调下，不拘时候。宜先烙口中黑脉，次烙百会穴，又烙玉泉、足阳明、章门、心俞、下廉，不愈宜服。" .

<medicine:鬼臼浆> a ex:Medicine;
  ex:hasFunction "射工中人，寒热。";
  ex:hasName "鬼臼浆";
  ex:hasPreparation "上细锉，以苦酒渍之，捣绞取汁1升。";
  ex:hasPrescription "鬼臼叶1把。";
  ex:hasUsage "顿服，每日3次。" .

<medicine:鬼见愁> a ex:Medicine;
  ex:hasFunction "乳奶婴小患疟，无计可治者。";
  ex:hasName "鬼见愁";
  ex:hasPreparation "上用湿纸7重同裹，慢火内煨至纸干，取出顿地上出火毒，次入脑、麝各半字，金箔5片，同研为细末。";
  ex:hasPrescription "代赭石（用丁头5粒，火煅，醋淬10次，研极细）、朱砂（透明块子）半钱（水飞），砒霜皂子大。";
  ex:hasUsage "每用1字，于发日早以麻油1滴调药，敷鼻尖上。" .

<medicine:鬼针散> a ex:Medicine;
  ex:hasFunction "割甲侵肉不愈。";
  ex:hasName "鬼针散";
  ex:hasPrescription "鬼针草苗、鼠粘草根。";
  ex:hasUsage "捣鬼针草苗汁及鼠粘草根，和腊月猪服敷之。" .

<medicine:鬾奶散> a ex:Medicine;
  ex:hasFunction "小儿饮母鬾奶黄瘦。";
  ex:hasName "鬾奶散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "豆蔻、母丁香、宣连、胡黄连各等分。";
  ex:hasUsage "3岁半钱，空心米饮调下。" .

<medicine:魁蛤丸> a ex:Medicine;
  ex:hasFunction "妇人瘀血作痛，经闭不行。";
  ex:hasName "魁蛤丸";
  ex:hasPreparation "上为末，蒸饼为丸，如梧桐子大。";
  ex:hasPrescription "香附（醋煮）4两，桃仁2两，瓦楞子（即魁蛤，煅，醋煮1昼夜）2两，大黄（蒸）1两，牡丹皮1两，当归1两，川芎半两，红花半两。";
  ex:hasUsage "每服30-50丸，空心温酒送下。" .

<medicine:魁蛤散> a ex:Medicine;
  ex:hasFunction "小儿阴(疒颓)。";
  ex:hasName "魁蛤散";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "魁蛤3分（细研），狗阴1具（炙令黄），白术半两，桂心1分。";
  ex:hasUsage "1-2岁儿，每服半钱，空心粥饮调下，晚后再服，酒送下。" .

<medicine:魂停汤> a ex:Medicine;
  ex:hasAlias "魂停散";
  ex:hasFunction "脾脏劳极。";
  ex:hasName "魂停汤";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "白芍药1两，桔梗1两，人参1两，茯苓1两，诃子1两，丁香1两，甘草1两。";
  ex:hasUsage "魂停散（《医统》卷四十六）。方中白芍药，《医统》作“白药子”。" .

<medicine:魏香散> a ex:Medicine;
  ex:hasAlias "魏莪散（《嵩崖尊生》卷十五）。";
  ex:hasFunction "治小儿盘肠内吊，腹中极痛，干啼后偃。";
  ex:hasName "魏香散";
  ex:hasPreparation "先用温水化阿魏，浸蓬莪术一昼夜，焙干，研为细末。";
  ex:hasPrescription "蓬莪术15克 真阿魏3克";
  ex:hasUsage "每服0.2～1.5克，煎紫苏、米饮，空腹时调下。" .

<medicine:鱼胆敷眼膏> a ex:Medicine;
  ex:hasFunction "治眼中飞血，赤脉作痛。";
  ex:hasName "鱼胆敷眼膏";
  ex:hasPreparation "上药二味，以胆汁调黄连末，瓷盒盛，于饭上蒸一次取出，如干即入少许蜜，调似膏。";
  ex:hasPrescription "鲤鱼胆5枚 黄连（去须，捣为末）15克";
  ex:hasUsage "每日五至七次，涂敷目眦。" .

<medicine:鱼脑石散> a ex:Medicine;
  ex:hasFunction "散寒，通窍，除涕。治鼻渊。鼻涕白粘，鼻塞或重或轻，嗅觉减退，鼻内肌膜淡红，肿胀，鼻甲肥大，遇风冷则鼻塞，流涕加重。";
  ex:hasName "鱼脑石散";
  ex:hasPreparation "共为细末。";
  ex:hasPrescription "鱼脑石粉9克 冰片0.9克 辛夷花9克 细辛3克";
  ex:hasUsage "吹鼻，每日二至三坟。" .

<medicine:鱼败银海汤> a ex:Medicine;
  ex:hasFunction "清热解毒利湿。主下焦湿热。";
  ex:hasName "鱼败银海汤";
  ex:hasPrescription "鱼腥草31克，败酱草31克，金银花18克，海金沙24克，苦参12克，车前草15克，石苇12克，地肤子18克，千里光15克，黄芩12克，白花蛇舌草31克。";
  ex:hasUsage "水煎服，每日1剂，日服2次。" .

<medicine:鱼鳔当归汤> a ex:Medicine;
  ex:hasFunction "大补气血。适用于再生障碍性贫血。";
  ex:hasName "鱼鳔当归汤";
  ex:hasPreparation "将上3味水煎。";
  ex:hasPrescription "鱼鳔 当归各10克 红枣10枚";
  ex:hasUsage "每日2次，可长期服用。" .

<medicine:鱼鳞汤> a ex:Medicine;
  ex:hasFunction "滋补肝肾，健脾润燥，益气养血，祛风活络。主肝肾阴虚，脾胃衰弱，荣血不足，血虚生风，风盛则燥，肌肤失养。（全身性皮肤角化症）";
  ex:hasName "鱼鳞汤";
  ex:hasPrescription "生地20克，熟地20克，黑芝麻40克，枸杞子15克，何首乌15克，白藓皮15克，地肤子15克，当归20克，川芎10克，桂枝10克，丹参15克，苦参15克，防风15克，蝉蜕10克，甘草10克，大枣3枚。";
  ex:hasUsage "水煎服，每日1剂，早晚温服。" .

<medicine:鲁公酿酒> a ex:Medicine;
  ex:hasFunction "风偏枯半死，行劳得风，若鬼所击，四肢不遂，不能行步，不自带衣，挛躄，五缓六急；妇人带下，产乳中风，五劳七伤。";
  ex:hasName "鲁公酿酒";
  ex:hasPreparation "上(口父)咀，以水5升渍3宿，法曲1斤合渍，秫米2斗，合酿3宿，去滓，炊糯米1斗，酝3宿药成。";
  ex:hasPrescription "干姜5分，踯躅5分，桂心5分，甘草5分，芎5分，续断5分，细辛5分，附子5分，秦艽5分，天雄5分，石膏5分，紫菀5分，葛根4两，石龙芮4两，石斛4两，通草4两，石南4两，柏子仁4两，防风4两，巴戟天4两，山茱萸4两，牛膝8两，天门冬8两，乌头20枚，蜀椒半升。";
  ex:hasUsage "先食服半合，每日2次，待米极消尽，乃去滓晒干，为末服。" .

<medicine:鲁府遇仙传种子药酒>
  a ex:Medicine;
  ex:hasFunction "补虚益气，滋阴降火，保元调经，填精壮骨。治诸脏衰弱，久不生育者。（不孕不育）";
  ex:hasName "鲁府遇仙传种子药酒";
  ex:hasPreparation "上药，为细末，共入蜜坛内和匀，竹箬封口，面外固，入锅内，大柴火煮二炷香，取出，埋于土中三日，去火毒。";
  ex:hasPrescription "白茯苓（去皮，净）500克 大红枣（煮，去皮、核，取肉）250克 胡桃肉（去壳，泡，去粗皮）180克 白蜂蜜3千克（置锅内熬滚，入前三味调匀，再用微火熬膏倾入瓷坛内，又加南烧酒10千克、糯米白酒5千克入蜜坛内）绵黄耆（蜜炙）人参 白术（去芦）当归 川芎 白芍（炒）生地黄 熟地黄 小茴香 覆盆子 陈皮 沉香 木香 甘枸杞子 官桂 砂仁 甘草 乳香 没药 北五味子";
  ex:hasUsage "每日早、午、晚三时，男女各饮数杯，勿使大醉。" .

<medicine:鲁王酒> a ex:Medicine;
  ex:hasAlias "鲁公酒";
  ex:hasFunction "风眩心乱，耳聋，目暗泪出，鼻不闻香臭，口烂生疮，风齿瘰疬，喉下生疮，烦热，厥逆上气，胸胁肩肿痛，手不上头，不自带衣，腰脊不能俯仰，脚酸不仁，难以久立；八风十二痹，五缓六急，半身不遂，四肢偏枯，筋挛不可屈伸；贼风咽喉闭塞，哽哽不利，或如锥刀所刺，行人皮肤中，无有常处，久久不治，入人五脏，或在心下，或在膏盲，游走四肢，偏有冷处，如风所吹，久寒积聚，风湿五劳七伤，虚损百病。";
  ex:hasName "鲁王酒";
  ex:hasPreparation "上(口父)咀，以酒4斗，渍之10日。";
  ex:hasPrescription "茵芋30铢，乌头30铢，踯躅30铢，天雄24铢，防己24铢，石斛24铢，细辛18铢，柏子仁18铢，牛膝18铢，甘草18铢，通草18铢，桂心18铢，山茱萸18铢，秦艽18铢，黄芩（胡洽作黄耆）18铢，茵陈18铢，附子18铢，瞿麦18铢，杜仲18铢，泽泻18铢，王不留行（胡洽作天门冬，《千金翼》作王荪）18铢，石南18铢，防风18铢，远志18铢，干地黄18铢。";
  ex:hasUsage "鲁公酒（《千金翼》卷十六）。方中甘草，《千金翼》作干姜。" .

<medicine:鲍鱼大麻子羹> a ex:Medicine;
  ex:hasFunction "妇人产后下乳。主";
  ex:hasName "鲍鱼大麻子羹";
  ex:hasPrescription "鲍鱼肉3斤，麻子仁1升。";
  ex:hasUsage "上与盐豉、葱作羹，任意食之。" .

<medicine:鲍鱼汤> a ex:Medicine;
  ex:hasFunction "妇人漏血崩中。";
  ex:hasName "鲍鱼汤";
  ex:hasPrescription "鲍鱼3两，当归3两（切），阿胶（炙）4两，艾（如鸡子大）3枚。";
  ex:hasUsage "上以酒3升，水2升合煮，取2升5合，去滓，纳胶烊令尽，1服8合，日3服。" .

<medicine:鲍鱼羹> a ex:Medicine;
  ex:hasFunction "产后乳汁不下。";
  ex:hasName "鲍鱼羹";
  ex:hasPrescription "鲍鱼肉（切细）半斤，麻子仁（别研）1两半，香豉（别研）半合，葱白（切碎）3茎。";
  ex:hasUsage "先取鲍鱼肉，以水3升煮熟，后入麻仁、豉、葱白等煮作羹。任意食之。" .

<medicine:鲎鱼胆散> a ex:Medicine;
  ex:hasFunction "大风癞。";
  ex:hasName "鲎鱼胆散";
  ex:hasPreparation "上药一处细研，时点少许水，研水银星尽为度。";
  ex:hasPrescription "鲎鱼胆（生用）半两，白矾（生用）半两，绿矾（生用）半两，腻粉半两，水银半两，麝香半两。";
  ex:hasUsage "本方方名，《本草纲目》卷四十五引作“鲎胆散”。" .

<medicine:鲛鱼皮散> a ex:Medicine;
  ex:hasFunction "五尸鬼疰，百毒恶气。";
  ex:hasName "鲛鱼皮散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "鲛鱼皮（炙）1两，朱砂1两，雄黄1两，金牙椒1两，天雄1两，细辛1两，鬼臼1两，麝香1两，干姜1两，鸡舌香1两，桂心1两，莽草1两，贝母半两，蜈蚣（炙）2枚，蜴蜥（炙）2枚。";
  ex:hasUsage "每服半钱匕，渐增至5分匕，温清酒送下，日3次。" .

<medicine:鲜冬瓜叶> a ex:Medicine;
  ex:hasFunction "据报道，用本方治小儿夏季热，经三年临床验证，疗效满意。";
  ex:hasName "鲜冬瓜叶";
  ex:hasPreparation "水煎代茶，给患儿频频喂饮。";
  ex:hasPrescription "鲜竹叶、鲜冬瓜叶各50克，鲜荷叶1张，冰糖适量。";
  ex:hasUsage "每日1剂，连服7～10日。" .

<medicine:鲜包菜饴糖汁> a ex:Medicine;
  ex:hasFunction "清热止痛，促进溃疡愈合。适用于胃、十二指肠溃。早期疗效明显。";
  ex:hasName "鲜包菜饴糖汁";
  ex:hasPreparation "将包心菜用冷开水洗净后捣烂，置消毒纱布中绞汁。";
  ex:hasPrescription "鲜包心菜 饴糖适量";
  ex:hasUsage "每日上、晚饭前，取鲜包心菜汁1杯，加温后，加入适量饴糖饮服。每日2次，每10天为一个疗程。" .

<medicine:鲜橙汁冲米酒> a ex:Medicine;
  ex:hasFunction "行气，止痛。适用于妇女急性乳腺炎早期，妇女哺乳期乳汁排出不畅、乳房红肿、硬结疼痛等。";
  ex:hasName "鲜橙汁冲米酒";
  ex:hasPreparation "将米酒冲入鲜橙汁内即可。";
  ex:hasPrescription "鲜橙汁半碗 米酒1～2汤匙";
  ex:hasUsage "每日2次饮服。" .

<medicine:鲜芹菜汁> a ex:Medicine;
  ex:hasFunction "降血压，平肝，镇静，解痉，和胃止吐，利尿。适用于眩晕头痛、颜面潮红、精神易兴奋的高血压患者。";
  ex:hasName "鲜芹菜汁";
  ex:hasPreparation "将鲜芹菜洗净，放入沸水中汤2分钟，切碎绞汁。";
  ex:hasPrescription "鲜芹菜250克";
  ex:hasUsage "每服1小杯，每日2次。" .

<medicine:鲢鱼小米粥> a ex:Medicine;
  ex:hasFunction "通经下乳。适用于产后乳少。";
  ex:hasName "鲢鱼小米粥";
  ex:hasPreparation "先煮小米，待水沸开时，将鱼及丝瓜仁放入锅内再煮，至熟。";
  ex:hasPrescription "活鲢鱼1条 丝瓜仁10克 小米100克";
  ex:hasUsage "空腹吃鱼喝粥。" .

<medicine:鲤鱼头煮冬瓜> a ex:Medicine;
  ex:hasFunction "利水消肿，下气通乳。适用于脾虚型妊娠水肿。";
  ex:hasName "鲤鱼头煮冬瓜";
  ex:hasPreparation "将鱼头洗净去鳃，冬瓜去皮切成块，把炒锅放在文火上，倒入鲤鱼头、冬瓜加水1000克煮沸，待鲤鱼头熟透即可。";
  ex:hasPrescription "鲤鱼头1个 冬瓜90克";
  ex:hasUsage "吃鲤鱼头饮汤，每日1次。一般服5～7次有效。" .

<medicine:鲤鱼散> a ex:Medicine;
  ex:hasFunction "产后恶血不散，冲心痛闷。";
  ex:hasName "鲤鱼散";
  ex:hasPreparation "上件药，同入于固济了瓷瓶内，密封泥，候干，用炭火烧令通赤，待冷取出，入麝香1分，同研令极细。";
  ex:hasPrescription "鲤鱼2两，乱发1两，皂荚1挺（长7-8寸者），硇砂1两，穿山甲1两，香墨半两。";
  ex:hasUsage "本方方名，《普济方》引作“鳣鱼散”。方中鲤鱼，《普济方》引作“鳣鱼”。" .

<medicine:鲤鱼汁> a ex:Medicine;
  ex:hasFunction "妊娠小便淋。";
  ex:hasName "鲤鱼汁";
  ex:hasPrescription "鲤鱼1头重半斤（煮治如食法），葵菜6茎（去根），葱白2茎（细切）。";
  ex:hasUsage "以水5盏，煮令熟，入少许盐，取却鱼菜等，将汁饮之。" .

<medicine:鲤鱼汤> a ex:Medicine;
