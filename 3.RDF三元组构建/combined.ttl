  ex:hasPrescription "山栀（炒黑）、青黛（飞）、香附（童便浸5日）、抚芎、神曲（炒）、苍术（米泔浸7日）。" .

<medicine:火醋锭子> a ex:Medicine;
  ex:hasFunction "面上热疮，耳上热疖。";
  ex:hasName "火醋锭子";
  ex:hasPreparation "和为锭。";
  ex:hasPrescription "大黄（用醋浸晒九次）。";
  ex:hasUsage "火酒磨涂。" .

<medicine:火门串> a ex:Medicine;
  ex:hasFunction "泄泻，红白痢疾。";
  ex:hasName "火门串";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "蛤粉1钱，熟大黄3分，木通1钱，丁香1对。";
  ex:hasUsage "作1服。" .

<medicine:火食丸> a ex:Medicine;
  ex:hasFunction "脾虚弱，不进饮食，翻胃不食。";
  ex:hasName "火食丸";
  ex:hasPreparation "上为末，用生姜自然汁为丸，如梧桐子大。";
  ex:hasPrescription "陈仓米1升（黄土炒米熟，去土），白豆蔻仁1两，丁香1两，缩砂仁2两。";
