  ex:hasPrescription "海带、贝母、青皮、陈皮各等分。";
  ex:hasUsage "《种福堂方》有海藻。" .

<medicine:海带散> a ex:Medicine;
  ex:hasFunction "风口噤，牙关不开。";
  ex:hasName "海带散";
