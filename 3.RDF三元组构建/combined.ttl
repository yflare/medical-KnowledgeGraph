<medicine:长肌丸> a ex:Medicine;
  ex:hasFunction "小儿无辜疳，面黄发直，时时壮热，食不生肌。";
  ex:hasName "长肌丸";
  ex:hasPreparation "上7味，捣罗4味为末，与3味研者拌匀，滴水为丸，如绿豆大。";
