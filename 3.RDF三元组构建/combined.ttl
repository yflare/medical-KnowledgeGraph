  ex:hasPreparation "上为粗末。";
  ex:hasPrescription "大青（去根）1两，吴蓝（去根）半两，石膏（研）1两，芍药1两。";
  ex:hasUsage "每服3钱匕，以水1盏，加葱白、盐豉各少许，煎至6分，去滓，临卧温服。" .

<medicine:大青饮子> a ex:Medicine;
  ex:hasFunction "热病6日不解，通身内热，毒气令人更相染着。";
  ex:hasName "大青饮子";
  ex:hasPreparation "上细锉。";
  ex:hasPrescription "大青2两，石膏3两，香豉2合，葛根1两（锉），栀子仁1两，生地黄2两，川芒消3两，甘草半两（炙微赤，锉）。";
  ex:hasUsage "每服半两，以水1大盏，煎至5分，去滓温服，不拘时候。" .

<medicine:大青龙加味汤> a ex:Medicine;
  ex:hasFunction "瘅疟。";
  ex:hasName "大青龙加味汤";
  ex:hasPrescription "石膏6钱，麻黄8分，桂枝4分，杏仁（去皮尖）3钱，甘草5分，葛根1钱5分。" .

<medicine:大青龙加黄芩汤> a ex:Medicine;
  ex:hasFunction "太阳无汗，恶风烦躁。寒疫头痛，身热无汗，恶风烦躁者。";
  ex:hasName "大青龙加黄芩汤";
  ex:hasPrescription "麻黄2两，桂枝6钱2字半，甘草6钱2字半，杏仁40个，生姜1两，大枣12枚，石膏2鸡子大，黄芩6钱2字半。";
  ex:hasUsage "《济阳纲目》本方用法：每服五钱，水煎，温服，取汗。" .

<medicine:大青龙汤> a ex:Medicine;
  ex:hasClinicalApplication "临床主要用于治疗感冒、急性支气管炎、支气管哮喘等病症。";
  ex:hasFunction "发汗解表，清热除烦。主外感风寒，兼有里热，恶寒发热，身疼痛，无汗烦躁，脉浮紧3亦治溢饮，见上述症状而兼喘咳面浮者。";
  ex:hasName "大青龙汤";
  ex:hasPrescription "麻黄12克（去节）桂枝4克（去皮）甘草5克（炙）杏仁6克（去皮、尖）生姜9克（切）大枣10枚（擘）石膏20克（碎）";
  ex:hasUsage "上七味，用水900毫升，先煮麻黄，减200毫升，去上沫，纳诸药，煮取300毫升，去滓，温服100毫升。现代用法：水煎服。" .

<medicine:大顺丸> a ex:Medicine;
  ex:hasFunction "痰裹食积肿胀。";
  ex:hasName "大顺丸";
  ex:hasPreparation "老米糊为丸。";
  ex:hasPrescription "罗卜子5钱，连翘5钱，山楂肉2两，广术4钱，陈皮7钱，砂仁5钱，赤茯苓1两，神曲1两，半夏1两，白术1两。";
  ex:hasUsage "每服1钱2分，小儿减半。" .

<medicine:大顺散> a ex:Medicine;
  ex:hasAlias "二宜汤";
  ex:hasFunction "温中散暑。主冒暑伏热，引饮过多，脾胃受湿，水谷不分，清浊相干，阴阳气逆，霍乱呕吐；脏腑冷热不调，泄泻多渴，心腹烦闷，痢下赤白，腹痛后重；中阴暑，食少体倦，发热作渴，腹痛吐泻，脉沉微者。";
  ex:hasName "大顺散";
  ex:hasPreparation "上先将甘草用白沙炒及8分黄熟，次入干姜同炒，令姜裂，再入杏仁又同炒，候杏仁不作声为度，用筛隔净，后入桂，一处捣罗为散。";
  ex:hasPrescription "甘草（锉寸长）30斤，干姜4斤，杏仁（去皮尖，炒）4斤，肉桂（去粗皮，炙）4斤。";
  ex:hasUsage "二宜汤（原书卷十）。①《景岳全书》：此方加附子，即名“附子大顺散”。②本方改为丸剂，名“杏仁丸”（见《普济方》）。" .

<medicine:大顺汤> a ex:Medicine;
  ex:hasFunction "难产。";
  ex:hasName "大顺汤";
  ex:hasPrescription "人参2钱，砂仁1钱，麻油1两（熬）。";
  ex:hasUsage "水煎服。" .

<medicine:大顺饮> a ex:Medicine;
  ex:hasFunction "冒暑毒，烦渴吐泻，腹痛，发热，神昏；或衄血、咯血，及大腑下血，小便黄少，口干汗多。";
  ex:hasName "大顺饮";
  ex:hasPreparation "上先以生姜方切如绿豆样，石钵内略杵烂，入面再杵匀，摊作薄片，烈日中晒干；赤茯苓、粉草2味细锉，同前姜、面片或晒或焙，合研为末。";
  ex:hasPrescription "细面20两，生姜16两，赤茯苓（去皮）5两，粉草5两。";
  ex:hasUsage "每服1钱至2钱，新汲井水或温热汤调服，不拘时候。" .

<medicine:大风丸> a ex:Medicine;
  ex:hasFunction "疥癞。";
  ex:hasName "大风丸";
  ex:hasNote "忌咸酱辛辣及一切发物、房事。";
  ex:hasPreparation "上为细末，白米烂饭为丸，如梧桐子大。";
  ex:hasPrescription "大风子1斤，全蝎1两半，蝉蜕2钱半，当归尾5钱，白僵蚕2钱半，苦参2两，防风2两，羌活2两，独活1两，大黄1两，荆芥1两，川芎1两，乌蛇肉2两。";
  ex:hasUsage "每服50丸，茶清送下。" .

<medicine:大风丹> a ex:Medicine;
  ex:hasFunction "癣痒各疮。";
  ex:hasName "大风丹";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "大风子肉3钱，土硫黄2钱，枯矾1钱，明雄2钱。";
  ex:hasUsage "灯油调搽。" .

<medicine:大风子丸> a ex:Medicine;
  ex:hasFunction "疠风。";
  ex:hasName "大风子丸";
  ex:hasPreparation "上为末，米糊为丸，如无患子大。";
  ex:hasPrescription "大风子1两7钱。";
  ex:hasUsage "日服30丸。" .

<medicine:大风子油> a ex:Medicine;
  ex:hasFunction "杀虫攻毒，去腐生新。主风湿癣疮，疥疮，癞疮，杨梅毒疮。";
  ex:hasName "大风子油";
  ex:hasPreparation "打油去尽水气为度。";
  ex:hasPrescription "大风子不拘多少。";
  ex:hasUsage "用时搽敷患处，油纸裹之。" .

<medicine:大风子膏> a ex:Medicine;
  ex:hasFunction "肺风并鼻。";
  ex:hasName "大风子膏";
  ex:hasPreparation "上药各为末，另入大风子膏和匀，更入桕油，杵百余即成膏矣。";
  ex:hasPrescription "大风子（去壳）10个，木鳖子（去壳）10个，硫黄3分，轻粉3分。";
  ex:hasUsage "上药捣成膏。不时以自己唾津调擦患处。" .

<medicine:大风引汤> a ex:Medicine;
  ex:hasAlias "风引汤";
  ex:hasFunction "妇人中风。";
  ex:hasName "大风引汤";
  ex:hasNote "忌海藻、菘菜、猪肉醋物、蒜、面、生菜等物。";
  ex:hasPreparation "上切。";
  ex:hasPrescription "小风引汤加麻黄、苁蓉、附子、当归、羚羊角各等分。";
  ex:hasUsage "上(口父)咀。每服3钱，水1盏，加生姜3片，杏仁5个（去皮尖，捶碎），同煎至7分，去滓温服。" .

<medicine:大风引酒> a ex:Medicine;
  ex:hasFunction "有祛风利湿止痛的功效，主治风湿痛，遍身胀满。";
  ex:hasName "大风引酒";
  ex:hasNote "因制附子之毒性，可小量服之，观察效果，再酌加至治疗量。";
  ex:hasPrescription "制附子16g 枳实20g 泽泻20g 陈皮20g 茯苓20g 防风20g 大豆100g （原方有甘草） 水1000ml 米酒1000ml";
  ex:hasUsage "每日服1份，3份为1疗程。" .

<medicine:大风桃杏油> a ex:Medicine;
  ex:hasFunction "癞疥，沿皮蛀，肥疮并癣。";
  ex:hasName "大风桃杏油";
  ex:hasPrescription "大风子肉1两，桃仁5钱，杏仁5钱。";
  ex:hasUsage "上3味，以蜡烛油不拘多少。熔化滤清同煎，不可太焦，捞出研烂；如干，加油少许，如糊粥，调匀候用；如多加轻粉，少加樟脑，调匀。敷各肥疮，并发疮痒者，加升药，共蜡烛油倾入瓦罐内收贮，日后要煎，仍将此油；如煎过10次油用更妙。" .

<medicine:大风水银膏> a ex:Medicine;
  ex:hasFunction "远年近日疮癞，脓窠风癣，及鹅掌风。";
  ex:hasName "大风水银膏";
  ex:hasNote "忌食鸡、鹅、羊肉、猪首肠蹄、辛辣发毒之物。";
  ex:hasPreparation "上各为极细末，和匀，桕油化开，为丸。";
  ex:hasPrescription "牙消4两，绿矾（2味烧酒炒过）4两，白矾4两（同入罐内，泥封固，煅2炷香足，取出为极细末），水银2两，黑铅2两（入铁勺内化开，煅过，为细末），胆矾5钱（另研极细末），川椒（另研）2两，杏仁（去皮尖，另研）2两，蛇床子（另研）2两，半夏2两，硫黄（另研）2两，槟榔（以水浸1宿，细片，同水磨2-3次，连水晒干）2两，杜木鳖（去壳，细切薄片，另研）2两，雄黄（另研）2两，大风子（去壳，细切片）3两，油核桃3两（2味共研），桕油烛2斤。";
  ex:hasUsage "用川椒、葱白、甘草煎汤，洗去腌脓，软绢拭干后用药。手内揉软，揩擦疮上，2-3次效。" .

<medicine:大风油> a ex:Medicine;
  ex:hasFunction "肺风，面赤鼻赤。";
  ex:hasName "大风油";
  ex:hasPreparation "上以草乌尖为末，入麝研匀：次用大风子油，瓷盒子盛，于火上调匀。";
  ex:hasPrescription "草乌尖7个，大风油50文，真麝香50文。";
  ex:hasUsage "先以生姜擦患处，次用药擦之，每日2-3次。" .

<medicine:大风神验方> a ex:Medicine;
  ex:hasFunction "大风。";
  ex:hasName "大风神验方";
  ex:hasPreparation "上先用好酒5升浸苦参于瓷瓶内，以重汤煮1复时，其锅釜下火亦不用绝猛，但令常小沸为候，经一复时足，即取出，滤去滓，只将酒浸乳香于银锅内煎如汤即止。入天麻末4两，大麻仁2两（别研如膏），入于乳香膏内，研搅令匀，慢火熬之，可丸即丸，如梧桐子大。";
  ex:hasPrescription "通明乳香20两，苦参4两（肥好者。细锉）。";
  ex:hasUsage "每服20丸，空心及夜饭前以大麻仁酒送下。" .

<medicine:大风膏> a ex:Medicine;
  ex:hasFunction "诸般风搐。";
  ex:hasName "大风膏";
  ex:hasPreparation "上为末，炼蜜为丸，（久留，用面糊丸），如小指头大。";
  ex:hasPrescription "花蛇（酒浸，去皮骨）1条，蜈蚣（酒浸，去粪）1条，全蝎5个（去毒），蛇含石2两（烧红，醋淬7遍），大赭石1两（烧红，醋淬7遍），天竺黄5钱，天麻3钱，防风1两，青黛3钱，紫粉3钱，僵蚕（炒去丝）5钱，白附子5钱，辰砂5钱，麝香半钱，天南星3两（姜汁浸，焙干）。";
  ex:hasUsage "本方方名，据剂型当作“大风丸”。方中花蛇用量原缺。" .

<medicine:大风门散> a ex:Medicine;
  ex:hasFunction "跌打之后，伤入骨髓、隐隐疼痛，四肢沉重，麻木无力。";
  ex:hasName "大风门散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "独活1两，羌活1两，木瓜1两，川牛膝1两，威灵仙1两，细辛5钱，制首乌5钱，钻地风5钱，川乌（炮，去尖）5钱，防风5钱，川芎5钱，五加皮5钱，苍术（炒）5钱，白芷5钱，草乌（泡，去皮尖）5钱，穿山甲5钱。";
  ex:hasUsage "每服1钱，酒送下。" .

<medicine:大风门顶> a ex:Medicine;
  ex:hasFunction "无名肿毒，痈疽发背，筋骨疼，痛风流注。";
  ex:hasName "大风门顶";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "川芎5钱，草乌5钱，川乌5钱，乳香3钱，秦艽1钱5分，川牛膝3钱，羌活3钱，防风3钱，地龙3钱，桂枝1两，麻黄1两，当归5钱，虎骨3钱，白芷5钱，红花5钱，独活5钱，川木鳖2两（水煮胀，去皮毛，麻油炸黄），木瓜3钱，苍术3钱，5加皮3钱，蕲蛇肉3钱，原麝香5分。";
  ex:hasUsage "每服7-8分至1钱，陈酒送下。另加山杨柳4两（即芫花根），朴消1两，作掺敷药。" .

<medicine:大风龙胆膏> a ex:Medicine;
  ex:hasFunction "大风疾。";
  ex:hasName "大风龙胆膏";
  ex:hasPreparation "掘地坑深3尺，令净，安瓜于内，以乌蛇胆、消梨置于瓜上，以土隔盖之；至21日看1度，瓜未甚坏，候49日，3物俱化为水，在瓜皮内取出。";
  ex:hasPrescription "冬瓜1个（截去5寸长，去瓤），乌蛇胆1个，消梨1个。";
  ex:hasUsage "每用1茶脚，以酒和服之，2-3次立愈。小可风疾，每服1匙头。" .

<medicine:大飞扬洗剂> a ex:Medicine;
  ex:hasFunction "慢性湿疹。";
  ex:hasName "大飞扬洗剂";
  ex:hasPrescription "大飞扬500g，青凡本1000g，毛麝香12g。";
  ex:hasUsage "上药加水2.250升，煎成750毫升，湿敷、坐浴或外洗。" .

<medicine:大饼子> a ex:Medicine;
  ex:hasFunction "惊泻。";
  ex:hasName "大饼子";
  ex:hasPreparation "上为末，滴水为饼，如棋子大。";
  ex:hasPrescription "大附子（破，炮，净）2片，韶粉1块（附子大），藿香5钱，丁香50粒。";
  ex:hasUsage "每服1饼，饭饮化下。" .

<medicine:大香甲散> a ex:Medicine;
  ex:hasAlias "大香甲丸散";
  ex:hasFunction "补血海，调气。主妇人血脏风虚冷气，肌肉黄瘦，饮食进退，经候不匀，心腹多胀，渐变如劳。";
  ex:hasName "大香甲散";
  ex:hasPrescription "沉香半两，鳖甲（汤浸，去裙襕，炙令黄香用）1两，柴胡（去芦）半两，人参半两，桔梗半两，茯苓（去皮）半两，川芎半两，藿香叶半两，羌活半两，木香半两，陈橘皮（去白）半两，牡丹皮半两，安息香半两，当归半两，厚朴半两（姜汁炙令香），京三棱半两（炮），官桂（去皮）半两，附子（炮，去皮脐）半两，牛膝（去苗）半两，桃仁（汤浸，去皮尖）半两，和皮大腹子1分。";
  ex:hasUsage "大香甲丸散（《妇人良方》卷五）。" .

<medicine:大香连丸> a ex:Medicine;
  ex:hasAlias "香连丸、二味香连丸";
  ex:hasFunction "丈夫妇人肠胃虚弱，冷热不调，泄泻烦渴，米谷不化，腹胀肠鸣，胸膈痞闷，胁肋胀满；或下痢脓血，里急后重，夜起频并，不思饮食；或小便不利，肢体怠惰，渐即瘦弱。";
  ex:hasName "大香连丸";
  ex:hasPreparation "上为细末，醋糊为丸，如梧桐子大。";
  ex:hasPrescription "黄连（去芦须）20两（用茱萸10两同炒令赤，去茱萸不用），木香（不见火）4两8钱8分。";
  ex:hasUsage "香连丸（《直指》卷十四）、二味香连丸（《全国中药成药处方集》青岛方）。" .

<medicine:大香连圆> a ex:Medicine;
  ex:hasFunction "治丈夫、妇人肠胃虚弱，冷热不调，泄泻烦渴，米谷不化，腹胀肠鸣，胸膈痞闷，胁肋胀满，或下痢脓血，里急后重，夜起频并，不思饮食，或小便不利。肢体怠惰，渐即瘦弱，并宜服之。";
  ex:hasName "大香连圆";
  ex:hasPrescription "黄连（去芦.须）二十两（用茱萸十两同炒令赤，去茱萸不用），木香（不见火）四两八钱八分。";
  ex:hasUsage "每服二十圆，饭饮吞下。" .

<medicine:大驱风散> a ex:Medicine;
  ex:hasFunction "卒中欲死，风攻身体及五脏，言语謇涩，神思昏昧。";
  ex:hasName "大驱风散";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "麻黄2两（去节），芎1两半，石膏1两半，肉桂3分，白芷3分，甘草（炙）3分，干姜（炮）3分，当归（炒）3分，黄芩3分，杏仁（去皮尖，炒黄）3分。";
  ex:hasUsage "每服4钱，以水1中盏，煎至6分，去滓稍热服，不拘时候。以汗出为度。一法，入荆沥5合同煎，大验。" .

<medicine:大鳖头足丸> a ex:Medicine;
  ex:hasFunction "小儿胁下积气，羸瘦骨立，圊便不节。";
  ex:hasName "大鳖头足丸";
  ex:hasPreparation "上为末，炼蜜为丸，如胡豆大。";
  ex:hasPrescription "鳖头1具（酒浸1宿，炙令黄），鳖足1具（酒浸1宿，炙令黄），干漆2分（炒），紫芝3分，芍药3分，人参3分，栝楼根3分，甘草4分。";
  ex:hasUsage "每服1丸，1日3次。鳖截之，去颔，下段足，取腕前。" .

<medicine:大鳖甲丸> a ex:Medicine;
  ex:hasFunction "虚劳积聚，心腹胀满，喘促气逆，面色萎黄，痰嗽心忪，不思饮食。";
  ex:hasName "大鳖甲丸";
  ex:hasPreparation "上为末，炼蜜为丸，如梧桐子大。";
  ex:hasPrescription "鳖甲1枚重2两（去裙襕，醋炙），柴胡（去苗）1两，大黄（湿纸裹煨）1两，熟干地黄（焙）1两，乌梅（去核，炒）1两，桃仁（汤浸，去皮尖、双仁，炒）1两，干姜（炮）半两，槟榔（锉）半两，木香半两，人参半两，白茯苓（去黑皮）半两，芎半两，桂（去粗皮）半两，紫菀（去苗土）半两，芍药半两，牛膝（酒浸，切，焙）半两，知母（焙）半两，京三棱（炮，锉）半两，五味子半两，白术半两，黄连（去须）半两，厚朴（去粗皮，姜汁炙）半两，黄芩（去黑心）半两，陈橘皮（汤浸，去白，炒）半两，枳壳（去瓤，麸炒）半两，当归（切，焙）半两。";
  ex:hasUsage "每服20丸至30丸，温酒送下，1日3次。" .

<medicine:大鳖甲汤> a ex:Medicine;
  ex:hasFunction "脚弱风毒，挛痹气上。江东岭南，瘴毒脚气，或其中即脚膝肿满，心神闷乱，寒热痰逆，头痛口干，肩背拘急，肢节烦疼，不欲饮食。";
  ex:hasName "大鳖甲汤";
  ex:hasPrescription "鳖甲（炙）1两，防风1两，麻黄（去节）1两，半夏（洗）1两，白术1两，茯苓1两，芍药1两，杏仁（去皮尖双仁）1两，麦门冬（去心）1两，生姜（切）1两，人参1两，石膏（碎）1两，羚羊角（屑）1两，甘草（炙）1两，犀角1分（屑），雄黄半两（研），青木香2两，吴茱萸半升，大黄1分半，麝香3分，薤白14枚（切），乌梅7枚，贝齿7枚，大枣20枚（擘），赤小豆24枚。";
  ex:hasUsage "上(口父)咀。以水2斗，煮取4升。分4服，日2夜1服。" .

