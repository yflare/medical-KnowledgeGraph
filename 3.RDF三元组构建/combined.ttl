  ex:hasUsage "每服30丸，空心、食前酒、饮任意送下。" .

<medicine:地仙丹> a ex:Medicine;
  ex:hasAlias "秘传地仙丹";
  ex:hasFunction "令发黑，延年，久服貌如童子，齿落重生，行如奔马，夜视有光。主";
  ex:hasName "地仙丹";
