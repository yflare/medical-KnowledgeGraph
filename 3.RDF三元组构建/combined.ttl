  ex:hasUsage "每日置屋内烧烟，令气透入鼻中；或以粗末，炉中烧之，更为简便。另加芸香1两共研，尤妙。" .

<medicine:辟瘟散> a ex:Medicine;
  ex:hasFunction "伤风伤寒，憎寒壮热，头痛身痛，项痛，背强腰痛，目胀鼻塞，身重，风痰咳嗽，上呕下泻，口渴便赤，内伤饮食，外感风寒四时不正之气，霍乱转筋，痧症，瘟疫，瘴气，疠气、疟疾、赤眼、口疮、湿流毒、流注、脚气、腮肿、火喉、喉痈，喉风，喉肿，痢，热斑症，赤游。并治朱砂症，又名心经症，其病即起，初时脉息周散，牙关紧闭，手足麻木，浑身发软，闭目不语，喉肿心疼，心慌。";
  ex:hasName "辟瘟散";
  ex:hasPreparation "上为细末，绸绢节净，用好瓶收贮，勿令漏气。";
  ex:hasPrescription "茅山苍术5钱，草果（去壳，煨）2钱，贯仲2钱，羌活2钱，生甘草2钱，法半夏2钱，川芎2钱，公丁香2钱，防风1钱，荆芥尾2钱，细辛1钱，枳壳2钱，皂角（去皮，刮去子）2钱，香薷1钱，豆砂1钱，石菖蒲1钱，滑石2钱，藿香2钱，熟军2钱，桔梗1钱5分，神曲1钱，前胡2钱，白芷2钱，红胡（酒炒）1钱5分，陈皮2钱，薄荷2钱，广木香2钱，梗朴2钱。";
  ex:hasUsage "用本方治朱砂症，须急视前后心有红丝者，点用针刺破出血，内有红丝，随即挑出血，即好，出紫血即愈，可免事。惟此症传染甚多，顷刻不救，急宜早早备用。" .

<medicine:辟瘟汤> a ex:Medicine;
  ex:hasFunction "时疫瘟疠。";
  ex:hasName "辟瘟汤";
  ex:hasPreparation "上细锉。";
  ex:hasPrescription "甘草2钱，大黄2钱，皂荚1钱（并生用）。";
  ex:hasUsage "用水2盏，煎至1盏，去滓，空心热服。至晚下恶物为效。" .

<medicine:辟瘟线香> a ex:Medicine;
  ex:hasFunction "熏治蛇虫毒气、瘴气、六畜瘟疫。";
  ex:hasName "辟瘟线香";
  ex:hasPreparation "上为细末，作成线香。";
  ex:hasPrescription "苍术12斤，桃枝12斤，香芷8斤，山奈8斤，甘松2斤，大茴2斤，桂皮2斤，香附2斤，檀香2斤，降香2斤，乌头2斤，白蒺藜1斤，贯仲1斤，鬼箭1斤，雄黄8两，雌黄8两，榆面量用。";
  ex:hasUsage "闭户焚之，令烟气随息出入。" .

<medicine:辟瘟集祥香> a ex:Medicine;
  ex:hasFunction "天行瘟疫，瘟病，闻之易愈，并不传染。主";
  ex:hasName "辟瘟集祥香";
  ex:hasPreparation "上药晒干研细，榆面拌匀，令做香匠以细竹丝为骨，做成线香。";
  ex:hasPrescription "苍术12斤，桃枝（向东南者）12斤，白芷8斤，山奈8斤，檀香3斤，降香3斤，甘松3斤，大茴香3斤，桂皮3斤，香附3斤，乌头2斤，贯众1斤，鬼箭羽1斤，白蒺藜1斤，雄黄8两，雌黄8两。";
  ex:hasUsage "随时焚点。" .

<medicine:辟瘴饮子> a ex:Medicine;
  ex:hasFunction "瘴时行。无事之时，先服此则不感染。主";
  ex:hasName "辟瘴饮子";
  ex:hasPrescription "陈皮7分，半夏1钱（制），茯苓7分，厚朴（姜制）7分，人参5分，枳壳（炒）5分，砂仁（炒）5分，甘草（炙）3分。";
  ex:hasUsage "上以水2钟，加生姜3片，大枣2枚，煎1钟服。" .

<medicine:辟秽丹> a ex:Medicine;
  ex:hasAlias "祛秽散、辟秽散";
  ex:hasFunction "辟秽气。主";
  ex:hasName "辟秽丹";
  ex:hasPreparation "上为细末，水为丸，如弹子大，久窨为妙。";
  ex:hasPrescription "细辛半两，甘松1两，川芎2两。";
  ex:hasUsage "每烧1丸。加麝香少许尤好，无亦可。" .

<medicine:辟秽散> a ex:Medicine;
  ex:hasFunction "预防瘟疫。主";
  ex:hasName "辟秽散";
  ex:hasPreparation "上为极细末。";
  ex:hasPrescription "川芎3钱，藿香3钱，藜芦3钱，牡丹皮2钱，玄胡2钱，朱砂（水飞）1钱，雄黄（水飞）4钱，白芷4钱，牙皂4钱。";
  ex:hasUsage "每早、晚或看病出房，先噙水口中，吸些许入两鼻取嚏，出清涕为佳，再减去皂角，以为小丸，亦可噙嚼。牲畜受瘟者，以末吹入两鼻，即愈。" .

<medicine:辟秽香> a ex:Medicine;
  ex:hasFunction "辟秽。主";
  ex:hasName "辟秽香";
  ex:hasPreparation "上锉细，研末。";
  ex:hasPrescription "苍术1斤，大黄半斤。";
  ex:hasUsage "痘家常宜焚之。" .

<medicine:辟秽驱毒饮> a ex:Medicine;
  ex:hasFunction "芳香辟秽，解毒护心。主温疫热盛神昏，痰涌窍闭，舌干喉痛。";
  ex:hasName "辟秽驱毒饮";
  ex:hasPrescription "西牛黄2.4克（研，冲）人中黄9克 九节菖蒲1.5克 靛叶4.5克 忍冬蕊15克（鲜者蒸露亦可）野郁金3克";
  ex:hasUsage "水煎服。" .

<medicine:辟谷丹> a ex:Medicine;
  ex:hasFunction "强健面貌。主";
  ex:hasName "辟谷丹";
  ex:hasPreparation "各捣为末，后共捣团如拳，入甑蒸，戌时蒸至子时止，寅时出甑，午时晒干，为末。";
  ex:hasPrescription "大黑豆5斗（淘尽，蒸2遍，去皮），火麻子3斗（水浸1宿，蒸3遍，令开口）。";
  ex:hasUsage "干服，以饱为度。不许食一切他物。服4-5顿，不饥，令人红润不枯。若渴，煎麻子仁饮；若欲如旧饮食，用冬葵子仁3合研末，煎汤冷服，解下前物如金色，再用饮食，并无所损。" .

<medicine:辟谷丹砂丸> a ex:Medicine;
  ex:hasFunction "辟谷。主";
  ex:hasName "辟谷丹砂丸";
  ex:hasPreparation "上药先细切白蜡，铜器煮清酒令沸，投蜡于酒中，候蜡消，置器于冷水中，用柳木篦子不住手搅，勿令猛火，候煎成膏，取出，放于不津瓷器中，为丸，如梧桐子大。";
  ex:hasPrescription "丹砂（研，水飞过）1斤，白蜡1斤。";
  ex:hasUsage "每服10丸，温水送下。每1服得21日不饥；又1服一月不饥；再1服得100日不饥。从此3服以后，每百日1服。如服药后觉渴饮冷水1盏，服至周岁以外，自觉身轻体健，延年不老，即不饥矣。如欲饮食之时，先煮淡葵菜吃1次，然后每日依常饮食无碍。" .

<medicine:辟谷散> a ex:Medicine;
  ex:hasFunction "救荒辟谷。主";
  ex:hasName "辟谷散";
  ex:hasPreparation "上共磨为末。";
  ex:hasPrescription "山药8两，莲肉（去心皮）8两，芡实（去壳）8两，白扁豆（去壳，炒）8两，绿豆（去壳，炒，末）8两，薏苡仁（去壳）12两，小茴（炒）4两，白粳米（炒黄）2升。";
  ex:hasUsage "每用5钱，滚白汤调服；或用白汤调，蒸糕食之亦妙。" .

<medicine:辟谷木耳丸> a ex:Medicine;
  ex:hasFunction "辟谷。主";
  ex:hasName "辟谷木耳丸";
  ex:hasPreparation "上炼蜜为丸，如鸡卵大。";
  ex:hasPrescription "木耳（捣末）8两，大豆（炒熟，捣末）8两，大枣（煮熟，去皮核，研）1升。";
  ex:hasUsage "有食日服1丸，无食日服2丸，逢食即食，无食亦不饥矣。" .

<medicine:辟邪丸> a ex:Medicine;
  ex:hasFunction "预防瘟疫。主";
  ex:hasName "辟邪丸";
  ex:hasPreparation "上为末，炼蜜为丸，如梧桐子大。";
  ex:hasPrescription "雄黄1两，丹参2两，鬼箭羽2两，赤小豆2两。";
  ex:hasUsage "每服5丸，空心温水送下。" .

<medicine:辟邪丹> a ex:Medicine;
  ex:hasFunction "岚瘴、鬼疟、食疟频并者。";
  ex:hasName "辟邪丹";
  ex:hasNote "忌荤腥。孕妇不可服。";
  ex:hasPreparation "上为末，于端午日同入乳钵内，滴水为丸，分作30粒。";
  ex:hasPrescription "雄黑豆（一作小豆）49粒，绿豆49粒，信砒半钱（另研），黄丹1钱（为衣）。";
  ex:hasUsage "每服1粒，用东南桃心7枝研汁，将井花水于早晨日欲出未出时吞之，醋汤亦得，3日1服。" .

<medicine:辟邪膏> a ex:Medicine;
  ex:hasAlias "沉香降气汤";
  ex:hasFunction "婴儿血气未实，神气软弱，经履鬼神粗恶暴气，吐下青黄赤白，水谷解离，其状似发痫者，但眼不上载，脉不弦急，名曰客忤。";
  ex:hasName "辟邪膏";
  ex:hasPreparation "上为细末，次入水磨雄黄半两，细研水飞；次研麝香1钱，都拌匀，炼蜜为丸，如芡实大。";
  ex:hasPrescription "降真香（锉）半两，白胶香半两，沉香半两，虎骨（微炙）半两，鬼臼（去毛）半两，草龙胆半两，人参（去芦头）半两，白茯苓半两。";
  ex:hasUsage "沉香降气汤（《医灯续焰》卷十六）。" .

<medicine:辟邪避瘟丹> a ex:Medicine;
  ex:hasFunction "辟邪避瘟。主";
  ex:hasName "辟邪避瘟丹";
  ex:hasPreparation "生晒为末，榆粉打浆为大丸。";
  ex:hasPrescription "降香4两，檀香4两，箭羽2两，丹参2两，茅术2两，连翘心2两，白芷2两，细辛2两，当归2两，丹皮2两，佩兰2两。";
  ex:hasUsage "凡遇四时不正瘟疫流行，宜常焚烧，不致传染，岁末多烧，可以辟邪避瘟，空室久无人住，湿毒最易害人，此丹烧之，可以远害。" .

<medicine:辟风汤> a ex:Medicine;
  ex:hasFunction "诸风疾，无问新久者。半身不遂，口眼斜，语言謇涩，精神昏愦，痰涎并多，咽嗌不利；及风虚头痛目眩，旋运欲倒，或心忪健忘，恍惚不宁，手足麻痹，颤掉无力，筋脉拘急，骨节烦疼，行步艰难。";
  ex:hasName "辟风汤";
  ex:hasPreparation "上为细末，炼蜜为丸，每两作10丸，朱砂为衣。";
  ex:hasPrescription "独活（洗去土，焙干）1两，防风（去芦头）1两，吴白芷1两，桂藁本（去土）1两，麻黄（去节，微炒）1两，白芍药（去皮）1两，天麻1两，川乌头（炮裂，去皮，捶碎炒黄）半两，藿香叶（去土）半两，川芎7钱，羌活（去苗）3钱，甘草（锉，炒）半两，白花蛇（酒浸，去皮骨）半两，白僵蚕（炒黄）3钱，全蝎（去毒，炒黄色）半两，朱砂（为衣）2两，白附子（炮制，捣碎，炒微黄）4钱，天南星（牛胆酿，炒黄）4钱，远志（汤浸，去心，焙）3钱。";
  ex:hasUsage "每服1丸，细嚼或化服，用生姜汤送下，麝香汤亦得；如破伤风，豆淋酒送下；急风痫病，人参汤送下，不拘时候。" .

<medicine:辟风锭子> a ex:Medicine;
  ex:hasFunction "小儿急慢惊风；大人诸风，破伤风。";
  ex:hasName "辟风锭子";
  ex:hasPreparation "上为极细末，用麻黄1斤，甘草半斤，蜂蜜2两，煎作膏，令稀稠得宜，将前药末和匀为锭，金箔为衣。";
  ex:hasPrescription "全蝎20个（生用），牛胆南星（腊月用肥泽无病犍牛胆1个，将南星入内，悬高处49日后取出，各晒干，收用）7钱，防风5钱，白附子5钱，干生姜3钱，川乌5钱，天麻5钱，川芎5钱，白芷5钱，人参5钱，牛黄3钱，辰砂1两，麝香2钱，片脑3钱，薄荷5钱，木香5钱，白术5钱，白僵蚕20个（生用），一方加天竺黄5钱。";
  ex:hasUsage "急惊风，手足搐搦，用金银磨汤化下；慢惊风，四肢不收，昏昏如眠，不省人事，淡姜汤化下，各量儿大小虚实，或半分，1分、2分、3分，斟酌与服；大人破伤诸风，温酒下。" .

<medicine:辨毒散> a ex:Medicine;
  ex:hasFunction "一切毒及药毒。";
  ex:hasName "辨毒散";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "阿魏（研）1两，青盐（研）1两，甘草1两。";
  ex:hasUsage "如遇有毒物处，每服1钱匕，空心沸汤送下。若食着毒物，立便吐出。" .

<medicine:辰字探吐方> a ex:Medicine;
  ex:hasFunction "豁痰催吐。主喉肿、乳蛾。";
  ex:hasName "辰字探吐方";
  ex:hasPreparation "冬月用青鱼胆拌，阴干，研极细末。";
  ex:hasPrescription "真胆矾9克";
  ex:hasUsage "水调送下。" .

<medicine:辰朱虎睛丸> a ex:Medicine;
  ex:hasFunction "压惊悸，镇心脏。主小儿惊痫。";
  ex:hasName "辰朱虎睛丸";
  ex:hasPreparation "上为细末，炼蜜为丸，如鸡头子大。";
  ex:hasPrescription "辰锦朱砂1两，白茯苓1两，黄芩1两，山栀子仁1两，人参1两，虎睛1对（用仁），牛黄1分，脑1分，麝1分，犀角屑1分，钩藤4两，大黄（用湿纸裹煨）4两。";
  ex:hasUsage "每服1-2丸，用金银汤送下，人参汤亦得。" .

<medicine:辰砂一粒丹> a ex:Medicine;
  ex:hasFunction "气郁心疼，及小肠膀胱疝气，痛不可止。";
  ex:hasName "辰砂一粒丹";
  ex:hasPreparation "上为末，醋糊为丸，如枣核大，辰砂为衣。";
  ex:hasPrescription "附子、郁金、橘红各等分。";
  ex:hasUsage "每服1丸，男，酒送下；女，醋汤送下。" .

<medicine:辰砂一粒金丹> a ex:Medicine;
  ex:hasFunction "一切厥，心小肠膀胱痛不可忍者。";
  ex:hasName "辰砂一粒金丹";
  ex:hasPreparation "上为细末，醋煮糊为丸，如梧桐子大，朱砂为衣。";
  ex:hasPrescription "附子（炮）、郁金、干姜各等分。";
  ex:hasUsage "每服30丸，男子温酒送下，妇人醋汤送下，食远服。" .

<medicine:辰砂七宝散> a ex:Medicine;
  ex:hasFunction "小儿壮热，伤风壅热；夹惊伤寒；疹痘热。";
  ex:hasName "辰砂七宝散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "麻黄（去节）半两，白术半两，当归半两，大黄半两，赤芍药半两，荆芥半两，前胡半两，生地黄半两，甘草半两。";
  ex:hasUsage "伤风用生姜薄荷煎；急惊加辰砂薄荷调下。" .

<medicine:辰砂七珍散> a ex:Medicine;
  ex:hasFunction "产后血虚不语。";
  ex:hasName "辰砂七珍散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "人参1两，菖蒲1两，川芎7钱半，细辛2钱半，防风4钱，甘草（炙，一作生地）3钱半，辰砂（水飞）3钱。";
  ex:hasUsage "每服3钱，薄荷汤调下。" .

<medicine:辰砂丸> a ex:Medicine;
  ex:hasAlias "辰砂化痰丸";
  ex:hasClinicalApplication "疟：夔州潭逵病疟半年，前人方术用之略尽，皆不能效，邂逅故人窦藏臾先生口授此方，遂愈。";
  ex:hasFunction "百虫啮，沙虱、蛇、蝎、蛊毒。";
  ex:hasName "辰砂丸";
  ex:hasNote "忌热物。";
  ex:hasPreparation "上为末，粟米糊为丸，如绿豆大。";
  ex:hasPrescription "辰砂1两，雄黄（研，水飞）1两，赤足蜈蚣1两，续随子1两，麝香1分。";
  ex:hasUsage "每服1丸，冷水送下。良久身上毛旋起处，即是毒所伤，却用水调1丸，于毛旋起处绕围四畔磨涂，其虱自爆出。" .

<medicine:辰砂丹> a ex:Medicine;
  ex:hasClinicalApplication "疟痢：征南副帅大忒木儿，已未奉剌立息州，其地卑湿，军多病疟痢，予合辰砂丹、白术安胃散，多痊效。";
  ex:hasFunction "大人小儿诸种疟病。";
  ex:hasName "辰砂丹";
  ex:hasNote "忌热食一时辰；忌荤酒、果、硬物；凡治疟病，但热不寒者，勿服。";
  ex:hasPreparation "上为细末，滴水为丸，如绿豆大，朱砂为衣。";
  ex:hasPrescription "明雄黄半两，明砒5钱（同研极细），绿豆粉1两，黑豆面1两，朱砂2钱（留一半为衣）。";
  ex:hasUsage "每服1丸，未发前新水送下，小儿黄米大。" .

<medicine:辰砂乳香丸> a ex:Medicine;
  ex:hasAlias "镇惊安神丸";
  ex:hasFunction "小儿惊痫胎风，壮热瘛疭，弄舌摇头，眠睡不稳，目睛上视，口眼牵引，痰实咳嗽，咬齿谵语。";
  ex:hasName "辰砂乳香丸";
  ex:hasPreparation "上药各为细末，面糊为丸。";
  ex:hasPrescription "半夏（泡）、乳香、朱砂（各研）各等分。";
  ex:hasUsage "每服10丸，乳食后温薄荷汤送下。" .

<medicine:辰砂二宝丹> a ex:Medicine;
  ex:hasFunction "男妇杨梅结毒，或在头脑，咽喉鼻腐。";
  ex:hasName "辰砂二宝丹";
  ex:hasPreparation "上为细末，分12服。";
  ex:hasPrescription "飞辰砂2钱5分，飞滑石2钱5分。";
  ex:hasUsage "每服用土茯苓1斤和煎服之。" .

<medicine:辰砂五苓散> a ex:Medicine;
  ex:hasAlias "苓砂散";
  ex:hasFunction "分阴阳，利水道。主热泻烦谵。";
  ex:hasName "辰砂五苓散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "五冬散加辰砂、滑石、木通。";
  ex:hasUsage "灯心汤为引。" .

<medicine:辰砂五香丸> a ex:Medicine;
  ex:hasFunction "翻胃、噎膈、呕吐。";
  ex:hasName "辰砂五香丸";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "血竭1钱5分，乳香1钱5分，没药1钱5分，辰砂1钱5分，元胡1钱，化州橘红1钱。";
  ex:hasUsage "每服3分，酒送下。" .

<medicine:辰砂保命丹> a ex:Medicine;
  ex:hasFunction "急慢惊风。";
  ex:hasName "辰砂保命丹";
  ex:hasPreparation "上为末，用重午粽尖为锭，用金箔为衣。";
  ex:hasPrescription "麝香1钱，南星（炒）5钱，白附子（炮）5钱，朱砂5钱，蛇含石4两（煅7次，用米醋淬后用瓦焙干）。";
  ex:hasUsage "若急惊，薄荷汤送下；慢惊、风惊，荆芥汤化下；热惊，薄荷汤化下。" .

<medicine:辰砂僵蚕散> a ex:Medicine;
  ex:hasFunction "小儿脐风撮口。";
  ex:hasName "辰砂僵蚕散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "辰砂1钱，僵蚕（直者，去丝嘴，炒）1钱，蛇蜕皮1钱（炒），麝香半分（别研）。";
  ex:hasUsage "方中辰砂用量原缺。" .

<medicine:辰砂全蝎散> a ex:Medicine;
  ex:hasFunction "小儿初生口噤。";
  ex:hasName "辰砂全蝎散";
  ex:hasPreparation "上为极细末。";
  ex:hasPrescription "辰砂（飞）半钱，全蝎（去毒，炙）20枚，硼砂1字，龙脑1字，麝香1字。";
  ex:hasUsage "用乳母唾调，涂口唇里及牙齿上，或用猪乳少许调入口内。" .

<medicine:辰砂六一散> a ex:Medicine;
  ex:hasAlias "加味六一散";
  ex:hasFunction "小儿狂言，发搐，惊闷。";
  ex:hasName "辰砂六一散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "桂府滑石（水飞过）6两（净），大甘草（去皮，为末）1两，制辰砂3钱。";
  ex:hasUsage "用防风、荆芥、薄荷、天麻煎汤，候冷调下。" .

<medicine:辰砂利痰丸> a ex:Medicine;
  ex:hasFunction "化痰止嗽，消克饮食。主痰涎留滞，停留不散，心腹痞闷，饮食迟化，或时咳嗽、咽膈不利。";
  ex:hasName "辰砂利痰丸";
  ex:hasPreparation "上为末，生姜汁、面糊为丸，如梧桐子大，朱砂一两为衣。";
  ex:hasPrescription "神曲（炒黄）半斤，麦糵半斤，陈皮4两（去白），白矾（飞过）3两半，皂角（炙黄色，去皮子，酥炙）3两半，天南星（炮）3两半，半夏（汤洗7次）3两半，香白芷（共半夏用好酒1斤半煮，令惩炀用，晒干）3两半。";
  ex:hasUsage "每服60-70丸，煎生姜汤送下，不拘时候，茶清亦得。" .

<medicine:辰砂利膈丸> a ex:Medicine;
  ex:hasFunction "胸膈痞满，痰饮气滞，上焦窒塞，肺气不利，咳嗽喘满，呕吐痰涎，咽（口益）不利，风热相搏，头目昏痛，精神困倦。";
  ex:hasName "辰砂利膈丸";
  ex:hasPreparation "上为细末，以皂角膏子为丸，如梧桐子大，朱砂为衣。";
  ex:hasPrescription "天南星（炮）2两，白茯苓2两，干生姜2两，生犀2两，半夏半斤，白矾3两（一半生，一半枯），干山药3两，皂角1斤（去皮子弦，水3斤，熬膏子）。";
  ex:hasUsage "每服60-70丸，食后生姜汤送下。" .

<medicine:辰砂化痰丸> a ex:Medicine;
  ex:hasFunction "取膈上湿痰热积。主喘。";
  ex:hasName "辰砂化痰丸";
  ex:hasPreparation "上为末。粥为丸，如麻子大，朱砂为衣。";
  ex:hasPrescription "芫花（好醋拌匀，过一宿，瓦器不住手搅炒，令黑不要焦）半两，甘遂（湿面裹，长流水浸半日，再水洗，晒干，又云：水浸冬7，春、秋5日，或水煮亦可）3钱4分，大戟（长流水煮一时，再水洗，晒干）3钱4分，大黄（湿纸裹，爆勿焦，切，焙干，再酒润炒熟）1两半，黄柏3两（焙，炒）。";
  ex:hasUsage "每服20-30丸，临卧津液送下，或白汤1口送下。欲利，则空心服。" .

<medicine:辰砂化痰圆> a ex:Medicine;
  ex:hasFunction "治风化痰，安神定志，利咽膈，清头目，止咳嗽，除烦闷。每服十圆，生姜汤下，食后服。";
  ex:hasName "辰砂化痰圆";
  ex:hasPrescription "白矾（枯过.别研）、辰砂（飞研），各半两；南星（炮）一两，半夏（洗七次.姜汁捣.作僸）三两。" .

<medicine:辰砂半夏丸> a ex:Medicine;
  ex:hasAlias "辰半丸";
  ex:hasFunction "痰饮咳嗽。";
  ex:hasName "辰砂半夏丸";
  ex:hasPreparation "上药汤泡七次，晒干为细末，用生绢袋盛贮于瓷盆内，用净水洗，去粗滓，将洗出半夏末就于盆内日晒夜露，每日换新水，七日七夜了，澄去水，将半夏粉晒干，每半夏粉一两，入飞过细朱砂末一钱，用生姜汁糊为丸，如梧桐子大。";
  ex:hasPrescription "大半夏1斤。";
  ex:hasUsage "辰半丸（《国医宗旨》卷二）。" .

<medicine:辰砂半夏圆> a ex:Medicine;
  ex:hasFunction "治小儿肺壅痰实，咳嗽喘急，胸膈痞满，心忪烦闷，痰涎不利，呀呷有声。";
  ex:hasName "辰砂半夏圆";
  ex:hasPrescription "五灵脂（微炒.用酒研飞.去砂土）、朱砂（研飞），各一两；葶苈（水淘净.日干.别杵成膏）、杏仁（汤浸.去皮.尖及双仁.麸炒.别杵成膏）、半夏（汤浸七次.去滑.焙干），各半两。";
  ex:hasUsage "每服五圆至七圆，淡生姜汤下，食后。" .

<medicine:辰砂圆> a ex:Medicine;
  ex:hasFunction "治诸风痰盛，头痛恶心，精神昏愦，目眩心忪，呕吐痰涎，胸膈烦闷。";
  ex:hasName "辰砂圆";
  ex:hasPrescription "硼砂（研）、牛黄（研），各一钱。白附子（炮）、白僵蚕（去丝.嘴.）、天南星（炮裂.研）、蝎梢（温），各一分。辰砂（研）半两，半夏（汤洗七遍）一两。";
  ex:hasUsage "每服二十圆，用生姜荆芥汤下，不计时候。" .

<medicine:辰砂大红丸> a ex:Medicine;
  ex:hasFunction "产后寒热运闷，血气块硬疼痛不止。";
  ex:hasName "辰砂大红丸";
  ex:hasPreparation "上为末，酒煮面糊为丸，如酸枣大。";
  ex:hasPrescription "朱砂1两（一半入药，一半为衣），附子（炮）半两，没药半两，海马半钱，乳香半两，苁蓉半两，肉桂半两，玄胡半两，姜黄半两，硇砂半两，斑蝥1分，生地黄1两。";
  ex:hasUsage "方中附子、乳香、苁蓉、肉桂、玄胡、姜黄用量原缺。" .

<medicine:辰砂天麻丸> a ex:Medicine;
  ex:hasFunction "镇养心神，擒截诸风，和流荣卫，滋润筋络，开通关膈，肥密表腠。主心中风。";
  ex:hasName "辰砂天麻丸";
  ex:hasPreparation "上为末，水煮面糊为丸，如梧桐子大。";
  ex:hasPrescription "丹砂半两，天麻1两，半夏（汤煮软，焙干）半两，天南星半两，蝎蛸1分（炒），白附子半两，白僵蚕半两（炒），牛黄半两（研入），硼砂1分（研入），麝香1分（研入）。";
  ex:hasUsage "每服30丸，荆芥汤送下，不拘时候。" .

<medicine:辰砂天麻圆> a ex:Medicine;
  ex:hasFunction "治诸风痰盛，头痛目眩，旋运欲倒，呕哕恶心，恍惚健忘，神思昏愦，肢体疼倦，颈项拘急，头面肿痒，手足麻痹。常服除风化痰，清神思，利头目。";
  ex:hasName "辰砂天麻圆";
  ex:hasPrescription "川芎二两半，麝香（研）、白芷，各一两一分。辰砂（研飞.一半入药.一半为衣）、白附子（炮），各五两。天麻（去苗）十两，天南星（汁浸.切.焙干）二十两。";
  ex:hasUsage "每服二十圆，温荆芥汤下，不拘时。" .

<medicine:辰砂夺命丹> a ex:Medicine;
  ex:hasFunction "破伤风邪。";
  ex:hasName "辰砂夺命丹";
  ex:hasPreparation "上为细末，枣肉和为丸，如弹子大，朱砂为衣。";
  ex:hasPrescription "凤凰台2钱，川乌头（生）2钱，麝香少许，朱砂少许。";
  ex:hasUsage "量病人虚实加减用之，小儿半丸，鳔酒送下。以吐为度，不止，以葱白汤解之。" .

<medicine:辰砂妙圣丸> a ex:Medicine;
  ex:hasFunction "小儿惊风生涎，时作搐搦，壮热惊掣，夜卧不安，牙关紧急。";
  ex:hasName "辰砂妙圣丸";
  ex:hasPreparation "上为末，拌匀，糯米清糊为丸，如鸡头子大。";
  ex:hasPrescription "麝香半钱，川芎半钱，羌活半钱，天麻半钱，当归半钱，胆酿南星半钱，半夏（汤洗7次，煮一伏时）半钱，蝎蛸1钱半，僵蚕1钱半，辰砂1钱半（一半入药，一半为衣）。";
  ex:hasUsage "每服1丸，荆芥汤化下；如噤口，用药擦牙上。" .

<medicine:辰砂宁心散> a ex:Medicine;
  ex:hasFunction "心疾。男子妇人心血久虚，阴阳不和，忧愁思虑，睡卧不安，精神恍惚，五心烦热，骨节酸疼，面如火爁，头目昏眩，耳内蝉鸣，虚气独行，中满气隘，口无津液，状若饮酒。";
  ex:hasName "辰砂宁心散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "人参（去芦）1两半，白茯苓（去皮）1两半，木香（不见火）1两，白术（炒）1两，藿香叶（洗去土）1两，肉豆蔻（面裹煨）1两，酸枣仁（别研）1两，龙齿（别研）1两，白附子（炮）1两，远志（去心）1两，甘草（炙）1两，牡蛎粉1两，辰砂（别研）半两，肉桂（去粗皮，不见火）半两。";
  ex:hasUsage "每服2钱，水1盏，加生姜3片，大枣1个，煎7分，空心、食前、临卧温服。" .

<medicine:辰砂宁志丸> a ex:Medicine;
  ex:hasFunction "劳神过度，致伤心血，惊悸怔忡，梦寐不宁，若有人来捕捉，渐成心疾，甚至癫狂者。";
  ex:hasName "辰砂宁志丸";
  ex:hasPreparation "上为细末，用猪心一个研如泥，入前药末，并煮辰砂酒搅匀为丸，如绿豆大。";
  ex:hasPrescription "辰砂2两（用无灰酒3升煮，酒将尽留2盏用之），远志（去心）7钱，石菖蒲（去毛）7钱，7钱，酸枣仁（炒）7钱，乳香（炙）7钱，当归身（酒洗）7钱，人参5分，白茯神（去皮木）7钱，白茯苓（去皮）7钱。";
  ex:hasUsage "每服60-70丸，临卧以大枣汤送下。" .

<medicine:辰砂安惊丸> a ex:Medicine;
  ex:hasFunction "镇心。主风热涎盛，身体拘急，睡中不稳。";
  ex:hasName "辰砂安惊丸";
  ex:hasPreparation "上为细末，炼蜜为丸，如鸡头大。";
  ex:hasPrescription "天麻1分，川芎2钱，防风半两（洗，去芦头），甘草1两（炙），白附子1分，人参半两（洗），茯神半两，朱砂2钱（一半入药，一半为衣）。";
  ex:hasUsage "每服1-2丸，用薄荷、荆芥煎汤化下。" .

<medicine:辰砂安神丸> a ex:Medicine;
  ex:hasFunction "胎前伤寒，心惊发热。";
  ex:hasName "辰砂安神丸";
  ex:hasPrescription "生地、当归、柏子仁（炒去油）、枣仁（去壳，炒）、茯神（去皮木）、竹茹、砂仁。" .

<medicine:辰砂定痛散> a ex:Medicine;
  ex:hasFunction "清热解毒。主口舌生疮，咽喉肿痛，鼻腔溃疡。";
  ex:hasName "辰砂定痛散";
  ex:hasPreparation "上药共为末，收罐内。";
  ex:hasPrescription "软石膏（煅）30克 胡黄连（末）0.6克 辰砂（末）1.5克 冰片0.6克";
  ex:hasUsage "如口内则掺之，喉内、鼻内则吹之，一日五至七次。" .

<medicine:辰砂导赤散> a ex:Medicine;
  ex:hasAlias "辰砂导赤汤";
  ex:hasFunction "痘疮，心肝二经之火盛，发热，发惊者。";
  ex:hasName "辰砂导赤散";
  ex:hasPrescription "生地、木通、甘草、辰砂、滑石、黄连。";
  ex:hasUsage "服此药，惊不退者，用泻青散。" .

<medicine:辰砂抱龙丸> a ex:Medicine;
  ex:hasFunction "利惊疏风，豁痰清热。主伤寒伤风，咳嗽生痰，喘急，昏沉，发热，鼻流清涕，或吐泻、风暑十种热症，睡中惊掣，痧疹癍疮；胎风、胎惊、胎热。急慢惊风，慢脾风。";
  ex:hasName "辰砂抱龙丸";
  ex:hasPreparation "上为细末，炼蜜为丸，如芡实大，雪水糊丸尤佳。";
  ex:hasPrescription "天竺黄4钱（需要嫩白者），牛胆星1两，朱砂4钱（一半为衣），天麻5钱，雄黄（秋冬3钱、春减半、夏2钱），麝香3分（痘疹中不用），防风3钱，甘草3钱。";
  ex:hasUsage "姜汤或薄荷汤磨服。" .

<medicine:辰砂散> a ex:Medicine;
  ex:hasAlias "附子散";
  ex:hasClinicalApplication "心病：上枢正肃吴公，少时病心，服一剂，三日方寤，遂愈。";
  ex:hasFunction "伤寒内热不解，心烦恍惚，小便赤色，烦渴。";
  ex:hasName "辰砂散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "滑石1两，寒水石1两，甘草1两，辰砂5分。";
  ex:hasUsage "每服2钱，井花水或童便调下。" .

<medicine:辰砂既济丸> a ex:Medicine;
  ex:hasFunction "大补元气，涩精固阳。主元阳虚惫，精气不固，夜梦遗精。";
  ex:hasName "辰砂既济丸";
  ex:hasPreparation "上为末，用白术8两，水8碗，煎至一半，取滓再益水煎，漉净，合煎至二碗成膏为丸，如梧桐子大，辰砂研细为衣。";
  ex:hasPrescription "人参、当归（酒洗）、黄耆（盐水洗，炒）、白山药、牡蛎（酒浸1宿，煅）、锁阳、甘枸杞（蜜拌）、熟地黄（酒洗）4两，知母（去毛，酒洗，略炒）2两，败龟版（酒浸一宿，酥炙）2两，牛膝（酒洗）1两半，破故纸1两2钱，黄柏（酒炒）6钱。";
  ex:hasUsage "方中人参、当归、黄耆、白山药、牡蛎、锁阳、甘枸杞用量原缺。" .

<medicine:辰砂汤> a ex:Medicine;
  ex:hasFunction "退虚热，和胃进饮食。主心惊邪热。";
  ex:hasName "辰砂汤";
