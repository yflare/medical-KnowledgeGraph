  ex:hasFunction "治下疳湿疮。";
  ex:hasName "柏蛤散";
  ex:hasPrescription "黄柏（以瓷锋割末）蛤粉各等分";
  ex:hasUsage "上药和匀，掺患处。" .

<medicine:柏连散> a ex:Medicine;
  ex:hasFunction "面上有热毒恶疮。";
  ex:hasName "柏连散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "胡粉（炒）、黄柏（炙）、黄连各等分。";
  ex:hasUsage "以面脂或猪脂调敷，1日3次。" .

<medicine:柏霜散> a ex:Medicine;
  ex:hasFunction "杨梅癣，浑身腥臭，或干而起白屑，或肉碎而流红水者。";
  ex:hasName "柏霜散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "黄柏2钱，雄黄2钱，没药1钱，轻粉1钱，枯矾1钱，粉霜1钱，冰片3分，朱砂5分，孩儿茶3钱，蜗牛10只。";
  ex:hasUsage "猪胆汁调敷患处。" .

<medicine:柏香丸> a ex:Medicine;
  ex:hasFunction "治胬肉攀睛，或眼生血疣。";
  ex:hasName "柏香丸";
  ex:hasPreparation "上药研末，水泛丸。";
  ex:hasPrescription "侧柏叶（同大黄拌，蒸数次）香附（制）";
  ex:hasUsage "每服6克。" .

<medicine:柏黄丸> a ex:Medicine;
  ex:hasFunction "肠风脏毒，下血鲜红。";
  ex:hasName "柏黄丸";
  ex:hasPrescription "生地黄1斤，黄柏（炒）1斤。";
  ex:hasUsage "上为末，炼蜜为丸，如梧桐子大。每服80-90丸，空心、食前米饮送下。" .

<medicine:柏黄散> a ex:Medicine;
  ex:hasFunction "经血不止。";
  ex:hasName "柏黄散";
  ex:hasPreparation "上药叹咀。";
  ex:hasPrescription "黄芩1两2钱半，侧柏叶1两，蒲黄1两，伏龙肝1两。";
  ex:hasUsage "上（口父）咀。用水2升，煎取8合，分为2服。" .

<medicine:柏黛散> a ex:Medicine;
  ex:hasFunction "治日晒疮，火癍疮。";
  ex:hasName "柏黛散";
  ex:hasPrescription "黄柏6克 青黛6克";
  ex:hasUsage "各研末。麻油调搽。" .

<medicine:柑仁散> a ex:Medicine;
  ex:hasFunction "妇人里外吹乳。";
  ex:hasName "柑仁散";
  ex:hasPrescription "柑子核。";
  ex:hasUsage "每岁1粒，以阴阳瓦焙干枯，为末。热陈酒送下。即盖被出汗而愈。" .

<medicine:柑叶定痛散> a ex:Medicine;
  ex:hasFunction "酒病初发，形如感冒，被医误治，三焦受伤，死血凝结不化作痛，滞注胸膈，大痛不移。";
  ex:hasName "柑叶定痛散";
  ex:hasPrescription "柑子叶4两，葱白根3两，生姜片2两。";
  ex:hasUsage "上共捣烂如泥，用锅烙热，铺盖痛处，白布裹紧，将盐炒热，包烙。痛立止。随服异功散。" .

<medicine:柑皮汤> a ex:Medicine;
  ex:hasFunction "产后发渴，及经血过多，发渴者。";
  ex:hasName "柑皮汤";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "柑子皮（焙干）。";
  ex:hasUsage "每服3钱，白汤调下。" .

<medicine:柑皮煮散> a ex:Medicine;
  ex:hasAlias "柑皮散、柑皮煎散";
  ex:hasFunction "酒毒昏闷烦渴，或醉不醒。";
  ex:hasName "柑皮煮散";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "柑子皮2两（洗，焙干）。";
  ex:hasUsage "柑皮散（《寿亲养老》卷四）、柑皮煎散（《普济方》卷二五三）。" .

<medicine:柞叶汤> a ex:Medicine;
  ex:hasAlias "柞木散（《普济本事方》卷六），柞木饮子（《外科精要》卷上）。";
  ex:hasFunction "治痈疽发背。";
  ex:hasName "柞叶汤";
  ex:hasNote "服药期间，忌食一切毒物。";
  ex:hasPreparation "上药锉细。";
  ex:hasPrescription "柞木叶（干）120克 干荷叶120克 萱草根（干）60克 甘草节30克 地榆30克";
  ex:hasUsage "每服15克，用水500毫升，煎至250毫升，早、晚分服，滓并煎作一服。有脓血者自干，脓血在内者，自大肠下，未成者自消。" .

<medicine:查术膏> a ex:Medicine;
  ex:hasFunction "脾虚多食，停积成痢。";
  ex:hasName "查术膏";
  ex:hasPrescription "白术、查肉、陈皮、甘草。";
  ex:hasUsage "煎膏服。" .

<medicine:查糖散> a ex:Medicine;
  ex:hasFunction "产后恶血攻心，儿枕作痛。";
  ex:hasName "查糖散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "山查5钱（炒）。";
  ex:hasUsage "水煎浓，加黑沙糖3钱，和匀服之。" .

<medicine:查苏汤> a ex:Medicine;
  ex:hasFunction "产后儿枕腹痛。";
  ex:hasName "查苏汤";
  ex:hasPrescription "山查1两，苏木3钱。" .

<medicine:查补二陈汤> a ex:Medicine;
  ex:hasFunction "伤寒温疫初起3-4日之间者。";
  ex:hasName "查补二陈汤";
  ex:hasPrescription "山查、厚朴、陈皮、白茯苓、半夏、甘草。";
  ex:hasUsage "加生姜3片，水煎服。" .

<medicine:柳仙散> a ex:Medicine;
  ex:hasFunction "口舌碎痛。";
  ex:hasName "柳仙散";
  ex:hasPrescription "薄荷1钱，儿茶8分，青黛5分，川连4分，冰片2分5厘。";
  ex:hasUsage "先取野蔷薇根煎汤漱口，后吹此药。" .

<medicine:柳光散> a ex:Medicine;
  ex:hasFunction "一切顽癣。";
  ex:hasName "柳光散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "斑蝥（去翅足）2钱，大风子2钱，川槿皮3钱，枯矾3钱，轻粉3钱，白砒5分。";
  ex:hasUsage "醋调擦患处。" .

<medicine:柳华散> a ex:Medicine;
  ex:hasAlias "柳叶散";
  ex:hasFunction "热毒口疮。";
  ex:hasName "柳华散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "黄柏（炒）、蒲黄、青黛、人中白（煅）各等分。";
  ex:hasUsage "柳叶散（《保婴撮要》卷十一）。" .

<medicine:柳叶汤> a ex:Medicine;
  ex:hasFunction "漆疮。";
  ex:hasName "柳叶汤";
  ex:hasPrescription "生柳叶3斤（细切，冬用皮）。";
  ex:hasUsage "以水1斗5升，煮取7升。适寒温洗之，1日3次。" .

<medicine:柳木耳饼> a ex:Medicine;
  ex:hasFunction "痈疽疮肿，热焮疼痛。";
  ex:hasName "柳木耳饼";
  ex:hasPreparation "上为散，用浆水和，捏作饼子，如5钱厚。";
  ex:hasPrescription "柳木耳1两，龙葵根1两（锉），黄连3分（去须），川芒消1两，麦饭石3分（烧，醋淬3遍），雄雀粪1分，乳香1两，杏仁1两（其疮有头作孔者，煨，去皮尖；无孔者，和皮捣用之）。";
  ex:hasUsage "贴疮头，以单帛抹之，1日2易之。" .

<medicine:柳枝当归膏> a ex:Medicine;
  ex:hasFunction "一切热疮。";
  ex:hasName "柳枝当归膏";
  ex:hasPreparation "先令油热，下挑、柳枝熬令半焦。以绵裹当归、杏仁，同熬至桃、柳枝黑焦为度，去药滓，滤油澄净，抹去铫子中滓秽净，再上火令沸，旋旋入黄丹，熬，滴水中不散为度，或只于纸上摊透为度。";
  ex:hasPrescription "当归尾（尖细梢，水浸）1两，杏仁（浸，去皮尖）100个，黄丹（细研，水飞）6两，肥嫩柳枝3两半（切如一寸，水洗净，令干），肥嫩桃枝1两半（洗净，令干），芝麻油1斤。";
  ex:hasUsage "本方方名，《医学纲目》引作“热疮寒膏药”。" .

<medicine:柳枝散> a ex:Medicine;
  ex:hasFunction "鼻衄不止。";
  ex:hasName "柳枝散";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "寒食杨柳枝（门傍插者）1两，人参1分。";
  ex:hasUsage "每服1钱匕，新水调下，并2服。" .

<medicine:柳枝汤> a ex:Medicine;
  ex:hasFunction "牙根宣露，动摇疼痛。";
  ex:hasName "柳枝汤";
  ex:hasNote "切慎外风。";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "羌活1两，独活1两，地骨皮1两，防风（去芦头）1两，柳枝皮1两，小椒半两（去目），苍术8两（拣净，去粗皮）。";
  ex:hasUsage "每用2钱，水1盏，入柳枝，黑豆少许，同煎至7分，去滓，食后热漱冷吐，1日2-3次。" .

<medicine:柳枝浴汤> a ex:Medicine;
  ex:hasFunction "小儿生一月至五月，乍寒乍热。";
  ex:hasName "柳枝浴汤";
  ex:hasPrescription "柳枝（细切）。";
  ex:hasUsage "煮汁，浴儿。" .

<medicine:柳枝煎防风丸> a ex:Medicine;
  ex:hasFunction "大风疾，体生疮肿，瘙痒出脓，风毒极甚者。";
  ex:hasName "柳枝煎防风丸";
  ex:hasPreparation "上锉，以水7斗，于大银锅中，煎取1斗，尽滤去滓；用晚蚕沙1升，炒令香，捣罗为末，入药汁中相和，再煎稀稠得所，取出，用瓮合盛，每用酒调下后丸药：防风1两（去芦头），羌活1两，五味子1两，人参1两（去芦头），五加皮1两，白蒺藜1两（微炒，去刺），赤茯苓1两，白鲜皮1两，甘菊花1两，松子1两（去壳），乌蛇3两（酒浸，去皮骨，炒令黄），露蜂房1两（微炙）。上为末，炼蜜为丸，如梧桐子大。";
  ex:hasPrescription "倒垂柳枝2斤，桑枝2斤，槐技2斤，天寥木枝2斤，仙灵脾叶2斤。";
  ex:hasUsage "每服30丸，以温酒1中盏，入煎成药1茶匙调匀，食前送下。" .

<medicine:柳枝膏> a ex:Medicine;
  ex:hasFunction "齿历蠹。";
  ex:hasName "柳枝膏";
  ex:hasPreparation "用水3盏，煎至1盏半，去滓更煎成膏，以瓷器收。";
  ex:hasPrescription "柳枝（锉）1握，防风（去叉，锉）1分，细辛（去苗叶，锉）1分，盐花1分。";
  ex:hasUsage "每用薄纸，剪如柳叶，涂药贴齿上。" .

<medicine:柳根熨方> a ex:Medicine;
  ex:hasFunction "乳痈二三百日，众疗不愈，但坚紫色青。";
  ex:hasName "柳根熨方";
  ex:hasPreparation "熟捣、火温，帛囊贮。";
  ex:hasPrescription "柳根（削取上皮）。";
  ex:hasUsage "熨乳肿处，冷更易之。1宿即愈。" .

<medicine:柳根酒> a ex:Medicine;
  ex:hasFunction "瘤瘿。";
  ex:hasName "柳根酒";
  ex:hasPrescription "柳根3斤（须水所经露出者，锉）。";
  ex:hasUsage "用水1斗，煮取5升，用米3升，酿之酒成。每服半升，空心、日午、夜卧各1服。" .

<medicine:柳灰散> a ex:Medicine;
  ex:hasFunction "天灶丹。";
  ex:hasName "柳灰散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "柳枝（烧灰）5钱，荆芥（炒，末）2钱，滑石3钱，生甘草2钱。";
  ex:hasUsage "水调涂之。" .

<medicine:柳白散> a ex:Medicine;
  ex:hasFunction "蜘蛛咬作疮，久不愈者。";
  ex:hasName "柳白散";
  ex:hasPreparation "上并烧为灰，细研。";
  ex:hasPrescription "柳白皮1两，半夏1两。";
  ex:hasUsage "以水调涂之。" .

<medicine:柳白皮汤> a ex:Medicine;
  ex:hasFunction "脚气缓弱，疼痹肿满。";
  ex:hasName "柳白皮汤";
  ex:hasPreparation "上细锉，如棋子大。";
  ex:hasPrescription "柳白皮3升。";
  ex:hasUsage "以水1石，煎取6斗，取1小瓮子，可受1石者，纳汤瓮中，以两木横瓮底，脚踏其上，汤不得过三里穴，如此3度，即消。浸时，使汤常热佳。" .

<medicine:柳皮膏> a ex:Medicine;
  ex:hasAlias "柳木膏";
  ex:hasFunction "诸疮愈后，疮瘢胬肉未消；瘰疬风结。";
  ex:hasName "柳皮膏";
  ex:hasPreparation "上为细末，以水8斗，煮取汁2斗，去滓，移于小锅子中，下木香，煎至7升，去滓，又移于小锅中，以慢火煎，搅勿住手，炼如饧，捻得成丸即住，以细帛裹收之。";
  ex:hasPrescription "柳白皮5斤，楸皮5斤，木通1斤，枳壳半斤，皂荚1斤，木香末3两。";
  ex:hasUsage "柳木膏（《普济方》卷二七二）。方中楸皮，《普济方》作“楸叶”。" .

<medicine:柳絮散> a ex:Medicine;
  ex:hasFunction "面露疮，作脓窠如香瓣。";
  ex:hasName "柳絮散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "柳絮（捣末）、腻粉各等分。";
  ex:hasUsage "灯盏中油调涂之。" .

<medicine:柳絮矾散> a ex:Medicine;
  ex:hasFunction "小儿疳渴不止。";
  ex:hasName "柳絮矾散";
  ex:hasPrescription "柳絮矾半两，铅白霜1两，马牙消1分，芒消1分。";
  ex:hasUsage "上为散。每服1字匕，冷水调下。" .

<medicine:柳绿散> a ex:Medicine;
  ex:hasFunction "牙疳，并口、鼻、耳边疳疮。";
  ex:hasName "柳绿散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "人中白。";
  ex:hasUsage "入铜青，和令如柳色。疮湿则干掺，干则油调。" .

<medicine:柳花丹> a ex:Medicine;
  ex:hasAlias "柳黄丹";
  ex:hasFunction "镇心神。主男子三焦壅热，顾渴不止；脚气，乳石发动，狂躁不彻。";
  ex:hasName "柳花丹";
  ex:hasPreparation "上为细末，以枣肉为丸，如梧桐子大。";
  ex:hasPrescription "柳絮矾1两，铅霜1两。";
  ex:hasUsage "每服5丸，以冷金银汤送下。若路行走马，热渴不彻，即含化7丸，或常含1丸，终不患渴。" .

<medicine:柳花散> a ex:Medicine;
  ex:hasFunction "小儿走马牙疳。";
  ex:hasName "柳花散";
  ex:hasPreparation "上为末。冰片少许，研细。";
  ex:hasPrescription "人中白、青黛、黄柏末、蒲黄各等分。";
  ex:hasUsage "敷上。" .

<medicine:柳蚛屑浴汤> a ex:Medicine;
  ex:hasFunction "风瘾疹。";
  ex:hasName "柳蚛屑浴汤";
  ex:hasNote "洗浴后，宜避风。";
  ex:hasPrescription "柳蚛屑1斤，蒴藋根1斤，黄栌木1斤（锉），盐2合。";
  ex:hasUsage "以水5斗，煎至3斗，去滓，暖室中看冷热洗浴。" .

<medicine:柳蛀粪熨> a ex:Medicine;
  ex:hasFunction "柔风，筋骨疼痛。";
  ex:hasName "柳蛀粪熨";
  ex:hasPrescription "柳蛀粪2升。";
  ex:hasUsage "甑上炊1饭顷；如无柳蛀粪，用大豆5斗蒸熟。摊于床上，着旧夹衣盖村，令患人卧，蒸熨所患处。" .

<medicine:柳豆散> a ex:Medicine;
  ex:hasFunction "去齿根下热毒。主齿龈风肿。";
  ex:hasName "柳豆散";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "赤小豆2合（炒熟），黑豆2合（炒熟），柳枝1握（锉），地骨皮1两，柳蠹末半分（合）。";
  ex:hasUsage "每用4钱，以水1大盏，煎至7分，去滓，热含冷吐。" .

<medicine:柳酸乌梅膏> a ex:Medicine;
  ex:hasFunction "鸡眼。";
  ex:hasName "柳酸乌梅膏";
  ex:hasPreparation "取食盐10g，用开水50毫升，溶化后，将乌梅放入，浸泡1日，去核，放入乳钵加食醋15毫升，捣烂，最后，加水杨酸混合即成。";
  ex:hasPrescription "乌梅30g，水杨酸2g。";
  ex:hasUsage "外用。" .

<medicine:柳青丸> a ex:Medicine;
  ex:hasFunction "妊娠三月，心经火甚而堕胎。";
  ex:hasName "柳青丸";
  ex:hasPreparation "上为末，米糊为丸，如绿豆大。";
  ex:hasPrescription "川黄连（姜汁炒3次）3两。";
  ex:hasUsage "每服3-5分至7-8分，以陈皮、半夏汤送下。须于未交3月前10日服起。" .

<medicine:柳青散> a ex:Medicine;
  ex:hasFunction "大人口破。";
  ex:hasName "柳青散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "川连2钱，川柏4钱，梅片1钱，薄荷5钱，淡芩2钱，儿茶4钱，白芷1钱，甘草5分，青黛2钱5分。";
  ex:hasUsage "吹之。" .

<medicine:柳黄散> a ex:Medicine;
  ex:hasFunction "喉痛，口舌生疮，破烂。";
  ex:hasName "柳黄散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "黄连、黄柏、蒲黄、青黛、硼砂、胡黄连、芒消各等分，冰片少许。";
