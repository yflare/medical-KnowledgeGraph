  ex:hasPreparation "上为细末，过筛，混匀即得。";
  ex:hasPrescription "沉香180g，广枣180g，檀香90g，紫檀香90g，红花90g，肉豆蔻60g，天竺黄60g，北沙参60g。";
  ex:hasUsage "口服，每次3g，1日1～2次。" .

<medicine:八味清毒膏> a ex:Medicine;
