  ex:hasPrescription "黄耆3钱，人参2钱，川芎1钱，当归1钱，白芷5分，官桂5分，甘草5分，防风5分。";
  ex:hasUsage "水、酒煎，空心服。1服痛止，再服内消，10服肉生。" .

<medicine:跨鹤丹> a ex:Medicine;
  ex:hasFunction "鸡爪风。";
  ex:hasName "跨鹤丹";
  ex:hasPreparation "上为末。";
