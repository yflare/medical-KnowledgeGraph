  ex:hasUsage "每取如杏仁大，绵裹含之，有涎即吐之，日3服，夜1服，以愈为度。" .

<medicine:含汤> a ex:Medicine;
  ex:hasFunction "牙齿疼，虫痛。";
  ex:hasName "含汤";
  ex:hasPreparation "上切。";
