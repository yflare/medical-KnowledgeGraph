  ex:hasName "固肝养荣汤";
  ex:hasPrescription "大熟地5钱，当归3钱，人参2钱，川芎2钱，枸杞3钱，肉苁蓉4钱，菟丝子3钱，巴戟3钱，蒺藜3钱（炒），石斛3钱，菊花2钱，夏枯草3钱，云苓3钱，甘草1钱。";
  ex:hasUsage "水煎服。" .

<medicine:固肠丸> a ex:Medicine;
  ex:hasFunction "大肠久冷，滑泄不禁。";
  ex:hasName "固肠丸";
  ex:hasPreparation "上为细末，醋糊为丸，如梧桐子大。";
