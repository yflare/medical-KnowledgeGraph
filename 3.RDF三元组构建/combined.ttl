  ex:hasUsage "每g生药约作10丸。每次30丸，开水送下，1日2次。" .

<medicine:菊虫汤> a ex:Medicine;
  ex:hasFunction "皮肤癌。";
  ex:hasName "菊虫汤";
  ex:hasPrescription "菊花125g，蝉蜕31g，麦冬18g，花粉9g，木香3g，明雄黄3g，香附9g，白蒺藜15g，防风6g，杏仁9g，桔梗9g，甘草3g。";
  ex:hasUsage "水煎服。" .

<medicine:菊连汤> a ex:Medicine;
  ex:hasFunction "妇人胎风眼。";
