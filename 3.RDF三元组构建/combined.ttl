  ex:hasName "得生丸";
  ex:hasNote "孕妇忌服。";
  ex:hasPrescription "益母草600g 当归200g 白芍200g 柴胡100g 木香50g 川芎50g";
  ex:hasUsage "口服，一次1丸，一日2次。" .

<medicine:徙薪饮> a ex:Medicine;
