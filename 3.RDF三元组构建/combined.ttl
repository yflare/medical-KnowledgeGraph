  ex:hasName "龙硼丹";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "硼砂5分，青黛5分，山豆根5分，冰片5厘。";
  ex:hasUsage "吹喉。" .

<medicine:龙硼散> a ex:Medicine;
