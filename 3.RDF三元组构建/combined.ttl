  ex:hasFunction "补肾水。主肾水不能制火，每夜发热如火，至五更身凉，时而有汗，时而无汗，觉骨髓中内炎，饮食渐少，吐痰如白沫。";
  ex:hasName "凉髓丹";
  ex:hasPrescription "地骨皮1两，丹皮1两，麦冬5钱，金钗石斛3钱，牛膝2钱，茯苓2钱。";
  ex:hasUsage "水煎服。" .

<medicine:凌花散> a ex:Medicine;
  ex:hasAlias "凌霄花散";
  ex:hasFunction "妇人月水不行，发热腹胀。妇人腹满，身体疼痛，瘦淬食少，发热自汗。";
  ex:hasName "凌花散";
  ex:hasPrescription "当归（酒浸）、凌霄花、刘寄奴、红花（酒浸，候煎药1-2沸即入）、官桂（去皮）、牡丹皮（洗）、川白芷、赤芍药、延胡索各等分。";
  ex:hasUsage "凌霄花散（《济阴纲目》卷二）。" .

<medicine:凌阳子木香丸> a ex:Medicine;
  ex:hasFunction "滋阴养正，补肾秘真，坚骨髓，调荣卫，悦颜色，墨髭鬓。主虚损。";
  ex:hasName "凌阳子木香丸";
  ex:hasPreparation "上为细末，炼蜜为丸，如梧桐子大。";
  ex:hasPrescription "山茱萸1两（不去核），莲花蕊1两，破故纸5两，白茯苓2两，木香2两，胡桃仁半斤（微去油，烂研），菟丝子5两，（酒浸3宿，焙干）。";
  ex:hasUsage "每服70丸，空心以温酒送下，每日1次。" .

<medicine:凌霄散> a ex:Medicine;
  ex:hasAlias "五九散、凌霄花散";
  ex:hasFunction "疠风。";
  ex:hasName "凌霄散";
  ex:hasPreparation "上为极细末。";
  ex:hasPrescription "蝉壳7个，地龙（炒）7个，白僵蚕7个，全蝎7个，凌霄花半两。";
  ex:hasUsage "五九散（《儒门事亲》卷十五）、凌霄花散（《医学入门》卷八）。" .

<medicine:凌霄花丸> a ex:Medicine;
  ex:hasFunction "妇人积年血块，兼月水不通。";
  ex:hasName "凌霄花丸";
  ex:hasPreparation "上为末，糯米饭为丸，如梧桐子大。";
  ex:hasPrescription "凌霄花半两，芫花2分（醋拌，炒令干），京三棱半两（微煨，锉），木香半两，姜黄半两，水蛭1分（炒令微黄），硇砂半两，斑蝥10枚（糯米拌，炒令黄，去翅足），雄雀粪1分（微炒）。";
  ex:hasUsage "每服7丸，空心以温酒送下。服药后觉寒热，小腹内及连腰疼痛，当下恶物即愈；如未应，次日再服。" .

<medicine:凌霄花散> a ex:Medicine;
  ex:hasClinicalApplication "酒皶鼻；临川曾景仁尝苦此疾，一日得此方于都下一异人，不三次遂去根本。";
  ex:hasFunction "妇人久积风冷，气血不调，小腹(疒丂)刺疼痛。";
  ex:hasName "凌霄花散";
  ex:hasNote "方中红娘子、硇砂有一定的毒性与刺激性，故对素有胃痛者宜禁用。";
  ex:hasPreparation "上为细散。";
  ex:hasPrescription "凌霄花半两，当归1两（锉，微炒），木香1两，没药1两，桂心半两，赤芍药。";
  ex:hasUsage "方中赤芍药用量原缺。" .

<medicine:凌霄花根丸> a ex:Medicine;
  ex:hasFunction "大肠虚冷风秘。";
  ex:hasName "凌霄花根丸";
  ex:hasPreparation "上为末，炼蜜为丸，如绿豆大。";
  ex:hasPrescription "凌霄花根（去皮，洗，焙）3两，乌药（锉）半两，人参半两，皂荚子50枚。";
  ex:hasUsage "每服10-15丸，温水送下，每日2次。" .

<medicine:凌霄花汤> a ex:Medicine;
  ex:hasFunction "妇人血闭不行，脐下硬痛，及腰痛不可忍。";
  ex:hasName "凌霄花汤";
  ex:hasPreparation "上为粗末。";
  ex:hasPrescription "凌霄花（去萼，一名紫葳）半两，芫花（酽醋炒焦）半两，红蓝花半两，没药1分（研）。";
  ex:hasUsage "每服1钱匕，水1盏，煎至6分，去滓，食前热服。" .

<medicine:减半麻黄汤> a ex:Medicine;
  ex:hasFunction "年老伤寒，恶寒发热者。";
  ex:hasName "减半麻黄汤";
  ex:hasPrescription "紫苏叶3钱，薄荷3钱，粉葛根3钱，麻黄1钱，人参2钱，酒黄芩3钱，淡豆豉2钱，桂枝1钱，木通3钱，甘草2钱。";
  ex:hasUsage "水煎，温服。" .

<medicine:减味乌梅丸> a ex:Medicine;
  ex:hasFunction "厥明三疟，日久不已，劳则发热，或有痞结，气逆欲呕。";
  ex:hasName "减味乌梅丸";
  ex:hasPrescription "半夏、黄连、干姜、吴萸、茯苓、桂枝、白芍、川椒（炒黑）、乌梅。" .

<medicine:减味普济消毒饮> a ex:Medicine;
  ex:hasFunction "湿毒咽痛喉肿。";
  ex:hasName "减味普济消毒饮";
  ex:hasPreparation "上为粗末。";
  ex:hasPrescription "连翘1两，薄荷3钱，马勃4钱，牛蒡子6钱，芥穗3钱，僵蚕（直者）5钱，元参1两，银花1两，板兰根5钱，苦桔梗1两，生甘草5钱。";
  ex:hasUsage "每服6钱，重者8钱，以鲜苇根汤煎，去滓服。" .

<medicine:减味竹叶石膏汤> a ex:Medicine;
  ex:hasFunction "阳明温病，脉浮而促者。";
  ex:hasName "减味竹叶石膏汤";
  ex:hasPrescription "竹叶5钱，石膏8钱，麦冬6钱，甘草3钱。";
  ex:hasUsage "上以水8杯，煮取3杯，1时服1杯，约3时令尽。" .

<medicine:减味肾气汤> a ex:Medicine;
  ex:hasFunction "温补肾阳，行水利湿。主妊娠小便短数，续则不通，小腹胀满而痛，不得卧，面色白，四肢面目浮肿，身体疲乏，头眩怕冷，腰腿酸软，舌质淡，苔薄白，脉沉滑。";
  ex:hasName "减味肾气汤";
  ex:hasPrescription "砂拌熟地2钱（作丸8两），萸肉2钱（4两），泽泻3钱（3两），茯苓3钱（3两），淮药3钱（4两），肉桂5分（1两），附片（先煎半小时）3钱（1两）。";
  ex:hasUsage "水煎温服。（作丸，以7味为细末，炼蜜为丸，如梧桐子大。以酒送下5丸，可加至25丸，每日2次。）" .

<medicine:减味鳖甲煎丸> a ex:Medicine;
  ex:hasFunction "久疟不愈，结为症瘕，名曰疟母。";
  ex:hasName "减味鳖甲煎丸";
  ex:hasPreparation "上为末，用清酒1坛入灶下灰1升，着鳖甲于中煮令消化，绞汁去渣，入诸药煎浓，留药末，调和为丸，如梧桐子大。";
  ex:hasPrescription "鳖甲2两4钱，柴胡1两2钱，黄芩6钱，人参2钱，半夏2钱，甘草2钱，桂枝6钱，芍药1两，丹皮1两，桃仁4钱，阿胶6钱，大黄6钱，干姜6钱，葶苈2钱。";
  ex:hasUsage "空腹服7丸，每日3次。" .

<medicine:减甘草白豆蔻散> a ex:Medicine;
  ex:hasFunction "脾胃虚寒，气痞胸膈，不思饮食。";
  ex:hasName "减甘草白豆蔻散";
  ex:hasPrescription "白豆蔻仁、厚朴（生姜制）、白术、沉香、陈皮各等分。";
  ex:hasUsage "上药各（口父）咀。每服1两，以水2大盏，加生姜10片，同煎至7分，去滓，稍热服，不拘时候。" .

<medicine:减疟丹> a ex:Medicine;
  ex:hasFunction "疟疾。";
  ex:hasName "减疟丹";
  ex:hasPreparation "上药取5月5日为末，用粽子角为丸，如梧桐子大。";
  ex:hasPrescription "螺青、硫黄、官桂、白矾、巴豆（去油）各等分。";
  ex:hasUsage "每服1丸，用新绵裹，安耳内，男左女右，发日用之。" .

<medicine:减黄丹> a ex:Medicine;
  ex:hasFunction "补肾中之气，利膀胱之水。主女劳疸。其症因女色而成，肾气虚损，四肢酸痛，夜梦惊恐，精神困倦，饮食无味，举动乏力，心腹胀满，脚膝痿缓，房室不举，股内湿痒，水道涩痛，时有余沥，小腹满，身尽黄，额上黑。";
  ex:hasName "减黄丹";
  ex:hasPrescription "白茯苓5钱，山药5钱，人参3分，白术1钱，芡实5钱，薏仁5钱，菟丝子3钱，车前子1钱，生枣仁1钱。";
  ex:hasUsage "水煎服。10剂黄疸减，又10剂黄疸更减，又10剂全愈，再服30剂可无性命之忧。" .

<medicine:凝冰散> a ex:Medicine;
  ex:hasFunction "清热解毒，消肿止痛。治风热毒气，项下结核，及欲作痈疽、疮疖，发背。";
  ex:hasName "凝冰散";
  ex:hasPrescription "绿豆粉 乳香（研）各30克";
  ex:hasUsage "上药二味，合研为数，体强者分作四服，体虚者分作八服，食后米饮调下。就有核处一边卧，尽剂必愈。" .

<medicine:凝水石丸> a ex:Medicine;
  ex:hasFunction "治伤寒躁闷，口干时渴，狂言乱道。";
  ex:hasName "凝水石丸";
  ex:hasPreparation "上五味，合研匀细，糯米粥和丸，如弹子大。";
  ex:hasPrescription "凝水石250克（用炭火半秤，烧半日，取出放温，土上出火毒，研两日令极细，以瓮器盛，于井中浸一宿）龙脑（研）硼砂（研）各7.5克 甘草（炙，锉为末）7.5克 天竺黄15克（研）";
  ex:hasUsage "每服1丸，生姜、蜜水化下。" .

<medicine:凝水石散> a ex:Medicine;
  ex:hasAlias "寒水石散（《外台秘要》卷四）、二石散（《三因极一病证方论》卷十）。";
  ex:hasFunction "治饮酒过度，致患肉疸，饮少，小便多如白泔色。";
  ex:hasName "凝水石散";
  ex:hasPreparation "上六味，捣末下筛。";
  ex:hasPrescription "凝水石 白石脂 栝楼根 桂心各37.5克 菟丝子 知母各23克";
  ex:hasUsage "每次2克，麦粥饮调服，一日三次。五日知，十日愈。" .

<medicine:凝波散> a ex:Medicine;
  ex:hasFunction "治鼻衄不止。";
  ex:hasName "凝波散";
  ex:hasPreparation "上药为末。";
  ex:hasPrescription "寒水石 贝母 知母 马牙消（川消亦得）各7.5克 荷叶30克（水600毫升，煮五七沸，焙）";
  ex:hasUsage "用1.5克，蜜水调服。" .

<medicine:凝神饮子> a ex:Medicine;
  ex:hasFunction "治痨瘵。憎寒发热，口干咽燥，自汗烦郁，咳嗽声重，唾中血丝，瘦剧倦乏。";
  ex:hasName "凝神饮子";
  ex:hasPreparation "上药锉散。";
  ex:hasPrescription "人参（去芦）当归（去尾）白芍药 茯神（去木）白茯苓 黄耆 白术 半夏曲 五味子 熟地黄（洗，酒蒸）麦门冬（去心）甘草（炙）莲肉（去心）大麦冬（去心）桔梗各等分";
  ex:hasUsage "每服12克，用水400毫升，加乌梅、红枣各1枚，煎至200毫升，内服。" .

<medicine:凝露散> a ex:Medicine;
  ex:hasFunction "治汤、火伤。";
  ex:hasName "凝露散";
  ex:hasPrescription "白及30克 黄连 黄柏 黄芩 大黄各60克";
  ex:hasUsage "上药共为末，香油调，频搽患处，如有渗出液者干掺。" .

<medicine:凤仙膏> a ex:Medicine;
  ex:hasFunction "痈疽发背，杖疮蛇伤；对口发背，鱼口便毒，及瘰疬初起，一切肿毒之症。";
  ex:hasName "凤仙膏";
  ex:hasNote "已破者禁用。";
  ex:hasPrescription "凤仙花连根茎叶。";
  ex:hasUsage "《不知医必要》本方用法：洗净风干，捶自然汁，入铜锅内不可加水，将原汁熬稠敷患处，一日一换。" .

<medicine:凤仙酒> a ex:Medicine;
  ex:hasFunction "损伤脱骨。";
  ex:hasName "凤仙酒";
  ex:hasNote "多服伤人，以一寸为极。";
  ex:hasPrescription "凤仙花根（最肥者）1寸。";
  ex:hasUsage "酒磨服，然后揉托上则不知痛。" .

<medicine:凤凰散> a ex:Medicine;
  ex:hasFunction "消肿定痛，拔毒生肌。主男女下疳肿烂，疼痛难堪，并治一切皮破肿烂诸疮。";
  ex:hasName "凤凰散";
  ex:hasPreparation "上为细末，每1钱加冰片2分，密贮。";
  ex:hasPrescription "抱鸡蛋壳（连衣壳焙）。";
  ex:hasUsage "用时或干掺，或猪胆汁或麻油调擦。" .

<medicine:凤凰油> a ex:Medicine;
  ex:hasFunction "一切火毒。";
  ex:hasName "凤凰油";
  ex:hasPreparation "陈菜油熬枯，去鸡黄，收贮听用。";
  ex:hasPrescription "鸡子黄不拘多少。" .

<medicine:凤凰煎> a ex:Medicine;
  ex:hasFunction "休息痢，及疳泻日久不能愈者。";
  ex:hasName "凤凰煎";
  ex:hasPreparation "打破鸡子，用黄蜡一块如指大，铫内熔，以鸡子拌炒热。";
  ex:hasPrescription "鸡子1枚。";
  ex:hasUsage "空心食之。" .

<medicine:凤凰露> a ex:Medicine;
  ex:hasFunction "劳瘵。";
  ex:hasName "凤凰露";
  ex:hasPrescription "老鸡1只（去毛肠），金石斛2两，砂仁2钱。";
  ex:hasUsage "水2分，酒1分，煮干，蒸取露服。" .

<medicine:凤爪散> a ex:Medicine;
  ex:hasFunction "面上黄水痒疮，久不愈者。";
  ex:hasName "凤爪散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "公鸡爪（炒烟尽存性）。";
  ex:hasUsage "用真麻油调上。" .

<medicine:凤珠丹> a ex:Medicine;
  ex:hasFunction "耳聋。";
  ex:hasName "凤珠丹";
  ex:hasPreparation "鸡蛋上开一孔，入巴豆于内，用双层纸封之，与鸡抱之，以鸡出为度。";
  ex:hasPrescription "鸡蛋1个，巴豆1粒（去心膜）。";
  ex:hasUsage "取蛋清滴耳内，1日2次。" .

<medicine:凤眼丹> a ex:Medicine;
  ex:hasFunction "肠风痔。";
  ex:hasName "凤眼丹";
  ex:hasPreparation "上一处捣为丸，如花球大。";
  ex:hasPrescription "凤眼草（炒）半两，槐角子半两。";
  ex:hasUsage "以薄绵裹，于热坑茵上端坐。1昼夜效。" .

<medicine:凤眼草散> a ex:Medicine;
  ex:hasFunction "肠风下血。";
  ex:hasName "凤眼草散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "风眼草（拣净，即椿树荚也）4两，褐油麻（水淘净）4两，枳壳（去瓤，麸炒）2两，轻粉1字。";
  ex:hasUsage "每服2钱，空心、食前温酒调下；米饮亦得。" .

<medicine:凤衣散> a ex:Medicine;
  ex:hasFunction "口疮口疳，并乳蛾喉癣，喉疳喉痈，肿痛闭塞。";
  ex:hasName "凤衣散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "凤凰衣（即孵鸡蛋壳风衣，微火焙黄）3钱，人中白（即溺桶中白垢，煅）3钱，橄榄核（瓦上焙存性）3钱，孩儿茶3钱。";
  ex:hasUsage "每药1钱，加冰片5厘，吹搽患处。" .

<medicine:凤雏丸> a ex:Medicine;
  ex:hasFunction "妇人不孕。";
  ex:hasName "凤雏丸";
  ex:hasPreparation "放置一处养之，勿与群鸡相混，候生子时，将初生子顶颠上画一圈，待生子数多，抱时将初子照圈开空，用辰砂3钱，当归2钱，芍药2钱，川芎2钱，熟地黄2钱，为末，将子黄倾出调和药末，仍入壳内盛不尽时，另又装—壳，俱封之以厚纸放众子内同抱，鸡出时，将药子取起去壳，用炼蜜为丸。";
  ex:hasPrescription "头窝乌骨鸡雌雄1对。";
  ex:hasUsage "每服30-40丸，空心好洒送下。药尽有孕。" .

<medicine:凤雏膏> a ex:Medicine;
  ex:hasFunction "痘疮，热毒疮烂不收，并疳蚀不敛。";
  ex:hasName "凤雏膏";
  ex:hasPreparation "用鸡子4-5个煮熟，去白熬油，与药和匀。";
  ex:hasPrescription "乳香2分5厘，血竭2分5厘，龙骨2分5厘，轻粉5分。";
  ex:hasUsage "用鸡毛刷入患处。" .

<medicine:凤髓丹> a ex:Medicine;
  ex:hasFunction "肝肾二脏稍有不足，风寒之气侵之；每到中夜后腰背疼痛，转侧不得，不能行步；或左瘫右痪，肢体偏枯，起止不前，阳气衰绝，阴气大胜，久卧床枕，渐渐日深者。";
  ex:hasName "凤髓丹";
  ex:hasPreparation "上为细末，酒煮面糊为丸，如梧桐子大。";
  ex:hasPrescription "杜仲1两（生姜汁制），木瓜1两半，狗脊1两，川乌8两（炮，去皮），萆薢2两，牛膝1两，虎骨5钱（酥制），鹿茸5钱（酥制），麝香2钱，芎藭5钱，肉桂5钱（去皮），全蝎3钱，细辛7钱，乳香5钱，没药5钱，木鳖子3钱（去壳），海桐皮5钱，五加皮5钱，威灵仙7钱（去皮），薏苡仁5钱，自然铜7钱（醋淬7次），地龙2两半，木香5钱，骨碎补1两，朱砂5钱（为衣）。";
  ex:hasUsage "每服50丸，好酒温送下。" .

<medicine:凤髓汤> a ex:Medicine;
  ex:hasFunction "润肺。主咳嗽。";
  ex:hasName "凤髓汤";
  ex:hasPreparation "上将牛髓、白蜜砂锅内熬沸，以绢滤去滓，盛瓷瓶内，将杏仁等3味入瓶内，以纸密封瓶口，重汤煮1日夜，取出冷定。";
  ex:hasPrescription "牛髓1斤（取胻骨中者），白蜜半斤，杏仁4两（去皮尖，研如泥），干山药（炒）4两，胡桃仁（去皮，另研）4两。";
  ex:hasUsage "每早晨以白汤化1-2匙服。" .

<medicine:凤髓膏> a ex:Medicine;
  ex:hasFunction "润肺。主肺燥咳嗽。";
  ex:hasName "凤髓膏";
  ex:hasPreparation "上研膏，和熟蜜半两收之。";
  ex:hasPrescription "松子仁1两，胡桃仁2两。";
  ex:hasUsage "本方原名风髓汤，与剂型不符，据《卫生鸿宝》改。" .

<medicine:凤麟膏> a ex:Medicine;
  ex:hasFunction "降火，拨云去翳。主";
  ex:hasName "凤麟膏";
  ex:hasPreparation "共煎浓汁，去滓，将制过龙砂、虎液各5钱，入铜锅内，将汁缕续投下，以汁尽药干为度。加制过甘石1钱、白丁香1钱、鹅不食草2钱。";
  ex:hasPrescription "荆芥1钱，薄荷1钱，玄参1钱，防风1钱，白芷1钱，蕤仁1钱，白芍1钱，栀子1钱，干葛1钱，连翘1钱，当归1钱，黄芩1钱，柴胡1钱，升麻1钱，车前子1钱，生地1钱，木贼1钱，细辛1钱，枸杞1钱，桑白皮1钱，夏枯草1钱，黄连1钱，菊花1钱，石决明1钱，蒺藜1钱，白术1钱，香附米1钱，黄柏1钱。";
  ex:hasUsage "本方用法中的“龙砂”、“虎液”，均出原着。参阅“龙砂”、“虎液”条。" .

<medicine:凤龙膏> a ex:Medicine;
  ex:hasFunction "预防痘疮。";
  ex:hasName "凤龙膏";
  ex:hasPreparation "以鸡卵开一小窍，入地龙在内，夹皮纸糊其窍，饭锅上蒸熟，去地龙，与儿食之。";
  ex:hasPrescription "乌鸡卵1个，地龙1条（活者细小者）。";
  ex:hasUsage "每岁立春日食10枚，终身不出痘疮；邻里有此证流行时，食1-2枚亦好。" .

<medicine:凫茈散> a ex:Medicine;
  ex:hasFunction "妇人血崩。";
  ex:hasName "凫茈散";
  ex:hasPreparation "烧存性，研末。";
  ex:hasPrescription "凫茈1岁1个。";
  ex:hasUsage "酒服之。" .

<medicine:凫葵粥> a ex:Medicine;
  ex:hasFunction "利小便。主热淋。";
  ex:hasName "凫葵粥";
  ex:hasPrescription "凫葵2斤，米半升。";
  ex:hasUsage "上于豉汁中煮作粥。空心食之。" .

<medicine:出声散> a ex:Medicine;
  ex:hasFunction "主肺损失音。";
  ex:hasName "出声散";
  ex:hasPreparation "上药哎咀。";
  ex:hasPrescription "诃子4个（炮2个，生用2个）甘草13厘米（6.5厘米炮，6.5厘米生）桔梗30克";
  ex:hasUsage "每服6克，用童便150毫升，和药煎五七沸，温服。甚者不过五服。" .

<medicine:出声消肺散> a ex:Medicine;
  ex:hasFunction "咽喉病，痄腮，梅核气。";
  ex:hasName "出声消肺散";
  ex:hasPrescription "人参、茯苓、半夏曲、甘草、橘红、干葛、黄芩、桔梗、薄荷、五味子、杏仁、连翘、犀角屑。";
  ex:hasUsage "水煎，加蜜2钱服。" .

<medicine:出毛丸> a ex:Medicine;
  ex:hasFunction "肺疼久嗽，梦见先亡，或梦中饮食，亡精失血，多怒少睡，饮食不入，渐渐羸瘦；及骨蒸虚劳，传染鬼气。";
  ex:hasName "出毛丸";
  ex:hasNote "服毕不得洗手，频看十指甲中有毛出，逐旋拭了，至辰时候方得洗手。";
  ex:hasPreparation "上除雄黄外，先捣如泥，入乳钵内与雄黄同研匀，日内晒，候可丸，即丸如梧桐子大。";
  ex:hasPrescription "雄黄1两，大蒜1两，杏仁1两。";
  ex:hasUsage "每服21丸，凌晨空心清米饮送下。" .

<medicine:出牙齿乌头散> a ex:Medicine;
  ex:hasFunction "牙齿动摇，终不牢固者。";
  ex:hasName "出牙齿乌头散";
  ex:hasPreparation "上为细散，研入巴豆令匀。";
  ex:hasPrescription "川乌头1分，巴豆1-7枚（去皮），大硼砂1字，硇砂1字，大蜘蛛1枚（炙干），腻粉半钱。";
  ex:hasUsage "每用少许着牙根，一食间牙即自出。" .

<medicine:出虫丸> a ex:Medicine;
  ex:hasFunction "小儿五疳久不愈，羸瘦极甚。";
  ex:hasName "出虫丸";
  ex:hasPreparation "上为细末，以面糊和丸，如绿豆大。";
  ex:hasPrescription "朱砂1分（细研），麝香1分，牛黄1分，蟾酥半钱，熊胆1分，蜗牛子1分（炒微黄），夜明沙1分（微炒）。";
  ex:hasUsage "每服3丸，以温水送下；更别以水研1丸，滴向鼻中，得嚏5-7声，良久当有虫随汁出。" .

<medicine:出虫膏> a ex:Medicine;
  ex:hasFunction "痈疽败证及骨疽。";
  ex:hasName "出虫膏";
  ex:hasPreparation "以猪膏1斤半，纳2物煎之，消尽下之，欲冷，纳盐1合搅和。";
  ex:hasPrescription "自死虾蟆1枚，头发1把。";
  ex:hasUsage "以膏着疮中，日1易。" .

