  ex:hasUsage "每服4钱，空心白汤或淡盐汤送下。" .

<medicine:阿胶地黄汤> a ex:Medicine;
  ex:hasFunction "热伤肺脏，唾血不止。";
  ex:hasName "阿胶地黄汤";
  ex:hasPreparation "上为散。";
