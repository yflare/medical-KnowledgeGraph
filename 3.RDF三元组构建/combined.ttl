  ex:hasPrescription "防风通圣散。";
  ex:hasUsage "诸药俱用酒炒，倍入酒煨大黄，再用酒炒3次。水煎，食后服。" .

<medicine:酒归饮> a ex:Medicine;
  ex:hasFunction "头疮。";
  ex:hasName "酒归饮";
  ex:hasPrescription "酒当归1钱半，白术1钱半，洒芩5分，酒芍5分，川芎5分，陈皮5分，酒天麻7分半，苍术7分半，苍耳7分半，酒甘草4分，黄柏4分，防风3分。";
  ex:hasUsage "水煎服。日4-5服。服后蕴睡片时。" .

<medicine:酒枳丸> a ex:Medicine;
  ex:hasFunction "酒积。饮酒受伤成积，面黄黑，腹膜胀，时呕痰水。";
  ex:hasName "酒枳丸";
  ex:hasPreparation "上为末，蒸饼为丸，如绿豆大。";
  ex:hasPrescription "乌梅肉1两，半夏曲7钱，青木香4钱，枳实半两，砂仁半两，杏仁3钱，巴霜1钱，黄连（酒浸1宿）1两。";
  ex:hasUsage "每服8丸，白汤送下。" .

<medicine:酒泻丸> a ex:Medicine;
  ex:hasFunction "饮酒过伤成病，骨立不能食，但饮酒即泻。";
  ex:hasName "酒泻丸";
  ex:hasPreparation "上为末，陈米饭为丸，如梧桐子大。";
  ex:hasPrescription "嫩鹿茸（酥炙透）1两，肉苁蓉5钱，麝香5分。";
  ex:hasUsage "每服40-50丸，米汤送下。" .

<medicine:酒浸牛膝丸> a ex:Medicine;
  ex:hasAlias "牛膝丸";
  ex:hasFunction "腰酸脚软，脚气寒痛。脚气枯瘦，冷淡。寒胜无汗，挛急掣痛。";
  ex:hasName "酒浸牛膝丸";
  ex:hasNote "忌食动风等物。";
  ex:hasPreparation "上（口父）咀。用生绢袋入药扎口，用煮酒1斗，春、秋浸10日，夏浸7日，冬浸14日。";
  ex:hasPrescription "牛膝3两（炙黄），川椒半两（去目并合口者），附子1个（炮，去皮脐），虎胫骨（真者）半两（醋炙黄）。";
  ex:hasUsage "牛膝丸（《杂病源流犀烛》卷二十九）。" .

<medicine:酒浸芍药散> a ex:Medicine;
  ex:hasFunction "骨极，骨髓中疼。";
  ex:hasName "酒浸芍药散";
  ex:hasPreparation "上为粗散。以酒1升，浸1宿，焙干，再捣罗为散。";
  ex:hasPrescription "芍药5两，生地黄（切，焙）3两，虎骨（酒浸，炙）2两。";
  ex:hasUsage "每服3钱匕，空腹温酒调下。日午、夜卧再服。" .

<medicine:酒浸药仙方> a ex:Medicine;
  ex:hasFunction "中风。骨节疼痛，四肢浮肿，眼目昏暗，半身不遂，语言謇涩，口眼斜，中风失音。";
  ex:hasName "酒浸药仙方";
  ex:hasPreparation "上为粗末。用新绢袋盛药，用新小瓮儿1个，放药在内，以无灰酒2斗，将药浸之，密封其口，春、夏浸14日，秋、冬浸21日。";
  ex:hasPrescription "甘菊花半两，防风（去芦头）半两，羌活半两，杜仲半两，牡蛎半两，瓜蒌根半两，牡丹皮半两，紫菀半两，菖蒲半两，人参半两，白蒺藜半两，牛蒡子半两，枸杞子半两，白花蛇2钱半，桔梗2钱半，吴白术2钱半，山茱萸2钱半，白茯苓2钱半，晚蚕砂（炒）2钱半，黄桂2钱半，远志（去心）2钱半，牛膝2钱半，虎胫骨3钱，牛蒡根3钱，干姜3钱，干地黄3钱，柏子仁3钱，狗脊（去毛，焙）3钱，天雄（去皮，炮）3钱，萆薢3钱，蛇床子3钱，黑附子3钱，肉苁蓉3钱，菟丝子3钱，续断3钱，芍药（去皮）3钱，石斛3钱。";
  ex:hasUsage "开瓮，早晨、临午、晚3时，令病人自取冷酒3盏，依时服之。每服不过1盏，不多服，亦不可添减，乱开酒瓮。久病服者不过1月，近者10日，轻者5日见效。凡患中风疾，四肢不举，服之3日，举手梳头，7日渐舒，10日行步，半月遍身依旧，觉得轻健，眼目更明。" .

<medicine:酒渣粉> a ex:Medicine;
  ex:hasFunction "解毒消肿，杀菌止痒。主酒渣，痤疮，传染性湿疹样皮炎，脓疱疮。";
  ex:hasName "酒渣粉";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "京红粉、轻粉、元明粉各等分。";
  ex:hasUsage "用猪油调敷。" .

<medicine:酒渣鼻擦剂> a ex:Medicine;
  ex:hasFunction "治酒渣鼻，粉刺。";
  ex:hasName "酒渣鼻擦剂";
  ex:hasPreparation "先将轻粉研细，加杏仁同研，最后加硫黄研和。";
  ex:hasPrescription "轻粉6克 杏仁12克 硫黄12克";
  ex:hasUsage "用手指洗净，蘸药磨擦患处。" .

<medicine:酒炒螺蛳> a ex:Medicine;
  ex:hasFunction "清热利尿止遗。适用于小便白浊不利、滑精。";
  ex:hasName "酒炒螺蛳";
  ex:hasPreparation "将螺蛳洗净泥土，置铁锅中炒热，加适量白酒和水，煮至汤将尽时起锅。";
  ex:hasPrescription "螺蛳500克 白酒适量";
  ex:hasUsage "用针挑螺蛳肉蘸调料吃。" .

<medicine:酒煎干蟾丸> a ex:Medicine;
  ex:hasAlias "干蟾丸";
  ex:hasFunction "小儿五疳，不生肌肉。";
  ex:hasName "酒煎干蟾丸";
  ex:hasPreparation "上为末。都研令匀，入蟾膏内为丸，如绿豆大。";
  ex:hasPrescription "干蟾1枚（用无灰酒1升煎其酒半升以来却去蟾骨，煎令熟，以后于乳钵内并酒1时，研令如膏，次用后药），肉豆蔻2枚（去壳），槟榔1两，甘草1寸（炙微赤锉），乳香半两（研人），朱砂1两（研细），麻黄半两（去根节），腻粉1钱（研入），胡黄连半两，黄连半两（去须），丁香1分，芦荟1分（研入），麝香1钱（研细），牛黄1钱（研细）。";
  ex:hasUsage "干蟾丸（《普济方》卷三七九）。" .

<medicine:酒煎散> a ex:Medicine;
  ex:hasFunction "眼有风热，赤涩疼痛。";
  ex:hasName "酒煎散";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "防风、防己、甘草、荆芥、当归、赤芍药、牛蒡子各等分。";
  ex:hasUsage "上用好酒煎，食后温服。" .

<medicine:酒煎汤> a ex:Medicine;
  ex:hasFunction "腿外侧生疽属胆经者。";
  ex:hasName "酒煎汤";
  ex:hasPreparation "上为粗末。";
  ex:hasPrescription "当归2钱，生耆2钱，柴胡1钱半，大力子1钱，连翘1钱，桂心1钱，升麻5分，川柏5分，甘草5分。";
  ex:hasUsage "酒为引，水煎服。" .

<medicine:酒煎附子四神丹> a ex:Medicine;
  ex:hasAlias "四神附子煎、沉酒煎附子四神丹、四神附子丹";
  ex:hasFunction "升降阴阳，顺正祛邪，消风冷痰涎，散结伏滞气，通利关节，破瘀败凝涩奔冲失经之血，接助真气，生续脉息，补肾经不足，和膀胱小肠，秘精固气，定喘止逆，压烦燥，养胃气。主小儿慢惊，一切虚冷之疾。五脏亏损，下虚上壅，胸中痰饮，脐腹冷积，奔豚气冲，上下循环，攻刺疼痛，脾寒冷汗，中风痿痹，精神昏乱，霍乱吐泻，手足逆冷，阴毒伤寒，四肢厥逆，形寒恶风，向暗睡卧，乍寒乍乱。妇人产后诸疾，血气逆潮，迷闷欲绝，赤白带下，崩漏不止。";
  ex:hasName "酒煎附子四神丹";
  ex:hasNote "如有固冷陈寒，宜常久服饵。如病安愈，不得多服。";
  ex:hasPreparation "上以好法酒1斗，熬至3升，然后入附子末为糊，和前药为丸，如鸡头子大，留少酒膏，恐药干。候干。";
  ex:hasPrescription "水窟雄黄半斤，雌黄半斤，辰砂半斤，透明硫黄半斤（上别研水飞过，渗干，再同研匀。用烧药盒子1个，看大小用。临时先以牡丹根皮，烧烟熏盒子，令酽烟气黑黄色，入前四物在内，约留药盒子口下及1指，以醋调腊茶作饼子盖定，与盒子口缝平，用赤石脂泥固济盒子，用盒盖子盖之，令严，却用纸筋盐泥通裹盒子，固济约厚1寸，放令极干。初用炭火烧热，次加少火烧合通赤，常约令火5斤以来，渐渐添火气，小却添至5斤以来，照顾勿令炭厚薄不一，可添至三秤得济，去火渐令冷，入在地坑内，深1尺以上，用好黄土盖之。候3日取出，打破盒子，取药研细，约30两。）别入：胡椒末7两，荜茇末7两，真赤石脂末3两，好官桂心末6两，附子（及6钱以上者，炮，去皮脐，取末）12两。";
  ex:hasUsage "四神附子煎（《传信适用方》卷二）、沉酒煎附子四神丹、四神附子丹（《普济方》卷二二五）。" .

<medicine:酒煎附子煎> a ex:Medicine;
  ex:hasFunction "心腹积聚，风寒邪气，冷癖在胁，咳逆上气，喘嗽寒痰，痃癖痼冷，筋骨无力，百节酸疼，虚劳损败，阴汗泄精，腰肾久冷，心腹疼痛，下痢肠骨，呼吸少气，瘦悴异形，全不思食，身体大虚，五脏百病。";
  ex:hasName "酒煎附子煎";
  ex:hasPreparation "上为细末。酒煮面糊为丸，如皂子大。";
  ex:hasPrescription "大赭石1斤，荜茇2两，胡椒2两，附子2两。";
  ex:hasUsage "每服2丸，空心米饮送下。" .

<medicine:酒煎饮> a ex:Medicine;
  ex:hasAlias "三黄酒";
  ex:hasFunction "呕逆不进食者，下痢。";
  ex:hasName "酒煎饮";
  ex:hasPreparation "上为细末，如麻豆大。";
  ex:hasPrescription "黄连3钱，黄芩3钱，大黄2钱。";
  ex:hasUsage "三黄酒（《中国医学大辞典·补遗》）。" .

<medicine:酒煮当归丸> a ex:Medicine;
  ex:hasFunction "升阳胜湿。主(疒颓)疝，白带下注，脚气。腰以下如在冰雪中，以火焙炕，重重厚绵衣盖其上，犹寒冷不任，面白如枯鱼之象，肌肉如刀割削瘦。小便不止，与白带长流而不禁固，自不知不觉，面白目青，蓝如菜色，目（目巟）（目巟）无所见，身重如山，行步倚侧，不能安地，腿膝枯细，大便难秘，口不能言，无力之极，食不下，心下痞，烦心懊憹，不任其苦，面停垢，背恶寒，小便遗而不知，此上中下三阳真气俱虚竭。胃虚之极，哕呕不止，脉沉厥紧而涩，按之空虚。小腹下痛。";
  ex:hasName "酒煮当归丸";
  ex:hasPreparation "上与前4味药同为细末，酒煮面糊为丸，如梧桐子大。";
  ex:hasPrescription "茴香5钱，黑附子（炮制，去皮脐）7钱，良姜7钱，当归1两（上4味锉如麻豆大，以上等好酒1升半同煎至酒尽，焙干），炙甘草5钱，苦楝（生用）5钱，丁香5钱，木香1钱，升麻1钱，柴胡2钱，炒黄盐3钱，全蝎3钱，延胡索4钱。";
  ex:hasUsage "每服50-70丸，空心淡醋汤送下。" .

<medicine:酒煮木瓜粥> a ex:Medicine;
  ex:hasFunction "筋急。";
  ex:hasName "酒煮木瓜粥";
  ex:hasPrescription "大木瓜。";
  ex:hasUsage "酒、水相和，煮令烂，研作膏，热裹痛处，冷即易，1宿3-5次。" .

<medicine:酒煮矾> a ex:Medicine;
  ex:hasFunction "喉闭，咽喉肿痛。";
  ex:hasName "酒煮矾";
  ex:hasPreparation "上为细末。砂石器内以无灰酒煮至紫黑色为度，入砂合内收，与面油膏相似。";
  ex:hasPrescription "白矾（明亮有墙壁者）5-7两或10两。";
  ex:hasUsage "每用半匙许含化。候取出痰即消。此药煮时须慢火煎熬，热时须搅稀放冷，如稍健硬，即又添酒煮，直至紫色为度。" .

<medicine:酒煮茵陈汤> a ex:Medicine;
  ex:hasFunction "酒疸。遍身眼目金黄，如黄金色者。";
  ex:hasName "酒煮茵陈汤";
  ex:hasPrescription "茵陈1两。";
  ex:hasUsage "上用好陈酒1钟半，煎至8分，食远温服。" .

<medicine:酒煮解毒汤> a ex:Medicine;
  ex:hasFunction "诸疮毒，经年不愈，或骨节疼痛者。";
  ex:hasName "酒煮解毒汤";
  ex:hasPrescription "穿山甲5钱，白芷5钱，防风5钱，没药5钱，甘草5钱，芍药5钱，贝母5钱，金银花3钱，陈皮3钱，皂角刺1钱。";
  ex:hasUsage "上药加酒煎，初以酒3合，煮取2合，再入酒2合，煮取1合，若不嗜酒者，酒、水各半煎服，日服1剂，3日或7日服之。" .

<medicine:酒煮鳗鲡鱼> a ex:Medicine;
  ex:hasFunction "骨蒸劳瘦，及肠风下虫。";
  ex:hasName "酒煮鳗鲡鱼";
  ex:hasPrescription "鳗鲡鱼2斤（锉作段子）。";
  ex:hasUsage "上入铛内。以酒3大盏，熟煮，入盐、醋食之。" .

<medicine:酒煮黄连丸> a ex:Medicine;
  ex:hasFunction "厚肠胃，止泄泻。治泄泻，痢疾。";
  ex:hasName "酒煮黄连丸";
  ex:hasPreparation "上并锉，用无灰酒，米醋各200毫升，慢火熬尽，晒干为末，再用酒、醋打面糊为丸，如梧桐子大。";
  ex:hasPrescription "黄连（去须）150克 厚朴（去粗皮）90克 肉豆蔻30克（面裹煨）";
  ex:hasUsage "每服50～70丸，米饮送下。" .

<medicine:酒病丸> a ex:Medicine;
  ex:hasFunction "积聚。酒疸身黄，饮食减少。";
  ex:hasName "酒病丸";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "葛根不拘多少。";
  ex:hasUsage "用猪腰子1个，劈破，用药3钱，烧熟服。" .

<medicine:酒症丸> a ex:Medicine;
  ex:hasFunction "酒积，诸药不效者。";
  ex:hasName "酒症丸";
  ex:hasNote "孕妇人不可服。";
  ex:hasPreparation "上为细末，却合作一处，再研匀细，蒸饼剂为丸，如梧桐子大，放半日之间，欲干不干，却于铫内用麸炒令香熟，勿令大焦，放水上药丸于浮为度。";
  ex:hasPrescription "大药半两，小药半两，半夏半两，巴豆2钱，大麦糵半两，雄黄5铢。";
  ex:hasUsage "用温酒下1丸为候，若服2丸，微利，取下酒积食劳之病。" .

<medicine:酒症圆> a ex:Medicine;
  ex:hasFunction "治饮酒过度，头旋恶心，呕吐不止，及酒积停于胃间，遇饮即吐，久而成癖。";
  ex:hasName "酒症圆";
  ex:hasPrescription "雄黄（拣六个.如皂荚子大）、巴豆（不去皮.不出油）、？各十五个。";
  ex:hasUsage "每服二粒，温酒下，食后服。" .

<medicine:酒积丸> a ex:Medicine;
  ex:hasFunction "酒癖不消，心腹胀闷，噫酢吞酸，哕逆不食，胁肋刺痛。";
  ex:hasName "酒积丸";
  ex:hasPreparation "上为细末，沸汤和为丸，如梧桐子大。";
  ex:hasPrescription "神曲（炒）1钱，麦糵（炒）1钱，硇砂1字（别研），白面4两，巴豆60粒（取霜），黄连1字。";
  ex:hasUsage "每服3丸，嚼，食后煨生姜温酒下。" .

<medicine:酒积乌梅丸> a ex:Medicine;
  ex:hasFunction "伤酒。";
  ex:hasName "酒积乌梅丸";
  ex:hasPreparation "蒸饼糊为丸，如绿豆大。";
  ex:hasPrescription "乌海1两，青木香4钱，砂仁5钱，巴豆霜1钱，半夏曲7钱，枳实5钱，杏仁3钱，黄连1两（酒浸1宿）。";
  ex:hasUsage "每服8丸，白汤送下。" .

<medicine:酒积麦芽丸> a ex:Medicine;
  ex:hasFunction "酒癖不消，心腹胀满，噫酸呕逆，胁肋痛。";
  ex:hasName "酒积麦芽丸";
  ex:hasPreparation "上为末，沸汤搜和为丸，如梧桐子大。";
  ex:hasPrescription "神曲（炒）1两，麦芽（炒）1两，黄连5钱（锉用巴豆5粒同炒）。";
  ex:hasUsage "每服50丸，食远姜汤送下。" .

<medicine:酒肿丸> a ex:Medicine;
  ex:hasFunction "酒肿，及脾虚发肿。";
  ex:hasName "酒肿丸";
  ex:hasPreparation "上2味用水煮干，去皂角，将萝卜捣烂，蒸饼糊为丸，如芡实大。";
  ex:hasPrescription "萝卜10枚，皂角5枚。";
  ex:hasUsage "萝卜煎汤送下。" .

<medicine:酒蒸黄连丸> a ex:Medicine;
  ex:hasAlias "酒煮黄连丸、酒连丸、黄龙丸、小黄龙丸、独连丸";
  ex:hasFunction "诸痔疮及便血不止。";
  ex:hasName "酒蒸黄连丸";
  ex:hasPreparation "上为末。黄连余酒面糊为丸，如梧桐子大。";
