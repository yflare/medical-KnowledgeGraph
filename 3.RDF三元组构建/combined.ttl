  ex:hasUsage "每服2钱匕，入盐少许,空心、食前沸汤点服。" .

<medicine:二母丸> a ex:Medicine;
  ex:hasFunction "肺热咳嗽，痰中带血。";
  ex:hasName "二母丸";
