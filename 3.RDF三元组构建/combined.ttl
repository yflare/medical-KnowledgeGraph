  ex:hasPrescription "白术5分，甘草5分，缩砂仁5分，杏仁（去皮尖）5分，人参5分，半夏（制）5分，赤茯苓1钱，藿香1钱，扁豆（姜汁炒）1钱，木瓜1钱，香薷2钱，厚朴（姜制）2钱。";
  ex:hasUsage "上作1服，加生姜3片，大枣1个，水2盏，煎1盏，温服。" .

<medicine:六和定风散> a ex:Medicine;
  ex:hasFunction "瘫痪风，寒湿痹，历节白虎。";
  ex:hasName "六和定风散";
  ex:hasPreparation "以生姜捣自然汁1碗，胡葱捣自然汁1碗浸苍术，待苍术泛白，晒干，又加去节麻黄末1两。";
  ex:hasPrescription "苍术4两，草乌2两，杏仁1两1钱（去皮尖），当归4钱，牛膝4钱，乳香1钱，没药1钱。";
  ex:hasUsage "每服3-4分，酒下；重者5-6分。其病根从元府汗中泄尽，愈。" .

<medicine:六和汤> a ex:Medicine;
  ex:hasAlias "六合汤";
  ex:hasFunction "夏月病人霍乱转筋，呕吐泄泻，寒热交作，倦怠嗜卧；伏暑烦闷，小便赤涩，或利或渴；中酒；胎产。";
  ex:hasName "六和汤";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "砂仁1两，半夏1两，杏仁1两，人参1两，甘草1两，白术2两，藿香2两，木瓜2两，厚朴2两，扁豆2两，赤茯苓2两。";
  ex:hasUsage "入盐点服。" .

<medicine:六和生化汤> a ex:Medicine;
  ex:hasFunction "产后六淫外侵。";
  ex:hasName "六和生化汤";
  ex:hasPrescription "川芎2钱，当归4钱，炮姜4分，炙甘草5分，桃仁10粒，茯苓3钱，砂仁壳1钱，橘红8分。";
  ex:hasUsage "水煎服。" .

<medicine:六和膏> a ex:Medicine;
  ex:hasFunction "冻疮。";
  ex:hasName "六和膏";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "海螵蛸10g，煅龙骨10g，象皮6g，血竭6g，木香6g，没药6g，轻粉6g。";
  ex:hasUsage "撒布患处。" .

<medicine:六和茶> a ex:Medicine;
  ex:hasFunction "调和六气。主";
  ex:hasName "六和茶";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "藿香1两5钱，川朴1两，杏仁1两5钱，半夏2两，木瓜1两5钱，赤苓2两，苍术1两5钱，人参1两，扁豆2两，甘草2钱，茶叶4两，砂仁5钱。";
  ex:hasUsage "加生姜、大枣，水煎服。" .

<medicine:六圣丸> a ex:Medicine;
  ex:hasFunction "和胃，主气厚肠，消疮快膈。主小儿诸积。";
  ex:hasName "六圣丸";
  ex:hasPreparation "上除南木香不见火，余4味锉焙，同木香为末。";
  ex:hasPrescription "莪术（炮，锉）5钱，净黄连5钱，陈皮（去白）5钱，白姜（炮）5钱，南木香2钱半。";
  ex:hasUsage "每1钱重。巴豆3粒(去壳膜心，存油，碎切)，入乳钵极细杵，同前药末再拌匀，醋煮面糊为丸，如麻子大。每服15-25丸，或35丸，五更初空心淡姜汤送下。利3-5行，匀气散止补。常服助脾化积，进食消痞，临睡以净汤或温酒下3-5丸而已。每1次止丸药末3钱重，净巴豆9粒为则，不可多合，久则味过，用之效迟。" .

<medicine:六圣散> a ex:Medicine;
  ex:hasAlias "赤火金针";
  ex:hasFunction "头面生疮作痒，流黄水。";
  ex:hasName "六圣散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "小红枣（烧灰）1两，枯矾1两，黄丹1两，官粉1两，松香1两，银朱3钱。";
  ex:hasUsage "疮干用油调搽，疮湿干掺上。" .

<medicine:六均丸> a ex:Medicine;
  ex:hasFunction "祛风热，除肠中垢腻。主酒病，诸积滞。";
  ex:hasName "六均丸";
  ex:hasPreparation "上为末，滴水为丸，如梧桐子大。";
  ex:hasPrescription "大黄、葛根、朴消、槐花、牵牛皂角（微爁过，去皮弦子）各等分。";
  ex:hasUsage "每服20丸，温水送下。欲快利，临卧服50-70丸。" .

<medicine:六奇汤> a ex:Medicine;
  ex:hasFunction "虚劳羸瘦，日久不瘥；心腹痞满，不思饮食。";
  ex:hasName "六奇汤";
  ex:hasPreparation "上为粗末。";
  ex:hasPrescription "柴胡（去苗）半两，厚朴（去粗皮，生姜汁炙，锉）半两，枳壳（去瓤，麸炒）半两，白术半两，京三棱（醋浸，炮，锉）1两，白茯苓（去黑皮）1两。";
  ex:hasUsage "每服3钱匕，水1盏，加生姜半分(切碎)，同煎至8分，去滓，空心温服。" .

<medicine:六妙丸> a ex:Medicine;
  ex:hasFunction "疳积。";
  ex:hasName "六妙丸";
  ex:hasPrescription "保童丸1帖，芦荟丸1帖，化虫丸1帖，肥儿丸1帖，六神丸1帖，蚵蚾丸1帖。";
  ex:hasUsage "合和为丸服。" .

<medicine:六妙汤> a ex:Medicine;
  ex:hasFunction "下血，或痢不止。";
  ex:hasName "六妙汤";
  ex:hasPrescription "乌梅10个（捶碎），甘草2寸（生用），罂粟壳10个（去瓤顶，捶碎），丁香50个（全用），桂心2寸（去粗皮），缩砂仁4钱半（捶破）。";
  ex:hasUsage "上药同拌匀，作1服，水1盏半，于银器(忌钢铁器)内煎至7分，去滓温服，滓用水2盏，再煎小半盏服。" .

<medicine:六妙饮> a ex:Medicine;
  ex:hasFunction "吐呕不止，口渴身热。";
  ex:hasName "六妙饮";
  ex:hasPrescription "陈皮3钱，半夏（姜、矾制）3钱，黄连（姜汁炒）3钱，栀子仁（酒炒）3钱，槟榔3钱，老生姜5钱。";
  ex:hasUsage "水煎，温服。" .

<medicine:六子丸> a ex:Medicine;
  ex:hasFunction "知识太早，精血未满而泄，关键不摄，始而精腐变浊，久则元精滑溢，口咸气胀。";
  ex:hasName "六子丸";
  ex:hasPrescription "生菟丝子粉、蛇床子、覆盆子、沙苑子、家韭子、五味子。";
  ex:hasUsage "鳇鱼胶为丸服。" .

<medicine:六安煎> a ex:Medicine;
  ex:hasFunction "化痰止咳。治风寒咳嗽，及非风初感，痰滞气逆等证。";
  ex:hasName "六安煎";
  ex:hasPrescription "陈皮4.5克 半夏6～9克 茯苓6克 甘草3克 杏仁3克（去皮、尖，切）白芥子1.5～2.1克（老年气弱者不用）";
  ex:hasUsage "用水220毫升，加生姜3～7片，煎至200毫升，空腹时服。" .

<medicine:六宝散> a ex:Medicine;
  ex:hasFunction "阴头疳疮，";
  ex:hasName "六宝散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "五倍（烧存性）7分，朱砂7分，儿茶5分，轻粉2分半，水银1分，冰片半分。";
  ex:hasUsage "敷患处。" .

<medicine:六岁墨> a ex:Medicine;
  ex:hasFunction "解毒止痛。主疔疮肿毒，口眼歪斜，牙关紧急；及山岚瘴气，死牛、死马、河脉中毒，砒毒，咽喉肿痛。";
  ex:hasName "六岁墨";
  ex:hasPreparation "上为细末，以糯米煮糊捣匀，用模型铸为1钱重墨状条块，阴干备用。";
  ex:hasPrescription "山慈菇1两，千金子1两，大戟1两，文蛤2两（去虫），麝香1分，川乌2两，草乌2两。";
  ex:hasUsage "原书按：太岁墨即太乙紫金锭之变方，以二乌、朱砂、雄黄，化和平为峻险，专作外用，不重内服，反不若紫金锭之安全稳妥。故在用本品处，皆代以紫金锭，其收效颇能如理想也。" .

<medicine:六应丸> a ex:Medicine;
  ex:hasClinicalApplication "临床主要用于治疗鼻炎、智齿冠周炎等病症。";
