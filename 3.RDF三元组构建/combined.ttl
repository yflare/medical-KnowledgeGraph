  ex:hasPrescription "黄耆1钱，人参3分，炙甘草5分，真漏芦1钱，升麻1钱，葛根5分，连翘1钱，牡丹皮3分，当归身3分，生地黄3分，熟地黄3分，白芍药3分，肉桂2分，柴胡8分，黍粘子3分，羌活1钱，独活5分，防风5分，昆布2分，京三棱（煨）2分，广荗（煨）3分，益智仁2分，大麦芽面1钱，神曲末（炒黄色）2分，黄连（去须）3分，黄柏（炒）3分，厚朴3钱2分（姜制）。";
  ex:hasUsage "救苦胜灵汤（《准绳·疡医》卷三）、消瘰化坚汤（《医林篡要》卷十）。本方方名，《济生拔萃》本作“救苦胜灵丹”；改为丸剂，名“救苦化坚丸”（见《杏苑》）。" .

<medicine:救苦回生丹> a ex:Medicine;
  ex:hasFunction "治历节风，半肢风，紫云风，寒湿麻痹，瘫痪，及中风不语，口眼歪斜。";
  ex:hasName "救苦回生丹";
  ex:hasPreparation "上为细末，糯米饭丸，如龙眼大，朱砂为衣，金箔飞裹。";
  ex:hasPrescription "乳香 没药 当归 川芎各45克 五灵脂 檀香 松香 自然铜（醋煅）威灵仙各3e克 虎骨（炙）地龙 草乌各15克 天麻21克 全蝎6克 麝香9克 荆芥 白芷 苦参各36克 番木鳖30个（炙）冰片1克 京墨1块 黑豆6克（炒）闹羊花15克 僵蚕18克";
  ex:hasUsage "每服用薄荷酒磨下1丸。" .

<medicine:救苦拔毒丹> a ex:Medicine;
  ex:hasFunction "顶门疽，脑发，对口，发鬓，发眉。";
  ex:hasName "救苦拔毒丹";
  ex:hasPreparation "上药捣烂。";
  ex:hasPrescription "雄蜒蚰（背有白纹者是）2条，葱白3寸。";
  ex:hasUsage "加雄黄、白及研匀，少加冰片、麝香，敷患处。" .

<medicine:救苦散> a ex:Medicine;
  ex:hasFunction "一切恶疮。";
  ex:hasName "救苦散";
  ex:hasNote "忌湿面冷硬之物。";
  ex:hasPreparation "上为细末，与密佗僧、蒸饼、乳汁为丸。";
  ex:hasPrescription "朱砂1钱，红娘子2个，斑蝥6个，雄黄1钱，没药1钱，金脚信1钱（细研），南乳香半钱，海马1对，轻粉1钱，脑子1钱，密陀僧2钱（另研），蜈蚣1对，麝香5分，水蛭4个，黄连1钱。";
  ex:hasUsage "如疔疮，作小尖锭子；若疮口大，捏作饼子，纴于疮内。" .

<medicine:救苦汤> a ex:Medicine;
  ex:hasAlias "还阴救苦汤（《原机启微》卷下）。";
  ex:hasFunction "时疫赤眼，两目突然红肿疼痛。";
  ex:hasName "救苦汤";
  ex:hasPreparation "上药哎咀。";
  ex:hasPrescription "桂枝1钱5分，连翘1钱5分（去隔），红花1钱5分，细辛1钱5分，归尾1钱5分，甘草1钱5分，苍术7分（泔浸，焙），胆草7分，羌活1钱，黄芩1钱，麻黄1钱，柴胡1钱，防风1钱，藁本1钱，黄柏1钱，黄连5分，生地1钱，知母（炒）1钱，白芍2钱。";
  ex:hasUsage "食远服。" .

<medicine:救苦灵丹> a ex:Medicine;
  ex:hasFunction "赚疮，血风湿毒诸疮。";
  ex:hasName "救苦灵丹";
  ex:hasPreparation "上用麻油3斤，煎滚入花椒，煎黑去滓，煎至滴水成珠，将白蜡溶化，次下甘石、陀僧，调匀成膏，将皮纸裁成8寸长，3寸阔，油面拖之，凉干收用，愈陈愈妙。";
  ex:hasPrescription "三黄汤、煅石膏（研末）4两，黄蜡10两，白蜡10两，密陀僧（研末）1两，花椒（去茎）1两5钱。" .

<medicine:救苦灵膏> a ex:Medicine;
  ex:hasFunction "男妇内外臁疮，血气蚁窠，脚上一切湿毒诸疮。";
  ex:hasName "救苦灵膏";
  ex:hasPreparation "上用麻油3斤煎滚，将花椒放下，煎黑捞去滓，候油熬至滴水成珠不散为度，再将黄白蜡下，次人芦甘石、陀僧，调匀成膏。其膏用拖法，将顶高皮纸裁8寸，3寸阔，锅面拖之，凉干收用，愈陈愈妙。";
  ex:hasPrescription "芦甘石4两（制），黄蜡10两，白蜡10两，密陀僧1两（研细），花椒1两5钱（去茎净）。" .

<medicine:救苦神白散> a ex:Medicine;
  ex:hasFunction "治风寒所致的偏正头疼，眉骨两太阳穴痛。";
  ex:hasName "救苦神白散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "川芎 甘松 白芷 赤芍药 两头尖 川乌（去皮）各2克 甘草（炙）24克";
  ex:hasUsage "每服6克，茶清调下，服后饮热汤75毫升。" .

<medicine:救苦膏> a ex:Medicine;
  ex:hasFunction "顺气发风，活血脉，壮筋骨。主男子、妇人左瘫右痪，半身不遂，口眼斜，痈疽发背，疔肿恶疮，巳末成脓，疼痛不止，打扑损伤；蛇虎犬咬，刀斧、汤烫伤，杖疮；及风寒湿痛，咳嗽喘急，痰涎壅盛，心脾疼痛，赤白痢疾，脏寒泄泻，眼目赤障，耳鸣头痛；牙痛，瘰疬，鹤膝，及妇人生产死胎，胞衣不下等。";
  ex:hasName "救苦膏";
  ex:hasPreparation "上没药、沥青、杏仁、乳香先捣，后用白胶香磈润和捣之，以上药俱要研为细末，和匀，用香油不时浇润，捣取出，揉和之。";
  ex:hasPrescription "川乌3钱（生用，勿火），香白芷2钱，川牛膝5钱（焙），当归1两（焙），黄丹半两（飞过），贝母2钱，磈润（即桃脂）1钱，白蔹2钱，白及2钱（焙），没药7钱，乳香5钱（茗叶1片，将药放在叶上，用慢火慢焙干），杏仁3两（用热汤泡去皮尖），沥青半两，香油半盏，白胶香3两（入铁器，于火上熬数沸，放入冷水中）。";
  ex:hasUsage "远近咳嗽，吐唾痰涎，背心穴贴；喘急痰盛，肺俞穴贴；前后心脾疼痛，随疼处贴；胸膈痞闷，少思饮食，胸骨上贴；赤白痢疾，脏寒泄泻，腰眼脐下贴；眼目赤障，疼痛作楚，太阳穴贴；耳鸣、头目昏眩，项窝穴贴；牙齿疼痛，膏药亭穴贴；男子久虚，肾气衰弱，腰膝筋骨疼痛，腰眼穴贴；闪肭骨折，手搦腕骨还旧，以膏药量伤处尺寸贴，软帛绵好竹片包裹扎定，3次收换，须候7日，如是伤重，12日可效；妇人气虚血弱，腰脐腹胯疼痛，于脐下腰眼贴之；奶痈吹奶，于患处贴之；小儿一切痈疮失气痛，随患处贴；瘰疬漏疮，两膝肿痛，髀膝枯瘁，皮肤拘挛，蜷卧不得屈伸，此证名曰鹤膝，以药烘贴；生产死胎，胞衣不下者，用川芎汤下7粒；余病随疼处、患处、伤处贴。" .

<medicine:救苦观音散> a ex:Medicine;
  ex:hasFunction "小儿痘疹伤眼初起，睛上红紫涩痛。";
  ex:hasName "救苦观音散";
  ex:hasPreparation "炼蜜为丸。";
  ex:hasPrescription "桔梗、当归、连翘、藁本、细辛、苍术、龙胆草、羌活、黄连、知母、黄芩、黄柏、川芎、柴胡、防风、升麻、生地黄、红花各等分。";
  ex:hasUsage "能吞者每服40-50丸，小者量服之。" .

<medicine:救苦金丹> a ex:Medicine;
  ex:hasFunction "益气调经。主经期不准，腹部胀痛，症瘕痞块，精神疲倦。";
  ex:hasName "救苦金丹";
  ex:hasNote "孕妇忌服。";
  ex:hasPreparation "上以青蒿、川芎、木香、益母草、白芷、藁本、白术、砂仁、黄芩、橘皮、紫苏叶、续断、肉桂、红花14味，共为粗末，铺晒，余下罐，加黄酒1184两，蒸3昼夜，再将群药加在一起，共为细末，炼蜜为丸，重3钱。";
  ex:hasPrescription "当归64两，木香16两，玄胡索64两，藁本64两，白薇64两，赤石脂（生）64两，黄柏64两，丹皮64两，阿胶64两，黄耆64两，人参（去芦）64两，山药64两，川芎64两，白芍64两，甘草64两，熟地64两，没药64两，白芷64两，黄芩64两，砂仁64两，鹿角64两，白术64两，茯苓64两，血余炭8两，蕲艾（炭）8两，小茴香8两，青蒿16两，乳香16两，杜仲16两，锁阳16两，菟丝子16两，红花16两，肉桂16两，续断16两，紫苏叶16两，补骨脂16两，松香脂32两，红鸡冠花32两，白鸡冠花32两，橘皮96两，益母草240两。";
  ex:hasUsage "每服1丸，1日2次，温开水送下。" .

<medicine:救苦黄耆散> a ex:Medicine;
  ex:hasFunction "诸恶疮痈疖。";
  ex:hasName "救苦黄耆散";
  ex:hasPreparation "上（口父）咀。每服5钱，无灰好酒1升，同引子装于瓷瓶内，将瓶用笋叶封，坐于锅内，上以大盆覆锅口，盆外用黄土封之，无令出气，煮之，外闻药香为度。取出瓶，澄定饮清，将药滓再添酒1升，依前煮服，若不饮酒者，以水煮服，若酒少者，酒、水各半煮服。";
  ex:hasPrescription "黄耆1两5钱，甘草1两5钱，当归1两5钱，瓜萎根1两5钱，芍药1两5钱，悬蒌1对，熟地黄不拘多少，金银花2两，皂角棘针（为引）。";
  ex:hasUsage "疮在上，食后临卧服；在下，空心服之。" .

<medicine:救荒丹> a ex:Medicine;
  ex:hasFunction "辟谷疗饥，容颜佳胜，更不憔悴，滋润脏腑。主";
  ex:hasName "救荒丹";
  ex:hasPreparation "上蒸3遍，晒干，去皮为末，火麻子3升，汤浸1宿，捞出晒干，用牛皮胶水拌晒，去皮淘净，蒸3遍碓捣，渐次下黑豆末和匀，用糯米粥为丸，如拳大。入甑蒸，从夜至子，住火，至寅取出晒干，瓷器内盛，不令见风。";
  ex:hasPrescription "黑豆5升（洗净）。";
  ex:hasUsage "每服3块，但饱为度。" .

<medicine:救荒代粮丸> a ex:Medicine;
  ex:hasFunction "救荒辟谷。主";
  ex:hasName "救荒代粮丸";
  ex:hasPreparation "上切碎，用水5升，同豆熬煮，文武火烧，直至水尽，拣去各药，取豆捣烂为丸，如鸡头子大，将瓦瓶密封。";
  ex:hasPrescription "黑豆（去皮）1升，贯众1个，赤茯苓1两，白茯苓（去皮）5钱，白术5钱，砂仁5钱。";
  ex:hasUsage "每嚼1丸。" .

<medicine:救蔑丹> a ex:Medicine;
  ex:hasFunction "心热之极，火刑肺金，鼻中出黑血不止，名曰衄蔑。";
  ex:hasName "救蔑丹";
  ex:hasPrescription "黄连2钱，丹皮3钱，茯神2钱，麦冬5钱，玄参1两，生枣仁3钱，生地3钱，柏子仁1钱。";
  ex:hasUsage "水煎服。" .

<medicine:救误益气汤> a ex:Medicine;
  ex:hasFunction "产后中气不足，中满，或嗳气虚饱，及误用耗气顺气药，致膨胀危症。";
  ex:hasName "救误益气汤";
  ex:hasPrescription "人参2钱（虚加2钱），白术3钱，白芍1钱，神曲（炒）1钱，大腹皮（洗）4分，陈皮4分，当归3钱，茯苓1钱5分，甘草3分，川芎7分。";
  ex:hasUsage "如腹胁痛或块痛，加砂仁5分；腹大痛，加吴茱萸1钱。" .

<medicine:救败丹> a ex:Medicine;
  ex:hasFunction "生疮毒时，不守房帏，疮黑暗，痛如刀割者。";
  ex:hasName "救败丹";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "人参2钱，三七根末3钱，孩儿茶3钱，乳香1钱，白僵蚕2钱，轻粉1钱，发灰2钱。";
  ex:hasUsage "掺于膏药内贴之。若不用膏药者，干掺妙；猪油调搽亦妙。" .

<medicine:救败散> a ex:Medicine;
  ex:hasFunction "冬月伤寒5-6日，吐泻后又加大汗，气喘不得卧，发厥者。";
  ex:hasName "救败散";
  ex:hasPrescription "当归5钱，麦冬5钱，人参5钱，白芍5钱，柴胡5分，甘草5分，北五味10粒，神曲3分。";
  ex:hasUsage "水煎服。" .

<medicine:救败求生汤> a ex:Medicine;
  ex:hasFunction "补气以回元阳，摄血以归神，生精而续命。主少妇产后半月，不慎房帏，血崩昏晕，目见鬼神。";
  ex:hasName "救败求生汤";
  ex:hasPrescription "人参2两，当归2两（酒洗），白术2两（土炒），九蒸熟地1两，山萸5钱（蒸），山药5钱（炒），枣仁5钱（生用），附子1分或1钱（自制）。";
  ex:hasUsage "水煎服。" .

<medicine:救败汤> a ex:Medicine;
  ex:hasFunction "纵欲伤精，两胫酸痛，腰背拘急，行立足弱，夜卧遗泄，阴汗痿靡，精神倦怠，饮食减少，两耳飕飕如听风声，为初起之痨瘵。";
  ex:hasName "救败汤";
  ex:hasPrescription "地骨皮5钱，丹皮5钱，人参3分，白芍3钱，山药1两，甘草2分。";
  ex:hasUsage "水煎服。" .

<medicine:救逆散> a ex:Medicine;
  ex:hasFunction "冬月伤寒，汗下后又加大吐，气逆，呕吐饱闷，胸中痞满，时时发厥，昏晕欲死，谵语如见神鬼，且知生人出入。此为坏症之不可救者。";
  ex:hasName "救逆散";
  ex:hasPrescription "人参2两，茯苓1两，白芍1两，附子1钱，麦冬5钱，牛膝2钱，破故纸1钱。";
  ex:hasUsage "水煎服。" .

<medicine:救逆止利汤> a ex:Medicine;
  ex:hasFunction "伤寒少阴证，恶寒身蜷而下利，手足逆冷。";
  ex:hasName "救逆止利汤";
  ex:hasPrescription "人参2两，附子2钱，甘草2钱，干姜2钱，白术1两，茯苓5钱。";
  ex:hasUsage "水煎服。" .

<medicine:救逆汤> a ex:Medicine;
  ex:hasFunction "温病误表，津液被劫，或在少阴，或在厥阴，心中震震，舌强神昏，中无所主者。";
  ex:hasName "救逆汤";
  ex:hasPrescription "于加减复脉汤内去麻仁，加生龙骨4钱，生牡蛎8钱。";
  ex:hasUsage "煎如复脉法。" .

<medicine:救阳丸> a ex:Medicine;
  ex:hasFunction "大便失禁，手足厥冷，面色青白。";
  ex:hasName "救阳丸";
  ex:hasPreparation "上为细末，稀糊为丸，如梧桐子大。";
  ex:hasPrescription "吴茱萸（汤浸焙干，炒）、干姜（炮）、赤石脂、龙骨、蜀椒（去目并开口者，炒出汗）、桂（去粗皮）、附子（炮裂，去皮脐）、天雄（炮裂，去皮脐）、硫黄（飞，研）、阳起石（煅，醋淬，研）各等分。";
  ex:hasUsage "每服15丸，空心、食前米饮送下。渐加丸数，盐汤亦得。" .

<medicine:救阳丹> a ex:Medicine;
  ex:hasFunction "补虚疗冷。主脾元虚冷。";
  ex:hasName "救阳丹";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "附子1两，乌头2两，干姜1两2钱，防风半两，桂半两，牡蛎半两，人参半两。";
  ex:hasUsage "每服3钱，水2盏，煎至8分，空心并3服。" .

<medicine:救阳汤> a ex:Medicine;
  ex:hasFunction "阳微阴性，风寒侵袭，真气暴衰，形寒脉结，神识不明，心胸痰满，呕逆清涎，头目昏眩不觉，倦卧，自汗不止，饮食不入，下利频并，脐腹疼痛，肢体困倦。";
  ex:hasName "救阳汤";
  ex:hasPreparation "上为粗末。";
  ex:hasPrescription "川乌头4两，干姜4两（捣碎，同炒转色）。";
