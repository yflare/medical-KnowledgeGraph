  ex:hasPrescription "白芍（酒炒）、归梢、牛地黄、酒红花、地骨皮。";
  ex:hasUsage "水煎服。" .

<medicine:凉血解仓散> a ex:Medicine;
  ex:hasFunction "凉血。主";
  ex:hasName "凉血解仓散";
  ex:hasPreparation "上为末。";
