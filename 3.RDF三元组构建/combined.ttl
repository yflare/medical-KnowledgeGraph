  ex:hasUsage "每服70丸，食前温水送下。" .

<medicine:白术姜黄汤> a ex:Medicine;
  ex:hasFunction "肘臂痛。";
  ex:hasName "白术姜黄汤";
  ex:hasPreparation "上为粗末。";
