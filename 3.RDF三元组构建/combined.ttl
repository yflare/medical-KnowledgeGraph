  ex:hasUsage "入五味调和匀，煮熟。空腹食之。" .

<medicine:鲤鱼煎> a ex:Medicine;
  ex:hasFunction "上气咳嗽，胸膈烦闷，气喘。";
  ex:hasName "鲤鱼煎";
  ex:hasPrescription "鲜鲤鱼1尾（不论大小，将鲤去鳞，血洗净，切作脍，榨去血水）。";
  ex:hasUsage "以姜、醋制而食之，加蒜、齑亦得。" .

<medicine:鲤鱼煮豆> a ex:Medicine;
  ex:hasFunction "老人水肿，手足俱胀。";
  ex:hasName "鲤鱼煮豆";
  ex:hasPrescription "大豆2升，白术1两，鲤鱼肉1斤。";
  ex:hasUsage "以水煮令豆烂熟。空心常食，以汁咽之。" .

<medicine:鲤鱼皮散> a ex:Medicine;
  ex:hasFunction "产后恶血未尽，结聚腹痛。";
  ex:hasName "鲤鱼皮散";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "鲤鱼皮灰半两，乱发灰半两，益智子（去皮）半两，虻虫（微炒）1分，水蛭（微炒）1分，当归（锉，微炒）3分。";
  ex:hasUsage "每服1钱，以热酒调下，不拘时候。" .

<medicine:鲤鱼粥> a ex:Medicine;
  ex:hasFunction "妊娠安胎。主妊娠胎动不安。";
  ex:hasName "鲤鱼粥";
  ex:hasPrescription "鲤鱼1头（治如食法），糯米1合，葱2-7茎（细切），豉半合。";
  ex:hasUsage "以水3升，煮鱼至1半，去鱼，入糯米、葱、豉煮粥食之。" .

<medicine:鲤鱼羹> a ex:Medicine;
  ex:hasFunction "脚气冲心烦躁，言语错谬。";
  ex:hasName "鲤鱼羹";
  ex:hasPreparation "上九味，锉后八味令匀细，纳鱼腹中，用绵裹合。";
  ex:hasPrescription "鲤鱼1枚（制如食法），莼菜4两，葱白2合。";
  ex:hasUsage "上调和豉汁，煮作羹食之。" .

<medicine:鲤鱼脍> a ex:Medicine;
  ex:hasFunction "老人痔，下血久不愈，渐加黄瘦无力。";
  ex:hasName "鲤鱼脍";
  ex:hasNote "忌鲊甜食。";
  ex:hasPreparation "上切。";
  ex:hasPrescription "鲤鱼肉10两。";
  ex:hasUsage "作脍如常法，以蒜、醋、五味调和，空心常食之，1日1次。" .

<medicine:鲤鱼脑髓粥> a ex:Medicine;
  ex:hasAlias "鲤脑粥";
  ex:hasFunction "耳聋久不愈。";
  ex:hasName "鲤鱼脑髓粥";
  ex:hasPrescription "鲤鱼脑髓2两，粳米3合。";
  ex:hasUsage "鲤脑粥（《医统》卷八十七）。" .

<medicine:鲤鱼膏> a ex:Medicine;
  ex:hasFunction "脚气冲心，烦躁不安。";
  ex:hasName "鲤鱼膏";
  ex:hasPrescription "鲤鱼1头（重1斤，治如食法，切），莼菜4两（切）。";
  ex:hasUsage "上调和入豉汁中，煮作羹食之。" .

<medicine:鲤鱼臛> a ex:Medicine;
  ex:hasFunction "老人水气病，身体肿，闷满气急，不能食，皮肤欲裂，四肢常疼，不可屈伸。";
  ex:hasName "鲤鱼臛";
  ex:hasPreparation "上切。";
  ex:hasPrescription "鲤鱼肉10两，葱白1握，麻子1升（熬、细研）。";
  ex:hasUsage "上以水滤麻子汁，和煮作臛，下五味、椒、姜调和，空心时渐服之，常服尤佳。" .

<medicine:鲤鱼茯苓汤> a ex:Medicine;
  ex:hasAlias "鲤鱼泽漆汤";
  ex:hasFunction "肿入腹，苦满急，害饮食。石水。";
  ex:hasName "鲤鱼茯苓汤";
  ex:hasNote "忌酢物。";
  ex:hasPrescription "鲤鱼1头5斤，泽漆5两，茯苓3两，桑根白皮（切）3升，泽泻5两。";
  ex:hasUsage "鲤鱼泽漆汤（《金匮翼》卷四）。" .

<medicine:鲤鱼贴> a ex:Medicine;
  ex:hasFunction "小儿木舌长大。";
  ex:hasName "鲤鱼贴";
  ex:hasPrescription "鲤鱼1枚（去骨，切肉作片）。";
  ex:hasUsage "上1味，将鱼肉贴于舌上，以线系定。" .

<medicine:鲤鱼鳞散> a ex:Medicine;
  ex:hasFunction "产后腹痛。";
  ex:hasName "鲤鱼鳞散";
  ex:hasPreparation "上同入瓶子内，以瓦子盖，盐泥缝，渐次着火烧令通赤为度，候冷取出，细研为散，入曲末1两，更同研令匀。";
  ex:hasPrescription "鲤鱼鳞2两，乱发1两，故徘帛1两。";
  ex:hasUsage "以热酒调下2钱，不拘时候。" .

<medicine:鲤鱼齿汤> a ex:Medicine;
  ex:hasFunction "产后淋痛及血淋。";
  ex:hasName "鲤鱼齿汤";
  ex:hasPrescription "鲤鱼齿10-20个，葵子3合，黄芩5钱，瞿麦2钱，车前子2钱，木通2钱。";
  ex:hasUsage "水2升，煎取1升，入齿末，空心服，每日3次。" .

<medicine:鲤鳞丸> a ex:Medicine;
  ex:hasFunction "未成内消，己成多脓，神效异常。主无名肿毒，瘰疬。";
  ex:hasName "鲤鳞丸";
  ex:hasPreparation "上为末，米醋打烂为丸，重1钱2分，朱砂1钱5分为衣，贮瓷瓶，麝香5分养之。";
  ex:hasPrescription "归尾5钱，大黄2钱，荆芥穗2钱，桔梗2钱，乳香（炙）2钱，没药（炙）2钱，黄芩3钱，连翘3钱，防风2钱5分，羌活2钱5分，全蝎1钱，蝉退（去头）20个，僵蚕25条，雄黄7分，牛皮胶（土炒）1两，金头蜈蚣（去头足）4条（分4法制，1条用姜汁涂上焙干；1条用香油涂上焙干；1条用醋涂上焙干；1条用酥炙），穿山甲4两（亦作4制，1两用红花5钱，煎汤煮，焙干；1两用牙皂5钱，煎汤煮，焙干；1两用紫草节5钱，煎汤煮，焙干；1两用苏木5钱，煎汤煮焙干）。";
  ex:hasUsage "每服1丸，滚酒送下。" .

<medicine:鲩鱼胆膏> a ex:Medicine;
  ex:hasFunction "小儿咽喉痹肿，乳食难下。";
  ex:hasName "鲩鱼胆膏";
  ex:hasPrescription "鲩鱼胆2枚，灶底土1分（研）。";
  ex:hasUsage "上药相和，调涂咽喉上，干即易之。" .

<medicine:鲫鱼丸> a ex:Medicine;
  ex:hasFunction "内消瘰疬。主马刀瘰疬。";
  ex:hasName "鲫鱼丸";
  ex:hasNote "服后忌热物。";
  ex:hasPreparation "上研末，共入鱼肚内，用纸包缚，黄泥封固，煅至烟尽为度，取出冷定，研细末，米糊为丸，如绿豆大。";
  ex:hasPrescription "大鲫鱼（去肠肚）1尾，鼠粪7钱，大风子5钱，巴豆3钱。";
  ex:hasUsage "每服2钱，空心黄酒送下。" .

<medicine:鲫鱼冬瓜汤> a ex:Medicine;
  ex:hasFunction "清肺利尿，消肿。适用于小儿肾炎急性期。";
  ex:hasName "鲫鱼冬瓜汤";
  ex:hasPreparation "将鲫鱼洗净，去肠杂及鳃与冬瓜（去皮）同煎汤。";
  ex:hasPrescription "鲫鱼250克 冬瓜500克";
  ex:hasUsage "每日2次，吃鱼饮汤。" .

<medicine:鲫鱼围药> a ex:Medicine;
  ex:hasFunction "一切无名肿毒。";
  ex:hasName "鲫鱼围药";
  ex:hasPrescription "鲫鱼1条，山药3寸，白砂糖少许，火石（即打火石）1小块（一方有苏木屑，生猪油）。";
  ex:hasUsage "上并打烂，围肿处。" .

<medicine:鲫鱼散> a ex:Medicine;
  ex:hasAlias "敛口生肌散、生肌散";
  ex:hasFunction "下注疮。";
  ex:hasName "鲫鱼散";
  ex:hasPreparation "上5味，将前3味入鲫鱼肚内，却缠合固济了，烧通红取出，候冷，同粉研为细末，用猪胆汁调。";
  ex:hasPrescription "鲫鱼（去肚肠）1枚，黄连（去须）半两，铅丹1钱，密陀僧（碎）1钱，胡粉（研）1钱。";
  ex:hasUsage "敷疮上。" .

<medicine:鲫鱼汤> a ex:Medicine;
  ex:hasAlias "鲫鱼酒";
  ex:hasFunction "下乳汁。主妇人产后乳汁不行。";
  ex:hasName "鲫鱼汤";
  ex:hasPrescription "鲫鱼7寸，猪肪半斤，漏芦8两，石钟乳8两。";
  ex:hasUsage "鲫鱼酒（《圣惠》卷八十一）。" .

<medicine:鲫鱼涂敷方> a ex:Medicine;
  ex:hasFunction "治疮癣浸淫。";
  ex:hasName "鲫鱼涂敷方";
  ex:hasPreparation "上二味，合捣令细。";
  ex:hasPrescription "生鲫鱼长10厘米 豉50克";
  ex:hasUsage "涂敷疮上，一日三次。" .

<medicine:鲫鱼熟脍> a ex:Medicine;
  ex:hasFunction "脾胃冷气，不能下食，虚弱无力。";
  ex:hasName "鲫鱼熟脍";
  ex:hasPrescription "鲫鱼1斤（鲜者，治如食法）。";
  ex:hasUsage "上细切作脍，以羊肉汁，入椒、干姜、莳萝、荜茇、橘皮、酱、醋等，煮令熟。空心食之。" .

<medicine:鲫鱼砒方> a ex:Medicine;
  ex:hasFunction "虫牙痛。";
  ex:hasName "鲫鱼砒方";
  ex:hasPrescription "鲫鱼1个。";
  ex:hasUsage "破开，入信于内，放在地孔中，候鱼身上自然霜，扫，灯心点虫牙，咳嗽自落。" .

<medicine:鲫鱼粥> a ex:Medicine;
  ex:hasFunction "和脏腑。主老人赤白痢，刺痛，不多食，痿瘦。亦治劳。";
  ex:hasName "鲫鱼粥";
  ex:hasPrescription "鲫鱼肉7两，青梁米4两，橘皮末1分。";
  ex:hasUsage "上相和煮作粥，下五味，椒、酱、葱调和。空心食之。" .

<medicine:鲫鱼羹> a ex:Medicine;
  ex:hasFunction "久痔，肠风，大便常有血。";
  ex:hasName "鲫鱼羹";
  ex:hasPreparation "将鲫鱼去鳞、鳃和内脏，洗净。在鱼腹内装入陈皮、缩砂仁、荜茇、大蒜、泡辣椒、葱、食盐、酱油、胡椒。在锅内放入菜油烧开将鲫鱼放入锅内烧熟，再加入水适量，炖成羹即成。";
  ex:hasPrescription "大鲫鱼1头（新鲜者，洗净，切片），小椒2钱（为末），草果1钱（为末）。";
  ex:hasUsage "用葱3茎，煮熟，入5味。空腹食之。" .

<medicine:鲫鱼胆膏> a ex:Medicine;
  ex:hasFunction "耳聋。";
  ex:hasName "鲫鱼胆膏";
  ex:hasPrescription "鲫鱼胆1枚，乌驴脂少许，生油半两。";
  ex:hasUsage "上3味和匀，纳于葱管中7日，滴于耳内，愈。" .

<medicine:鲫鱼脍> a ex:Medicine;
  ex:hasFunction "赤白痢。";
  ex:hasName "鲫鱼脍";
  ex:hasPrescription "小鲫鱼1斤（如常脍法），蒜、醋、椒、姜、盐。";
  ex:hasUsage "上先将鱼切作薄片，以蒜、齑、椒、姜、盐拌和食之，不用别物兼食。" .

<medicine:鲫鱼膏> a ex:Medicine;
  ex:hasClinicalApplication "临床主要用于治疗多发性疖肿、蜂窝组织炎、乳腺炎、淋巴结炎、痔疮；又有用于治疗肩关节周围炎、癌痛等病症。";
  ex:hasFunction "乳痈初起。";
  ex:hasName "鲫鱼膏";
  ex:hasNote "乳岩及一切色白阴疽忌用；永戒食蛤蟆。";
  ex:hasPreparation "同捣如泥。";
  ex:hasPrescription "活鲫鱼1个，山药1段（如鱼长）。";
  ex:hasUsage "敷扎，上以纸盖之。2-3日内立消。" .

<medicine:鲫鱼贴> a ex:Medicine;
  ex:hasFunction "治目生胬肉涩痛。";
  ex:hasName "鲫鱼贴";
  ex:hasPrescription "鲫鱼（鲜者）";
  ex:hasUsage "上一味，去皮骨，取肉一片，中央开一窍，正贴眼上。一日换三五次。" .

<medicine:鲮甲散> a ex:Medicine;
  ex:hasFunction "治乳痈。";
  ex:hasName "鲮甲散";
  ex:hasPrescription "穿山甲 皂刺 橘叶 当归 栝楼仁 木通各等分";
  ex:hasUsage "水煎，温服。" .

<medicine:鲮鲤甲丸> a ex:Medicine;
  ex:hasFunction "白癞。";
  ex:hasName "鲮鲤甲丸";
  ex:hasPreparation "上为细末，炼蜜为丸，如梧桐子大。";
  ex:hasPrescription "鲮鲤甲3片，蝮蛇半条，魁蛤半枚，水蛭（生用）2个，蜘蛛（生用）2个，斑蝥（去头翅足）2个，虻虫（去足翅）2个，蛴螬（生用）3个，蜈蚣1条，龙骨半两（研），石膏1两（细研，水飞），白矾（枯）半两，滑石半两，川芒消半两，消石半两，水银（与消石点楮汁研令星尽）半两，川大黄半两，黄连半两，桂心半两，附子（炮，去皮脐）2枚，雷丸10枚，巴豆12枚（去皮心膜油），川椒2钱半。";
  ex:hasUsage "每服2丸，空心、临卧温水送下，日2次。" .

<medicine:鲮鲤甲散> a ex:Medicine;
  ex:hasAlias "通和汤";
  ex:hasFunction "狼瘘。";
  ex:hasName "鲮鲤甲散";
  ex:hasPreparation "上药入1瓦罐子内，烧烟绝，便以盆合之，勿令成灰，候冷，为细散。";
  ex:hasPrescription "鲮鲤甲1两，鸩鸟嘴半两，蝉衣1枚，犬牙1分，蜈蚣1枚。";
  ex:hasUsage "以腊月猪脂炼过调，敷疮上，日换2次。" .

<medicine:鲮鲤甲方> a ex:Medicine;
  ex:hasFunction "蚁入耳。";
  ex:hasName "鲮鲤甲方";
  ex:hasPrescription "鲮鲤甲1两（烧灰）。";
  ex:hasUsage "以水调，滤过，滴入耳中，即出。" .

<medicine:鲮鲤甲汤> a ex:Medicine;
  ex:hasAlias "鲮鲤汤、鲮鲤甲酒";
  ex:hasFunction "山瘴疟。南方山岭溪源瘴气毒作，寒热发作无时，萎黄肿满，四肢痹弱。";
  ex:hasName "鲮鲤甲汤";
  ex:hasNote "忌苋菜、生葱、生菜、猪肉。";
