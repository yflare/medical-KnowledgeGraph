  ex:hasNote "坐、卧避冷处。";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "荜茇半两，肉豆蔻（去壳，半生半煨）1两，干姜（炮）半两，诃黎勒（半生半煨，去核）1两，白术3分，甘草（半生半炙，锉）半两，木香（半生半炒）1两。";
  ex:hasUsage "每服2钱匕，空心米饮调下，日2次。" .

<medicine:荜茇汤> a ex:Medicine;
  ex:hasFunction "齿痛。";
  ex:hasName "荜茇汤";
  ex:hasPreparation "上为粗末。";
