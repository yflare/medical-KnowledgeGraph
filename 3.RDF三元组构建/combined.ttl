  ex:hasUsage "每服100丸，空心黄酒送下。" .

<medicine:六时散> a ex:Medicine;
  ex:hasFunction "风气，风眩，头面风，头中风病。";
  ex:hasName "六时散";
  ex:hasPreparation "上切，捣筛为散。";
  ex:hasPrescription "秦艽（春4分、夏2分、秋8分、冬12分），独活（春4分、夏2分、秋8分、冬12分），茯神（春4分、夏2分、秋8分、冬12分），薯蓣（春4分、夏2分、秋8分、冬12分），山茱萸（春4分、夏2分、秋8分、冬12分），藁本（春4分、夏2分、秋8分、冬12分）。";
  ex:hasUsage "每服1方寸匕，以酒下，1日2次。" .

<medicine:六星散> a ex:Medicine;
  ex:hasAlias "六星丹";
  ex:hasFunction "碹指疳。";
