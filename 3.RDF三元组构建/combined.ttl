  ex:hasUsage "4-5岁儿每服2丸，1日2次。" .

<medicine:鸡鸣丸> a ex:Medicine;
  ex:hasAlias "鸡鸣定喘丸";
  ex:hasFunction "喘嗽。";
  ex:hasName "鸡鸣丸";
  ex:hasNote "肺弱咳嗽而无痰喘者忌服。";
  ex:hasPreparation "上为末，炼蜜为丸，如弹子大。";
