  ex:hasName "决效散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "贯众3两，白芷1两。";
  ex:hasUsage "油调涂。" .

<medicine:决效方> a ex:Medicine;
  ex:hasFunction "泻血不止。";
  ex:hasName "决效方";
  ex:hasNote "不得稍生气。";
  ex:hasPrescription "巴豆1枚（去皮）。";
  ex:hasUsage "上1味，以鸡子开1小窍，纳巴豆1枚入鸡子窍中，以纸塞定，别以湿纸裹，用火煨熟透，去壳并巴豆，只1味吃尽鸡子，其病即止。虚人分作2服。" .

<medicine:决明丸> a ex:Medicine;
  ex:hasAlias "退膜丸";
  ex:hasFunction "小儿赤眼。";
  ex:hasName "决明丸";
  ex:hasPreparation "上为末，炼蜜为丸，如麻子大。";
  ex:hasPrescription "决明子、牛黄（别研）、蕤仁等分。";
  ex:hasUsage "每服2丸，临卧时以乳汁送下。如热痛不可忍者，用猪胆汁为丸。" .

<medicine:决明丹> a ex:Medicine;
  ex:hasAlias "决明散";
