  ex:hasUsage "每服1茶匙，以暖酒调下，不拘时候。" .

<medicine:阿胶芍药汤> a ex:Medicine;
  ex:hasAlias "四神散";
  ex:hasFunction "大便下血不止。";
  ex:hasName "阿胶芍药汤";
  ex:hasPreparation "上为散。";
