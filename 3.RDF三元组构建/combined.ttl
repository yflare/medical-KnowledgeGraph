  ex:hasName "立效饼子";
  ex:hasPreparation "上为细末，酒糊为丸，如梧桐子大，捻作饼子。";
  ex:hasPrescription "良姜、草乌、川芎、荜茇、胡椒各等分。";
  ex:hasUsage "每用1饼，咬在患处。有涎出立愈。" .

<medicine:立极汤> a ex:Medicine;
  ex:hasFunction "补土燥湿。主着痹。";
  ex:hasName "立极汤";
  ex:hasPrescription "党参4钱，附子6分，当归2钱，茯苓3钱，白术1钱，茅术1钱，破故纸1钱5分，杜仲2钱，川断2钱，独活1钱，牛膝2钱，红枣5枚，生姜3片。";
  ex:hasUsage "苡仁1两，煎汤代水，煎诸药服。" .

<medicine:立止丸> a ex:Medicine;
  ex:hasFunction "风蛀牙痛。";
  ex:hasName "立止丸";
  ex:hasPreparation "上为末，薄面糊为丸，如梧桐子大。";
  ex:hasPrescription "肥皂荚（去皮子，取肉）1两，草乌头（不去尖）1两，乳香（研）1钱。";
  ex:hasUsage "每用1丸，入蚛孔中，涎出即吐。" .

<medicine:立止吐血散> a ex:Medicine;
  ex:hasFunction "吐血。";
  ex:hasName "立止吐血散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "藕节炭1两，蒲黄炭5钱，血余炭5钱。";
  ex:hasUsage "每服3钱，开水调下。立止。" .

<medicine:立止吐血膏> a ex:Medicine;
  ex:hasFunction "引血下行，止血逐瘀。主伤寒夹血，呕血吐血，表邪虽解，血尚不止者。";
  ex:hasName "立止吐血膏";
  ex:hasPreparation "用冰糖4两收膏。";
  ex:hasPrescription "鲜生地1斤，生绵纹3两，桑叶2两，丹皮2两，血见愁2两，杜牛膝2两，土三七1两，苏子1两，降香1两。";
  ex:hasUsage "每服8钱-1两，犀地清络饮去桃仁、姜、蒲二汁冲下。" .

<medicine:立止咳嗽丸> a ex:Medicine;
  ex:hasFunction "久嗽痰喘。";
  ex:hasName "立止咳嗽丸";
  ex:hasNote "忌辛辣油腻。";
  ex:hasPreparation "上为细末，炼蜜为丸，每重1钱5分。";
  ex:hasPrescription "麻黄5钱，杏仁5钱，桔梗8钱，蒌仁4钱，丹皮3钱，杭芍4钱，黄芩3钱，黄连2钱，栀子3钱，花粉3钱，茯苓5钱，清夏3钱，沙参4钱，橘红3钱，川贝2钱，五味子2钱，甘草2钱，米壳1两。";
  ex:hasUsage "每服2丸，小儿1丸，开水送下。" .

<medicine:立止咳血膏> a ex:Medicine;
  ex:hasFunction "降气泻火，补络填窍。主咳血妄行，或久病损肺咳血。";
  ex:hasName "立止咳血膏";
  ex:hasPreparation "先煎，去滓滤净，加净白蜜1斤、奎冰糖8两，煎浓成膏。";
  ex:hasPrescription "剪草1斤，地锦2斤，野百合1两，黑木耳1两，白及1两，没石子1两，鲜藕节2两，鲜枇杷叶（去毛筋，净）8两，鲜刮淡竹茹8两，鲜茭白根8两。";
  ex:hasUsage "寻常咳血妄行，每服1小匙，日2夜1，空心服。如久病损肺咳血，五更服此，上下午服琼玉膏。" .

<medicine:立止哮喘烟> a ex:Medicine;
  ex:hasFunction "哮喘。";
  ex:hasName "立止哮喘烟";
  ex:hasPreparation "上为细末，用老姜1片，捣烂取汁，将药末合匀，以有盖茶钟1只，盛贮封固，隔水蒸1时久，取出，以熟烟丝10两和匀，放通风处吹至7-8成干（不可过干，恐其易碎）时，贮于香烟罐中备用。";
  ex:hasPrescription "曼陀罗花1两5，火消1钱，川贝1两，法夏8钱，泽兰6钱，冬花5钱。";
  ex:hasUsage "每日用旱烟筒或水烟袋如寻常吸烟法吸之，哮即渐次痊愈。" .

<medicine:立止头痛散> a ex:Medicine;
  ex:hasFunction "清热，通窍，止痛。主由风热上攻引起的头晕头痛，鼻塞不通，时发时愈。";
  ex:hasName "立止头痛散";
  ex:hasPreparation "上为细末，装3分，蜡壳封固。";
  ex:hasPrescription "大黄2两，全虫10个，朱砂3钱，麝香4分，冰片5分。";
  ex:hasUsage "《中药制剂手册》本方用法：每服三分，温开水冲下。外用可搐鼻少许。" .

<medicine:立止散> a ex:Medicine;
  ex:hasFunction "治牛皮癣。";
  ex:hasName "立止散";
  ex:hasPreparation "上药研末。";
  ex:hasPrescription "冬瓜皮（烧灰）";
  ex:hasUsage "油调搽疮上。" .

<medicine:立止水泻方> a ex:Medicine;
  ex:hasFunction "水泻。";
  ex:hasName "立止水泻方";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "车前1钱，泽泻1钱，厚朴1钱2分（姜汁炒）。";
  ex:hasUsage "滚水调服。" .

<medicine:立止灵丹> a ex:Medicine;
  ex:hasFunction "痢疾泄泻，昼夜无数次者。";
  ex:hasName "立止灵丹";
  ex:hasNote "孕妇忌用。";
  ex:hasPreparation "上为细末，入瓷瓶封固。";
  ex:hasPrescription "当门子2钱5分，川连5钱，白芷1两。";
  ex:hasUsage "红痢用蜜为丸，白痢用姜汁为丸，红白痢用醋为丸，如黄豆大。纳脐中，外贴小膏药。止后，服调理药方。" .

<medicine:立止牙疼药> a ex:Medicine;
  ex:hasFunction "牙疼。";
  ex:hasName "立止牙疼药";
  ex:hasPreparation "用蟾酥糊为小丸。";
  ex:hasPrescription "蟾酥、细辛、荜茇、食盐各等分。" .

<medicine:立止牙痛即安丹> a ex:Medicine;
  ex:hasAlias "一粒笑";
  ex:hasFunction "牙痛。";
  ex:hasName "立止牙痛即安丹";
  ex:hasPreparation "上药打匀为丸，如绿豆大，晒干，贮于玻璃瓶内塞好，不令出气。";
  ex:hasPrescription "蟾酥（酒化烊）2钱，荜茇（研末）1钱，五灵脂（酒飞）2钱，麝香（研末）2分。";
  ex:hasUsage "凡1-2个牙齿痛者，乃风火牙痛是也，每用此丸1粒，嵌于痛处。待其涎流丸药化尽，其痛立止。" .

<medicine:立止牙痛散> a ex:Medicine;
  ex:hasFunction "风火牙痛。";
  ex:hasName "立止牙痛散";
  ex:hasPreparation "上为细末，乳至极细。";
  ex:hasPrescription "没食子4钱，生石膏4钱，煅硼砂3钱，玄明粉1钱5分，冰片5分，飞朱砂7分。";
  ex:hasUsage "每用少许，擦患处。" .

<medicine:立正散> a ex:Medicine;
  ex:hasFunction "治走马牙疳。";
  ex:hasName "立正散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "人中白 枯白矾 铜绿 轻粉各0.3克 麝香少许";
  ex:hasUsage "先洗净疳，然后上药，每日二三次，贴之大效。" .

<medicine:立消丸> a ex:Medicine;
  ex:hasFunction "饮食积聚成块。";
  ex:hasName "立消丸";
  ex:hasPreparation "上为末，神曲6两，打糊为丸。";
  ex:hasPrescription "槟榔2两，草果（炒）2两，山楂肉2两，莱菔子（炒）2两，阿魏（酒炖化）1两，三棱1两5钱，莪术（醋煮）1两5钱，广木香1两5钱，青皮（醋炒）1两5钱，香附1两5钱。";
  ex:hasUsage "每服3钱，姜汤送下。" .

<medicine:立消散> a ex:Medicine;
  ex:hasFunction "喉痹。";
  ex:hasName "立消散";
  ex:hasNote "如已成将溃，禁服。";
  ex:hasPreparation "上为极细末。";
  ex:hasPrescription "白硼砂、灯心灰（以灯心塞入罐内固济，煅之罐红为度）、风化消、黄柏、青黛、冰片各等分。";
  ex:hasUsage "以芦管吹入喉中。" .

<medicine:立消斗大疝气方> a ex:Medicine;
  ex:hasFunction "疝气。";
  ex:hasName "立消斗大疝气方";
  ex:hasPreparation "多年香橼1个，切碎，雄猪尿胞洗净，入药扎紧，好酒4-5斤，煮烂，面糊为丸，如梧桐子大。";
  ex:hasPrescription "沉香5钱，紫苏5钱，苏木5钱，南星5钱。";
  ex:hasUsage "每服4-5丸，酒送下。药尽胞缩。" .

<medicine:立消汤> a ex:Medicine;
  ex:hasFunction "攻散诸毒。主痈疽发背，或生头项，或生手足臂腿腰脐之间、前阴粪门之际，以及肺痈、肠痈。";
  ex:hasName "立消汤";
  ex:hasPrescription "蒲公英1两，金银花4两，当归2两，玄参1两。";
  ex:hasUsage "水煎，饥服。" .

<medicine:立消疔疮外治神效方>
  a ex:Medicine;
  ex:hasAlias "疔疮膏";
  ex:hasFunction "疔疮。";
  ex:hasName "立消疔疮外治神效方";
  ex:hasNote "贴后忌食荤腥辛辣、沸汤大热食、生冷发物、面食、豆腐、茄子、黄瓜、酒，忌水洗，忌恼怒忧闷，大忌房事。";
  ex:hasPreparation "用桑柴火先将麻油入锅煎滚，次下松香候稍滚，三下白蜡候稍滚，四下黄蜡候稍滚，五下乳香候稍滚，六下没药候稍滚，七下铜绿候稍滚，八下百草霜，滚过数次，于锅内冷透，搓成条子为丸，如龙眼核大，藏净瓷器内。";
  ex:hasPrescription "松香20两，没药3两（研极细末），白蜡2两（切，为粗末），铜绿5两（研细，过绢筛，再研至无声为度），黄蜡10两（刮取粗片），百草霜5两（研细，过绢筛，再研至无声为度），明乳香3两（研极细末），麻油6两。";
  ex:hasUsage "疔疮膏（《经验方》卷上）。①制松香法：用桑柴灰煎汁澄清，入松香煮烂，取出入冷水中，少时再入灰水中煮，以色白如玉为度，②取百草霜法：先须刮净锅底，专烧茅柴百草，取烟煤用。如以别种柴烟煤用入，则不验。" .

<medicine:立消神效膏> a ex:Medicine;
  ex:hasFunction "阴阳肿毒。";
  ex:hasName "立消神效膏";
  ex:hasPreparation "上药煎枯去滓，再煎至滴水成珠，待冷，下银朱12两，乳香、没药、轻粉、芸香末各5钱，麝香3钱，搅匀。";
  ex:hasPrescription "大黄1两，五倍子1两，白蔹1两，半枝莲1两，黄柏1两，甘草1两，姜黄1两，紫金皮1两，南星1两，白芥子1两，官桂1两，白芷1两，草乌1两，苍术1两，巴豆肉1两，蓖麻肉1两，蜈蚣（炙）30枚，土狗（炙）30枚，麻油3斤半，白凤仙梗汁1饭碗，大蒜汁1饭碗，葱汁1饭碗，姜汁1饭碗，韭菜汁1饭碗，商陆6两，苍耳头2两，蛇蜕5钱，驴蹄甲1个，山羊角2只，虾蟆干1只，黄牛角腮1两，猪蹄甲1两，番木鳖1两，山甲1两，苏木1两，归尾1两，芫花1两，大戟1两，大鲫鱼8两1个。";
  ex:hasUsage "摊贴。" .

<medicine:立消膏> a ex:Medicine;
  ex:hasAlias "至妙立消膏、立消散、立消丹";
  ex:hasFunction "浮翳、粟翳，雾膜遮睛,或来或去，渐发差大，侵睛减明。";
  ex:hasName "立消膏";
  ex:hasPreparation "上药共研为细末。";
  ex:hasPrescription "雪白盐（净器中生研）少许。";
  ex:hasUsage "至妙立消膏（《活幼口议》卷二十）、立消散（《医学入门》卷七）、立消丹（《眼科全书》卷六）。" .

<medicine:立溃拔毒膏> a ex:Medicine;
  ex:hasFunction "诸般恶毒，痈疽疮疖。";
  ex:hasName "立溃拔毒膏";
  ex:hasPreparation "上以五样灰淋汁，锅内慢火熬之，面上起白霜为度，调前4味。";
  ex:hasPrescription "糯米1两（南星、当归、赤芍各3钱同炒），硇砂3钱，斑蝥3钱，好石灰1两（皂角烧烟熏，共为末），桑柴灰3两，真炭灰3两，皂角灰3两，毛竹（去青，煅灰）3两，脂麻楷灰3两。";
  ex:hasUsage "点于患处。" .

<medicine:立灵散> a ex:Medicine;
  ex:hasFunction "目生翳膜。";
  ex:hasName "立灵散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "炉甘石1钱（打成小块，放银罐内，将火硝拌匀，用火煅红取出，研极细，飞过，复研，以细绝为度），冰片1分，麝香1分，熊胆2分，蕤仁3分（去油净）。";
  ex:hasUsage "点翳膜上。" .

<medicine:立生丹> a ex:Medicine;
  ex:hasFunction "治伤暑霍乱，疟疾，痢疾，泄泻，胃痛腹痛，吞吐酸水。";
  ex:hasName "立生丹";
  ex:hasNote "孕妇忌服。";
  ex:hasPreparation "共为细末，用蟾酥24克，铜锅内加水酒200毫升化开，入前药末，丸绿豆大。";
  ex:hasPrescription "母丁香36克 沉香12克 茅苍术36克 明雄黄36克";
  ex:hasUsage "每服2丸，小儿1丸，温水送下。又下死胎如神。凡被蝎蜂螫者，调涂立效。" .

<medicine:立生酥葵膏> a ex:Medicine;
  ex:hasFunction "妊娠数日不产，或生不顺理，百方不得安。";
  ex:hasName "立生酥葵膏";
  ex:hasPreparation "以清酒1升，细研葵子，入酥、蜜中，微火熬令熔，即下诸药，慢火煎，常令沸如鱼目，约半升，即以新绵滤，贮瓷器中。";
  ex:hasPrescription "酥1斤，秋葵子1升，白蜜半斤，滑石1两半，瞿麦1两，大豆黄卷2两。";
  ex:hasUsage "每服半匙，加至1匙，多恐呕逆。" .

<medicine:立神丹> a ex:Medicine;
  ex:hasFunction "小肠气。";
  ex:hasName "立神丹";
  ex:hasPreparation "上为细末，薄荷酒糊为丸，如梧桐子大。";
  ex:hasPrescription "香附子不拘多少（去毛炒，再去毛，用无灰酒煮尽）。";
  ex:hasUsage "每服20丸，或30丸，空心、日午盐汤或酒送下。" .

<medicine:立竹汤> a ex:Medicine;
  ex:hasFunction "诸鱼骨鲠在喉中。";
  ex:hasName "立竹汤";
  ex:hasPrescription "立死竹（从地高2尺以上刮去皮，细劈如算子）、三七茎。";
  ex:hasUsage "用水2盏，煎7分，去滓顿服。" .

<medicine:立竿见影方> a ex:Medicine;
  ex:hasFunction "活水瘦胎，软骨。主死胎不下，横生逆产。";
  ex:hasName "立竿见影方";
  ex:hasPreparation "上为末，醋糊为丸，如弹子大，大黄为衣。";
  ex:hasPrescription "黄葵花3钱，牡丹花3分，真芜荑3分，寸香1分，桑牛半个，巴豆半粒（去油），蓖麻半粒（去油）。";
  ex:hasUsage "临用研碎1丸，热酒和香油少许送下。用葱汁打糊为丸更妙。" .

<medicine:立胜散> a ex:Medicine;
  ex:hasAlias "立胜煎";
  ex:hasFunction "小儿咽喉作呀呷声不止。";
  ex:hasName "立胜散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "胆矾1钱，轻粉少许。";
  ex:hasUsage "用浆水半盏，小油1-2点，打散灌之。" .

<medicine:立胜煎> a ex:Medicine;
  ex:hasFunction "治三焦火毒上燔，目中黄液上冲，证见黑睛与黄仁之间积聚黄色脓液。";
  ex:hasName "立胜煎";
  ex:hasPreparation "用水300毫升，煎30分钟后过滤，浓缩至150毫升，再加缓冲溶液，以消除刺激性。";
  ex:hasPrescription "川连 黄柏 秦皮 甘草";
  ex:hasUsage "用时滴于眼内。" .

<medicine:立苏散> a ex:Medicine;
  ex:hasFunction "小肠气。";
  ex:hasName "立苏散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "蝎蜥9个（去毒），马蔺花2钱（水浸1宿），木香1钱，没药半钱，胡椒（为末）半钱。";
  ex:hasUsage "方中胡椒用量原缺，据《普济方》补。" .

<medicine:立行饮> a ex:Medicine;
  ex:hasFunction "闭经，因食生冷所致。";
  ex:hasName "立行饮";
  ex:hasPrescription "官桂3钱，干姜1钱，广木香1钱，玄胡索1钱，牛膝1钱5分，蓬术1钱5分，归尾1钱5分，山楂1钱5分。";
  ex:hasUsage "酒煎，空心热服。" .

<medicine:立解咽喉肿塞方> a ex:Medicine;
  ex:hasFunction "咽喉肿塞。";
  ex:hasName "立解咽喉肿塞方";
  ex:hasPreparation "同煮膏，贮瓮中，埋地下，一年后取出。";
  ex:hasPrescription "夏枯草花10斤，瓮水梨肉100斤。";
  ex:hasUsage "含少许即消。" .

<medicine:立通丸> a ex:Medicine;
  ex:hasAlias "青橘皮丸";
  ex:hasFunction "胃热肠寒，善食数饥，便溺，小腹胀痛，大便或涩。";
  ex:hasName "立通丸";
  ex:hasPreparation "上为细末，面糊为丸，如绿豆大。";
  ex:hasPrescription "京三棱（炮，锉）1两，黄连（去须）1两，青橘皮（汤浸，去白，焙）1两，蓬莪术（炮）1两，巴豆霜1分。";
  ex:hasUsage "青橘皮丸（《宣明论》卷二）。" .

<medicine:立通散> a ex:Medicine;
  ex:hasFunction "治咽喉闭塞不通。";
  ex:hasName "立通散";
  ex:hasPreparation "上三味，捣罗为散。";
  ex:hasPrescription "蜒蚰（阴干）2-7条 矾石（半生半烧）7.5克 白梅肉（炒燥）2-7枚";
  ex:hasUsage "每用1.5克吹入喉内，或水调下。得吐立通。" .

<medicine:立通饮> a ex:Medicine;
  ex:hasFunction "内有积热，闭结不通。";
  ex:hasName "立通饮";
  ex:hasPrescription "黄芩3钱，石膏（煅）5钱，黄柏1钱，山栀仁1钱，麦冬1钱，玄明粉2钱，桃仁2钱。";
  ex:hasUsage "水煎，不拘时候服。" .

<medicine:立金汤> a ex:Medicine;
  ex:hasFunction "腰痛。";
  ex:hasName "立金汤";
  ex:hasNote "戒房事。";
  ex:hasPrescription "杜仲5钱，故纸4钱，萆薢3钱半，当归1钱半，续断2钱，牛膝2钱，狗脊1钱，木瓜1钱半，炙草5分，胡桃肉1钱。";
  ex:hasUsage "酒2碗煎，加盐下，连2服。" .

<medicine:立除冷哮散> a ex:Medicine;
  ex:hasFunction "散寒定哮。主冷哮痰喘，遇冷即发者。";
  ex:hasName "立除冷哮散";
  ex:hasNote "若有伏热者忌用。";
  ex:hasPreparation "入活癞虾蟆腹中，盐泥裹，煅存性。";
  ex:hasPrescription "胡椒49粒。";
  ex:hasUsage "分5-7服，用小青龙汤送下。" .

<medicine:立马乌> a ex:Medicine;
  ex:hasFunction "乌髭。主";
  ex:hasName "立马乌";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "定粉1钱，瓦粉1钱，密陀僧半钱，龙骨半钱，轻粉3钱，朴消1钱，铅白霜1钱，韶脑半两，花碱6钱，玉霜1两3钱。";
  ex:hasUsage "先用白土黄丹敷过髭地，候干，将前项药水调，再上髭鬓上，用纸裹。候少时，其髭便黑，用新水洗去。" .

<medicine:立马回疔丹> a ex:Medicine;
  ex:hasClinicalApplication "临床主要用于治疗化脓性疖肿，也有用于治疗蜂窝织炎(有头疽)等病症。";
  ex:hasFunction "化毒消肿。主疔疮走晕不止,一切疔疮疔毒走黄险症,疔毒初起，红肿疼痛。";
  ex:hasName "立马回疔丹";
  ex:hasPreparation "上为细末，用生草乌头汁拌和为锭，如麦子长大。";
  ex:hasPrescription "金脚信半钱，蟾酥半钱，血竭半钱，朱砂半钱，轻粉，龙脑，麝香各1字，没药半钱。";
  ex:hasUsage "用时将疮顶刺破，将药1锭放疮口内。第2日疮肿为效。" .

<medicine:立马回疔夺命散> a ex:Medicine;
  ex:hasFunction "疔疮，咽喉乳蛾肿痛，喉痹。";
