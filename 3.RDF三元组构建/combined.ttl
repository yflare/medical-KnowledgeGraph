  ex:hasUsage "以水2升，煮取8合，去滓，温含，冷吐之。" .

<medicine:含沙散> a ex:Medicine;
  ex:hasFunction "沙毒。";
  ex:hasName "含沙散";
  ex:hasPreparation "上极细末，瓷瓶收贮。";
  ex:hasPrescription "生大黄6两，公丁香1两5钱，明天麻3两，牙皂角3两，丹砂4两，明雄黄4两，麻黄3两，冰片3钱，麝香3钱，苍术3两，蟾酥1两，香白芷3钱，草果仁1两5钱。";
  ex:hasUsage "吹入鼻中取嚏。" .

<medicine:含消丸> a ex:Medicine;
  ex:hasFunction "胸中热，口干。";
  ex:hasName "含消丸";
  ex:hasPreparation "上为散，别捣梅、枣令熟，合余药为丸，如弹子大。";
  ex:hasPrescription "茯苓1两，五味子1两，甘草1两，乌梅（去核）2-7个，大枣（去核）2-7个。";
  ex:hasUsage "含之咽汁，日3夜2。" .

<medicine:含漱汤> a ex:Medicine;
  ex:hasFunction "齿痛。";
  ex:hasName "含漱汤";
  ex:hasPreparation "上七味，哎咀。";
