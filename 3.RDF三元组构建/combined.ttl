  ex:hasPrescription "乌鸡1只（令净），胡荽子适量。";
  ex:hasUsage "胡荽子入鸡缝之，煮熟食之。不效，再如法服食1只乌鸡。" .

<medicine:胡荽子散> a ex:Medicine;
  ex:hasFunction "肠风下血不止，变成痔疾。";
  ex:hasName "胡荽子散";
  ex:hasPreparation "上为散。";
