  ex:hasUsage "注眼大眦，每日2次。" .

<medicine:鸡距子汤> a ex:Medicine;
  ex:hasFunction "饮酒发热。";
  ex:hasName "鸡距子汤";
  ex:hasPrescription "鸡距子。" .

<medicine:鸡酒膏> a ex:Medicine;
