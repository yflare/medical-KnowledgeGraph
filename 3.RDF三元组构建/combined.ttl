  ex:hasUsage "仙传救命丹（《集验良方三百种》）。" .

<medicine:救命延年丸> a ex:Medicine;
  ex:hasFunction "一切重痢。";
  ex:hasName "救命延年丸";
  ex:hasPreparation "上为末，用米醋煮阿胶令消尽，不可剩，将药搜醋丸，如梧桐子大。";
