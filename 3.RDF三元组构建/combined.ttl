  ex:hasUsage "水煎服。" .

<medicine:补肝酒> a ex:Medicine;
  ex:hasAlias "松膏酒";
  ex:hasFunction "肝虚寒，或高风眼泪等杂病。";
  ex:hasName "补肝酒";
  ex:hasPreparation "上细锉，以水淹浸一周日煮之，细细接取上臂，水竭更添之，脂尽更水煮如前；烟尽去火停冷，脂当沉下，取1斤，酿米1石，水7斗，好曲末2斗，如家常酿酒法，仍冷沉下；饭封100日，脂、米、曲并消尽，酒香满1室。";
  ex:hasPrescription "松脂10斤。";
  ex:hasUsage "细细饮之。此酒须1倍加曲。" .

<medicine:补肝重明丸> a ex:Medicine;
