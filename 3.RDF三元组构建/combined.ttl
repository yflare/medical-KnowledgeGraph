  ex:hasName "百合杏仁粥";
  ex:hasPreparation "将杏仁去皮、尖，打碎，同鲜百合、粳米共煮为稀粥。";
  ex:hasPrescription "鲜百合50克 杏仁10克 粳米50克 白糖适量";
  ex:hasUsage "加白糖适量温服。" .

<medicine:百合桔梗鸡子汤> a ex:Medicine;
  ex:hasFunction "失声，音哑。";
  ex:hasName "百合桔梗鸡子汤";
  ex:hasPrescription "百合3钱，桔梗2钱，五味1钱，鸡子白1枚。";
  ex:hasUsage "煎半杯，去滓，入鸡子清，热服。" .

<medicine:百合汤> a ex:Medicine;
  ex:hasClinicalApplication "胃院痛：陈某某，男，44岁，脘痛而胀，按之痛减，嘈杂，嗳气，泛酸，知饥纳少，舌苔微黄，质淡红，脉弦细。曾服理气止痛诸方，初尚有效，继则复痛如故。因思此证痛而兼胀，必属气痛；嘈杂泛酸，知饥纳少，服辛温行气药不效，其病偏热无疑，故用百合汤，服三剂之后，痛胀减轻大半，继服数剂而愈。";
  ex:hasFunction "暑病已愈而触犯者。";
  ex:hasName "百合汤";
  ex:hasPreparation "上锉1剂。";
  ex:hasPrescription "柴胡（去芦）1钱，人参（去芦）5分，黄芩1钱，甘草5分，知母（去粗）8分，百合1钱2分，陈皮（去白）1钱，生地黄7分。";
  ex:hasUsage "水1钟，加生姜3片，捶碎，醋煮鳖甲，煎之温服。" .

<medicine:百合洗方> a ex:Medicine;
  ex:hasFunction "百合病一月不解，变成渴者。";
  ex:hasName "百合洗方";
  ex:hasNote "宜淡食。";
  ex:hasPrescription "百合1升。";
  ex:hasUsage "以水1斗，渍之1宿，以洗身。洗已，食煮饼，勿以盐豉。" .

<medicine:百合消胀汤> a ex:Medicine;
  ex:hasFunction "肺、脾、肾三经之虚，导致胃中积水浸淫，遍走于经络皮肤，气喘作胀，腹肿，小便不利，大便亦溏，一身俱肿。";
  ex:hasName "百合消胀汤";
  ex:hasPrescription "白术1两，芡实1两，茯苓5钱，百合5钱，山药1两，肉桂2钱，人参3钱。";
  ex:hasUsage "水煎服。" .

<medicine:百合滑石散> a ex:Medicine;
  ex:hasAlias "滑石散";
  ex:hasFunction "百合病小便赤涩，脐下坚急。";
  ex:hasName "百合滑石散";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "百合1两（炙），滑石3两。";
  ex:hasUsage "滑石散（《活人书》卷十八）。" .

<medicine:百合煎> a ex:Medicine;
  ex:hasFunction "肺痈。";
  ex:hasName "百合煎";
  ex:hasPrescription "白花百合。";
  ex:hasUsage "或煮或蒸，频食即愈，拌蜜蒸更好。" .

<medicine:百合知母汤> a ex:Medicine;
  ex:hasFunction "百合病，发汗后者。";
  ex:hasName "百合知母汤";
  ex:hasPrescription "百合7枚（擘），知母3两（切）。";
  ex:hasUsage "先以水洗百合，渍1宿，当白沫出，去其水，更以泉水2升，煎取1升，去滓；别以泉水2升煎知母，取1升，去滓；后合和，煎取1升5合，分温再服。" .

<medicine:百合粥> a ex:Medicine;
  ex:hasFunction "补肺止嗽。主";
  ex:hasName "百合粥";
  ex:hasPreparation "百合以水煮熟，投入将熟粥中，数沸即可。";
  ex:hasPrescription "生百合1升，蜜1两。";
  ex:hasUsage "用水煮熟，干投入将熟粥罐中，每碗用2合，空心食。" .

<medicine:百合紫菀汤> a ex:Medicine;
  ex:hasFunction "伤寒百合病，似劳，形状如疟。";
  ex:hasName "百合紫菀汤";
  ex:hasPreparation "上为粗末。";
  ex:hasPrescription "百合、紫菀（去苗土）、柴胡（去苗）、杏仁（汤浸，去皮尖双仁，炒令黄）、白茯苓（去黑皮）、甘草（炙令微赤）各等分。";
  ex:hasUsage "每服5钱匕，水1盏半，加生姜半分（拍碎），煎至7分，去滓，空心温服，日晚再服。" .

<medicine:百合茅根汤> a ex:Medicine;
  ex:hasFunction "清肺气以滋化源。主阳水肿，已用宣上发汗，通利小便，水肿已退者。";
  ex:hasName "百合茅根汤";
  ex:hasPrescription "苏百合1钱，生桑皮1钱，通草1钱，鲜茅根50支。" .

<medicine:百合饮> a ex:Medicine;
  ex:hasFunction "伤寒后脾胃有余热，气满不能食。";
  ex:hasName "百合饮";
  ex:hasPreparation "上锉，如麻豆大。";
  ex:hasPrescription "百合1分，人参1分半，豉（熬）半合，粳米（淘）半合，陈橘皮（汤浸，去白，焙）半两，薤白（切）5茎，生姜（切）半两。";
  ex:hasUsage "以水5盏，煎至2盏半，去滓，食后温服，日3次。" .

<medicine:百合饮子> a ex:Medicine;
  ex:hasFunction "泻肺火，清肺金，而滋水之化源。主诸淋。";
  ex:hasName "百合饮子";
  ex:hasPreparation "上锉细。";
  ex:hasPrescription "桑白皮6分，通草8分，百合8分，白茅根1分。";
  ex:hasUsage "本方用法中前散药：滑石、冬葵子各八分，瞿麦、石韦各五分（去毛），蒲黄六分，陈橘皮四分，芍药、茯苓、芒消各六分，子芩六分。捣为散。每服方寸匕，一日二次。" .

<medicine:百合鸡子汤> a ex:Medicine;
  ex:hasAlias "鸡子汤";
  ex:hasFunction "百合病，吐之后者。";
  ex:hasName "百合鸡子汤";
  ex:hasPrescription "百合7枚（擘），鸡子黄1枚。";
  ex:hasUsage "鸡子汤（《活人书》卷十八）。本方方名，《兰台轨范》引作“百合鸡子黄汤”。" .

<medicine:百和汤> a ex:Medicine;
  ex:hasFunction "跌扑损伤。";
  ex:hasName "百和汤";
  ex:hasPrescription "生地、当归、白及、骨碎补、鹿茸、续断、首乌、炙草。";
  ex:hasUsage "水煎服。" .

<medicine:百和香> a ex:Medicine;
  ex:hasFunction "令身体香。主";
  ex:hasName "百和香";
  ex:hasPreparation "上为末，酒洒令软，再宿酒气歇，以白蜜和，细瓷器中，蜡纸封，勿令泄，冬月开取用，大佳。";
  ex:hasPrescription "沉水香5两，甲香2两，丁子香2两，鸡骨香2两，兜娄婆香2两，熏陆香2两，白檀香2两，熟捷香2两，炭末2两，零陵香1两，藿香1两，青桂皮1两，白渐香（柴也）1两，青木香1两，甘松香1两，雀头香半两，苏合香半两，安息香半两，麝香半两，燕香半两。" .

<medicine:百嚼丸> a ex:Medicine;
  ex:hasFunction "风壅涎实，头目昏晕，眼多紧涩，肌肉瞤动，手足烦热，浑身疼痛，腰重脚弱，大便多秘，夜间少睡。";
  ex:hasName "百嚼丸";
  ex:hasPreparation "上为细末，炼蜜为丸，每1两作10丸。";
  ex:hasPrescription "槐角（炒）半斤，槐花（炒）半斤，桔梗（炒）半斤，薄荷叶（去土）半斤，蝉蜕（净洗）半斤，荆芥穗4两，甘草4两（炙），枳壳（麸炒，去瓤）4两，白僵蚕（炒去丝嘴）4两，川芎2两，羌活（去头芦）2两，防风（去头芦）2两，香白芷2两，白茯苓（去皮）2两，天麻1两（去苗），细辛（去叶土）半两，藁本（去土）半两，白附子（炮）半两，细松烟墨（烧红，醋淬）半两。";
  ex:hasUsage "每服1丸，食后、临睡细嚼，茶清送下。" .

<medicine:百子建中丸> a ex:Medicine;
  ex:hasFunction "温中暖脐，调经，开郁开胃。主妇人久冷，赤白带下，肚腹疼痛，经水不调，四肢无力，久鲜子息。";
  ex:hasName "百子建中丸";
  ex:hasPreparation "上为末，用壬子日好米浴打粳米面糊为丸，如梧桐子大。";
  ex:hasPrescription "香附1斤（分作4份：1份童便浸7日，1份酒浸7日，1份泔浸7日，1份盐水浸7日，各炒香），大艾叶4两（米泔浸7日，将米泔慢火煮半日，焙干为末），砂仁5钱，淮熟地（酒浸）3两，白芍药3两，玄胡索1两5钱，五味子5钱，杜仲（酒炒）1两，阿胶（炒）1两5钱，白术1两（麸炒）。";
  ex:hasUsage "每服80丸，空心用淡酣汤送下。服至半月必有孕矣。" .

<medicine:百子附归丸> a ex:Medicine;
  ex:hasAlias "滋血暖宫丸、百子建中丸、百子归附丸";
  ex:hasFunction "调经养血，安胎顺气，种子。主阴阳不利，气血不足，不孕，胎前产后，月事参差，有余不足诸证。";
  ex:hasName "百子附归丸";
  ex:hasPreparation "上为极细末，用大陈石榴1枚，连皮捣碎，东流水3升熬去滓，打面糊为丸，如梧桐子大。";
  ex:hasPrescription "真阿胶（蛤粉炒成珠）2两，蕲艾叶（去筋梗，醋煮干）2两，当归（肥大者，酒洗，去芦）2两，川芎（去芦）2两，怀庆熟地黄（去脑，取沉水者）2两，白芍药（肥长者）2两，香附（赤心者，去毛，杵成米，水、醋各淹1宿，晒，炼干）12两。";
  ex:hasUsage "滋血暖宫丸（《医统》卷八十四）、百子建中丸（《回春》卷六）、百子归附丸（《济阴纲目》卷一）。" .

<medicine:百宝丸> a ex:Medicine;
  ex:hasFunction "牝痔血，肛边生疮。";
  ex:hasName "百宝丸";
  ex:hasPreparation "上为细末，炼蜜为丸，分作25丸。";
  ex:hasPrescription "枳实（去瓤，麸炒）1两。";
  ex:hasUsage "每服1丸，以百宝散送下。" .

<medicine:百宝散> a ex:Medicine;
  ex:hasFunction "牡痔。";
  ex:hasName "百宝散";
  ex:hasPrescription "皂荚（不蚛者4挺烧灰，去皂子不用，研为末，八麝香半钱同研）、皂荚刺针（生杵为末）。";
  ex:hasUsage "取皂荚末1钱匕，入皂荚刺针末半钱匕，以水1盏，同煎至7分，放温服。发痛时嚼百宝丸1丸，以此散送下。" .

<medicine:百寿丸> a ex:Medicine;
  ex:hasFunction "清热健胃，化滞安神。主停乳停食，消化不良，痰盛咳嗽，气促抽搐。";
  ex:hasName "百寿丸";
  ex:hasPreparation "上药和匀，炼蜜为丸，重8分，金箔为半衣，蜡皮封固。";
  ex:hasPrescription "山楂5两，滑石5两，苍术2两5钱，胆南星2两5钱，天竺黄2两5钱，木香2两5钱，砂仁1两5钱，六神曲1两5钱，麦芽1两5钱，钩藤1两5钱，薄荷1两5钱，僵蚕1两5钱，茯苓1两，桔梗1两，甘草1两，橘皮2两5钱（共为细粉），朱砂1两，牛黄2钱。";
  ex:hasUsage "每服1丸，白开水送下。" .

<medicine:百寿散> a ex:Medicine;
  ex:hasFunction "初生小儿未满月内，服之预防疮疥。主";
  ex:hasName "百寿散";
  ex:hasPrescription "黄连1两，朱砂1钱。";
  ex:hasUsage "水煎服，拭去口涎，灌下；余药倾盆中浴儿，遍身搽妙。" .

<medicine:百岁丸> a ex:Medicine;
  ex:hasFunction "恶痢杂下及脾泄。";
  ex:hasName "百岁丸";
  ex:hasPreparation "上除乳香外，将其余5味锉成小块，炒令焦黑色存性，不令烟绝，为末，乳香和匀，面糊为丸，如梧桐子大。";
  ex:hasPrescription "漏篮子1个（大者），阿胶半两，木香半两，黄连半两，罂粟壳半两，乳香少许（别研）。";
  ex:hasUsage "每服1岁1丸，因其年数服之，米饮送下，不拘时候。" .

<medicine:百岁酒> a ex:Medicine;
  ex:hasFunction "水火既济，步履强健。主虚损劳伤，瘫痪诸风，失精亡血，阳衰气弱。";
  ex:hasName "百岁酒";
  ex:hasPrescription "蜜炙黄耆2两，大生地1两2钱，茯苓1两，龟版胶1两，肉桂6钱，抱茯神2两，大麦门冬1两，熟地1两5钱，羌活8钱，川芎1两，潞党参1两5钱，全当归1两2钱，陈皮1两，防风1两，于术1两，五味子8钱，枸杞子1两，大枣仁2斤，枣皮1两，冰糖2斤。";
  ex:hasUsage "泡高梁烧酒20斤，合前药入瓶内，隔水共煮1炷香，或埋土中7日更好。每晚随量饮之。" .

<medicine:百岁铁娃丹> a ex:Medicine;
  ex:hasFunction "消化积聚，消热祛风。主小儿停食停乳，积滞不化，腹膨胀满，大便秘结，急热惊风。";
  ex:hasName "百岁铁娃丹";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "当归2两，枳实（炒）1两，神曲（炒）1两，山楂1两，全蝎1两，麦芽（炒）1两。";
  ex:hasUsage "每35两细末兑入牛黄2两，朱砂20两，豆霜2钱5分，共为极细末，混合均匀，袋装，每袋重5厘。每服5厘，温开水冲下。" .

<medicine:百应丸> a ex:Medicine;
  ex:hasFunction "年深日近痃癖气块，症癖痛积聚，气积、滞积、酒食积、五脏停滞不消，小便黄赤，四肢沉困。";
  ex:hasName "百应丸";
  ex:hasPreparation "上为细末，消糊为丸，如小豆大。";
  ex:hasPrescription "麦糵（炒）5钱，神曲（炒）5钱，丁皮5钱，桂皮（去粗皮）5钱，玄胡索5钱，缩砂仁5钱，肉豆蔻5钱，京三棱1两，广术（炮）1两，雄黄（去石）1两，青皮（去衣）1两，枳壳（麸炒，去瓤）1两，槟榔1两，代赭石1两，木香1两。";
  ex:hasUsage "每服50丸，小肠气，茴香汤送下；心痛，热醋送下；产后寒热腹痛，当归、红花汤送下；内外积伤，葱白汤送下；常服，茶、酒或盐汤送下，不拘时候。" .

<medicine:百应神膏> a ex:Medicine;
  ex:hasAlias "百应膏";
  ex:hasFunction "一切疮毒；并治风瘫，鹤膝。";
  ex:hasName "百应神膏";
  ex:hasPreparation "用真麻油1斤，每药1斤加生姜1两，葱白10根，头发1团，同入药内熬枯焦色。滤滓，再用广松香1斤，入滤清油内，又熬至核桃花起，先入陀僧末2两，又徐徐加入硫黄末半斤。投此2味，须慢慢洒入，不可太多太骤，以滴水成殊为度。将此膏药倾入水中，去火毒。";
  ex:hasPrescription "南星4钱，川大黄4钱，桃仁4钱，羌活4钱，半夏4钱，草乌4钱，川乌4钱，红花4钱，独活4钱，当归4钱。";
  ex:hasUsage "百应膏（《理瀹》）。" .

<medicine:百当膏> a ex:Medicine;
  ex:hasFunction "一切积聚，心腹疼痛，年月深久者。";
  ex:hasName "百当膏";
  ex:hasPreparation "上为细末，熔蜡并熟蜜少许，同和成膏，旋丸如梧桐子大。";
  ex:hasPrescription "丹砂（研）半两，腻粉（研）半两，水银1分，铅1分（2味结成砂子），牛黄2钱，龙脑（研）2钱，铅霜（研）2钱，粉霜（研）1分，阳起石（研）1分，黄蜡半两，巴豆（肥者，去皮心膜，研出油，取霜用）120粒，蝎梢（炒）1分，半夏1钱（汤洗7遍，杵罗为末）。";
  ex:hasUsage "每服3-5丸，吐逆，藿香汤送下；取热积，生姜、蜜水送下；取冷积，乳香汤送下；风涎，薄荷汤送下；便痢，米饮送下。" .

<medicine:百御丸> a ex:Medicine;
  ex:hasFunction "外感风寒，内伤食滞，腹泻身疼，黄疸湿泻。";
  ex:hasName "百御丸";
  ex:hasPreparation "上药各为细末，姜、枣汤为丸。";
  ex:hasPrescription "真茅术20两（米泔浸，米拌抄），甘草20两（生、炙各半），半夏20两（姜制），云茯苓20两，白扁豆10两（炒），厚朴10两（姜汁炒），麦芽10两（炒），香附10两（制），山楂炭10两，广藿香10两，神曲10两，陈皮8两，枳壳（麸炒）8两，黄芩8两（酒炒），防风8两，桔梗8两，苏叶8两，薄荷8两。";
  ex:hasUsage "每服2钱，轻者每日1次，重者每日2次。寒热往来，关节烦疼，无汗者，白开水送下；有汗者，葛根1钱煎汤送下。一身尽痛，或不痛而不能转侧者，桂枝1钱煎汤送下；有汗者，生苡米仁3钱煎汤送下。腹满谵语者，焦山栀1钱，豆豉2钱煎汤送下。腹胀泄泻者，煨木香3分煎汤送下。面目及一身俱黄者，茵陈蒿2钱，焦山栀1钱煎汤送下。身黄发热者，焦山栀1钱，黄柏5分煎汤送下。足跗肿或1身俱肿者，木通1钱煎汤送下。" .

<medicine:百损丸> a ex:Medicine;
  ex:hasFunction "滋补肝肾，强壮筋骨，活血祛瘀，通经络，续断伤，补骨髓。主跌打损伤，不论内伤脏腑，外伤筋骨，以及劳伤经络；并治遗精，脚弱，腰膝酸痛．诸虚百损。";
  ex:hasName "百损丸";
  ex:hasPreparation "前8味，共为细末，连同后5味和匀，入鸡血藤膏，再入炼蜜为丸，每丸重3钱。";
  ex:hasPrescription "破故纸（羊油炒微黄）2两半，骨碎补（甜酒洗）2两，杜仲（盐水炒断丝，勿令焦）1两，川牛膝（甜洒炒，勿令焦）1两，川续断（甜酒炒，勿令焦）1两，肉苁蓉（酒洗）1两，黑（禾兽？？）豆1两，当归（酒洗）1两，鸡血藤膏（甜酒化开，或用鸡血藤3两代）5钱，三七（另研，可用竹节3-7代）5钱，血琥珀（另研。或用乳香5钱代）3钱，麒麟竭（另研）5钱，沉香（另研。或用降香代）5钱。";
  ex:hasUsage "每服1丸，早、晚空心开水送下。久服自效。" .

<medicine:百效丸> a ex:Medicine;
  ex:hasFunction "一切大毒恶疮，无论已溃未溃。";
  ex:hasName "百效丸";
  ex:hasNote "孕妇忌服。";
  ex:hasPreparation "上为细末，葱汁熬汤，水为丸，如芥子大，晒干，瓷瓶密贮。";
  ex:hasPrescription "草乌头（酒浸半日，刮去皮，切片，炒）1两，马钱子（切薄片，炒黄色，筛去毛，净）1两，全当归（切片，酒拌，晒干，炒）1两，麻黄（去节，不见火，晒脆）1两，真僵蚕（酒洗，炒去丝）1两，穿山甲（炒，去沙）1两，大甘草（不见火，晒干，研）5钱。";
  ex:hasUsage "高年者5-6分，中年者7-8分，少年者3分，凡服俱用葱汁白汤送下。务须避风取汗，如汗出后，必须次日辰已时方可起床见风，如不遵戒守，汗出见风，则手足坚硬。凡犯此者，即用甘草末，调服即解。" .

<medicine:百效散> a ex:Medicine;
  ex:hasFunction "清热化滞，镇惊安神。主食滞火盛，急热惊风，呕吐乳食，红白痢疾。";
  ex:hasName "百效散";
  ex:hasPreparation "上为细末，袋装，每袋6厘。";
  ex:hasPrescription "大黄8两，牙皂2两，当归4两，全蝎1两，黄土5钱，神曲（炒）4两，天麻4两，僵蚕（炒）2两，赤金150张，朱砂4两。";
  ex:hasUsage "每服1袋，温开水送下，日2次。" .

<medicine:百效汤> a ex:Medicine;
  ex:hasFunction "肠胃壅热、风热，牙龈肿痛，颊车皆肿。";
  ex:hasName "百效汤";
  ex:hasPrescription "升麻1钱，葛根1钱，白芷1钱，酒芩1钱，桔梗1钱，防风5分，薄荷5分，石膏3钱，甘草6分，天花粉8分，细辛4分。";
  ex:hasUsage "加生姜3片，水煎服，食后频频少服之。" .

<medicine:百效膏> a ex:Medicine;
  ex:hasFunction "活血化痞。主风湿疼痛，跌打损伤，积聚痞块，及妇女月经不调。";
  ex:hasName "百效膏";
  ex:hasNote "忌劳累，并忌食发物。";
  ex:hasPreparation "上药用香油240两，炸枯去滓，炼至滴水成珠，入黄丹100两搅匀成膏；另用阿魏2两，乳香2两，没药2两，共为细粉，每16两膏油兑药粉5钱，搅匀摊贴。";
  ex:hasPrescription "白芷4两，官桂3两，当归11两，玄参4两，大黄4两，赤芍4两，木鳖子4两，血余3两，生地11两。";
  ex:hasUsage "微火化开，贴患处。" .

<medicine:百效饮> a ex:Medicine;
  ex:hasFunction "杨梅、下疳、便毒。";
  ex:hasName "百效饮";
  ex:hasPrescription "土茯苓120钱，玄参20钱，银花20钱，防风20钱，荆芥20钱，连翘20钱，黄柏20钱，大黄20钱，芒消20钱，蝉蜕20钱，天花粉20钱，龙胆20钱，猪苓20钱，泽泻20钱，甘草1钱2分。";
  ex:hasUsage "上分作12帖。每帖头煎以水6盏，煮取5盏；第2次煎，以水5盏，煮取3盏；第3次煎，以水3盏，煮取2盏，俱相和，1日服尽。" .

<medicine:百日咳新药> a ex:Medicine;
  ex:hasFunction "利气化痰，降气行痰，泻肺火，散肺风，消痰解痉。主百日咳。";
  ex:hasName "百日咳新药";
  ex:hasNote "忌发物、五辛。";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "制麻黄7钱，生山栀2钱，北细辛1钱5分，五爪红4钱，葶苈子3钱，炒杏仁4钱，北五味2钱，制桑皮3钱，清夏4钱，生石膏7钱，制紫菀3钱，生黄芩2钱，生甘草3钱，制覆花4钱。";
  ex:hasUsage "未满周岁小儿每次服半分；满周岁服1分；2-3岁服1分5厘；4-6岁服2分；7-8岁服3分；9-10岁服4分；10-15岁服5分。白水送下，日3次。" .

<medicine:百日还丹> a ex:Medicine;
  ex:hasFunction "消渴。";
  ex:hasName "百日还丹";
  ex:hasPreparation "上为末，枸杞汁为丸，如鸡头子大。";
  ex:hasPrescription "佛茄子、樟柳根各等分。";
  ex:hasUsage "每服10丸，新水送下。" .

<medicine:百杯丸> a ex:Medicine;
  ex:hasFunction "饮酒不醉。主";
  ex:hasName "百杯丸";
  ex:hasPreparation "上为细末，炼蜜为丸，每1两作10丸。";
  ex:hasPrescription "缩砂仁1两，高茶1两，诃子1个，麝香1钱，脑子少许。";
  ex:hasUsage "未饮酒先细嚼1丸，酒送下。" .

<medicine:百杯散> a ex:Medicine;
  ex:hasFunction "一切酒病。";
  ex:hasName "百杯散";
  ex:hasNote "忌食甘草1-2日。";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "甘遂1两，橘皮（去白）1两，葛花1两（净）。";
  ex:hasUsage "每服1钱，临卧用温酒调下。至夜利下，酒病方愈，未知再服。" .

<medicine:百果仙胶> a ex:Medicine;
  ex:hasFunction "添精补髓，清肺益气，祛痰止嗽，补诸虚损。主咯痰，喘嗽。";
  ex:hasName "百果仙胶";
  ex:hasPreparation "共熬成胶，每块1斤重，置于清凉之处。";
  ex:hasPrescription "核桃仁2斤1两4钱，真鹿胶3斤2两，榛子仁2斤1两4钱，松子仁5两3钱4分，瓜子仁5两3钱4分，贡冰糖8斤5两4钱，黄酒2斤1两4钱。";
  ex:hasUsage "每服2钱，开水送下，早、晚各1次。" .

<medicine:百果酒> a ex:Medicine;
  ex:hasFunction "补虚益骨。主";
  ex:hasName "百果酒";
  ex:hasPrescription "香橼2，佛手2个，核桃肉半斤，龙眼肉半斤，莲肉半斤，橘饼半斤，柏子仁4两，松子3两，红枣20两，黑糖3斤。";
  ex:hasUsage "干烧酒50斤浸。" .

<medicine:百枝膏> a ex:Medicine;
  ex:hasFunction "安心神，镇惊悸。主小儿禀赋怯弱，易感惊邪，心神恍惚，睡眠不安。";
  ex:hasName "百枝膏";
  ex:hasPreparation "除朱、麝外，同为细末，后人朱、麝研匀，炼蜜为丸，每1两分作40丸。";
  ex:hasPrescription "人参（去芦头）1两，防风（去芦头）1两，天麻1两，麦门冬（汤浸，去心，焙干）半两，白附子（炮）半两，白僵蚕（炒去丝嘴）半两，羌活（去芦头）半两，石菖蒲半两，朱砂2钱（别研），麝香1钱（别研）。";
  ex:hasUsage "本方方名，据剂型，当作“百枝丸”。" .

<medicine:百枣丹> a ex:Medicine;
  ex:hasFunction "口疳。";
  ex:hasName "百枣丹";
  ex:hasPreparation "先将枣肉包砒煅存性，再入余末乳匀。";
  ex:hasPrescription "黑枣100枚，白砒1两，川连2钱，煅月石1钱，黄柏1钱，芦荟2钱，上片3分。" .

<medicine:百段锦散> a ex:Medicine;
  ex:hasFunction "消肾，小便白浊，有浊无渴。";
  ex:hasName "百段锦散";
  ex:hasPrescription "五苓散、清心莲子饮。";
  ex:hasUsage "上2方依方制，等分打合。水煎服，日2次。" .

<medicine:百沸汤> a ex:Medicine;
  ex:hasFunction "霍乱吐泻。";
  ex:hasName "百沸汤";
  ex:hasPrescription "吴茱萸5钱，木瓜5钱，食盐5钱（同炒焦）。";
  ex:hasUsage "瓷瓶盛水3升，煮令百沸，却入上药同煎至2升以下，每服1盏，随病人意冷暖服之。药入即醒。" .

<medicine:百消丸> a ex:Medicine;
  ex:hasFunction "消积，消胀，利水。主肉积、食积、水积、气积及消化不良。";
  ex:hasName "百消丸";
  ex:hasNote "虚弱及孕妇忌用。";
  ex:hasPreparation "上为细末，水为小丸。";
  ex:hasPrescription "二丑2斤，五灵脂8两，香附子1斤半，大黄1斤半。";
  ex:hasUsage "每服3钱；开水送下，日2次。" .

<medicine:百消散> a ex:Medicine;
  ex:hasFunction "一切无名肿毒，对口发背，流注，痈疽，疔疮。";
  ex:hasName "百消散";
  ex:hasPreparation "先将龟版烘热，取蜡末渐渐掺上，掺完，版自炙枯，放泥土上，出火气，研碎。";
  ex:hasPrescription "血龟版1大个（须用下半段，断不可用汤版为要），白蜡1两（为细末）。";
  ex:hasUsage "用黄酒冲服，至醉为度，服后即仰卧，出大汗而愈。如稍有未平，再服半服，断无不愈。惟炙版须用桑柴火，如桑柴难觅，青炭亦可，切不可用煤火。" .

<medicine:百灵丸> a ex:Medicine;
  ex:hasFunction "一切咽喉急症。";
  ex:hasName "百灵丸";
  ex:hasNote "虚弱者忌用。";
  ex:hasPreparation "上为末，用好醋及冰糖汁炼为丸，如高梁子大。";
  ex:hasPrescription "猪牙皂1两，真麝香1钱，梅花冰片1钱，射干片1两5钱，炒牛蒡子1两5钱，大玄参2两，苦桔梗2两，净滑石8两，净雄黄2钱，生甘草1两。";
  ex:hasUsage "每服1钱，小儿7分。" .

<medicine:百灵丹> a ex:Medicine;
  ex:hasFunction "小儿犯肥疮及黄水疮。";
  ex:hasName "百灵丹";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "红枣（烧灰）1钱，枯矾1钱，黄丹1钱，松香1钱，官粉5分，银朱3分。";
  ex:hasUsage "湿则掺之，干则香油调搽。" .

<medicine:百灵散> a ex:Medicine;
  ex:hasFunction "赤白痢。";
  ex:hasName "百灵散";
  ex:hasNote "忌酒、面、鸡、鱼，一切毒物。";
  ex:hasPrescription "罂粟壳（去瓤蒂，用好醋炒）、陈皮（去瓤）、木通、乌梅、车前、甘草、黄连各等分。";
  ex:hasUsage "每服3钱，水1盏8分，加生姜3片，大枣1个，煎8分，不拘时候服。" .

<medicine:百灵汤> a ex:Medicine;
  ex:hasClinicalApplication "血痢：温人郑元升云：近日患病，血痢之间数10次，窘不可言，有客惠药两服而止。";
  ex:hasFunction "赤白痢。";
  ex:hasName "百灵汤";
  ex:hasPreparation "上锉如麻豆大。每服3大钱，水1盏，加生姜3片，枣子2个（劈破），沙罐内慢火煎至8分，去滓，放瓷器碗内，上面封口，用湿纸两重盖覆，不可令灰入腹。";
  ex:hasPrescription "罂粟壳、陈皮、木通、乌梅、甘草、黄连各等分。";
  ex:hasUsage "药后且忌口。" .

<medicine:百灵粉> a ex:Medicine;
  ex:hasFunction "鸡蒙眼，夜不见路者。";
  ex:hasName "百灵粉";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "锅底烟（要烧草者方好，烧柴者勿用）2钱。";
  ex:hasUsage "用煮熟猪肝切片，蘸而食之，即愈。" .

<medicine:百灵膏> a ex:Medicine;
  ex:hasFunction "痈疮久不愈。";
  ex:hasName "百灵膏";
  ex:hasPreparation "上为细末，用清油、黄蜡各1两，瓷器内慢火熬成膏。";
  ex:hasPrescription "槐花子（炒焦，为末）1两，松柏1两，乳香1两，腻粉1两。";
  ex:hasUsage "贴之。" .

<medicine:百灵藤煎> a ex:Medicine;
  ex:hasFunction "一切风。";
  ex:hasName "百灵藤煎";
  ex:hasPreparation "上锉细，以水3斗，慢火煎至5升，去滓。别于净锅中，慢火煎成膏，以瓷器密盛。";
  ex:hasPrescription "百灵藤5斤。";
  ex:hasUsage "每服1茶匙，以温酒调下，日3次。" .

<medicine:百灵藤牛膝煎> a ex:Medicine;
  ex:hasFunction "一切风，不以远近。";
  ex:hasName "百灵藤牛膝煎";
  ex:hasNote "忌毒滑物。";
  ex:hasPreparation "上为细末，入前煎中，别入白蜜5合同熬，以柳木篦搅令匀，如稀饧即止，收于瓷器中。";
  ex:hasPrescription "百灵藤5斤（细锉，以水3斗，煎至1斗，滤去滓，更煎至3升），牛膝（去苗）2两，附子（去皮脐）2两，赤箭2两，仙灵脾2两，何首乌2两，鹿角胶2两，乳香2两。";
  ex:hasUsage "每服1茶匙，空心及晚食前以温酒调下。" .

<medicine:百灵藤粥> a ex:Medicine;
  ex:hasFunction "大风疾。";
  ex:hasName "百灵藤粥";
  ex:hasPrescription "百灵藤4两。";
  ex:hasUsage "以水1斗，煎至2升，去滓，入粳米4合煮作粥，于温室中澡浴后服之。衣覆取汗。汗后皮肤风退如麸皮。每隔日1服。50-60日后渐愈，毛发即生。" .

<medicine:百灵藤酿酒> a ex:Medicine;
  ex:hasFunction "风。";
  ex:hasName "百灵藤酿酒";
  ex:hasPreparation "上候饭冷，即熟揉曲末入饭中，并药汁同入于瓮中，一如酿酒法。经3-5日，看沫尽，即更炊1斗糯米饭，候冷，投入瓮中，即熟澄清。";
  ex:hasPrescription "百灵藤10斤（以水1石，煎取3斗），神曲9两（微炒黄色，捣末），糯米3斗（炊作饭）。";
  ex:hasUsage "本方方名，《本草纲目》引作“百灵藤酒”。" .

<medicine:百点膏> a ex:Medicine;
  ex:hasFunction "散风清热，去翳除障。治翳膜遮睛，视物不明，有如云气之状。";
  ex:hasName "百点膏";
  ex:hasPreparation "上药锉如麻豆大，蕤仁别研如泥，同熬，至滴在水中不散为度，人蜜少许，再熬片刻即可。";
  ex:hasPrescription "蕤仁（去皮、尖）0.9克 当归身 甘草各1.8克 防风2.4克 黄连（拣治）6克";
  ex:hasUsage "每用少许点眼，日用五至七次。" .

<medicine:百生方> a ex:Medicine;
  ex:hasFunction "百物入咽喉，鲠欲死者。";
  ex:hasName "百生方";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "茯苓（去应）、贯众、甘草各等分。";
  ex:hasUsage "每服1钱，米饮调下。" .

<medicine:百生汤> a ex:Medicine;
  ex:hasFunction "滋阴润肺，清热养肾。主肺肾阴虚，咽喉失于濡润。";
  ex:hasName "百生汤";
  ex:hasPrescription "百合10克，生地10克，熟地10克，桑白皮10克，玄参10克，麦冬10克，柿霜6克，川贝粉（冲服）3克，甘草3克，芦根30克。";
  ex:hasUsage "水煎服，每日1剂，日服2次。" .

<medicine:百疾消散> a ex:Medicine;
  ex:hasFunction "胸膈饱闷，肚腹疼痛，及伤风发热。";
  ex:hasName "百疾消散";
  ex:hasPrescription "葱头7根，生姜5大片，陈茶叶3钱。";
  ex:hasUsage "砂糖半酒杯，水2碗共煎，热服，加陈酒随量饮。盖被汗出。惟暑热天气，不宜多用生姜，天气寒冷，生姜加重。" .

<medicine:百病丹> a ex:Medicine;
  ex:hasFunction "痘后头面周身发肿。";
  ex:hasName "百病丹";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "沉香1钱（为末），木香1钱（为末），郁金1钱（为末），延胡1钱（为末），当归1钱（为末），甘草1钱（为末），丁香（为末）1钱，大黄2钱，朱砂6分，白硼砂6分，巴豆肉（去油）4钱。";
  ex:hasUsage "量人之大小强弱，少者重约5-6厘，多者重约1分，如今日用，滚水泡服1次．隔1日，再服1次。" .

<medicine:百病汤> a ex:Medicine;
  ex:hasFunction "小儿惊痫胀满，掣缩吐（？？）。";
  ex:hasName "百病汤";
  ex:hasPrescription "黄耆1分，黄芩1分，钩藤1分，蚱蝉3分（炙），甘草2分（炙），蛇蜕皮1寸（炙），牛黄3铢。";
  ex:hasUsage "以水1升半，煮取6合，百日儿服半合，2岁服3合。取利为度，有汗则以粉扑之。" .

<medicine:百病钦丹丸> a ex:Medicine;
  ex:hasFunction "小儿惊痫复发，眩闷倒蹶，或汤火不避。";
  ex:hasName "百病钦丹丸";
  ex:hasPreparation "上为末，炼蜜为丸，如绿豆大。";
  ex:hasPrescription "铅丹1分，朱砂（细研，水飞过）1分，铁粉1分，牛黄1分，雄黄（各细研）1分，细辛1分，独活1分，露蜂房（炙黄）1分，人参（去芦头）1分，汉防已1分，桂心1分，甘草1分，川椒（去目及闭口者，微炒去汗）1分，蜣螂5枚（微炙），蛇蜕皮5寸（炙黄），鸡头1枚（炙赤，锉），赤茯苓1两。";
  ex:hasUsage "每服5丸，粥饮送下。" .

<medicine:百病饮子> a ex:Medicine;
  ex:hasFunction "小儿患温壮热实。";
  ex:hasName "百病饮子";
  ex:hasPrescription "大黄4分，甘草（炙）2分，芍药2分。";
  ex:hasUsage "以水1升6合，煮取8合，分为3服。" .

<medicine:百神散> a ex:Medicine;
  ex:hasFunction "一切癞病，风瘙疮癣，遍身搔痒，百节疼痛，眉毛堕落，眦烂耳聋，四肢（？？）痹。";
  ex:hasName "百神散";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "天雄（炮裂，去皮脐）1两，附子（炮裂，去皮脐）1两，茵芋（炙）1两，踯躅1两，细辛（去苗叶）1两，乌头（炮裂，去皮脐）1两，干姜（炮）1两，菖蒲1两，甘草（炙）1两，石南叶1两，防风（去叉）2两，白术2两，独活（去芦头）2两。";
  ex:hasUsage "每服4钱匕，空心温酒送下，日2次。" .

<medicine:百祥丸> a ex:Medicine;
  ex:hasAlias "南阳丸";
  ex:hasFunction "痘疮初发用之，可预防毒气上迫咽喉。主痘疮倒压黑陷，寒颤噤牙戛齿，身黄紫肿，热毒便秘里实。";
  ex:hasName "百祥丸";
  ex:hasNote "不发寒者，不黑者，慎勿下。";
  ex:hasPreparation "浆水煮极软，去骨晒干，复纳汁中煮，汁尽倍干为末，水为丸，如粟米大。";
  ex:hasPrescription "红芽大戟不拘多少（阴干）。";
  ex:hasUsage "每服10-20丸（研），赤脂麻汤送下，不拘时候。" .

<medicine:百粉丸> a ex:Medicine;
  ex:hasFunction "肾虚火动遗精。";
  ex:hasName "百粉丸";
  ex:hasPreparation "上为末，捣烂饭为丸，如梧桐子大。";
  ex:hasPrescription "黄柏（童便炒）、知母（童便炒）、蛤粉（略炒）、牡蛎（火煅）、山药（酒炒）。";
  ex:hasUsage "每服50-70丸，空心盐汤、温酒任下。" .

<medicine:百粒丸> a ex:Medicine;
  ex:hasFunction "远近便泻，大肠滑。";
  ex:hasName "百粒丸";
  ex:hasPreparation "上为细末，醋煮大蒜为丸。";
  ex:hasPrescription "红椒、胡椒、附子、丁香、干姜、麦糵各等分。";
  ex:hasUsage "每服100丸，用米饮汤送下。" .

<medicine:百花丸> a ex:Medicine;
  ex:hasFunction "中风后虚热翕翕然。";
  ex:hasName "百花丸";
  ex:hasNote "忌油、面、蒜、生冷、酢滑，及猪、羊、鸡、鱼等肉。";
  ex:hasPreparation "上为末，炼蜜为丸，如梧桐子大。";
  ex:hasPrescription "防风1两半，人参1两半，苁蓉1两半，干地黄1两半，羚羊角1两半，麦冬1两半，天门冬1两半，芍药20铢，独活20铢，干姜20铢，白术20铢，丹参20铢，山茱萸20铢，甘草20铢，茯神20铢，升麻20铢，黄耆20铢，菊花20铢，地骨皮20铢，石斛20铢，牛膝20铢，五加皮20铢，薯蓣20铢，秦艽1两，芎1两，桂心1两，防己1两，生姜1两，黄芩1两，附子18铢，石膏3两，寒水石2两。";
  ex:hasUsage "每服20丸，生姜蜜汤送下，日3次。稍加至30丸。" .

<medicine:百花如意酣春酝> a ex:Medicine;
  ex:hasFunction "益肾、固精、坚阳。主";
  ex:hasName "百花如意酣春酝";
  ex:hasPreparation "前七味用一绢袋盛之，悬于坛中，再入二酒，封固窨月余。";
  ex:hasPrescription "角沉香1两，玫瑰花1两，蔷薇露1两，梅花蕊1两，桃花瓣1两，韭菜花1两，核桃肉8两，白酒浆5斤，好烧酒5斤。";
  ex:hasUsage "随意饮之。" .

<medicine:百花定喘丸> a ex:Medicine;
  ex:hasFunction "疏风解热，止嗽定喘。主咳嗽痰喘，日夜不息，不能安眠，呼吸困难，胸满不畅，咽干口渴。";
  ex:hasName "百花定喘丸";
  ex:hasPreparation "上为细末，炼蜜为丸，3钱重，蜡皮或蜡纸筒封固。";
  ex:hasPrescription "冬花2两，丹皮4两，陈皮4两，黄芩4两，桔梗4两，天门冬4两，生紫菀4两，麦冬4两，杏仁（去皮，炒）4两，北沙参2两，麻黄4两，花粉4两，前胡4两，薄荷4两，生石膏2两，百合4两，生五味子2两。";
  ex:hasUsage "每服1丸，开水送下。" .

<medicine:百花拔毒散> a ex:Medicine;
  ex:hasFunction "疮肿。";
  ex:hasName "百花拔毒散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "黄柏3两（蜜炙3-2遍），草乌头半两。";
  ex:hasUsage "用津唾调摊在碎纸花上，敷贴。" .

<medicine:百花散> a ex:Medicine;
  ex:hasAlias "葵花散、五金膏";
  ex:hasFunction "妇人产中咳嗽。";
  ex:hasName "百花散";
  ex:hasNote "避风寒。";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "黄柏、桑白皮（用蜜涂，慢火炙黄色为度）各等分。";
  ex:hasUsage "每服1-2钱，水1盏，入糯米20粒，同煎至6分，以款冬花烧灰6钱，搅在药内同调，温服之。" .

<medicine:百花汤> a ex:Medicine;
  ex:hasFunction "肺气不顺，咳嗽气逆，胸膈不利。";
  ex:hasName "百花汤";
  ex:hasPreparation "上同搅拌匀，以瓷器盛，蒸熟，柳木匙捞，候成膏。";
  ex:hasPrescription "杏仁4两，生姜4两（研取汁，与杏仁同研细），白蜜半斤。";
  ex:hasUsage "本方方名，据剂型当作“百花膏”。" .

<medicine:百花煎> a ex:Medicine;
  ex:hasFunction "大风疾。";
  ex:hasName "百花煎";
  ex:hasPreparation "上件药，将生姜、石榴并皮同捣，绞取汁，更滤令净，入蜜中相和令匀；用一瓷瓶先称知斤两，然后入药蜜汁，后用三重蜡纸密封瓶头，置于釜中，重汤煮一复时，后时时称，但除瓶斤两外，得20两便住。";
  ex:hasPrescription "白蜜20两，酸石榴7颗，生姜半斤。";
  ex:hasUsage "每服1茶匙，空心以温酒调下，晚食前再服。" .

<medicine:百花煎丸> a ex:Medicine;
  ex:hasFunction "肺虚客热，咳嗽气急，胸中烦悸，肢体倦疼，咽干口燥，多唾痰沫，或有恶物，肌瘦发热，减食嗜卧。";
  ex:hasName "百花煎丸";
  ex:hasPreparation "上为细末，熔蜡为丸，如弹子大。";
  ex:hasPrescription "人参1两，紫菀1两，阿胶1两，百部1两，款冬花1两，山药1两，天门冬1两，麦门冬1两，贝母1两，甘草4两，杏仁半斤，蜡20两。";
  ex:hasUsage "每服1丸，水1盏，煎至7分，和滓，食后热服。" .

<medicine:百花膏> a ex:Medicine;
  ex:hasFunction "疠风。";
  ex:hasName "百花膏";
  ex:hasPreparation "捣汁，煎加蜜，炼成膏；再加沉香、檀香、冰片、麝香各等分为末入内，收贮于瓷瓶，勿泄气。";
  ex:hasPrescription "透骨草、忍冬藤、蒲公英、鹤虱草、九龙藤、野天麻、旱莲草、半枝莲、地杨梅、豨莶草、苍耳草、紫地丁、地锦草、旱辣蓼、大小青、薄荷叶、灵芝草、鱼腥草、见肿消、血见愁、淡竹叶、南天竹、枸杞、头橘树头、枳（木具）叶、五加叶、接骨木、石楠头、地蜈蚣、篇蓄草、马齿苋、野芥菜、蛇床叶、长青草、慎火草、太湖葱各等分。";
  ex:hasUsage "每服1匙，酒下，日3次。" .

<medicine:百草丸> a ex:Medicine;
  ex:hasFunction "治痔疮出血。";
  ex:hasName "百草丸";
  ex:hasPreparation "上为末，打糊为丸。";
  ex:hasPrescription "百草霜120克 黄芩 栀子各30克 黄连 槐花 地榆各15克";
  ex:hasUsage "每服9克，清汤送下。" .

<medicine:百草散> a ex:Medicine;
  ex:hasFunction "金疮。";
  ex:hasName "百草散";
  ex:hasPreparation "上于5月5日平旦，使4人出4方，各于5里内采1方草木茎叶，每种各半把。勿令漏脱1件，日正午时细切碓捣，并石灰极令烂熟1石，草断1斗；先凿大实中桑树，令可受药，取药纳孔中，实筑令坚，仍以桑树皮蔽之，用麻油捣石灰极粘，密泥之，令不泄气；又以桑皮缠之使坚牢，至9月9日午时，取出阴干，百日药成，捣之，日晒令干，便捣，绢筛贮放。";
  ex:hasPrescription "四方草木茎叶各半把。";
  ex:hasUsage "凡一切金疮出血，伤折，即时以药封裹，治使牢，勿令动转，不过10日，即愈。不肿不脓，不畏风，若伤后数日，始得药，须暖水洗令血出，然后敷此药，大验。平时无事宜多合以备仓卒，金疮之要，无出于此。" .

<medicine:百草煎> a ex:Medicine;
  ex:hasFunction "百般痈毒，诸疮损伤疼痛，腐肉肿胀，或风寒湿气留聚，走注疼痛，水臌肿胀等症。";
  ex:hasName "百草煎";
  ex:hasPrescription "百草（凡田野山间者，无论诸品皆可取用；然尤以山草为胜，辛香者佳；冬月可用干者，须预为收采之）。";
  ex:hasUsage "上不论多寡，取以多，煎浓汤乘热熏洗患处。仍用布帛蘸熨良久，务令药气蒸透，然后敷贴他药。每日2-3次不拘，频数更好。若洗水臌肿胀，每次须用草20-30斤，煎浓汤2-3锅，用大盆盛贮，以席簟遮风，熏洗良久，日1-2次。" .

<medicine:百草膏> a ex:Medicine;
  ex:hasAlias "百草霜";
  ex:hasFunction "喉癣及喉菌。";
  ex:hasName "百草膏";
  ex:hasNote "如治喉刺，玉丹、薄荷忌用；如见劳病已重，津竭火炎之候，亦不宜用。";
  ex:hasPreparation "上为末，用白蜜调膏。";
  ex:hasPrescription "薄荷8分，玉丹5分，川贝1钱，灯草灰5厘，柿霜8分，甘草1分5厘，天花粉1钱，冰片2分，草霜1分。";
  ex:hasUsage "频咽噙之。若症重，兼服煎剂，并用吹丹。" .

<medicine:百草血余棕灰散> a ex:Medicine;
  ex:hasFunction "血崩。";
  ex:hasName "百草血余棕灰散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "陈棕灰1两，百草霜1两，头发灰1两。";
  ex:hasUsage "每服1钱，陈酒下。" .

<medicine:百草霜丸> a ex:Medicine;
  ex:hasAlias "针头丸";
  ex:hasFunction "心腹痛及白痢。";
  ex:hasName "百草霜丸";
  ex:hasPreparation "上用巴豆、杏仁2味，各于麻油灯焰上烧灰存性，同3味和匀，用蜡2钱熔开，和剂为丸，为芥子大。";
  ex:hasPrescription "百草霜半两，巴豆1分，杏仁1分。";
  ex:hasUsage "针头丸（《普济方》卷二一一）。《百一》本方用法：白痢，干姜汤送下；赤痢，甘草汤送下；如要定转，用枣汤送下。" .

<medicine:百草霜散> a ex:Medicine;
  ex:hasFunction "产后血晕闷绝，如见鬼神，须臾欲绝。";
  ex:hasName "百草霜散";
  ex:hasPreparation "上为细散。";
  ex:hasPrescription "百草霜1两，生姜2两（去皮，炒令干），姜黄半两。";
  ex:hasUsage "每服2钱，以生地黄酒调下。" .

<medicine:百草霜方> a ex:Medicine;
  ex:hasAlias "百草霜散";
  ex:hasFunction "舌忽紧硬，逡巡能塞杀人。";
  ex:hasName "百草霜方";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "百草霜半两，好盐半两。";
  ex:hasUsage "百草霜散（《医方类聚》卷七十七引《济生续方》）。" .

<medicine:百草霜膏> a ex:Medicine;
  ex:hasFunction "发背痈疽，一切疮，热痛不可忍。";
  ex:hasName "百草霜膏";
  ex:hasPreparation "上同研如膏。";
  ex:hasPrescription "百草霜、生蛴螬各等分。";
  ex:hasUsage "贴之。如冰，痛即止。" .

<medicine:百草露散> a ex:Medicine;
  ex:hasFunction "止血。主金疮。";
  ex:hasName "百草露散";
  ex:hasPreparation "上先将草药四味同捣烂，渐渐入石灰，再捣匀，捏作饼子，阴干为末。";
  ex:hasPrescription "石灰1斤，刺蓟6两，马齿2两，韭4两，百草霜1斤。";
  ex:hasUsage "干掺之。" .

<medicine:百药散> a ex:Medicine;
  ex:hasFunction "脏毒下血不止。";
  ex:hasName "百药散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "川百药煎不以多少（1半生用，1半炒令黄）。";
  ex:hasUsage "每服2钱，空心、食前温米饮调下。" .

<medicine:百药煎散> a ex:Medicine;
  ex:hasFunction "咽痛。";
  ex:hasName "百药煎散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "百药煎5钱，硼砂1钱5分，甘草2钱。";
  ex:hasUsage "每服1钱，米饮调，食后细细咽之。" .

<medicine:百药煎油膏> a ex:Medicine;
  ex:hasFunction "小儿湿疹。";
  ex:hasName "百药煎油膏";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "百药煎15g，白矾6g。";
  ex:hasUsage "油调外搽。" .

<medicine:百药长> a ex:Medicine;
  ex:hasFunction "男妇诸虚百损，五劳七伤，身体羸瘦，胸膈胀满，脾胃不调，四肢无力，筋骨疼痛，并风痰寒湿。";
  ex:hasName "百药长";
