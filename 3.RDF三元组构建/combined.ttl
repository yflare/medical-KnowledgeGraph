  ex:hasPrescription "白丁香3克 白及 白牵牛各9克";
  ex:hasUsage "每日点眼三次。重者不出一月全愈，轻者朝点暮好。" .

<medicine:吹鼻一提金> a ex:Medicine;
  ex:hasFunction "一切杂证。";
  ex:hasName "吹鼻一提金";
  ex:hasPreparation "上为细末。";
