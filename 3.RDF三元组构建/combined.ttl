  ex:hasName "桂末吹鼻方";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "桂（紫色者，去粗皮）半两。";
  ex:hasUsage "每用少许，吹入鼻中，及量舌下。" .

<medicine:桂术二陈汤> a ex:Medicine;
