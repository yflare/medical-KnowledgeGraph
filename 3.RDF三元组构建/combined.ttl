  ex:hasPrescription "萆薢 苡仁 黄柏 赤苓 丹皮 泽泻 滑石 通草";
  ex:hasUsage "水煎服。" .

<medicine:萆薢煎丸> a ex:Medicine;
  ex:hasAlias "补骨脂煎";
  ex:hasFunction "补益丹田，壮筋骨。主妇人久冷。";
  ex:hasName "萆薢煎丸";
