  ex:hasUsage "每服2丸，温开水送下，1日2次。" .

<medicine:荷叶散> a ex:Medicine;
  ex:hasAlias "地黄汤";
  ex:hasFunction "产后血晕，心闷不识人，或神言鬼语，气欲绝者。";
  ex:hasName "荷叶散";
  ex:hasNote "忌肉食1日。";
