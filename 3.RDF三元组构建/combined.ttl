  ex:hasPrescription "枸杞根1两半，栝楼根1两半，麦门冬（去心，生）1两半，黄连（去须）1两半，土瓜根（干者）1两，知母1两，车前子（去土）1两。";
  ex:hasUsage "每服5钱匕，水1盏半，入生地黄半分，切，同煎至8分，去滓温服，1日3次。" .

<medicine:枸杞根酿酒> a ex:Medicine;
  ex:hasFunction "除风，补益，悦泽人。主风冷虚劳。";
  ex:hasName "枸杞根酿酒";
  ex:hasPreparation "上以水4石煎取6斗，去滓澄清，曲1斗（须干好），糯米1石，炊，如常法造酒，酒熟，密封头，然后压取清酒。";
  ex:hasPrescription "枸杞根（切）1石5斗，鹿骨1具（炙，碎）。";
  ex:hasUsage "口服。" .

<medicine:枸杞根饮> a ex:Medicine;
  ex:hasFunction "消渴，饮水无度，小便旋利，心中热闷烦躁。";
  ex:hasName "枸杞根饮";
  ex:hasPreparation "上为粗末。";
  ex:hasPrescription "枸杞根皮2两，菰根2两，李根白皮2两，葛根（4味并洗，锉）2两，甘草（炙）1两，牡蛎（炒）2两，石膏（碎）5两。";
  ex:hasUsage "每服5钱匕，水1盏半，煎至8分，去滓温服，不拘时候。" .

<medicine:枸杞汁点眼方> a ex:Medicine;
  ex:hasAlias "枸杞煎";
  ex:hasFunction "眼中翳少轻者；眼涩痛，兼有翳者。";
  ex:hasName "枸杞汁点眼方";
  ex:hasPrescription "枸杞叶、车前子叶各等分。";
  ex:hasUsage "上于手中熟挼，使汁欲出，又别取桑叶2-3重裹之，悬于阴地经宿，乃摘破桑叶取汁，细细点目中。不过3-5度，翳自当烂。" .

<medicine:枸杞汤> a ex:Medicine;
  ex:hasAlias "栝楼根汤、栝楼汤";
  ex:hasFunction "卒短气。";
  ex:hasName "枸杞汤";
  ex:hasNote "异海藻，菘菜，生葱。";
  ex:hasPreparation "上为粗末。";
  ex:hasPrescription "枸杞。";
  ex:hasUsage "每服3钱匕，水1盏，生姜1枣大（切碎），煎至7分，去滓温服，1日3次。" .

<medicine:枸杞浸酒> a ex:Medicine;
  ex:hasAlias "枸杞防风酒";
  ex:hasFunction "悦泽颜色，滋润皮肤，退风，益气强力。主中风，身如角弓反张，及妇人一切血风，上攻下注。";
  ex:hasName "枸杞浸酒";
  ex:hasPreparation "上以夹绢袋盛，用好酒3斗浸，密封闭，勿令通气，7日方开，开时不得面对瓶口。";
  ex:hasPrescription "枸杞子半升，晚蚕沙（炒）半升，恶实（炒）1升，苍耳子（炒）1升，防风（去叉）2升，大麻子（炒）2升，茄子根2斤（洗令净，细切，蒸1复时，须是9月9日采），牛膝（酒浸，细切）1斤，恶实根（切，炒）1斤，桔梗（锉，炒）2两，羌活（去芦头，锉）2两，秦艽（去苗土，焙）2两，石菖蒲（9节者，锉）2两。";
  ex:hasUsage "每服1盏，空心、食前、临卧温服。常令有酒容。" .

<medicine:枸杞煎> a ex:Medicine;
  ex:hasFunction "轻身益气，令人有力；预防痈疽。主虚劳。";
  ex:hasName "枸杞煎";
  ex:hasPreparation "上以水1石，煮取5斗，去滓，将滓更入釜与水依前煮取5斗，并前为1斛，澄之去淀，釜中煎之，取2斗许，更入小铜锅子煎，今连连如饴，或器盛重汤煮更好。";
  ex:hasPrescription "枸杞30斤（锉。叶生至未落，可用茎叶，落而未生可用根）。";
  ex:hasUsage "每日早朝服1合半，日再服。初服1合，渐渐加之。" .

<medicine:枸杞煎丸> a ex:Medicine;
  ex:hasFunction "增寿。主";
  ex:hasName "枸杞煎丸";
  ex:hasPreparation "上为粉，取根骨清水煎之，添汤煮，去渣，熬成膏，和上粉为丸，如梧桐子大。";
  ex:hasPrescription "枸杞子根30斤（取皮，9蒸9晒）。";
  ex:hasUsage "每服30-50丸。" .

<medicine:枸杞石决明酒> a ex:Medicine;
  ex:hasFunction "轻身，补肾气，和百节，好颜色，延寿肥健。主腰脚疾，疝(疒颓)，诸风痹，恶血，目翳，目赤膜痛，眨眨泪出，瞽盲。";
  ex:hasName "枸杞石决明酒";
  ex:hasPreparation "上细切，盛绢袋，以清酒4斗5升渍之，春5日，夏3日，秋7日，冬10日，去滓。";
  ex:hasPrescription "石决明干者1大斤（洗，炙），枸杞根白皮小1斤。";
  ex:hasUsage "始服，多少不拘。" .

<medicine:枸杞粥> a ex:Medicine;
  ex:hasAlias "枸杞叶粥";
  ex:hasFunction "补肾益血，养阴明目。主中老年人肝肾不足，腰膝酸软，头晕目眩，久视昏暗，以及老年性糖尿病。";
  ex:hasName "枸杞粥";
  ex:hasNote "凡脾胃虚弱，经常泄泻的老人忌服。";
  ex:hasPrescription "枸杞子30g，粳米60g。";
  ex:hasUsage "上加水适量，煮粥。供早点或晚餐服食，四季均可。" .

<medicine:枸杞羊肉粥> a ex:Medicine;
  ex:hasFunction "滋肾阳，补肾气，壮元阳。适用于肾虚劳损、阳气衰败所致阳痿、腰脊疼痛、腿脚痿弱、头晕耳鸣、听力减退、尿频或遗尿等。";
  ex:hasName "枸杞羊肉粥";
  ex:hasPreparation "将新鲜羊肾剖洗干净，去内膜，切细；再把羊肉洗净切碎枸杞煎汁去渣，同羊肾、羊肉、葱白、粳米一起煮粥。待粥成后加入细盐少许，稍煮即可。";
  ex:hasPrescription "枸杞叶250克 羊肾1只 羊肉100克 葱白2茎 粳米100～150克 细盐少许";
  ex:hasUsage "每日1～2次，温热服。" .

<medicine:枸杞羊肾粥> a ex:Medicine;
  ex:hasFunction "益肾阴，补肾气，壮元阳。主肾虚劳损，阳气衰败，腰脊疼痛，腿脚痿弱，头晕脑鸣，听力减退或耳聋，阳萎，尿频或遗尿。";
  ex:hasName "枸杞羊肾粥";
  ex:hasNote "以冬季食用为好，对阳盛发热，或性功能亢进者，不可选用。";
  ex:hasPrescription "枸杞叶1斤，羊肾1对（细切），葱白1茎，羊肉半斤（炒）。";
  ex:hasUsage "《药粥疗法》本方用法：将新鲜羊肾剖开，洗净，去内膜，细切；再把羊肉洗净，切碎。用枸杞叶煎汁，去滓，同羊肾、羊肉、葱白、粳米一起煮粥，待粥成后，加入细盐少许，稍煮即可。" .

<medicine:枸杞羹> a ex:Medicine;
  ex:hasFunction "虚劳羸瘦。";
  ex:hasName "枸杞羹";
  ex:hasPrescription "枸杞叶1斤，羊肾1对（切），羊肉（切）3两，葱白7茎（切）。";
  ex:hasUsage "上以五味汁煮作臛，空腹食之。" .

<medicine:枸杞膏> a ex:Medicine;
  ex:hasFunction "生精，补元气，益荣卫，生血，悦颜色，延年益寿。主诸虚百损。";
  ex:hasName "枸杞膏";
  ex:hasPreparation "上药放砂罐内，入水煎十余佛，用细绢罗滤过，将渣挤出汁净，如前再入水熬，滤取汁，3次，去渣不用，将汁再滤入砂罐内，慢火熬成膏，入瓷器内，不可泄气。";
  ex:hasPrescription "甘枸杞子1斤。";
  ex:hasUsage "不论男妇，早、晚用酒调服。" .

<medicine:枸杞茶> a ex:Medicine;
  ex:hasFunction "明目。主";
  ex:hasName "枸杞茶";
  ex:hasPrescription "枸杞子（深秋摘红熟者）。";
  ex:hasUsage "同干面拌和成剂，扞作饼样，晒干，研为细末，每江茶1两，杞子末2两，同和匀，入炼化酥油3两，或香油亦可，旋添汤搅成膏子，用盐少许，入锅煎熟饮之。" .

<medicine:枸杞菖蒲酒> a ex:Medicine;
  ex:hasFunction "缓急风，四肢不随，行步不正，口急及四体不得屈伸。";
  ex:hasName "枸杞菖蒲酒";
  ex:hasPreparation "上细锉，以水4石，煮取1石6斗，去滓，酿2斛米酒熟。";
  ex:hasPrescription "枸杞根100斤，菖蒲5斤。";
  ex:hasUsage "稍稍饮之。" .

<medicine:枸杞菟丝汤> a ex:Medicine;
  ex:hasFunction "枣花翳内障。";
  ex:hasName "枸杞菟丝汤";
  ex:hasPrescription "枸杞子、菟丝子、覆盆子、青葙子、熟地、防风、薄荷、玄参、密蒙花、当归、石决明、龙胆草。";
  ex:hasUsage "上水煎，磨石蟹汁冲入，食后服。" .

<medicine:枸杞还童丸> a ex:Medicine;
  ex:hasClinicalApplication "延年：古杭陈鉴，以此常服，年近九十，亲笔传神不减少年；余人服之，咸有效验。";
  ex:hasFunction "益气延年。主肝肾俱冷，眼目昏花，饮食少进。";
  ex:hasName "枸杞还童丸";
  ex:hasPreparation "上为末，和匀，酒糊为丸，如梧桐子大。";
  ex:hasPrescription "茅山苍术1斤（4两酒浸，4两米泔浸，4两盐水浸，4两醋浸，各浸已日，将苍术和合作1处，自初伏1日为始，早晨朝东晒，日午南晒，至晚西晒，夜则露天明放，至伏尽日收起不晒，如遇天阴下雨，收藏至睛明日再晒），西枸杞子1斤（晒干，另研细用）。";
  ex:hasUsage "每服50-70丸；空心枣盐汤或酒送下，或米饮汤下亦可。" .

<medicine:枸杞酒> a ex:Medicine;
  ex:hasFunction "补中逐水，破积去瘀，逐热破血，利耳目，长发，坚筋骨，强阴，利大小肠，填骨髓，长肌肉，破除结气。主五内邪气，消渴，风湿，胸胁间气，头痛，五劳七伤，胃中宿食，鼻衄吐血，内湿风疰，恶血石淋，伤寒瘴气，烦躁满闷，虚劳喘息及脚气肿痹。";
  ex:hasName "枸杞酒";
  ex:hasNote "慎芜荑、生冷、陈宿猪、犬、鸡、鱼、面、蒜、油腻、白酒、房室等。";
  ex:hasPreparation "上药地黄共米同蒸，余三物药汁，总合得5斗，分半渍米，（饣贲）半及曲和酿饭，如人肌温，总和一殴，盖瓮口，经14日，压取封泥，复经7日。";
  ex:hasPrescription "米1石（黍糯并得酿酒米，用上好曲末1斗，加5升弥佳），枸杞30斤（去赤皮，半寸锉之，以水1石，浸之3日，煮取5斗汁），生地黄20斤（洗去土，细切，共米同炊之），秋麻子3斗（微熬细粉，蒸气出，以枸杞汤淋取计），豆豉2斗（以枸杞汤煮取汁）。";
  ex:hasUsage "方中用法项用量原缺，据《圣惠》补。" .

<medicine:枸杞饮> a ex:Medicine;
  ex:hasFunction "老人烦渴口干，骨节烦热。";
  ex:hasName "枸杞饮";
  ex:hasPrescription "枸杞根白皮1升，小麦1升（净淘），粳米3合（研）。";
  ex:hasUsage "上以水1斗，煮前2味，取7升汁，下米作饮，渴即渐服之。" .

<medicine:枸橘汤> a ex:Medicine;
  ex:hasFunction "子痈。";
  ex:hasName "枸橘汤";
  ex:hasPrescription "枸橘全个，川楝1钱5分，秦艽1钱5分，陈皮1钱5分，防风1钱5分，泽泻1钱5分，赤芍1钱5分，甘草1钱5分。";
  ex:hasUsage "水煎服。" .

<medicine:枸苓丸> a ex:Medicine;
  ex:hasFunction "肾脏虚，水不上升，眼目昏暗，远视不明，渐生内障。";
  ex:hasName "枸苓丸";
  ex:hasPreparation "上为细末，炼蜜为丸，如梧桐子大。";
  ex:hasPrescription "白茯苓8两，真枸杞子4两（酒浸蒸），当归2两（酒洗），青盐2两（别研），菟丝子2两（酒蒸）。";
  ex:hasUsage "每服70丸，空心白汤送下。" .

<medicine:枸菊丸> a ex:Medicine;
  ex:hasFunction "治内外障眼，有翳晕或无翳，视物不明。";
  ex:hasName "枸菊丸";
  ex:hasPreparation "上为细末，炼蜜为丸，如弹子大。";
  ex:hasPrescription "甘菊花（拣净）枸杞各60克 川芎 薄荷叶各30克 苍术180克（米泔水浸三日，一日一换水，去皮，晒干）";
  ex:hasUsage "每服1丸，食后细嚼，茶清下，日进二服。" .

<medicine:柏仁散> a ex:Medicine;
  ex:hasFunction "小儿囟开不合。";
  ex:hasName "柏仁散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "防风1两半，柏子仁1两，白及1两。";
  ex:hasUsage "以乳和，敷囱上，每日1次。10日知，20日愈。" .

<medicine:柏公汤> a ex:Medicine;
  ex:hasFunction "伤寒下痢，亦治久血热痢。";
  ex:hasName "柏公汤";
  ex:hasPrescription "柏皮3两，黄芩2两，黄连1两。";
  ex:hasUsage "上（口父）咀。每服1两，水2盏，煎至1盏，去滓，通口服。" .

<medicine:柏叶丸> a ex:Medicine;
  ex:hasFunction "明目。主青盲。";
  ex:hasName "柏叶丸";
  ex:hasPreparation "上为末，用牛胆汁拌和为丸，如梧桐子大。";
  ex:hasPrescription "柏叶1两（微炙），夜明砂1两（以糯米炒令黄）。";
  ex:hasUsage "每服20丸，临卧时以竹叶汤送下；至五更初再服20丸，以粥饮送下。" .

<medicine:柏叶乳> a ex:Medicine;
  ex:hasFunction "治淋病。";
  ex:hasName "柏叶乳";
  ex:hasPrescription "人乳200毫升 侧柏叶捣取汁";
  ex:hasUsage "二味和匀，空腹时热服。" .

<medicine:柏叶散> a ex:Medicine;
  ex:hasFunction "三焦火甚，致生火丹，作痒或作痛，延及遍身。";
  ex:hasName "柏叶散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "侧柏叶（炒黄，为末）5钱，蚯蚓粪（韭菜田内者佳）5钱，黄柏5钱，大黄5钱，赤豆3钱，轻粉3钱。";
  ex:hasUsage "《金鉴》有雄黄，或用香油调搽，主治缠腰火丹。" .

<medicine:柏叶汤> a ex:Medicine;
  ex:hasClinicalApplication "临床主要用于治疗胃出血等病症。";
  ex:hasFunction "小便出血不止。";
  ex:hasName "柏叶汤";
  ex:hasPreparation "上为粗末。";
  ex:hasPrescription "柏叶（去梗，焙）1两，甘草（炙，锉）1两，阿胶（炒燥）1两，黄芩（去黑心，锉）1两，竹茹（切）1两，生干地黄（切）1两。";
  ex:hasUsage "每服4钱匕，水1盏半，同煎至8分，去滓温服，不拘时候。" .

<medicine:柏叶汤加减> a ex:Medicine;
  ex:hasFunction "温阳益气活血止血。主虚寒牙衄。";
  ex:hasName "柏叶汤加减";
  ex:hasPrescription "柏叶10克，干姜3克，艾叶10克，党参12克，白术10克，炙草5克，阿胶（另煎）10克，田三七末（冲服）3克。";
  ex:hasUsage "水煎服，每日1剂，日服2次。" .

<medicine:柏叶沐头丸> a ex:Medicine;
  ex:hasFunction "令发长不落。主脉极虚寒，鬓发堕落。";
  ex:hasName "柏叶沐头丸";
  ex:hasPreparation "上先将柏叶、附子为末，炼猪膏和为20丸。";
  ex:hasPrescription "生柏叶1两，附子（生，去皮脐）半两，猪膏5两。";
  ex:hasUsage "每用1丸，用布裹之，纳沐头汤中洗头。" .

<medicine:柏叶洗方> a ex:Medicine;
  ex:hasFunction "清热、润肤、止痒。主牛皮癣（白疕风），鱼鳞癣（蛇皮癣）及其他皮肤干燥脱屑类皮肤病。";
  ex:hasName "柏叶洗方";
  ex:hasPreparation "共为粗末。";
  ex:hasPrescription "侧柏叶4两，苏叶4两，蒺藜秧8两。";
  ex:hasUsage "装纱布袋内，用水5-6斤，煮沸30分钟，去滓浸洗。" .

<medicine:柏叶浸剂> a ex:Medicine;
  ex:hasFunction "清泄肺热，凉血解毒。主热邪伤肺，皮毛憔悴。";
  ex:hasName "柏叶浸剂";
  ex:hasPrescription "鲜侧柏叶32克，75％酒精100毫升。";
  ex:hasUsage "鲜侧柏叶放入精酒中浸泡，7天后方可使用。用棉球蘸药液少许，涂搽患处。" .

<medicine:柏叶膏> a ex:Medicine;
  ex:hasAlias "柏叶散（《普济方》卷三○○）。";
  ex:hasFunction "汤火伤。";
  ex:hasName "柏叶膏";
  ex:hasPreparation "上为末，以羊髓5-6合，火熔消，和药，以木椎研三五百遍。";
  ex:hasPrescription "柏叶（焙）1两，栀子仁1两，胡粉（研）半两。";
  ex:hasUsage "本方方名，原书（文瑞楼本）作“柏叶散”。" .

<medicine:柏叶蜜> a ex:Medicine;
  ex:hasFunction "清热泻火。适用于小儿百日咳。";
  ex:hasName "柏叶蜜";
  ex:hasNote "小儿风寒感冒咳嗽勿用。";
  ex:hasPreparation "每日取新鲜侧柏叶，放入搪瓷杯内，加水约2000克，煎取1000克，去渣，然后加入蜂蜜100克，和匀即可。";
  ex:hasPrescription "鲜侧柏叶500克 蜂蜜100克";
  ex:hasUsage "1岁以内每次10～15克，1～3岁15～30克，4岁以上30克。" .

<medicine:柏叶酒> a ex:Medicine;
  ex:hasFunction "传尸骨蒸，瘦病；风痹，历节作痛。";
  ex:hasName "柏叶酒";
  ex:hasPreparation "上以柏叶汁渍曲发动，即炊米熟，候冷拌和令匀，入瓮密封，7日开，压取酒。";
  ex:hasPrescription "柏叶20斤（捣碎，以水1石，煮取汁5斗），黍米1石（淘净），细曲10斤（捣碎）。";
  ex:hasUsage "1日3度，量力饮之。以愈为度。" .

<medicine:柏叶饮> a ex:Medicine;
  ex:hasFunction "便血。";
  ex:hasName "柏叶饮";
  ex:hasPrescription "侧柏叶多用（入白矾水煮，焙干）、川百药煎（炒）、蔓荆子（炒）各等分。";
  ex:hasUsage "入乳香末，浓米饮调下。" .

<medicine:柏叶鹿茸丸> a ex:Medicine;
  ex:hasFunction "冲任气虚，脐腹疼痛，漏下赤白。";
  ex:hasName "柏叶鹿茸丸";
  ex:hasPreparation "上为细末，酒煮面糊为丸，如梧桐子大。";
  ex:hasPrescription "柏叶1两，当归3分，干姜3分，阿胶半两，鹿茸1两。";
  ex:hasUsage "每服30丸，空心米饮送下。" .

<medicine:柏叶黄耆散> a ex:Medicine;
  ex:hasFunction "吐血，日夜不止。";
  ex:hasName "柏叶黄耆散";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "生干地黄4两，黄芩1两，柏叶1两，甘草（炙微赤，锉）1两，阿胶（杵，燥令碎、黄燥）2两，黄耆（锉）2两。";
  ex:hasUsage "每服3钱，于食后用糯米粥饮调服。" .

<medicine:柏土散> a ex:Medicine;
  ex:hasFunction "烟火丹。属足三阳经风热者，从两足跗起赤色肿痛；属少阴肾经火热者，从足底心起。";
  ex:hasName "柏土散";
  ex:hasPrescription "猪槽下土（炒）、黄柏末。";
  ex:hasUsage "原书治上疾，宜内服滋阴抑火之药，使水旺足以制火，外以本方兼治。" .

<medicine:柏墨散> a ex:Medicine;
  ex:hasFunction "小儿脐风，汁出不止；小儿断脐后为水湿所伤，或袍湿气伤于脐中，或解脱风冷所乘，致令小儿四肢不和，脐肿多啼，不能乳哺。";
  ex:hasName "柏墨散";
  ex:hasPreparation "上药同研细。";
  ex:hasPrescription "黄柏末1分，釜下墨煤1分，乱发（烧灰）1分。";
  ex:hasUsage "少少敷之。" .

<medicine:柏姜散> a ex:Medicine;
  ex:hasFunction "喉证，阴虚火盛。";
  ex:hasName "柏姜散";
  ex:hasPreparation "合焙成炭（存性），研极细末。";
  ex:hasPrescription "黄柏2钱，干姜8分。";
  ex:hasUsage "吹之。" .

<medicine:柏子仁丸> a ex:Medicine;
  ex:hasAlias "柏子丸、女科柏子仁丸";
  ex:hasFunction "肝气久虚，四肢筋脉怠惰，三焦气不顺，上攻眼生黑花。";
