  ex:hasPrescription "黄连1钱，当归1钱，连翘7分，黄芩7分，甘草3分。";
  ex:hasUsage "水煎服。" .

<medicine:连朴丸> a ex:Medicine;
  ex:hasFunction "厚肠胃。主泻痢。";
  ex:hasName "连朴丸";
  ex:hasPreparation "上（口父）咀，用生姜10两，取自然汁浸煮干，为细末，清面糊为丸，如梧桐子大。";
  ex:hasPrescription "黄连（好者）5两，厚朴10两（去粗皮）。";
  ex:hasUsage "每服50-70丸，空心米饮送下。" .

<medicine:连朴饮> a ex:Medicine;
  ex:hasClinicalApplication "临床主要用于治疗胆汁反流性胃炎、浅表性胃炎、动脉粥样硬化、湿温等病症。";
  ex:hasFunction "行食涤痰。主湿热蕴伏而成霍乱。";
  ex:hasName "连朴饮";
  ex:hasPrescription "制厚朴2钱，川连（姜汁炒）1钱，石菖蒲1钱，制半夏1钱，香豉（炒）3钱，焦栀3钱，芦根2两。";
  ex:hasUsage "本方方名，《温病学讲义》引作“王氏连朴饮”。" .

<medicine:连柏丸> a ex:Medicine;
  ex:hasFunction "亡血大虚所致眩晕。";
  ex:hasName "连柏丸";
  ex:hasPreparation "皆用姜汁炒，姜汁糊为丸。";
  ex:hasPrescription "黄连、黄柏。";
  ex:hasUsage "每服30丸，用人参、黄耆、当归、白术、芍药作大剂浓煎汤送下。" .

<medicine:连柏散> a ex:Medicine;
  ex:hasFunction "贴痔定痛。主";
  ex:hasName "连柏散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "黄连（去须）1两，黄柏（去粗皮）2两，腻粉1钱。";
  ex:hasUsage "先用浆水洗疮，后看疮大小，药贴之，日3次。" .

<medicine:连柏汤> a ex:Medicine;
  ex:hasFunction "下血，日夜70-80行。";
  ex:hasName "连柏汤";
  ex:hasPrescription "黄连、黄柏各等分。";
  ex:hasUsage "醇醋3升，煮取一半，分再服。" .

<medicine:连柏湿疹膏> a ex:Medicine;
  ex:hasFunction "慢性湿疹。";
  ex:hasName "连柏湿疹膏";
  ex:hasPreparation "前三味药，共研为细末，再加后二味研匀，最后加蛋黄油调成油膏。";
  ex:hasPrescription "黄连31g，黄柏31g，白芷31g，轻粉3g，冰片3g。";
  ex:hasUsage "外用。" .

<medicine:连梅丸> a ex:Medicine;
  ex:hasFunction "瘟疫噤口痢者。";
  ex:hasName "连梅丸";
  ex:hasPreparation "上为末，蜡蜜为丸，如梧桐子大。";
  ex:hasPrescription "川连5钱，乌梅肉3钱（焙）。";
  ex:hasUsage "每服20丸，日3次。" .

<medicine:连梅安蛔汤> a ex:Medicine;
  ex:hasFunction "清肝安蛔。治肝火犯胃，饥不欲食，食则吐蛔，甚则蛔暖不安，脘痛烦躁，昏乱欲死。";
  ex:hasName "连梅安蛔汤";
  ex:hasPrescription "胡连3克 炒川椒10粒 白雷丸9克 乌梅肉2个 生川柏2.4克 尖槟榔2枚（磨汁冲）";
  ex:hasUsage "水煎服。" .

<medicine:连梅汤> a ex:Medicine;
  ex:hasFunction "清心泻火，滋肾养液。治暑邪深入少阴，火灼阴伤，消渴引饮；暑邪深入厥阴，筋脉失养，手足麻痹者。";
  ex:hasName "连梅汤";
  ex:hasPrescription "云连6克 乌梅（去核）9克 麦冬（连心）9克 生地9克 阿胶6克";
  ex:hasUsage "用水1升，煮取400毫升，分二次服。" .

<medicine:连环串> a ex:Medicine;
  ex:hasFunction "风病。";
  ex:hasName "连环串";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "麸皮2钱，朱砂2分，代赭石1钱，炒草灰4分。";
  ex:hasUsage "作2服。" .

<medicine:连理汤> a ex:Medicine;
  ex:hasFunction "脾胃虚寒，湿热内蕴，寒热相搏，升降失常之呕吐酸水，顺逆，心痛，口糜，泄泻，腹胀者。";
  ex:hasName "连理汤";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "人参、白术、干姜、炙甘草、黄连。";
  ex:hasUsage "《医略六书》本方用黄连八分（姜汁炒），人参一钱半，白术一钱半（炒），干姜一钱半（炮），炙草五分，水煎，去滓温服。本方改为丸剂，名“连理丸”（见《医学金针》）。" .

<medicine:连石茱萸丸> a ex:Medicine;
  ex:hasFunction "麻疹收后，热毒未曾解尽，有下积滞者。";
  ex:hasName "连石茱萸丸";
  ex:hasPreparation "上为末，以山药研粉，作糊合为丸，如梧桐子大。";
  ex:hasPrescription "黄连（酒炒）1两，滑石（飞过）1两，黄芩8分，干葛8分，白芍8分，茱萸1两，升麻7分，甘草4分。";
  ex:hasUsage "原书用本方治上症时去升麻、干葛、甘草、白芍药，加枳壳、山楂肉、麦芽、青皮；方中茱萸，若非阴寒膈寒而挟有热者，亦须除去。" .

<medicine:连矾膏> a ex:Medicine;
  ex:hasFunction "清火。主时眼害久，有浮翳，不敢点重药者。";
  ex:hasName "连矾膏";
  ex:hasPreparation "用细梨一枚，去核，入上药末，仍用梨盖，竹钉钉住，外以面饼包住，于干饭上蒸三次，取出，去面，将梨捣烂，拧汁入碗内，露一宿。";
  ex:hasPrescription "黄连末2钱，生白矾末1钱。";
  ex:hasUsage "任意点之。" .

<medicine:连砂散> a ex:Medicine;
  ex:hasAlias "散云丹";
  ex:hasFunction "风热喉症。";
  ex:hasName "连砂散";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "薄荷2钱，牙消2钱，硼砂1钱，蒲黄5分，川连4分，朱砂2分，冰片3分。";
  ex:hasUsage "吹喉。" .

<medicine:连竹汤> a ex:Medicine;
  ex:hasFunction "治风毒攻眼，暴赤涩痛。";
  ex:hasName "连竹汤";
  ex:hasPreparation "上四味，锉细。";
  ex:hasPrescription "黄连（去须）竹叶各7.5克 秦皮11.2克 蛇蜕皮3.8克";
  ex:hasUsage "用水500毫升，煎取250毫升，绵滤去滓。夜卧时用白绢点药汁洗眼。" .

<medicine:连粉散> a ex:Medicine;
  ex:hasFunction "风癣湿疮。";
  ex:hasName "连粉散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "黄连1钱，轻粉5分，腻粉1钱，黄柏1钱，黄丹1钱，枯白矾1钱，龙骨5分，炉甘石5分。";
  ex:hasUsage "每用少许，疮湿则干搽，疮干则香油调搽。" .

<medicine:连翘丸> a ex:Medicine;
  ex:hasFunction "小儿瘰疬。";
  ex:hasName "连翘丸";
  ex:hasNote "孕妇忌服。";
