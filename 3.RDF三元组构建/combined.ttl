  ex:hasPreparation "上为细末，糯米粥为丸，如樱桃大。";
  ex:hasPrescription "消石半两，丹砂1分。";
  ex:hasUsage "每服1丸，生糯米汁入油1两点，青柳枝打匀服。" .

<medicine:定心壮气汤> a ex:Medicine;
  ex:hasFunction "产难，因年少单弱，致临产而惊恐气怯者。";
  ex:hasName "定心壮气汤";
  ex:hasPrescription "人参、黄耆、当归、川芎、辰砂、茯神、乳香、枳壳。" .

<medicine:定心汤> a ex:Medicine;
  ex:hasFunction "伤寒愈后，心下怔忡。";
  ex:hasName "定心汤";
  ex:hasPreparation "上为粗末。";
  ex:hasPrescription "生地汁半盏，童便半盏。";
  ex:hasUsage "上和合，重汤煮数沸服。" .

<medicine:定心神牛黄丸> a ex:Medicine;
  ex:hasFunction "风邪变成癫痫，时时发动，不知人事。";
