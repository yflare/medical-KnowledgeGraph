  ex:hasUsage "款冬花丸（《圣济总录》卷六十六）。" .

<medicine:款冬冰糖汤> a ex:Medicine;
  ex:hasFunction "小儿吼嗽，及大人咳嗽。";
  ex:hasName "款冬冰糖汤";
