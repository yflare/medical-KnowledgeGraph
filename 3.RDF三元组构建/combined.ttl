<medicine:粉糖丸> a ex:Medicine;
  ex:hasFunction "大肠壅结不通。";
  ex:hasName "粉糖丸";
  ex:hasPreparation "2味同研令匀，丸如梧桐子大。";
  ex:hasPrescription "腻粉半钱，砂糖如弹丸大1块。";
  ex:hasUsage "每服5丸，临卧温熟水送下。" .

<medicine:粉糖水> a ex:Medicine;
  ex:hasFunction "中暑霍乱。";
  ex:hasName "粉糖水";
  ex:hasPrescription "绿豆粉1两，白糖1两。";
  ex:hasUsage "新汲水调，频服。" .

<medicine:粉红丸> a ex:Medicine;
  ex:hasAlias "温惊丸";
