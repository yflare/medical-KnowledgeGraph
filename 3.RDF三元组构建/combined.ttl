  ex:hasPreparation "以75％乙醇100毫升浸。";
  ex:hasPrescription "苦参子仁31g。";
  ex:hasUsage "外用。" .

<medicine:苦参子膏> a ex:Medicine;
  ex:hasFunction "轻度腐蚀。主肉疙瘩。";
  ex:hasName "苦参子膏";
  ex:hasPreparation "上调匀成膏。";
  ex:hasPrescription "苦参子仁90g（研细），凡士林210g。";
  ex:hasUsage "按病变大小，敷贴患处。" .

<medicine:苦参散> a ex:Medicine;
  ex:hasAlias "苦参饮";
  ex:hasFunction "风癣疥疮。";
  ex:hasName "苦参散";
  ex:hasNote "忌猪肉、冷水。";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "石菖蒲（九节者）1两，威灵仙1两，胡麻（炒）1两，川芎1两，苦参4两，荆芥1两，甘草1两。";
  ex:hasUsage "每服3钱，好黄酒调下。" .

