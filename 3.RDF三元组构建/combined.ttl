  ex:hasUsage "上锉1剂，加龙眼肉3枚，水煎服。" .

<medicine:安神复睡汤> a ex:Medicine;
  ex:hasFunction "诸虚。";
  ex:hasName "安神复睡汤";
  ex:hasPreparation "上为细末，山药糊为丸；或炼蜜为丸，如绿豆大。";
