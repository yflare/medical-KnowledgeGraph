  ex:hasPrescription "刘寄奴1钱，骨碎补5钱，元胡5钱。";
  ex:hasUsage "水2钟煎，加童便1小钟冲服。" .

<medicine:流星串> a ex:Medicine;
  ex:hasFunction "积滞，大便红。";
