  ex:hasUsage "每服2钱，温开水送下。" .

<medicine:鸡黄散> a ex:Medicine;
  ex:hasFunction "头疮，不问远年近日。";
  ex:hasName "鸡黄散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "水龙骨（捣细）、黄丹、白矾各等分（1处烧过炭），牛皮（另烧）、鸡子清（和药1处烧）、硫黄（生用）。";
  ex:hasUsage "以酸齑汁烧热，洗去疮靥尽了，香油调末敷之。" .

<medicine:鸡黄油> a ex:Medicine;
  ex:hasFunction "汤火伤。";
  ex:hasName "鸡黄油";
  ex:hasPreparation "于银石锅内炒干，再炒，直待都化作油，去火毒，毛翎扫下，入韶粉、夜明沙为末。";
  ex:hasPrescription "鸡子（煮熟，去白用黄）。";
  ex:hasUsage "香油调敷，湿则干掺之。" .

<medicine:鸡黄煎> a ex:Medicine;
  ex:hasFunction "脓窝疮。";
  ex:hasName "鸡黄煎";
  ex:hasPreparation "上为极细末，将鸡子黄熬出油调敷。";
  ex:hasPrescription "煨石膏3钱，寒水石2钱，黄丹1钱，硫黄1钱。";
  ex:hasUsage "外敷。" .

<medicine:鸡黄膏> a ex:Medicine;
  ex:hasFunction "汤火及热油伤成疮。";
  ex:hasName "鸡黄膏";
  ex:hasPreparation "上炒取油，入腻粉少许搅匀。";
  ex:hasPrescription "鸡子两枚（取黄）。";
  ex:hasUsage "鸡毛刷疮上，永无瘢痕。" .

<medicine:鸬鹚屎膏> a ex:Medicine;
  ex:hasFunction "隳疮。";
  ex:hasName "鸬鹚屎膏";
  ex:hasPreparation "上药治下筛。";
  ex:hasPrescription "鸬鹚屎1升。";
  ex:hasUsage "腊月猪脂调和，敷之。" .

<medicine:鸬鹚散> a ex:Medicine;
  ex:hasFunction "鱼骨鲠在喉中，众法不去者。";
  ex:hasName "鸬鹚散";
  ex:hasPreparation "上烧灰为细末。";
  ex:hasPrescription "鸬鹚粪。";
  ex:hasUsage "水调，涂咽喉外。即出。" .

<medicine:鸬鹚涎丸> a ex:Medicine;
  ex:hasFunction "治小儿百日咳。";
  ex:hasName "鸬鹚涎丸";
  ex:hasPreparation "共研细末，鸬鹚涎90克，加蜜为丸，如弹子大。";
  ex:hasPrescription "光杏仁 栀子（炒黑）石膏 蛤粉 天花粉各60克 牛蒡子90克 生甘草12克 麻黄24克 青黛 射干各30克 细辛15克";
  ex:hasUsage "每服1丸，灯心、竹叶煎汤化下。" .

<medicine:鸭头丸> a ex:Medicine;
  ex:hasFunction "治水肿，面赤烦渴，面目肢体悉肿，腹胀喘急，小便涩少。";
  ex:hasName "鸭头丸";
  ex:hasPreparation "上为细来，绿头鸭血为丸，如梧桐子大。";
  ex:hasPrescription "甜葶苈（略炒）猪苓（去皮）汉防己各30克";
  ex:hasUsage "每服70丸，用木通汤送下。" .

<medicine:鸭粥> a ex:Medicine;
  ex:hasFunction "补益脾胃、利水消肿，滋阴血。适用于一切水肿病人。";
  ex:hasName "鸭粥";
  ex:hasNote "阴虚脾弱大便泄泻病人不宜选用。";
  ex:hasPreparation "青鸭肉切细煮至极烂，再加米、葱白煮粥；或用鸭汤煮粥。";
  ex:hasPrescription "青头雄鸭一只 粳米适量 葱白3茎";
  ex:hasUsage "每日2次，空腹温热食。5～7天为一疗程。" .

<medicine:鸭蛋汤> a ex:Medicine;
  ex:hasFunction "治妇人胎前产后赤白痢。";
  ex:hasName "鸭蛋汤";
  ex:hasPrescription "生姜汁适量 鸭蛋1个（打碎，入姜汁内搅匀）";
  ex:hasUsage "上二味，煎至八分，入蒲黄9克，煎五七沸，空腹时温服。" .

<medicine:鸱头丸> a ex:Medicine;
  ex:hasFunction "风癫。";
  ex:hasName "鸱头丸";
  ex:hasPreparation "上为末，炼蜜为丸，如梧桐子大。";
  ex:hasPrescription "葶苈子3分，铅丹3分，栝楼根3分，虎掌乌头3分，白术1分，蜀椒2分，大戟2分，甘遂2分，天雄2分，鸱头1枚，铁精1两，（艹闾）茹1两。";
  ex:hasUsage "每服2丸，以汤酒送下。日3次。" .

<medicine:鸱头酒> a ex:Medicine;
  ex:hasFunction "风头眩转，面上游风。";
  ex:hasName "鸱头酒";
  ex:hasPreparation "上切。";
  ex:hasPrescription "飞鸱头5枚，防风4两，芎藭4两，薯蓣4两，茯神4两，葛根2两，桂心2两，细辛2两，人参2两，天雄2两，干姜2两，枳实2两，贯众2两，蜀椒2两，麦门冬（1作天门冬）5两，石南5两（1作石膏），山茱萸1升，独活2两（1方无茯神）。";
  ex:hasUsage "上（口父）咀。绢囊盛，清酒4升渍6宿，初服2合，日再服，稍加，以知为度。" .

<medicine:鸱鸮膏> a ex:Medicine;
  ex:hasFunction "筋骨疼痛，手足麻木，瘰疬结核，无名肿毒。";
  ex:hasName "鸱鸮膏";
  ex:hasNote "忌辛辣发物。";
  ex:hasPreparation "用香油38两，先将鸱鸮炸枯去骨，再入他药同炸，滤去滓，用章丹3两，官粉14两收膏。";
  ex:hasPrescription "鸱鸮1个，穿山甲1两2钱（生），桂枝5钱5分，白芷1钱5分，木贼草3钱5分，山萸肉1两，郁金5钱，赤苓5钱，赤芍6钱，当归1两，云苓5钱，南红花5钱，白芍6钱，全蝎10条，麻黄3钱5分，石斛3两。";
  ex:hasUsage "将药膏摊于布上，贴患处。" .

<medicine:鸲鹆散> a ex:Medicine;
  ex:hasFunction "老人痔病下血不止，日加羸瘦无力。";
  ex:hasName "鸲鹆散";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "鸲鹆5只（治，洗令净，晒令干）。";
  ex:hasUsage "每服2方寸匕，空心以白粥饮服，每日2次；亦可任性炙食。" .

<medicine:鸽粪包> a ex:Medicine;
  ex:hasFunction "传尸劳病。";
  ex:hasName "鸽粪包";
  ex:hasPrescription "鸽粪3-5合。";
  ex:hasUsage "炒极热，布包，从尾闾擦背脊，上至大椎，又从大椎擦背脊，下至尾闾，如此上下数10次，冷则易之，日擦十余次，夜擦5-6次，3日内外长擦，其虫必死，服药可愈。" .

<medicine:鸽粪散> a ex:Medicine;
  ex:hasFunction "小儿口中及诸处生疳疮。";
  ex:hasName "鸽粪散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "鸽粪1分，人粪灰1分，白矾1分，青黛1分，麝香1分。";
  ex:hasUsage "敷之，日3次。" .

<medicine:鸾凤散> a ex:Medicine;
  ex:hasFunction "淋血。";
  ex:hasName "鸾凤散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "公鸡1只，用2腿骨共6节，烧灰存性。";
  ex:hasUsage "每服1钱，黄酒调下。" .

<medicine:鸾胶散> a ex:Medicine;
  ex:hasFunction "散瘀血。主打扑伤损。";
  ex:hasName "鸾胶散";
  ex:hasPreparation "以纸筋泥固济，用火烧，候烟过，取出放冷，去泥为末。";
  ex:hasPrescription "黄狗头1个（去毛）。";
  ex:hasUsage "先用糯米罨成软饭，看所患大小，摊在纸上，厚一指，以狗头末1分，桂末2分，煅了牡蛎末3分，和匀掺在上，乘稍热裹贴了。次用杉木板子夹缚。如痒不得抓，只用水轻轻拍，5-7日愈。或用毡发坐子裹亦可。" .

<medicine:鹁鸽羹> a ex:Medicine;
  ex:hasFunction "消渴，饮水无度。";
  ex:hasName "鹁鸽羹";
  ex:hasPrescription "白鹁鸽1只（切作大片）。";
  ex:hasUsage "上用土苏一同煮熟，空腹食之。" .

<medicine:鹅不食草> a ex:Medicine;
  ex:hasFunction "据数十例观察，大多于用药后1～2天痊愈。除胃痛患者服酒煮剂后间有疼痛外，一般无副作用。";
  ex:hasName "鹅不食草";
  ex:hasPreparation "研成粉末。";
  ex:hasPrescription "鹅不食草适量。";
  ex:hasUsage "成人每次用6～9克（小儿减半），以黄酒300～400毫升（不饮酒者用酒水各半），红糖50～100克，同煮（沸后密盖，勿令泄气），过滤后分次温服。药伤，包括跌伤、打伤、挫伤、扭伤等，均有效。" .

<medicine:鹅墩饮> a ex:Medicine;
  ex:hasFunction "鹅墩蛋。因暑湿积郁而成，其患在肾囊之下，形如鹅卵，疼痛异常。";
  ex:hasName "鹅墩饮";
  ex:hasPrescription "青蒿2钱，木通1钱半，车前子1钱，泽泻1钱，防己1钱，赤苓1钱，滑石3钱，甘草5分。";
  ex:hasUsage "加官私草汁1匙，同水煎服。" .

<medicine:鹅实散> a ex:Medicine;
  ex:hasFunction "胁痛，疝气痛。";
  ex:hasName "鹅实散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "鹅眼枳实（焙）、小茴香（炒）各等分。";
  ex:hasUsage "每服2钱，用小黑豆同艾叶炒热，冲黄酒于内，去滓，调前末药，食前服之。" .

<medicine:鹅掌油> a ex:Medicine;
  ex:hasAlias "鹅掌皮散";
  ex:hasFunction "脚指缝烂疡。脱疽。";
  ex:hasName "鹅掌油";
  ex:hasPreparation "上为末，敷之。";
  ex:hasPrescription "鹅掌皮（烧灰存性）。";
  ex:hasUsage "鹅掌皮散（《疡科捷径》卷中）。《疡科捷径》本方用法：以麻油调敷。" .

<medicine:鹅掌风浸剂> a ex:Medicine;
  ex:hasFunction "手癣。";
  ex:hasName "鹅掌风浸剂";
  ex:hasPreparation "上为细末，用米醋1000g，浸泡42小时后，即可应用。";
  ex:hasPrescription "斑蝥1g，蜈蚣4条，砒霜3g，樟脑9g，白及9g，土槿皮9g，大黄9g，马钱子9g。";
  ex:hasUsage "将患手（足）浸入药液，初次每日浸5-10分钟，2-3天后逐渐延长，每日浸1-2小时，连用2-15天。" .

<medicine:鹅掌风浸泡方> a ex:Medicine;
  ex:hasFunction "杀虫止痒。主鹅掌风，手足癣。";
  ex:hasName "鹅掌风浸泡方";
  ex:hasPrescription "大枫子肉9克 花椒9克 皂荚15克 土槿皮1.5克 地骨皮6克 藿香18克 白矾12克 鲜凤仙花9克 米醋1千克";
  ex:hasUsage "将药浸入米醋内二十四小时，煎沸待温，将药汁放人塑料袋内，将患手（足）伸人袋中扎住，浸六至十二小时，隔日将药汁煎沸待温再浸，共浸三至四天。浸泡后七天内不宜用碱水、肥皂水洗手（足），如有皲裂者，暂缓使用。以伏天浸泡为佳。" .

<medicine:鹅掌风膏> a ex:Medicine;
  ex:hasFunction "鹅掌风，风癞，顽癣，死肌，麻痹。";
  ex:hasName "鹅掌风膏";
  ex:hasPreparation "麻油1斤，同熬至滴水不散，绞去渣，离火，再下铅粉、银朱各4两，黄蜡、乳香各2两，和匀，瓷器收贮。";
  ex:hasPrescription "凤仙花（连根花叶，晒干）4两，苍耳草（用嫩头）4两，血余3两，鹿角屑（生刮）2两，络石2两，虎骨2两，百部2两，茜草2两，翦草2两，人指甲5钱，穿山甲1两，羌活1两，龙骨1两，麻黄1两，蕲艾1两，威灵仙1两。";
  ex:hasUsage "隔汤炖化，摊贴患处。" .

<medicine:鹅掌风药水> a ex:Medicine;
  ex:hasFunction "祛风除湿，杀虫止痒。主鹅掌风，灰指甲，湿癣，脚癣。";
  ex:hasName "鹅掌风药水";
  ex:hasNote "外用药切忌入口，严防触及眼、鼻、口腔等粘膜处。";
  ex:hasPreparation "将斑蝥粉碎成细粉，其余土荆皮等11味粉碎成粗粉，与斑蝥粉末混匀，照流浸膏剂与浸膏剂项下的渗漉法，用乙醇三倍与冰醋酸一倍的混合液作溶剂，浸渍48小时后，缓缓渗漉，收集渗漉液670毫升，静置，取上清液，加入香精适量搅匀，即得。";
  ex:hasPrescription "土荆皮250g，蛇床子125g，大风子仁125g，百部125g，防风50g，当归100g，凤仙透骨草125g，侧柏叶100g，吴茱萸50g，花椒125g，蝉蜕75g，斑蝥3g。";
  ex:hasUsage "用时将患处洗净，1日搽3-4次。灰指甲应先除去空松部分，使药易渗入。" .

<medicine:鹅梨汁煎丸> a ex:Medicine;
  ex:hasFunction "风痹。头、面、肢袭着，筋脉挛起，手足不随，痰涎胶粘，语涩昏浊，口眼偏。";
  ex:hasName "鹅梨汁煎丸";
  ex:hasPreparation "上为末，用皂角汁、薄荷汁、捣梨汁各1碗，煎成膏，和上药末一处为丸，如绿豆大。";
  ex:hasPrescription "羚羊角1两，木香半两，青橘（汤浸，去瓤）半两，半夏（汤净洗，切片，用生姜制）半两，羌活半两，独活半两，川芎半两，藿香半两，全蝎（微用酥酒拌、炒过）半两，白花蛇（微用酥酒拌，炙，去皮骨）半两，白附子（微炒）半两，天麻（酒水各半浸，焙干）半两，槟榔1两，朱砂1两（别研），麝香半两，牛黄、龙脑。";
  ex:hasUsage "方中牛黄、龙脑剂量原缺。" .

<medicine:鹅梨汤> a ex:Medicine;
  ex:hasFunction "缓通肺窍，以除积痰。主风痰入肺，久经吼咳者。痰随火升，上壅胸膈之哮病。";
  ex:hasName "鹅梨汤";
  ex:hasPrescription "鹅管石5分（煅，研），陈麻黄5分（蜜炙），当归1钱5分，茯苓2钱，蒌仁4钱，苏子1钱5分，桑叶1钱，橘红1钱，半夏1钱，贝母2钱，杏仁3钱。";
  ex:hasUsage "梨汁2大匙，姜汁2小匙，同冲服。" .

<medicine:鹅梨煎丸> a ex:Medicine;
  ex:hasFunction "凉心肺，利胸膈，解热毒，补元益气。主热痰。";
  ex:hasName "鹅梨煎丸";
  ex:hasPreparation "上除5味为膏外，余为末，入膏拌和，杵令硬软得所，丸如梧桐子大。";
  ex:hasPrescription "大鹅梨20枚（去皮核，用净布绞取汁），皂荚10挺（不蛀者，去黑皮，用浆水2升，揉取浓汁），生地黄半斤（净洗，研绞取汁），生薄荷半斤（细研取汁），蜜半斤（以上5味，同于银石器中慢火熬成膏，入诸药末），木香1两，人参1两，白茯苓（去黑皮）1两，白蒺藜（炒去角）1两，牛膝（酒浸1宿，切，焙干）1两，肉苁蓉（酒浸1宿，切，焙干）1两，羌活（去芦头）3分，防风（去叉）3分，白术3分，青橘皮（去白，焙）3分，桔梗（锉，炒）3分，山芋3分，半夏（汤洗7遍，焙干，炒过）1两，槟榔（煨，锉）2两，甘草（炙，锉）半两。";
  ex:hasUsage "每服15丸，加至20丸，食后荆芥汤送下，1日2次。" .

<medicine:鹅毛管眼药> a ex:Medicine;
  ex:hasFunction "清火明目，消肿去障。主目赤肿痛，怕光流泪，障翳遮睛，视物模糊。";
  ex:hasName "鹅毛管眼药";
  ex:hasPreparation "制成膏剂。";
  ex:hasPrescription "麝香、珍珠、熊胆、冰片、琥珀、炉甘石、硼砂、青葙子、谷精草、桑叶、菊花、密蒙花、决明子、蔓荆子、苍耳子、蚕砂、白蒺藜、薄荷、大黄、黄芩、黄连、黄柏、龙胆草、山栀、知母、车前子、生地黄、赤芍药、当归、牡丹皮、荆芥、防风、青蒿、石菖蒲、茯苓、银花、连翘、甘草、玄参、枳壳、苦丁茶、枸杞子、木贼草、望月砂。";
  ex:hasUsage "点眼用。" .

<medicine:鹅琅丸> a ex:Medicine;
  ex:hasFunction "活血助气。主麻醉各毒，遍身倦怠，四肢酸痛，咳嗽痰喘，大小便结，赤白痢疾，酒积酒寒。";
  ex:hasName "鹅琅丸";
  ex:hasPreparation "先将米壳熬成膏，再将其它药研成末，以米壳膏为丸，如黄豆大，红色为衣，贮瓷瓶中保存。";
  ex:hasPrescription "冬虫草6钱7分，金牛草6钱7分，当归3钱4分，川芎4钱，法半夏2钱，黄耆2钱，熟地2钱，丹皮2钱，山药2钱，明党参2钱，鹤虱2钱，洋参5钱4分，萸肉2钱，覆花1钱4分，米壳2钱。";
  ex:hasUsage "如毒重每服7丸，轻者4丸，均用白水送下。" .

<medicine:鹅石散> a ex:Medicine;
  ex:hasFunction "小儿咳嗽，涎盛不通，喉中鸣响。";
  ex:hasName "鹅石散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "鹅管石1钱半，井水石3钱，朱砂半钱（一方无朱砂）。";
  ex:hasUsage "每3岁服1字，杏仁汤调下。" .

<medicine:鹅管散> a ex:Medicine;
  ex:hasFunction "病愈后犯房，玉茎皮破肿痛。";
  ex:hasName "鹅管散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "黄连1钱，大黄1钱，鹅管石5分，赤石脂5分，雄黄1分，片脑半分。";
  ex:hasUsage "津液调敷。" .

<medicine:鹅管眼药> a ex:Medicine;
  ex:hasFunction "眼病。";
  ex:hasName "鹅管眼药";
  ex:hasPreparation "上为末，用黄连、大黄、甘草煎膏成条，阴干，入鹅管内封固。";
  ex:hasPrescription "甘石3两，琥珀2钱，朱砂1钱5分，牛黄5分，梅片3钱，雄黄1钱5分，珍珠1钱，麝香5分，青鱼胆5个，熊胆1钱，蕤仁1钱。" .

<medicine:鹅翎丹> a ex:Medicine;
  ex:hasFunction "各种目疾，眼漏。";
  ex:hasName "鹅翎丹";
  ex:hasPreparation "研至无声，即入前汁内，搓成如线细条，晾干，以鹅翎管贮。";
  ex:hasPrescription "粉炉甘石3两（用川黄连2两，龙胆草2两煎汁，甘石煅赤淬内，以酥为度，研极细如飞尘，仍入煎汁内，晒干），官硼砂2钱，新珠子1钱，片脑5分，琥珀5分，熊胆5分。";
  ex:hasUsage "用时以1条夹眼角内，自化泌入，1条可治数人。" .

<medicine:鹅翎散> a ex:Medicine;
  ex:hasFunction "疠风恶疾，赤肿腐烂。";
  ex:hasName "鹅翎散";
  ex:hasPreparation "上为散，分作50服。";
  ex:hasPrescription "番木鳖（麻油煮）1两，干漆（煅令烟尽）3钱，白鹅毛1只（烧存性，至不见星为度），苦参2两，皂角刺2两。";
  ex:hasUsage "清晨温酒或清茶送下。亦可用蜜作丸，分50服。" .

<medicine:鹅胆膏> a ex:Medicine;
  ex:hasFunction "杨梅疮。发于面，不便见人；或发于肛门，不便大解。";
  ex:hasName "鹅胆膏";
  ex:hasPreparation "上为极细末。";
  ex:hasPrescription "杏仁7个（去皮尖），轻粉5分，胆矾5分。";
  ex:hasUsage "鹅胆调，点疮上。" .

<medicine:鹅膏> a ex:Medicine;
  ex:hasFunction "耳聋。";
  ex:hasName "鹅膏";
  ex:hasPrescription "鹅膏1合。";
  ex:hasUsage "以少许滴耳中。" .

<medicine:鹅黄散> a ex:Medicine;
  ex:hasClinicalApplication "临床主要用于治疗面部粉刺感染，下肢、阴茎溃烂，疮疖肿痛等病症。";
  ex:hasFunction "痱子。";
  ex:hasName "鹅黄散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "绿豆粉31g，黄柏93g，轻粉6g，滑石粉15g，冰片3g。";
  ex:hasUsage "用猪油调成软膏。外用。" .

<medicine:鹘突羹> a ex:Medicine;
  ex:hasFunction "脾胃气冷，不能下食，虚弱乏力。";
  ex:hasName "鹘突羹";
  ex:hasPrescription "鲫鱼半斤。";
  ex:hasUsage "将鱼细切作鲙，沸豉汁热投之，着胡椒、干姜、莳萝、橘皮（为末）。空心食之。" .

<medicine:鹤寿丹> a ex:Medicine;
  ex:hasAlias "天浆子丸";
  ex:hasFunction "小儿急惊风，口噤，手足抽掣，眼目直视，多吐涎沫，四肢壮热。";
  ex:hasName "鹤寿丹";
  ex:hasPreparation "上为末，炼蜜为丸，如黍米大。";
  ex:hasPrescription "天浆子7枚（内有物者，微炒），蝉蜕2-7枚，牛黄1钱（细研），青黛1钱（细研），地龙3条，（微炒），蟾酥1钱（研入），朱砂半两（细研，水飞过），防风半两（去芦头），蚕纸1张（烧灰），麝香1钱（细研），乌蛇半两（酒浸，去皮骨，炙令黄）。";
  ex:hasUsage "天浆子丸（《普济方》卷三七）。《普济方》有半夏。" .

<medicine:鹤膝汤> a ex:Medicine;
  ex:hasFunction "牙痛。";
  ex:hasName "鹤膝汤";
  ex:hasPrescription "鼓椎草（又名鹤膝草）。";
  ex:hasUsage "水煎，灌漱。" .

<medicine:鹤膝风药酒> a ex:Medicine;
  ex:hasFunction "鹤膝风，肿起痛如针刺。";
  ex:hasName "鹤膝风药酒";
  ex:hasPreparation "上锉，布袋盛之，以好酒10斤放坛内，纳药其中，坛口用荷叶封住，放在火内烧三炷香久，冷定取起。";
  ex:hasPrescription "当归、赤芍、川芎、白芷、防风、牛膝、木瓜、苡仁、羌活、厚朴、苍术、陈皮、荆芥、土茯苓、熟地、升麻、甘草、桑寄生、石楠藤、白蒺藜。";
  ex:hasUsage "每日空心饮之，尽量而止。肿处以棉包裹，不可受风，以常温暖为佳。" .

<medicine:鹤虱丸> a ex:Medicine;
  ex:hasFunction "久心痛，经年不止。";
  ex:hasName "鹤虱丸";
  ex:hasNote "忌生葱。";
  ex:hasPreparation "上为末，炼蜜为丸，如小豆大。";
  ex:hasPrescription "鹤虱（炒）1两，木香1两，槟榔（锉）1两，陈橘皮（汤浸，去白，焙）1两，芜荑（炒）1两，附子（炮裂，去皮脐）1两，干姜（炮裂）1两。";
  ex:hasUsage "每服30丸，食前橘皮汤送下。" .

<medicine:鹤虱散> a ex:Medicine;
  ex:hasFunction "三虫。";
  ex:hasName "鹤虱散";
  ex:hasPreparation "上为细散。";
  ex:hasPrescription "鹤虱（微炒）1两半。";
  ex:hasUsage "每服1钱匕，空心猪羊肉臛汁调下。" .

<medicine:鹤虱槟榔汤> a ex:Medicine;
  ex:hasFunction "猬心痛。";
  ex:hasName "鹤虱槟榔汤";
  ex:hasNote "忌生冷，酢7日。";
  ex:hasPrescription "鹤虱2两（小儿用1两），槟榔2-7枚。";
  ex:hasUsage "以猪肉汁6升，煮槟榔取3升，去滓，纳鹤虱末，先夜不食，明旦空腹顿服之。须臾病下及吐水，永愈。" .

<medicine:鹤虱饮> a ex:Medicine;
  ex:hasFunction "蛔咬心痛。";
  ex:hasName "鹤虱饮";
  ex:hasPreparation "前二味为粗末，入研药和匀。";
  ex:hasPrescription "鹤虱（微炒）1两，苦楝根（有子者良，焙）1两，硇砂（研如粉）1分。";
  ex:hasUsage "每服3钱匕，水2盏，同煎至1盏，下朴消末1钱，煎沸去滓，空心服。" .

<medicine:鹤顶丸> a ex:Medicine;
  ex:hasFunction "带下之证有三：未嫁之女，月经初不止，或浴之以冷水，或热而扇，或当风，此室女病带下之由；有家之妇，阴阳过多，即伤胞络，风邪乘虚而入，胞络触冷，遂使秽液与血水相连带下之；产后带下，由亡失血气，伤动胞络，门开而外风袭，肌体虚冷风入，冷风与热气相连，故成液而下，冷则多白，而热则多赤，冷热相交，赤白俱下；月经不断。";
  ex:hasName "鹤顶丸";
  ex:hasPreparation "上为细末，醋糊为丸，如梧桐子大，以赤石脂为衣。";
  ex:hasPrescription "艾叶1两（醋半盏，煮干，为末），牡蛎1两3钱（盐泥煅），赤石脂1两半（醋淬7次），吴茱萸1两半（汤泡，去涎），干姜1两半（炮制），龙骨1两（盐泥煅），当归7钱半（酒浸），附子半两（泡，去皮）。";
  ex:hasUsage "方中吴茱萸用量原缺，据《奇效良方》补。" .

<medicine:鹤顶丹> a ex:Medicine;
  ex:hasAlias "二仙丹";
  ex:hasFunction "强脚膝，补气，能令气下行，安五脏，填骨髓，补虚羸，去百病。主";
  ex:hasName "鹤顶丹";
  ex:hasNote "忌进食一时辰，孕妇不可服。";
  ex:hasPreparation "上药共拌匀，同杵300-500下，丸如梧桐子大。";
  ex:hasPrescription "辰砂5两，椒红5两，青盐5两（上药纳银瓶内，木塞瓶口，油纸封，重汤煮7昼夜，入地坑出火毒，1宿后入下药），鹿茸5两1分（酒浸，水洛，焙干），参5两，茅术5两9分。";
  ex:hasUsage "每服40丸，空心、食前米饮送下。" .

<medicine:鹤顶红> a ex:Medicine;
  ex:hasFunction "杨梅疮及鸡冠痔。";
  ex:hasName "鹤顶红";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "杏仁5分，轻粉5分，银朱5分。";
  ex:hasUsage "鹅胆汁调点。痔干，以唾津润湿，干掺，痔潮，干搽。" .

<medicine:鹫霜散> a ex:Medicine;
  ex:hasFunction "一切久年打扑痛。";
  ex:hasName "鹫霜散";
  ex:hasPreparation "鹭去嘴、足、翅、肠，以红花、人参填入腹中，纳土器内，盐泥封固，烧存性，为细末。";
  ex:hasPrescription "鹭1只1两，红花1两，人参1两。";
  ex:hasUsage "每服1钱，热酒送下。" .

<medicine:鹭鸶咯丸> a ex:Medicine;
  ex:hasFunction "宣肺，化痰，止咳。用于百日咳，痰浊阻肺，阵阵咳嗽，痰鸣气促，咽干声哑。";
  ex:hasName "鹭鸶咯丸";
  ex:hasPrescription "麻黄12g 苦杏仁60g 石膏60g 甘草12g 细辛6g 紫苏子（炒）60g 白芥子（炒）12g 牛蒡子（炒）30g 瓜萎皮60g 射干30g 青黛30g 蛤壳60g 天花粉60g 桅子（姜炙）60g 牛黄5g";
  ex:hasUsage "梨汤或温开水送服，一次1丸，一日2次。" .

<medicine:鹭鸶喀丸> a ex:Medicine;
  ex:hasAlias "鹭鸶咳丸（《中药制剂手册》）。";
  ex:hasFunction "清宣肺热，止嗽化痰。治小儿百日咳。咳嗽不已，连作数十声，甚则呛血、音哑，面目浮肿，经久不愈。";
  ex:hasName "鹭鸶喀丸";
  ex:hasPreparation "上药十四味，共研细粉，过罗，每552克细粉兑龙延香1.5克，麝香0.6克，共研细，混合均匀，炼蜜为丸，每丸重1.2克，金衣三十六开，蜡皮封固。";
  ex:hasPrescription "杏仁（去皮，炒）60克 牛蒡子（炒）30克 生石膏60克 栀子（炒）60克 天花粉60克 紫苏子（炒）回克 甘草12克 瓜蒌皮60克 麻黄12克 青黛30克 蛤壳60克 射干30克 白芥子（炒）12克 细辛6克";
  ex:hasUsage "每服1～2丸，每日二次，温开水或煮梨汤过服。" .

<medicine:鹭鹚喀丸> a ex:Medicine;
  ex:hasAlias "鹭鹚咳丸";
  ex:hasFunction "宣解肺热，止嗽化痰。主小儿咳嗽不已，连作数十声，甚则呛血，音哑，面浮肿。";
  ex:hasName "鹭鹚喀丸";
