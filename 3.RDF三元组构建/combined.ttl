  ex:hasPrescription "石膏1两，玄参3两，人参3两，知母1钱，黄连3钱，茯神1两，白芥子3钱。";
  ex:hasUsage "水煎服。" .

<medicine:火龙丹> a ex:Medicine;
  ex:hasFunction "诸心腹痛。";
  ex:hasName "火龙丹";
  ex:hasNote "孕妇不可服。";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "焰消1钱，雄黄1钱。";
  ex:hasUsage "每点少许入眦内。" .

<medicine:火龙散> a ex:Medicine;
  ex:hasAlias "火龙汤";
  ex:hasFunction "心腹痛。";
  ex:hasName "火龙散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "生地、木香、砂仁壳（炒）。";
  ex:hasUsage "每服3钱，临卧用防风、荆芥煎汤洗浴，热酒送下即睡，则皮内毒虫迫出肌肤，然后用雄黄、硫黄、朱砂、代赭石、车米等分研末，香油调，熏擦遍身。" .

<medicine:火龙膏> a ex:Medicine;
  ex:hasClinicalApplication "鹤膝风：一妇人膝肿痛，遇寒痛益甚，月余不愈，诸药不应，脉弦紧，此寒邪深伏于内也。用大防风汤及火龙膏，治之而消。";
  ex:hasFunction "阴发背，黑凹而不知痛者。";
  ex:hasName "火龙膏";
  ex:hasPreparation "取鲜猪胆汁调入姜末如糊。";
  ex:hasPrescription "新火姜8两（6月6日晒干，为末，瓷罐收贮听用）。";
  ex:hasUsage "敷在患处周围，用纸盖之，干用热水润之。知痛时黑水自出为妙，如不知疼，出黑水难治。" .

<medicine:灭瘢丹> a ex:Medicine;
  ex:hasFunction "治面部瘢痕。";
  ex:hasName "灭瘢丹";
  ex:hasPreparation "炼蜜为丸。";
  ex:hasPrescription "轻粉 白附子 黄芩（微火略炒）白芷 防风（研细末）各等分";
  ex:hasUsage "于每日洗面之时多擦数次，临睡洗面时又擦之。不须三日，自然消痕灭瘢。" .

<medicine:灯心散> a ex:Medicine;
  ex:hasAlias "灯心汤";
  ex:hasFunction "鼻衄不止。";
  ex:hasName "灯心散";
  ex:hasPreparation "上为散，入丹砂1钱研。";
  ex:hasPrescription "灯心（焙）1两。";
  ex:hasUsage "每服2钱匕，以米饮调下。" .

<medicine:灯心汤> a ex:Medicine;
  ex:hasFunction "热淋疼痛。";
  ex:hasName "灯心汤";
  ex:hasPreparation "上锉。";
  ex:hasPrescription "灯心、干柿各等分。";
  ex:hasUsage "水煎服。" .

<medicine:灯心竹叶汤> a ex:Medicine;
  ex:hasFunction "干呕；夏月手足心热，面赤饮冷，吐出浑浊。";
  ex:hasName "灯心竹叶汤";
  ex:hasPrescription "竹叶30片，灯心30根。";
  ex:hasUsage "水煎服。" .

<medicine:灯花丸> a ex:Medicine;
  ex:hasFunction "小儿惊啼，夜啼。";
  ex:hasName "灯花丸";
  ex:hasPreparation "上为末，粟米饮为丸，如芥子大。";
  ex:hasPrescription "灯花20个，乳香（皂子大）2块。";
  ex:hasUsage "每服7丸，以桃心汤送下，不拘时候。" .

<medicine:灯花散> a ex:Medicine;
  ex:hasFunction "小儿夜啼。";
  ex:hasName "灯花散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "灯花7枚，辰砂1分。";
  ex:hasUsage "灯草汤吞下。" .

<medicine:灯花膏> a ex:Medicine;
  ex:hasAlias "火花膏、花火膏";
  ex:hasFunction "小儿夜啼。热燥，小便赤，口暖有汗，仰身而啼。";
  ex:hasName "灯花膏";
  ex:hasPreparation "上为极细末，以蜜调成膏。";
  ex:hasPrescription "灯花7个，硼砂1字，朱砂少许。";
  ex:hasUsage "火花膏（《赤水玄珠》卷二十五）、花火膏（《婴童百问》卷三）。" .

<medicine:灯苍丸> a ex:Medicine;
  ex:hasFunction "伏暑吐逆，头目痛，四肢厥冷，烦躁不解。";
  ex:hasName "灯苍丸";
  ex:hasPreparation "上为末，滴水为丸，如大豆大。";
  ex:hasPrescription "半夏2两（姜制），硫黄1两，白善土1两。";
  ex:hasUsage "每用1-2丸，儿小者服1丸，以针穿于灯上燎过，吐逆者，盐艾汤送下；烦躁者，生姜汤送下；四肢冷者，热酒送下；头痛者，腊茶送下。" .

<medicine:灰弹散> a ex:Medicine;
  ex:hasAlias "金创灰蛋散、金疮灰蛋散";
  ex:hasFunction "止血。主刀斧伤，及多年恶疮，并金疮。";
  ex:hasName "灰弹散";
  ex:hasPreparation "用多年陈石灰细碾，鸡子清调成团，煅过候冷，再碾细。";
  ex:hasPrescription "多年陈石灰、鸡子清。";
  ex:hasUsage "金创灰蛋散（《跌损妙方》、金疮灰蛋散（《景岳全书》卷六十四）。" .

<medicine:灰水膏> a ex:Medicine;
  ex:hasFunction "牙痛。";
  ex:hasName "灰水膏";
  ex:hasPrescription "木炭灰（择净细者）。";
  ex:hasUsage "冷水调涂牙痛处之脸上。止即去之。" .

<medicine:灰浆膏> a ex:Medicine;
  ex:hasFunction "消瘤。主";
  ex:hasName "灰浆膏";
  ex:hasPreparation "上煎浓汁，去滓，入木莲蓬蒂上白浆1-2两，采时以蛤蜊壳在蒂上刮取，搅匀，再用石灰以竹片拨炒，俟竹片焦黑成炭为度，徐徐投下，调成不稀不厚膏子，入瓷瓶收贮，黄蜡封口。";
  ex:hasPrescription "天南星1两，半夏1两，草乌（煅存性）5钱。";
  ex:hasUsage "用时如干，以唾津润开，敷瘤上；或木莲蓬浆润敷尤妙。2-3日即愈。" .

<medicine:灰煎> a ex:Medicine;
  ex:hasFunction "瘤赘，瘢痕，疵痣及痈疽，恶肉。";
  ex:hasName "灰煎";
  ex:hasPrescription "石灰1斗5升，湿桑皮4斗，柞栎灰4斗。";
  ex:hasUsage "其血瘤，瘤附左右胡脉，及上下悬壅，舌本诸险处，皆不可令消，消即血出不止，杀人。" .

<medicine:灰皂散> a ex:Medicine;
  ex:hasFunction "有腐蚀性作用，能使痔核发生干性坏死。主中、后期能脱出肛外的内痔。";
  ex:hasName "灰皂散";
  ex:hasPreparation "楠皂不拘量，放在房内通风的地方，使其自行吸收空气中的水分，慢慢溶化出液体，即叫自然水，溶多少倒多少，用玻璃瓶装好备用。黄丹原是粉末，不须再加配制，随时可用。";
  ex:hasPrescription "新出窑石灰、楠皂自然水（楠皂又名石碱或土丙药）、黄丹。";
  ex:hasUsage "用时先取石灰粉（不拘量）放于小杯中，加上黄丹少许，调匀后加入楠皂自然水，调成糊状，不宜过硬，也不宜过稀，调成后稍等几秒钟将药涂于痔核面上。因此药调成糊状后，会很快变成干硬，如发现过于干硬时，可即刻加入一些楠皂水调匀，使保持一定的稀度，所以必须随调随用，如果调好后10分钟以上，便会失去效力。" .

<medicine:灰矿散> a ex:Medicine;
  ex:hasFunction "止血。主金疮。";
  ex:hasName "灰矿散";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "古窑石灰半两，紫矿半两。";
  ex:hasUsage "敷之。" .

<medicine:灰米膏> a ex:Medicine;
  ex:hasFunction "黑痣浮浅者。";
  ex:hasName "灰米膏";
  ex:hasNote "忌酱、醋。";
  ex:hasPrescription "白川米、灰碱水。";
  ex:hasUsage "用成块火灰碱水调稠，将白川米插入灰内，留半米在外，片时许，候米熟，针挑损痣上，用米点痣上。可落矣。" .

<medicine:灰糖水> a ex:Medicine;
  ex:hasFunction "干霍乱。";
  ex:hasName "灰糖水";
  ex:hasPrescription "古石灰（老塔庙古城墙取）3钱。";
  ex:hasUsage "入冷水搅浑，澄清去滓，调入砂糖2钱服。" .

<medicine:灰草散> a ex:Medicine;
  ex:hasFunction "痘溃烂。";
  ex:hasName "灰草散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "荔枝壳（微烧存性）、草纸（烧存性）、多年陈茅草（晒干）。";
  ex:hasUsage "掺于烂处，即收水结痂。" .

<medicine:灰藋涂方> a ex:Medicine;
  ex:hasAlias "灰藋膏";
  ex:hasFunction "紫癜风。";
  ex:hasName "灰藋涂方";
  ex:hasPreparation "后7味为末，与炼了灰藋浓汁搅，煎如膏。";
  ex:hasPrescription "灰藋不拘多少（烧灰，用纸衬，淋取汁，炼令如膏，约2匙许），雄黄1钱，丹砂1钱，腻粉1钱，麝香1钱，蛤蟆灰1钱，石硫黄1钱，矾石灰1钱。";
  ex:hasUsage "灰藋膏（《准绳·疡科》卷五）。" .

<medicine:灰韭散> a ex:Medicine;
  ex:hasFunction "止血。主金疮。";
  ex:hasName "灰韭散";
  ex:hasPreparation "先捣3味，烂汁着石灰，再捣烂，和成饼子，乱草裹，放背阴处。";
  ex:hasPrescription "新石灰、韭菜、苎麻叶、小秦王草各等分。";
  ex:hasUsage "用时碾碎末，干掺如神。" .

<medicine:灵中散> a ex:Medicine;
  ex:hasFunction "背疽等疮。";
  ex:hasName "灵中散";
  ex:hasPreparation "上装入蜂巢内，火烧之，小油调。";
  ex:hasPrescription "陈大蜂巢1个，白矾、脂麻。";
  ex:hasUsage "扫之。" .

<medicine:灵丹> a ex:Medicine;
  ex:hasFunction "一切牙痛。";
  ex:hasName "灵丹";
  ex:hasPreparation "上为粗末，置大铜锅内，外用甘草5钱，煎水一大碗，将药拌匀，再取潮脑3两，研碎，分作5-7次，洒药上，再以大碗盖住药，又用石膏和灰面、盐水调匀，密糊碗口，不可泄气，煮长香一柱时，方可起下，将上升在碗内的灵丹用竹刀刮下，仍将滓用甘草水拌匀，复洒潮脑于上，如此升取5-7次，候药性升尽为度，再以瓷瓶收固。";
  ex:hasPrescription "防风2钱5分，北细辛2钱5分，黄芩2钱5分，石膏2钱5分，元参2钱5分，羌活2钱5分，荆芥2钱5分，小生地2钱5分，连翘2钱5分，黄柏2钱5分，甘草2钱5分，白芷2钱5分，白菊花2钱5分，栀仁2钱5分，川芎2钱5分，百部2钱5分，薄荷2钱5分，真黄连3钱。";
  ex:hasUsage "凡牙疼擦上，立止。" .

<medicine:灵乌丹> a ex:Medicine;
  ex:hasFunction "一切冷疾疼痛，麻痹风气。";
  ex:hasName "灵乌丹";
  ex:hasPreparation "上为末，炼蜜为丸，如梧桐子大，朱砂为衣。";
  ex:hasPrescription "川乌1斤（河水浸7日。换水浸，去皮尖，切片，干之），牛膝2两（酒浸，焙），何首乌4两（制如川乌法）。";
  ex:hasUsage "每服7丸，渐加至10丸，空心酒送下。病已即止。" .

<medicine:灵乌二仁膏> a ex:Medicine;
  ex:hasFunction "滋养肝肾，补益精血，调和脾肺。主肝肾阴虚，精血亏损，症见头晕头痛，失眠多梦，心悸健忘，大便不畅，或兼咳喘。临床用于高血压痛，冠心病、脑动脉硬化症、脂肪肝及高胆固醇血症。";
  ex:hasName "灵乌二仁膏";
  ex:hasNote "阳虚及腹泻者忌用。";
  ex:hasPrescription "灵芝500g，首乌500g，核桃仁250g，苡仁250g。";
  ex:hasUsage "首乌、灵芝、苡仁反复浓煎，加蜜收膏。将核桃肉研碎末兑入。" .

<medicine:灵乌散> a ex:Medicine;
  ex:hasFunction "风痫多惊，手足颤掉，口吐涎沫。";
  ex:hasName "灵乌散";
  ex:hasPreparation "上四味，将二味捣末，与别研二味同罗。";
  ex:hasPrescription "乌鸦1只（腊月取于藏瓶内盛，以盐泥固济，令干，用炭火煅存性，候冷，取出去肚肠，研），丹砂（研）1分，细辛（去苗叶）2两，干蝎（全者）14枚（炒）。";
  ex:hasUsage "每服半钱匕，午前温酒调下。病已即止。" .

<medicine:灵乳丹> a ex:Medicine;
  ex:hasFunction "补益诸虚。主";
  ex:hasName "灵乳丹";
  ex:hasPreparation "上为末，乳钵内拈令无声为度，却用半夏为末，煮糊为丸，如绿豆大，别用好朱砂细研为衣，建盏内出光。";
  ex:hasPrescription "灵砂1两（别研），钟乳半两（别研），沉香半两（镑末），乳香半两（箬叶上炙，研细），没药半两（研）。";
  ex:hasUsage "磨沉香汤送下。" .

<medicine:灵仙丸> a ex:Medicine;
  ex:hasFunction "通十二经脉，去宿垢。主口眼斜，疠风、头风、癜风，皮肤搔痒，手足顽麻、疥癣、腰重阴肿，妇人月闭。";
  ex:hasName "灵仙丸";
  ex:hasPreparation "上为末，好酒拌润，入竹筒内塞口，九蒸九晒，炼蜜为丸，如梧桐子大。";
  ex:hasPrescription "威灵仙（洗净，焙干）。";
  ex:hasUsage "本方改为散剂，名“灵仙散”。（见《医级》）。" .

<medicine:灵仙散> a ex:Medicine;
  ex:hasFunction "肠风病甚不愈。";
  ex:hasName "灵仙散";
  ex:hasPreparation "上锉，劈碎，以米醋2升煮干，更炒过，捣为末，以生鸡子清和作小饼子，炙干，再为细末。";
  ex:hasPrescription "威灵仙（去土）2两，鸡冠花2两。";
  ex:hasUsage "每服2钱匕，空心陈米饮调下，午后更1服。" .

<medicine:灵仙枫藤汤> a ex:Medicine;
  ex:hasFunction "肩、臂、肘痛肿，跌打损伤。";
  ex:hasName "灵仙枫藤汤";
  ex:hasPrescription "灵仙5钱，枫藤3钱，桂枝1钱5分，石菖7分，升麻8分，细辛2分，吉根1钱5分，羌活1钱5分，防风1钱5分，槟榔1钱，全皮1钱，草节8分，乳没2钱，赤芍1钱5分，生地2钱。";
  ex:hasUsage "水煎服。" .

<medicine:灵仙龙草汤> a ex:Medicine;
  ex:hasFunction "软坚散结。主无名肿毒，不痛不痒，痰核瘰疬，乳腺包块，喘咳痰鸣，呕吐痰涎，症瘕积聚，坚硬难化，舌质晦暗，苔腻，脉滑。";
  ex:hasName "灵仙龙草汤";
  ex:hasNote "忌服寒凉。";
  ex:hasPrescription "威灵仙30g，龙葵30g，夏枯草30g，土茯苓30g，栝楼30g，黄药子15g，山慈姑15g，了哥王12g。" .

<medicine:灵光丸> a ex:Medicine;
  ex:hasFunction "斑疮眼。";
  ex:hasName "灵光丸";
  ex:hasPreparation "上为末，沙糖为丸，如弹子大。";
  ex:hasPrescription "夜明沙1两（去土），蝉蜕21个（生，洗去土），木贼21条（去节）。";
  ex:hasUsage "每服1丸，嚼，木贼煎汤送下。" .

<medicine:灵光散> a ex:Medicine;
  ex:hasFunction "外障癍疮，扳睛胬肉，蚬肉蟹睛。";
  ex:hasName "灵光散";
  ex:hasPreparation "上为极细末。";
  ex:hasPrescription "炉甘石（煅）1两，灵药1钱（重者或2-3钱）。";
  ex:hasUsage "调点患处少许，将目久闭，候痛止药性散尽可拨去，用绢拭去令净，以热水洗之。" .

<medicine:灵光还睛膏> a ex:Medicine;
  ex:hasFunction "一切眼疾。";
  ex:hasName "灵光还睛膏";
  ex:hasPreparation "上为细末，用白沙蜜10两，银器内或沙锅内先熬5-7沸，以净纸搭去面上腊，取净，除黄丹外，下余药，用湿柳杆子搅匀，次下黄丹，再搅匀，于慢火内徐徐搅至紫色，不粘手为度，急丸如皂角子大，以纸裹之。";
  ex:hasPrescription "川黄连4两（锉如大豆许，用童便浸1宿，滤去滓，晒干，为末），炉甘石6两（放在铁片上，炭火内烧红透，黄连汁淬之，烧淬7次，研为末），黄丹3两（研细，水飞净），当归2钱，乌鱼骨1钱，白丁香1钱，硇砂（另研）1钱，轻粉（研）1钱，麝香（另研）半钱，乳香（另研）半钱。";
  ex:hasUsage "本方方名，《普济方》引作“灵光还睛丸”。" .

<medicine:灵功饮> a ex:Medicine;
  ex:hasFunction "痧后痢疾。";
  ex:hasName "灵功饮";
  ex:hasPrescription "当归8分，黄连8分，川芎8分，人参3分，广木香6分，枳壳6分，滑石6分，槟榔6分，甘草1分。";
  ex:hasUsage "加灯心30茎，水煎，食前温服。" .

<medicine:灵升散> a ex:Medicine;
  ex:hasAlias "升丹";
  ex:hasFunction "肠胃湿热，郁久生虫，啮齿齿碎，啮龈龈痛，不啮则微痛龈痒，又或痒或胀痛忽然而止者。";
  ex:hasName "灵升散";
  ex:hasPreparation "上药分研碎，茶钟盖上，放铜勺内，稠面封四围，勿令走气，放风炉上微火升之。少顷觉樟脑气透出，即取安放地上，候冷揭开，药俱升在茶钟底，刮下入瓷器密贮听用。";
  ex:hasPrescription "樟脑5分，川椒红1撮。" .

<medicine:灵圆丹> a ex:Medicine;
  ex:hasFunction "男子、妇人攀睛翳膜，痒涩羞明，赤筋碧晕，内外障瘀肉；风热赤眼。";
  ex:hasName "灵圆丹";
  ex:hasNote "忌酒面。";
  ex:hasPreparation "上为末，水浸蒸饼为丸，如弹子大。";
  ex:hasPrescription "甘菊花1两，川芎1两，白附子1两，柴胡1两，远志（去心）1两，羌活1两，独活1两，青葙子1两，仙灵脾（酥炙）1两，石膏1两，防风1两，全蝎1两，青皮1两，陈皮1两，荆芥1两，楮实1两，木贼（去节）1两，甘草1两，黄芩1两，苍术（米泔浸，焙）4两。";
  ex:hasUsage "每服1粒，食后细嚼，荆芥汤或茶清送下，日3次。" .

<medicine:灵圣散> a ex:Medicine;
  ex:hasFunction "大人、小儿疯狗咬破疮，犬咬所伤疮。";
  ex:hasName "灵圣散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "天南星（生，锉）、防风（去芦，锉）。";
  ex:hasUsage "先用浆水、葱白、槐枝熬汤洗净，干贴疮口上。上用膏药盖之，1日2次。" .

<medicine:灵奇饮> a ex:Medicine;
  ex:hasFunction "广疮（杨梅疮）。";
  ex:hasName "灵奇饮";
  ex:hasPrescription "麻黄（去节）春夏6钱、秋冬8钱，大黄1两，蝉蜕1两，威灵仙1两，白芷1两。";
  ex:hasUsage "以羊肉1斤，水5碗煮，去肉留汤煎药，热服出汗。" .

<medicine:灵妙散> a ex:Medicine;
  ex:hasFunction "小儿冷热不调，腹痛泄泻，下痢赤白，肠滑无度，多因嗜卧，全不入食。";
  ex:hasName "灵妙散";
  ex:hasNote "忌生冷之物。";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "人参（去芦头）1两，甘草1钱（炙黄），罂粟壳2两（切碎，用黑豆半合同炒油出，去黑豆不用）。";
  ex:hasUsage "每服1钱，泄泻，煎枣汤调下；赤白痢，煎生姜、乌梅汤调下；白多赤少，用温酒、白汤各一半调下；赤多白少，蜜汤调下。并乳食前服。" .

<medicine:灵妙饮> a ex:Medicine;
  ex:hasFunction "腹内作痛而兼泻。";
  ex:hasName "灵妙饮";
  ex:hasPrescription "白茯苓1钱5分，苍术1钱5分，猪苓1钱5分，白豆仁1钱5分，泽泻1钱，厚朴1钱，木通1钱，沉香1钱，甘草7分，肉桂7分。";
  ex:hasUsage "加生姜5片，水煎，食前服。" .

<medicine:灵姜饮> a ex:Medicine;
  ex:hasFunction "脾胃聚痰，发为寒热。";
  ex:hasName "灵姜饮";
  ex:hasPrescription "生姜4两（和皮捣汁1碗）。";
  ex:hasUsage "夜露至晓，空心冷服。" .

<medicine:灵字丸> a ex:Medicine;
  ex:hasFunction "麻风。";
  ex:hasName "灵字丸";
  ex:hasPreparation "炼蜜为丸。";
  ex:hasPrescription "白苦参（生用，脾经无病勿用）3两，白花蛇1两，白蒺藜7两，风子肉1两，土麻仁6两，小云连5钱。";
  ex:hasUsage "吞服，早晚、空心各服5钱。" .

<medicine:灵宝丸> a ex:Medicine;
  ex:hasFunction "十种水气。";
  ex:hasName "灵宝丸";
  ex:hasNote "忌盐一百日。";
  ex:hasPreparation "上先捣研滑石令极细，次入腻粉和匀，熬木瓜浓汁成膏，为丸如绿豆大。";
  ex:hasPrescription "滑石（好白者）2两，腻粉1两。";
  ex:hasUsage "每服7丸，五更空心温米饮送下，日只1服。服至5-7日，觉脐腹撮痛，小便多为效。觉效便服补脾胃药。" .

<medicine:灵宝丹> a ex:Medicine;
  ex:hasAlias "归命丹、返魂丹";
  ex:hasFunction "一切诸风，瘫痪伤风。";
  ex:hasName "灵宝丹";
  ex:hasPreparation "上将前五味为细末，择辰日辰时，取东方井花水，入乳香末和前药末为丸，如豆大，以朱砂、麝香为衣。";
  ex:hasPrescription "川乌（去皮尖，略炮）3两，五灵脂3两，没药1两半，胡椒半两，木香1分，乳香（研）1分，朱砂（研）1分，麝香1分（和朱砂为衣）。";
  ex:hasUsage "每服1粒，生姜2片，同嚼，茶酒任下，不拘时候。如伤风头痛，及胎风，荆芥汤下。" .

<medicine:灵宝化积膏> a ex:Medicine;
  ex:hasFunction "一切痞积。";
  ex:hasName "灵宝化积膏";
  ex:hasPreparation "除乳、没、麝、松、阿外，余药俱饮片，浸香油内三日，用砂锅煎药黑焦色，去滓再煎油，滴水成珠，每油4两入松香1斤，少煎一饭时，再入乳香、没药、麝香，取起入水中，抽洗金黄色，煎时以桃、柳枝不住手搅匀令枯。";
  ex:hasPrescription "巴豆仁100粒，蓖麻仁100粒，五灵脂4两，阿魏（醋煮化）1两，当归1两，白附子5钱，穿山甲5钱，乳香（炙，去油）5钱，没药（炙，去油）5钱，麝香3分，松香1斤半，芝麻油5两。";
  ex:hasUsage "用狗皮摊贴患处，每日以热鞋底熨，令药气深入。" .

<medicine:灵宝如意万应神效痧药>
  a ex:Medicine;
  ex:hasFunction "一切感冒风寒、中暑、山岚瘴气；九种气疼；痰迷心窍；各种痧症，小儿急，慢惊风。";
  ex:hasName "灵宝如意万应神效痧药";
  ex:hasNote "孕妇忌服。";
  ex:hasPreparation "上研末为丸。";
  ex:hasPrescription "真藿香梗3两，檀香末6钱，真茅山术6两，真蟾酥6钱，顶上沉香6钱，明雄黄6钱，麝香6钱，木香6钱，漂净朱砂6钱，丁香6钱。";
  ex:hasUsage "用时先将药数粒研末，吹入鼻内后，大人服30粒，小儿减半，开水送下。" .

<medicine:灵宝如意丹> a ex:Medicine;
  ex:hasAlias "如意丹、灵宝如意丸";
  ex:hasFunction "中暑眩晕，绞肠腹痛，脘闷饱胀，阴阳反错，不省人事，手足厥冷，恶心呕泻；山岚瘴气，感受邪秽，中恶头痛，一切痧气；伤寒，风寒咳嗽；中风不语，痰涎神昏，口眼斜，手足麻木；疟疾；瘟症疹子不出；痫证疯迷；饥饱劳碌；瘫痪；噎膈咽喉，胸膈疼痛，恶心嘈杂；牙痛；心胃气痛；心胃虫痛，九种胃痛；气蛊；水蛊；中酒毒；阴寒；忘前失后；小便尿血；二便不能；水泻；赤痢，白痢，噤口痢；偏坠疼痛；腿足疼痛；跌扑损伤；昏迷不醒；痄腮；痈疽疔疮、恶毒初起，肿烂太甚；疔疮走黄，天泡疮、杨梅疮初起，诸疮溃破；蛇蝎虫毒；妇人经闭；妇人鬼迷失魂，梦与鬼交；子死腹中；产后见神见鬼；产后腹胀；小儿乳积、食积、风寒、惊啼。";
  ex:hasName "灵宝如意丹";
  ex:hasNote "孕妇忌服。";
  ex:hasPreparation "上为末，取净粉，烧酒化蟾酥泛丸，如芥子大，辰砂为衣。";
  ex:hasPrescription "白粉霜1两，血竭1两，硼砂1两，腰黄1两，天麻1两，辰砂1两，麝香1钱，梅片1钱，人参1钱，蟾酥6钱（1方有巴豆霜）。";
  ex:hasUsage "如意丹（《北京市中药成方选集》）、灵宝如意丸（《全国中药成药处方集》兰州方）。" .

<medicine:灵宝妙应丹> a ex:Medicine;
  ex:hasFunction "一切痧证，霍乱吐泻，吊脚转筋，牙关紧闭，手足厥冷。";
  ex:hasName "灵宝妙应丹";
  ex:hasPreparation "上为细末。以小口瓷瓶收藏，勿令泄气。";
  ex:hasPrescription "当门子9钱，火消6钱，大梅片9钱，西黄3钱，腰黄1两8钱，荜拨3钱，擘砂3两，硼砂1两8钱。";
  ex:hasUsage "病重者，用此丹少许纳入脐内，以清冷膏盖之，轻者用少许吹入鼻孔内。" .

<medicine:灵宝护心丹> a ex:Medicine;
  ex:hasFunction "强心益气，通阳复脉，芳香开窍，活血镇痛。用于心动过缓型病态窦房结综合症及冠心病心绞痛，对某些心功能不全及部分心律失常的患者也有一定疗效。";
  ex:hasName "灵宝护心丹";
  ex:hasNote "孕妇忌服。少数患者在服药初期偶见轻度腹胀、口干，继续服药后症状可自行消失，无需停药。";
  ex:hasPrescription "麝香、蟾酥、牛黄、冰片、红参、三七、琥珀、丹参、苏合香油";
  ex:hasUsage "口服，一次3～4丸，一日3～4次，饭后服用或遵医嘱。" .

<medicine:灵宝救苦丹> a ex:Medicine;
  ex:hasFunction "止痛护心，解毒化脓。主痈疽发背，疔疮、内痈，恶疠、蛊毒，烂喉丹瘀、霉疮结毒，一切无名肿毒，已溃未溃，毒邪毒火。";
  ex:hasName "灵宝救苦丹";
  ex:hasNote "孕妇忌服。";
  ex:hasPreparation "上为极细末，用头生男孩人乳和化为丸，每丸1分，真金箔5分为衣。";
  ex:hasPrescription "麝香5分，番蟾酥（酒化）5分，真狗宝5分，西牛黄5分，廉珍珠3分，梅冰片2分，明硼砂5分，草河车1钱，真熊胆3分，真山上百草霜1钱（如无，用陈京墨代），真血竭5分，去油乳香5分，去油没药5分，生大黄1钱（勿见火），明雄黄（制）5分，飞净朱砂5分，生玳瑁5分，真琥珀5分，乌沉香2分，青木香3分。";
  ex:hasUsage "每服1丸，重者2-3丸，陈绍酒送下，以醉取汗为度。并可外敷。" .

<medicine:灵宝散> a ex:Medicine;
  ex:hasFunction "妇人血气攻刺痛，引两肋疼痛，及痃癖冷气。";
  ex:hasName "灵宝散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "丁香1钱半，木香1钱半，乳香1钱半，当归半两，玄胡索半两，白芍药半两。";
  ex:hasUsage "每服1钱，食前温酒调下。" .

<medicine:灵宝烟筒> a ex:Medicine;
  ex:hasFunction "一切寒喘咳嗽。";
  ex:hasName "灵宝烟筒";
  ex:hasPreparation "先将蜡熔化涂纸上，次以艾叶铺上，将三味细研掺匀，卷成筒。";
  ex:hasPrescription "黄蜡3钱，雄黄3钱，佛耳草1钱，款冬花1钱，艾叶3分。";
  ex:hasUsage "每用火点烟一头，熏入口内，吸烟1口，清茶吞下。" .

<medicine:灵宝膏> a ex:Medicine;
  ex:hasFunction "一切痈疽、脑疽、发背等疾。";
  ex:hasName "灵宝膏";
  ex:hasPreparation "上用白沙蜜10两，同前药于银石器内极慢火熬3时辰，其稠如饧糖，多合少合准此。";
  ex:hasPrescription "大瓜蒌10枚，（隔2-3年陈者，尽去其皮，留瓤子，约有半升许，用砂盆研细如粉），新胡桃10枚，（不油者，汤去膜，研细如粉），滴乳香10块（如大指头，大乳钵内研细如粉）。";
  ex:hasUsage "每服2匙，无灰酒半盏调下，不拘时候。甚者不过2-3服。" .

<medicine:灵宝辟瘟丹> a ex:Medicine;
  ex:hasFunction "辟瘟。主";
  ex:hasName "灵宝辟瘟丹";
  ex:hasPreparation "上为末，米糊为丸，如弹子大。";
  ex:hasPrescription "苍术1斤，降香4两，雄黄2两，朱砂1两，硫黄1两，消石1两，柏叶8两，菖蒲根4两，丹参3两，桂皮2两，藿香2两，白芷4两，桃头4两（5月5日午时收），雄狐黄2两，蕲艾4两，商陆根2两，大黄2两，羌活2两，独活2两，雌黄1两，赤小豆2两，仙茅2两，唵叭香（无亦可免）。";
  ex:hasUsage "火上焚烧1丸。" .

<medicine:灵宝香红丸> a ex:Medicine;
  ex:hasAlias "狗宝丸";
  ex:hasFunction "护心止痛，消毒化脓，在外者可使表散，在内者可使便泄。主内外一切痈疽疔毒。";
  ex:hasName "灵宝香红丸";
  ex:hasPreparation "上为细末，以熊胆6分、人乳化为丸。每重1分，金箔为衣。";
  ex:hasPrescription "牛黄2钱，狗宝2钱，血竭2钱，乳香（炙）2钱，没药（炙）2钱，飞辰砂2钱，硼砂2钱，葶苈2钱，飞雄黄2钱，真珠1钱，沉香1钱，冰片1钱，琥珀6分。";
  ex:hasUsage "每服1丸，重者2-3丸，陈酒调下。" .

<medicine:灵宵饮> a ex:Medicine;
  ex:hasFunction "小儿顿热，胎惊内吊。";
  ex:hasName "灵宵饮";
  ex:hasPrescription "防风5分，木通5分，枳壳5分，茯神5分，当归5分，僵蚕（炒）5分，川芎3分，荆芥3分，枣仁（炒）7分，甘草（炙）2分。";
  ex:hasUsage "水煎服。" .

<medicine:灵宿丹> a ex:Medicine;
  ex:hasAlias "灵宿丸";
  ex:hasFunction "大补益、强心志，壮筋骨，益气血，调营卫，补骨髓，固元阳，黑髭鬓，去诸风，除冷痰，明耳目。主治脚腰，及五劳七伤，诸风冷气。";
  ex:hasName "灵宿丹";
  ex:hasPreparation "上为末，用浸药酒调山芋末煮糊，更入酥、蜜各1两，和药为丸，如梧桐子大。";
  ex:hasPrescription "菟丝子（酒浸1宿，别捣末）5两，覆盆子3两（酒浸，焙），槟榔（煨）2两，牛膝（去苗，酒浸，切，焙）2两，肉苁蓉（去皴皮，酒浸，切，焙）2两，天麻（酒浸，锉，焙）2两，熟干地黄（酒浸3月，焙干）2两，鹿茸1对（涂酥炙），桂（去粗皮）1两，巴戟天（紫者，去心）1两，附子（炮裂，去皮脐）1两，石斛（去根）1两，青橘皮（去白，焙）1两，楮实（炒）1两，茴香子（微炒）1两，白龙骨（研碎）1两，杜仲（去粗皮，切，炒）1两，补骨脂（微炒）1两，葫芦巴1两，石韦（去毛）1两，枸杞子1两，远志（去心）1两，五味子（炒）1两，沉香（锉）1两，蛇床子（炒）1两，山茱萸1两，萆薢1两，山芋（捣末）1两。";
  ex:hasUsage "灵宿丸（《普济方》二二五）。" .

<medicine:灵应丸> a ex:Medicine;
  ex:hasFunction "内外障眼。";
  ex:hasName "灵应丸";
  ex:hasPreparation "用多年粟米饮为丸，如梧桐子大。";
  ex:hasPrescription "黄连（大者）2两，蕤仁2两，太阴元精石（阴阳火煅）1两，石决明1两，草决明1两，羊子肝7个（去膜，竹刀切）。";
  ex:hasUsage "每服20丸，临卧时用腊茶吞下。翳膜厚者不过1月，近者不过10日。服至7日，烙顶以助药。" .

<medicine:灵应丹> a ex:Medicine;
  ex:hasFunction "卒中风邪，涎潮不利；小儿惊风；瘫痪；四肢不举；风痹。";
  ex:hasName "灵应丹";
  ex:hasPreparation "上为细末，以麻黄膏为丸，如弹子大。";
  ex:hasPrescription "麻黄5斤（去根节，锉1寸，取河水5斗，以无油腻锅煮至1斗已来，漉去麻黄，冷定，用细罗子滤去滓，取清者，锅内再熬成膏，熬时要勤搅，勿令着底焦），白芷2两，桑白皮2两，苍术2两，甘松2两，浮萍2两，川芎3两，苦参3两。";
  ex:hasUsage "每服1丸，温酒化下，临卧服，隔2-3日再服。手足即时轻快。" .

<medicine:灵应必消散> a ex:Medicine;
  ex:hasAlias "灵应必效散";
  ex:hasFunction "一切痰核，无名肿毒。";
  ex:hasName "灵应必消散";
  ex:hasPreparation "上为细末，和匀，再研极细，瓷瓶收贮。";
  ex:hasPrescription "草乌5钱，川乌5钱，白芷5钱，花椒1钱，山奈3钱，麝香4分，贝母3钱，大黄3钱，蟾酥1钱（晒研）。";
  ex:hasUsage "未成者掺于膏上贴之。" .

<medicine:灵应愈风丹> a ex:Medicine;
  ex:hasFunction "气血虚亏，风邪所伤，筋骨酸痛，肢体麻木，手足不遂，诸风瘫痪。";
  ex:hasName "灵应愈风丹";
  ex:hasPreparation "上研细末，炼蜜为丸。";
  ex:hasPrescription "明天麻6两，杜仲7两，大熟地16两，全当归16两，肉桂3两，乌元参6两，独活5两，怀牛膝6两，川萆薢6两，羌活14两，大生地16两。";
  ex:hasUsage "每服3钱，开水送下。" .

<medicine:灵应散> a ex:Medicine;
  ex:hasFunction "一切咳嗽，不问久新、轻重。";
  ex:hasName "灵应散";
  ex:hasPreparation "上为细末，入钟乳粉、轻粉同研令匀。";
  ex:hasPrescription "钟乳粉1两，款冬花1两，枯白矾1两，甘草半两（炙），轻粉1钱，桂6钱。";
  ex:hasUsage "每服半钱。用匙挑入喉中，咽津，随用茶清压下。每日临卧只1服。小儿或以糖少许和服。" .

<medicine:灵应痧药> a ex:Medicine;
  ex:hasFunction "中暑昏厥，呕吐泄泻，腹中绞痛，胸满腹胀。";
  ex:hasName "灵应痧药";
  ex:hasPreparation "共轧细面，水发蟾酥为丸，朱砂为衣。";
  ex:hasPrescription "茅苍术22两，天麻25两，丁香4两2钱，麻黄27两，川军42两，甘草24两，蟾酥7两，雄黄24两，麝香2两，冰片2两。" .

<medicine:灵应膏> a ex:Medicine;
  ex:hasFunction "消肿定痛。主诸般疮疖。";
  ex:hasName "灵应膏";
  ex:hasPreparation "上件除没药、乳香、黄丹、僵蚕外，将余药入油内，熬令诸药赤黑色，然后滤去诸药。次将没药等四味研令极细，徐徐下入油内，用槐、柳枝各十条，长五六寸，不住搅之，渐加火，熬令滴入水中不散，成膏子为度。";
  ex:hasPrescription "蓖麻子（去壳，研）1两，当归（洗，焙，切）1两，木鳖子（去壳，研）1两，郁金（锉）1两，香白芷（锉）1两，草乌头（炮制，去皮脐）1两，甘草（锉，炒）1两，大黄（锉）1两，赤芍药（锉）1两，自然铜（火煅，醋淬，研）1两，白僵蚕（取末）1两，苏枋木（锉）1两，白及（锉）1两，白蔹（锉）1两，黄丹6两，乳香（别研）1钱，没药（别研）1钱，麻黄（去根节）半两，天南星（锉）半两，沥青（别研）半两，定粉（别研）半两，葱白10茎，麻油2斤。";
  ex:hasUsage "每遇患者，量痈肿大小，摊在纸花上贴之，日易1次。" .

<medicine:灵应饮> a ex:Medicine;
  ex:hasFunction "潮热。";
  ex:hasName "灵应饮";
  ex:hasPrescription "茯神2钱，小柴胡2钱，人参2钱，生地2钱，银柴胡2钱，黄芩2钱，知母1钱，麦门冬1钱。";
  ex:hasUsage "加大枣5枚，水煎，临服加童便1杯。" .

<medicine:灵异膏> a ex:Medicine;
  ex:hasClinicalApplication "毒疽：一县尹腿患毒疽，屡治不愈，后得此膏，一贴即愈。";
  ex:hasFunction "毒疽。";
  ex:hasName "灵异膏";
  ex:hasNote "勿用铁锅煎。";
  ex:hasPreparation "麻油6斤浸药，入乱发3两熬焦黑色，发化尽去滓再熬，滴水成珠下丹，收膏停火，下乳香等细药。再候少温下轻粉、麝香、黄白蜡溶化，入水中出火毒，瓷瓶收用。";
  ex:hasPrescription "防风2两，栀子2两，黄芩2两，当归2两，生地（忌铁器）2两，甘草2两，苦参2两，金银花2两，大黄2两，海风藤2两，赤芍2两，黄柏2两，连翘2两，荆芥2两，白蒺藜2两，槐枝2两，何首乌（忌铁器）1两，牛蒡子1两，白芷1两，杏仁1两，地榆1两，木通5钱，川芎5钱，山豆根5钱，苍术5钱，独活5钱，羌活5钱，蜂房5钱，蝉蜕5钱，僵蚕5钱，白及5钱，白蔹5钱，麻黄5钱，丹皮5钱，乳香2两，没药1两，血竭1两，海螵蛸1两，孩儿茶1两，龙骨1两，赤石脂2两，麝香2钱，樟脑5钱，轻粉5钱，黄蜡5钱，白蜡5钱，黄丹（水飞过，净）3斤。";
  ex:hasUsage "每用时先以冷水洗疮，挹干，敷药在疮上，外用白纸贴之。汤烫火烧不须水洗。" .

<medicine:灵感丸> a ex:Medicine;
  ex:hasFunction "虚劳积聚，腹胁坚满；男子、妇人一切风劳冷气，头旋眼疼，手脚（？？）痹；血风劳气，攻击五脏四肢，筋脉掉动，面上习习似虫行；遍生疮癣；心膈烦闷，腹痛虚鸣，腰疼膝冷，手足或冷或热；诸气刺痛，呕逆醋心，肠胃秘涩，肺气发动，耳复虚鸣，脚膝无力；仍治妇人病，冷血劳气，发损面黄，气刺心腹，骨筋酸痛，经脉不调，经年逾月，或下过多不定；兼治冷热诸痢，脚气水肿等。";
  ex:hasName "灵感丸";
  ex:hasPreparation "上为末，炼蜜为丸，如梧桐子大。";
  ex:hasPrescription "柴胡（去苗）半两，防风（去又）半两，紫菀（去苗土）半两，当归（切，焙）半两，人参半两，赤茯苓（去黑皮）半两，干姜（炮裂）半两，桔梗（炒）半两，菖蒲半两，乌头（炮裂，去皮脐）半两，厚朴（去粗皮，生姜汁炙，锉）半两，大黄半两，吴茱萸（汤洗，焙干）半两，皂荚（去皮子、酥炙）半两，蜀椒（去目并闭口，炒出汗）半两，陈橘皮（去白，炒）半两，郁李仁（别研）半两，黄连（去须，炒）半两，巴豆半两（去油，研）。";
  ex:hasUsage "每服5丸，空心酒饮送下，取微利为度。如风冷气人，长服此药最佳。又宜夜服。" .

<medicine:灵感膏> a ex:Medicine;
  ex:hasFunction "百病及疮毒。";
  ex:hasName "灵感膏";
  ex:hasPreparation "用香油6斤，入药浸3-5日，煎枯去滓，将净油熬至滴水成珠，加密陀僧细末4两，飞过黄丹2斤4两，熬至不老不嫩，收贮，合在地上出火3-5日。";
  ex:hasPrescription "大黄1两，生地1两，防风7钱，三棱1两，羌活8钱，白芷8钱，花粉7钱，蜈蚣10条，桃仁7钱（研末），香附7钱，厚朴7钱，槟榔7钱，黄柏8钱，大戟8钱，蓖麻子2两（研），蛇蜕5钱，杏仁7钱（研），皂角8钱，巴豆8钱（研），肉桂8钱，麻黄8钱，细辛7钱，黄连5钱，甘遂2两，木鳖子1两（研），莪术1两，川乌1两，枳实8钱，独活7钱，穿山甲7钱，全蝎7钱，当归1两5钱，草乌1两，元参7钱，五倍子7钱。";
  ex:hasUsage "随病摊贴。" .

<medicine:灵效丸> a ex:Medicine;
  ex:hasFunction "男子妇人痛风。";
  ex:hasName "灵效丸";
  ex:hasPreparation "上为细末，用糯米糊为丸，如梧桐子大。";
  ex:hasPrescription "锡磷脂（甘锅内煅通红）1两，白胶香（好明净者，研）1两，五灵脂（如沥青成块者）1两，当归（洗净，去芦）1两，白附子1两，没药1两，香白芷1两，草乌头（去尖）1两，糯米（炒令黄色）1两，桑柴灰（须是纯桑木烧，它木不可杂）1两。";
  ex:hasUsage "每服30-40丸，空心，临卧温酒送下。" .

<medicine:灵效散> a ex:Medicine;
  ex:hasFunction "妊娠尿血，比崩漏更甚。";
  ex:hasName "灵效散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "当归1两，生地1两，赤芍6钱，川芎6钱，山栀6钱，血余（煅存性）3钱，升麻3钱，龙骨3钱（煅，黄芩水浸），艾叶5钱。";
  ex:hasUsage "每服2钱，空心童便送下。" .

<medicine:灵明散> a ex:Medicine;
  ex:hasFunction "麻疯。";
  ex:hasName "灵明散";
  ex:hasPreparation "上为末，用皂角煎膏为丸。";
  ex:hasPrescription "槟榔1两，大黄1两，贯众1两，黑丑（半生熟）1两，雷丸5钱半，皂刺（灰）1钱5分，大戟1钱5分。";
  ex:hasUsage "每服3钱，空心冷茶送下，天明泻下。或虫或积。但见青黄赤白虫可治，黑虫难治，用净盆小便看之，如碎麸皮相似，过3日后再服。" .

<medicine:灵朱丸> a ex:Medicine;
  ex:hasAlias "灵脂丸";
  ex:hasFunction "小儿食痫，乳食不消，心腹壅滞，四肢抽掣。";
  ex:hasName "灵朱丸";
  ex:hasPreparation "上为细末，烧粟米饭为丸，如黄米大。";
  ex:hasPrescription "五灵脂（去沙石）1分，朱砂（研，水飞）1分，巴豆5枚（去皮心，研，纸裹去油）。";
  ex:hasUsage "灵脂丸（《普济方》卷三七七）。" .

<medicine:灵枢保产黑神丹> a ex:Medicine;
  ex:hasFunction "小产后诸症。";
  ex:hasName "灵枢保产黑神丹";
  ex:hasNote "此丹宜择吉日，净室中修合，一切药用具洁净。";
  ex:hasPreparation "上为极细末，合和研匀，淮麦面粉打糊为丸，金箔为衣，晒极干，如芡实大，丸重1分，外蜡封固。";
  ex:hasPrescription "陈墨1锭（须觅顶上选烟历百十年胶性全脱者，俟天雨时用新净瓷器当空接取洗砚，男子手磨成浓汁，倾入净细大瓷盘中，晒干刮下。每料约用净墨粉4钱，），百草霜2钱（陈者佳），天麻2钱（透明者，切时勿用水泡，研细待用），淮小麦面粉2钱（一半入药，一半为糊丸），大金箔50页（40页入药，余为衣）。";
  ex:hasUsage "证轻者1丸，重者2-3丸，童便或白汤送下。" .

<medicine:灵枣丹> a ex:Medicine;
  ex:hasFunction "走马牙疳并一切口疳。";
  ex:hasName "灵枣丹";
  ex:hasPreparation "上共捣烂，盐泥封固，火煅存性，去泥，为末。";
  ex:hasPrescription "小青虾蟆30个，生矾1钱，南枣（去核）5枚，铜绿1分，麝香3厘。";
  ex:hasUsage "吹患处。" .

<medicine:灵槟散> a ex:Medicine;
  ex:hasFunction "治心脾虫痛。";
  ex:hasName "灵槟散";
  ex:hasPreparation "上药研末。";
  ex:hasPrescription "五灵脂 槟榔各等分";
  ex:hasUsage "每次9克，用菖蒲煎汤送下。隔夜先将猪肉、盐、酱煮熟，令患者细嚼，吐出勿吞，却将前药空腹服之。" .

<medicine:灵水膏> a ex:Medicine;
  ex:hasFunction "白鲛风；疠疡。";
  ex:hasName "灵水膏";
  ex:hasPrescription "树孔中水。";
  ex:hasUsage "温热洗之，然后捣细辛、牡蛎等分为末，以面脂调敷白驳上，日3夜1。" .

<medicine:灵济丸> a ex:Medicine;
  ex:hasFunction "脚气游走两足，转上腰腿疼痛，不能转侧。";
  ex:hasName "灵济丸";
  ex:hasPreparation "上为细末，酒面稀糊为丸，如梧桐子大。";
  ex:hasPrescription "木瓜2两，川乌（炮去皮脐）1两，黄耆（炙）1两，白蒺藜（炒）1两，当归1两，防风1两，萆薢1两，牛膝1两，乌药1两，赤小豆（炒）7钱半，茴香（炒）7钱半，地龙（去土）7钱半，白胶香（另研）7钱半，五灵脂7钱半。";
  ex:hasUsage "每服30-40丸，紫苏煎汤送下。" .

<medicine:灵液丹> a ex:Medicine;
  ex:hasFunction "一切风热，脏腑积热，毒气上攻，胸膈烦躁，口舌干涩，心神壅闷，咽嗌不利，饮食无味。";
  ex:hasName "灵液丹";
  ex:hasPreparation "上为末，入研药令匀，炼蜜为丸，如弹子大。";
  ex:hasPrescription "乌梅（去核，炒）1两，寒水石（火煅，研飞）1两，瓜蒌根1两，石膏（研）1两，葛根1两，赤茯苓1两，麦门冬（去心，焙）1两半，龙脑（别研）1钱。";
  ex:hasUsage "每服1丸，薄绵裹，含化咽津。" .

<medicine:灵犀丹> a ex:Medicine;
  ex:hasFunction "一切诸风，言语謇涩，心神昏愦。";
  ex:hasName "灵犀丹";
  ex:hasPreparation "上为细末，炼蜜为丸，每两作8丸，朱砂2两半为衣。";
  ex:hasPrescription "犀角屑1两，天麻1两，防风1两，川羌活1两，木香1两，吴白芷1两，甘菊1两，白僵蚕（炒）1两，天南星（牛胆制）1两，甘草1两，地骨皮1两，山药1两，薄荷叶1两，川芎1两，蔓荆子1两，麻黄（去根节）1两，当归1两，桂（去粗皮）1两，干蝎梢半两，麝香（别研）2钱，白花蛇（酒浸，去皮骨，焙干）2两。";
  ex:hasUsage "每服1丸，细嚼，人参汤化下；或茶、酒亦得。不拘时候。" .

<medicine:灵犀饮> a ex:Medicine;
  ex:hasAlias "灵犀散";
  ex:hasFunction "小儿骨蒸潮热，盗汗，咳嗽，不食多渴，面黄肌瘦，腹急气粗。";
  ex:hasName "灵犀饮";
  ex:hasPrescription "犀角（镑屑）半两，胡黄连半两，茯苓（去皮）1两，人参（去芦）1两，川芎1两，秦艽1两，甘草1两，羌活1两，柴胡1两，桔梗1两，地骨皮1两。";
  ex:hasUsage "灵犀散（《普济方》卷三八四）。" .

<medicine:灵矾散> a ex:Medicine;
  ex:hasAlias "灵白散";
  ex:hasFunction "小儿虫咬心痛欲绝。";
  ex:hasName "灵矾散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "五灵脂（末）2钱匕，白矾（水飞）半钱匕。";
  ex:hasUsage "灵白散（《医方类聚》卷二五二引《施圆端效方》）。" .

<medicine:灵砂> a ex:Medicine;
  ex:hasFunction "性温无毒，主五脏百病，益精养神，补气明目，安魂魄，通血脉，止烦满，杀邪魅。";
  ex:hasName "灵砂";
  ex:hasNote "忌猪、羊血，绿豆粉、冷滑之物。";
  ex:hasPrescription "水银一斤，硫黄四两。";
  ex:hasUsage "每服三粒，空心，枣汤、米饮、井华水、人参汤任下，量病轻重增至五、七粒。" .

<medicine:灵砂丸> a ex:Medicine;
  ex:hasFunction "小儿风痰惊积至危笃者。";
  ex:hasName "灵砂丸";
  ex:hasPreparation "上为末，水为丸，如黍米大。";
  ex:hasPrescription "南星（泡）5钱，半夏（泡）5钱，巴豆（去壳、酒煮干2次）5钱，全蝎3钱，朱砂（1半入药，1半为衣）3钱，姜蚕（炒）7分，轻粉少许。";
  ex:hasUsage "每服3丸，如惊风，金银汤送下，其余姜汤送下。" .

<medicine:灵砂丹> a ex:Medicine;
  ex:hasAlias "龙虎丹";
  ex:hasFunction "妇人虚证头痛，恶风发热，六脉沉取无根，浮取却有。";
  ex:hasName "灵砂丹";
  ex:hasNote "有孕妇人勿服。";
  ex:hasPreparation "上先以杏仁、巴豆杀研极细，入黄丹研如泥，方入面一匙，滴新水为丸，如黄米大。";
  ex:hasPrescription "灵砂丹。";
  ex:hasUsage "以人参1-2两，银铫煎汤，空心下10粒，五更又下10粒。天明则愈矣。" .

<medicine:灵砂固本丸> a ex:Medicine;
  ex:hasFunction "夺阴阳造化之功，济心肾安养之妙。主真阳虚损，精髓耗伤，肾气不足，面黑耳焦；下虚上盛，头目昏眩，心腹疼痛，翻胃吐逆，劳汗水气，盗汗水气，喘满，全不思饮食；妇人血气，子宫久冷，崩中漏下。";
  ex:hasName "灵砂固本丸";
  ex:hasPreparation "上为细末，酒糊为丸，如梧桐子大。";
  ex:hasPrescription "沉香1两，木香1两，葫芦巴（酒浸）1两，小茴香（炒）1两，川楝肉（炒）1两，八角茴香（炒）1两，菟丝子（酒浸）1两，巴戟（去心，酒浸）1两，牛膝（酒浸）1两，杜仲（炒）1两，钟乳粉（另研）1两，续断（酒浸）1两，交趾桂1两，鹿茸（去皮生用）1两，山药1两，破故纸（酒浸）1两，肉豆蔻（煨，别研）1两，阳起石（水飞）1两，灵砂1两，黑锡丹头2两（与灵砂先研极细，又入前药再碾）。";
  ex:hasUsage "每服30丸，渐加至50丸，空心熬人参汤、枣汤送下，于物压之。妇人同。" .

<medicine:灵砂宁神丸> a ex:Medicine;
  ex:hasAlias "宁神丸";
  ex:hasFunction "补虚益气，滋养荣卫。主男子、妇人大病之后，伤损荣卫。或发汗、吐、下太过，或失血过多之后，精气亏损，不能复常，心神恍惚，不得睡眠，饮食全减，肌体瘦弱，怠堕倦乏，嗜卧无力，四肢酸痛。";
  ex:hasName "灵砂宁神丸";
  ex:hasPreparation "上为细末，次入辰砂研匀，用枣肉和令匀熟，为丸如梧桐子大。";
  ex:hasPrescription "辰砂2两（不夹石，绢袋子盛，于银石器内悬，于器内用椒红3两，取井花水调椒红盛于器内，可7-8分，更用锅子坐，盛朱砂器在内，重汤煮令鱼眼沸。3昼夜为度，取出辰砂研，水飞），人参（去芦头）3两，白术3两，茯神（去木）3两，鹿茸（燎去毛，涂酥炙令黄）3两，黄耆（蜜炙）3两，石菖蒲2两。";
  ex:hasUsage "宁神丸（《普济方》卷二一八）。本方方名，《永类钤方》引作“灵砂宁志丸”。" .

<medicine:灵砂安神丸> a ex:Medicine;
  ex:hasFunction "癫痫。兼治心肾不交，怔忡恍惚，忘事，惊悸恐怖，吐血，劳瘵，怯弱。";
  ex:hasName "灵砂安神丸";
  ex:hasPreparation "上为末，炼蜜为丸，如梧桐子大，灵砂为衣。";
  ex:hasPrescription "灵砂1两（一半留为衣），茯神（乳制）2两，远志2两，枣仁（炒）2两，生地2两，麦冬2两，石菖蒲2两，熟地2两，天冬2两，熊胆8钱。";
  ex:hasUsage "每服50丸，酒送下。" .

<medicine:灵砂归命丹> a ex:Medicine;
  ex:hasFunction "小儿蕴积邪热，潮热不除，颊赤口干，心膈烦躁，痰涎不利，睡卧不安，或发惊痫，涎潮搐搦。积滞不消，下利多日，腹中（疒丂）痛，烦渴呕秽，服药调和不能愈者。";
  ex:hasName "灵砂归命丹";
  ex:hasPreparation "上合研匀，炼黄蜡6两，入白沙蜜3分，同炼令匀，为丸如绿豆大。";
  ex:hasPrescription "巴豆（去心膜皮，炒熟，研如面油）315粒，牛黄（研）3两，龙脑（研）3两，麝香（研）3两，腻粉（研）3两，辰砂（研飞）9两，金箔（研）90片。";
  ex:hasUsage "每服2丸，金银薄荷汤下。更量岁数加减。如惊痫搐搦，用龙脑、腻粉、蜜汤送下。服药先以冷水浸少时，服之见效尤速。" .

<medicine:灵砂救命丹> a ex:Medicine;
  ex:hasFunction "小儿急、慢惊风，身热涎盛，目睛上视，牙关紧急，频发搐搦，或吐利生风，手足瘛疭，哽气神昏。";
  ex:hasName "灵砂救命丹";
  ex:hasPreparation "上为细末，次入研药和匀，用前五灵脂膏子为丸，每1两作40粒。";
  ex:hasPrescription "五灵脂1两（米醋浸化，去沙石，慢火熬成膏），羌活（去芦头）半两，蔓陀罗花4枚，天麻（酒浸，焙干）2钱，乌蛇尾（酒浸，取肉焙干）2钱，滑石（别研）2钱，钩藤2钱，白附子（炮）2钱，防风（去芦头）2钱，零陵香2钱，天南星（炮）2钱，白僵蚕（炒，去丝嘴）10枚，全蝎（去毒）10枚，刚子（去壳取虫）10枚，蝉蜕10枚，麝香1钱（别研），朱砂（别研）半钱，血竭（别研）半钱，乳香（别研）半钱。";
  ex:hasUsage "每服1粒，急惊加龙脑少许，煎薄荷汤磨化下；慢惊加麝香少许，煎荆芥汤磨化，入酒2-3点同调下，不拘时候。" .

<medicine:灵砂散> a ex:Medicine;
  ex:hasFunction "妇人经闭血块。";
  ex:hasName "灵砂散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "砂仁1两，五灵脂（焙干）1两。";
  ex:hasUsage "每服2钱，黄酒送下。" .

<medicine:灵砂明粉散> a ex:Medicine;
  ex:hasAlias "灵砂玄明粉";
  ex:hasFunction "翻胃隔食，肠结呕吐。";
  ex:hasName "灵砂明粉散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "元明粉5钱，灵砂1钱。";
  ex:hasUsage "灵砂玄明粉（《医统》卷二十八）。《医统》本方用法：拌豆腐下毕，饮酒一杯。" .

<medicine:灵砂白丸子> a ex:Medicine;
  ex:hasAlias "灵白丸";
  ex:hasFunction "元气虚弱，痰气上攻，风痰潮塞，呕吐不止。";
  ex:hasName "灵砂白丸子";
  ex:hasPreparation "上为末，和匀，以生姜汁煮秫米糊为丸，如梧桐子大。";
  ex:hasPrescription "灵砂（研细）1两，青州白丸子1两。";
  ex:hasUsage "灵白丸（《得效》卷十二）。" .

<medicine:灵砂酒> a ex:Medicine;
  ex:hasFunction "疹疮黑陷不起。";
  ex:hasName "灵砂酒";
  ex:hasPrescription "灵砂。";
  ex:hasUsage "以好酒磨化3-5粒服。" .

<medicine:灵砂黑虎丹> a ex:Medicine;
  ex:hasFunction "杨梅疮后，头如破裂之疼痛，筋骨拘挛，痛不可忍，或起冷痰包，脓水淋漓；兼治阴结毒，一切湿痰，久不收口之疮。";
  ex:hasName "灵砂黑虎丹";
  ex:hasNote "忌吃热汤水，宜吃大荤，以免嘈杂。";
  ex:hasPreparation "上为极细末，和匀，用小红枣4两，煮熟去皮核，同捣为丸，如豌豆大。";
  ex:hasPrescription "白砒3钱（将砒用绿豆水煮过，入罐内升5炷香，取出以白萝卜同煮过，入药），寒水石（煅）3钱，百草霜3钱，金头蜈蚣2条（焙），大黑豆120粒，冰片1分，麝香1分。";
  ex:hasUsage "每服2丸，冷水或茶送下，日3次。服是药，口、眼胞肿则药力到矣，缓1日再服。其黑豆生用，冷水泡软，去皮捣碎，加红枣肉，丸得起便罢，不必多，或加西黄2-3分更妙。凡结毒顽疮，先服五宝丹或八宝丹，必用此药收功，永远不发。" .

<medicine:灵神膏> a ex:Medicine;
  ex:hasFunction "小儿急惊风。";
  ex:hasName "灵神膏";
  ex:hasPreparation "上为末，蜜和作小饼子。";
  ex:hasPrescription "赤茯神1两，朱砂1两，麦门冬5钱，麝香2钱半。";
  ex:hasUsage "每1饼临睡前以薄荷汤化下。" .

<medicine:灵秘丹药> a ex:Medicine;
  ex:hasFunction "痔疮。";
  ex:hasName "灵秘丹药";
  ex:hasPrescription "片脑1分，朴消5分，熊胆2分，蜗牛1两，螺肉1两，橄榄炭5钱。";
  ex:hasUsage "捣烂，水浸1夜，取水并药敷痔上。" .

<medicine:灵秘散> a ex:Medicine;
  ex:hasFunction "血潜。";
  ex:hasName "灵秘散";
  ex:hasPreparation "上为末，和匀。";
  ex:hasPrescription "粪桶箍（煅灰）3钱，胎发（煅灰）1钱，煮酒饼上纸（煅）2钱。";
  ex:hasUsage "掺上即止，再服犀角地黄汤。" .

<medicine:灵脂丸> a ex:Medicine;
  ex:hasFunction "小儿慢惊，痰盛抽搐。";
  ex:hasName "灵脂丸";
  ex:hasPreparation "上为末，米醋煮生半夏糊为丸，如麻子大。";
  ex:hasPrescription "五灵脂（香润者）1分，白附子（略炮）1分，木香1分，直僵蚕（炒）1分，全蝎（焙）半分，朱砂1钱，大南星（湿纸炮）半两。";
  ex:hasUsage "每服3丸，姜汤送下。" .

<medicine:灵脂丹> a ex:Medicine;
  ex:hasFunction "因暑月引饮水多，取凉熟睡，停积成饮，或遇湿风流注，为之支饮，手足或时少力，指节间疼，屈伸不快；或有痰食，甚则及于膝足，或麻或弱。";
  ex:hasName "灵脂丹";
  ex:hasPreparation "上为细末，和匀，以半夏末半两，水煮薄糊为丸，如梧桐子大。";
  ex:hasPrescription "五灵脂1两，桂心1两，威灵仙1两，白茯苓1两，细辛（去叶）1两，牡丹皮（去心）1两。";
  ex:hasUsage "每服23粒，生姜汤送下，不拘时候。" .

<medicine:灵脂厚朴散> a ex:Medicine;
  ex:hasFunction "心头痛欲死，不可忍者。";
  ex:hasName "灵脂厚朴散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "灵脂、良姜、厚朴（姜汁炒）各等分。";
  ex:hasUsage "每服1钱，醋汤送下，即止。" .

<medicine:灵脂散> a ex:Medicine;
  ex:hasFunction "急心痛。";
  ex:hasName "灵脂散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "灵脂、玄胡、莪术、良姜、当归各等分。";
  ex:hasUsage "醋煎服。" .

<medicine:灵脂酒> a ex:Medicine;
  ex:hasAlias "霹雳酒、五灵脂散、抽刀散";
  ex:hasClinicalApplication "崩漏：有一老媪年八十，崩漏凡数年，得此药，服则病失去。";
  ex:hasFunction "妇人血山崩及丈夫脾积气。";
  ex:hasName "灵脂酒";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "五灵脂不拘多少（新者，烧存3分性，出火毒）。";
  ex:hasUsage "霹雳酒（原书同卷）、五灵脂散（《妇人良方》卷一）、抽刀散（《永类钤方》卷十五）。" .

<medicine:灵脂醋> a ex:Medicine;
  ex:hasFunction "恶血齿痛。";
  ex:hasName "灵脂醋";
  ex:hasPrescription "川五灵脂。";
  ex:hasUsage "以米醋煎汁，含咽。" .

<medicine:灵脾肉桂酒> a ex:Medicine;
  ex:hasFunction "温补肾阳，健脾利湿。主治脾肾两虚，脘腹冷痛，食欲不佳，腰酸体弱。";
  ex:hasName "灵脾肉桂酒";
  ex:hasPrescription "仙灵脾100g 陈橘皮15g 黑豆皮30g 连皮大腹槟榔3枚 豉30g 肉桂30克 生姜3片 葱白3根（切） 黄酒1000ml";
  ex:hasUsage "每次10ml，每日早晚2次，将酒温热服用。" .

<medicine:灵芝丸> a ex:Medicine;
  ex:hasFunction "白发，气血不荣者。";
  ex:hasName "灵芝丸";
  ex:hasPreparation "上为末，炼蜜为丸，如弹子大。";
  ex:hasPrescription "三叶酸1斤（阴干），黑桑椹1斤（晒干）。";
  ex:hasUsage "每服1丸，温酒化下，1日2次。" .

<medicine:灵苑汤> a ex:Medicine;
  ex:hasFunction "卒患诸淋，遗溺不止，小便赤涩疼痛。";
  ex:hasName "灵苑汤";
  ex:hasPrescription "三叶酸浆草（即布谷饭，取嫩者）。";
  ex:hasUsage "上捣汁1合，酒1合，搅匀，空心服之，立通。" .

<medicine:灵苗汤> a ex:Medicine;
  ex:hasFunction "沙淋。";
  ex:hasName "灵苗汤";
  ex:hasPrescription "瓦松（即屋上无根种草是也）。";
  ex:hasUsage "上捣细、浓煎汤，乘热熏洗小腹，约两时辰即通。" .

<medicine:灵草丹> a ex:Medicine;
  ex:hasAlias "浮萍丸";
  ex:hasFunction "一切风疾及瘾疹、紫白癜风，痛痒顽麻；及脚气，打扑伤损，浑身麻痹。";
  ex:hasName "灵草丹";
  ex:hasPreparation "摊于竹筛内，下着水，晒干，为细末，炼蜜为丸，如弹子大。";
  ex:hasPrescription "紫背浮萍草。";
  ex:hasUsage "浮萍丸（《济阳纲目》卷八十四）。" .

<medicine:灵草洗药方> a ex:Medicine;
  ex:hasFunction "久新痈疽，发背疖毒。";
  ex:hasName "灵草洗药方";
  ex:hasPrescription "白茅嘴根、紫背乌柏根、三白草、索草根、白毛桃、水杨柳根、毛狗脊、穿山蜈蚣、班（木尚）根、乌枹根、乳枹根、青木香、赤葛根、铁菱角、白马骨、老茶、臭桐叶、三角枫、隔山叫、回封草、乌茶。";
  ex:hasUsage "煎水熏洗，后用敷药。" .

<medicine:灵药方> a ex:Medicine;
  ex:hasFunction "杨梅疮。";
  ex:hasName "灵药方";
  ex:hasPreparation "上为细末，入阳城罐内，用铁盏合好，盐卤和泥封好，以铁丝扎紧，用银炭10斤，先文后武火，升3炷香为度。取起，冷定，开看，取铁盏上药约重2两7钱。如杨梅疮烂喉者，用灵药5分，加人中白、青黛各8分，乳香、没药各5分、冰片2分，麝香1分，药珠1分5厘，共研细末，吹入喉内，一日5-6次，三日即全愈；如烂嘴鼻，再加龙骨、象皮、血竭、儿茶各5分，琥珀2分，研细。";
  ex:hasPrescription "水银1两，劈朱砂5钱，明雄黄5钱，硫黄3钱，白矾1钱。";
  ex:hasUsage "掺之，外以清凉拔毒膏贴之。" .

<medicine:灵豆膏> a ex:Medicine;
  ex:hasFunction "小儿发疟不止。";
  ex:hasName "灵豆膏";
  ex:hasPreparation "同湿纸裹煨熟，一处研为膏，为丸如麻子大。";
  ex:hasPrescription "大蒜1枚（去皮研），巴豆3升（去皮心）。";
  ex:hasUsage "每服2、3、5丸，醋汤送下。吐泻即愈。" .

<medicine:灵通万应丹> a ex:Medicine;
  ex:hasAlias "平安如意丹、灵宝如意丹";
  ex:hasFunction "老幼、男女百病，中暑头晕眼黑，恶心头痛；霍乱吐泻，手足厥冷，转筋、顺逆；绞肠痧，胃气痛，喉风喉痹，疟、痢、瘟疫，斑痧；中风痰厥、不省人事，小儿初生，脐风撮口，急惊、牙痛，走马疳，恶毒疔疮。蛇蝎虫伤，狗咬，溢溺、跌打、惊魔、山岚瘴气，一切秽气。";
  ex:hasName "灵通万应丹";
  ex:hasNote "虚损及孕妇忌服。服药后停茶、酒、饭1-2时。";
  ex:hasPreparation "上为细末，以蟾酥烧酒浸化，泛为丸，如莱菔子大，朱砂为衣。";
  ex:hasPrescription "真蟾酥（舐之舌即麻者真）2两，茅术（小而有朱点者，米泔浸，炒焦黄）3两，明天麻（蒸、晒）3两6钱，麻黄（去根节、晒）3两6钱，明雄黄（水飞）3两6钱，朱砂（水飞）3两6钱，锦纹大黄（晒）6两，甘草（去皮）2两4钱，丁香（不拘公母）6钱，麝香3钱（1方加犀黄3钱）。";
  ex:hasUsage "平安如意丹（原书同卷）、灵宝如意丹（《经验方》卷下）。" .

<medicine:灵速散> a ex:Medicine;
  ex:hasFunction "一切头痛。";
  ex:hasName "灵速散";
  ex:hasPrescription "细茶1两（水二钟，煎至半钟去滓），白芷3钱，细辛3钱，牙皂3钱，紫苏3钱，薄荷3钱。";
  ex:hasUsage "用茶汤煎7分，食后服。" .

<medicine:灵雨汤> a ex:Medicine;
  ex:hasFunction "土败阳虚，呕吐瘀血，紫黑成块。";
  ex:hasName "灵雨汤";
  ex:hasPrescription "甘草2钱，人参2钱，茯苓3钱，半夏3钱，干姜3钱，柏叶3钱，丹皮3钱。";
  ex:hasUsage "煎大半杯，温服。" .

<medicine:灵雪丹> a ex:Medicine;
  ex:hasFunction "秘精不泄。主遗精。";
  ex:hasName "灵雪丹";
  ex:hasPreparation "共研，碗盛、纸糊口，用细锥纸上密刺小孔，另用碟覆碗上，碗边宽实余半指，黑豆面固济，沙锅底铺粗沙，加水，坐碗沙上，出水一寸。炭火煮五香，水耗，常添热水，待水冷取出，入麝香少许，研细，蟾酥少许，人乳浸化。葱涕、官粉、炼蜜为丸，如绿豆大，瓷瓶封收，津水研半丸，掌上涂玉尘头，约1两时，尘顶苏麻，便是药力透彻。";
  ex:hasPrescription "甘草3钱，薄荷3钱，甘遂3钱，潮脑3钱，阳起石3钱，紫苏叶3钱。";
  ex:hasUsage "若遗泄不止，势在危急，先炼此药，封之日落，研涂，一夜不走，肾精保固，徐用汤、丸。" .

<medicine:灵霜丸> a ex:Medicine;
  ex:hasFunction "瘅疟时发，大渴，寒热不定。";
  ex:hasName "灵霜丸";
  ex:hasNote "忌热物。";
  ex:hasPreparation "上为细末，入研药令匀，炼蜜为丸，如梧桐子大。";
  ex:hasPrescription "砒霜半两，绿豆半两，川大黄1两，麝香1分。";
  ex:hasUsage "夜露1宿。发日平旦以冷水送下1丸，临发前再服1丸。" .

<medicine:灵飞散> a ex:Medicine;
  ex:hasFunction "脚气冲心闷极者。脚气发时，或肿或咳，不头痛，不嗽逆，心间妨闷，上气急促者尤宜服之。";
  ex:hasName "灵飞散";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "干蝎（全者，炒）1两，硇砂（去夹石者，生用）3分，巴戟天（去心）1两，阳起石（研细）3分，真珠（捣研）半两，木香半两，附子（炮裂，去皮脐）半两，芫花（醋炒）3两半，青橘皮（汤浸，去白，焙）半两，硫黄（研）半两，阿魏（研）1分，磁石（煅赤，淬7遍，研）2两。";
  ex:hasUsage "每服1钱匕，空心热酒调下，良久以饭压之，至午食前再服，不拘时候。" .

<medicine:灵香丸> a ex:Medicine;
  ex:hasFunction "心胃痛。";
  ex:hasName "灵香丸";
  ex:hasPreparation "上为末，于六月六日修合，水泛为丸。";
  ex:hasPrescription "白胡椒、枳壳、白檀香、红花、五灵脂（去沙）、广木香。";
  ex:hasUsage "每用7丸，噙化。少顷痛即止。" .

<medicine:灵验疥疮药饼> a ex:Medicine;
  ex:hasFunction "疥疮。";
  ex:hasName "灵验疥疮药饼";
  ex:hasPreparation "上为细末，烊化猪、烛油，乘温调药作饼7个。";
  ex:hasPrescription "蛇床子4钱，大风子肉4钱，蜡烛油4钱，净江子肉1钱5分，洋樟2钱，油桃肉3枚，明矾7钱，血竭2钱，猪油1两。";
  ex:hasUsage "每日用1饼，贴扎胸前，逐日更换，用完即愈，扎手背上亦可。" .

<medicine:灵验白浊丸> a ex:Medicine;
  ex:hasFunction "白浊。";
  ex:hasName "灵验白浊丸";
  ex:hasPreparation "上为末，鸡蛋清为丸，如梧桐子大。";
  ex:hasPrescription "海金沙1两，甘草1两，滑石1两，生大黄1两，黄柏1两，琥珀1钱。" .

<medicine:灵黍汤> a ex:Medicine;
  ex:hasFunction "和养脾胃。主";
  ex:hasName "灵黍汤";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "大麦半升（炒黄），小麦半升（炒黄），甘草2两，盐4两，干生姜6两，肉豆蔻2个，草豆蔻2个。";
  ex:hasUsage "每服2钱，白汤点服，不拘时候。" .

<medicine:灵鼠膏> a ex:Medicine;
  ex:hasFunction "去痛。主疮肿。";
  ex:hasName "灵鼠膏";
  ex:hasPreparation "浑用清油1斤，慢火煎鼠焦，于水上试油不散，即以绵滤，去滓澄清，重拭铫子令净，以慢火煎上件油，次下黄丹5两，炒令色变，柳木篦子不住手搅令匀，再于水上试滴，候凝，即下黄腊1两，又熬带黑色方成膏。然后贮于瓷盒中，放在土地上，出火毒2-3日。";
  ex:hasPrescription "大黄鼠1枚。";
  ex:hasUsage "敷贴疮肿。" .

<medicine:灵龙丹> a ex:Medicine;
  ex:hasFunction "一切风疾，卒中潮搐，口噤不语，舌强脚弱，鹤膝瘫痪，半身不遂，偏风口眼斜。";
  ex:hasName "灵龙丹";
  ex:hasPreparation "上为细末，入诸别研药拌和，以辰年辰月辰日辰时取辰方上野水搜做小阿胶片，风干。";
  ex:hasPrescription "五灵脂（去沙）7两（别研），草乌头（生，去皮尖）半两，木鳖子（新者，去壳）2两（别研），白胶香（别研）半两，地龙（去土）半两，乳香半两（别研），麝香1钱（别研）。";
  ex:hasUsage "每有患者，以1片分作3服，用酒磨下；卒中急风，以白矾1小块研末，用童便同酒磨下；或口噤灌少许入鼻中，待口开1时灌尽；小儿惊风，分作6服，薄荷汤入酒化下；手足疼痛，薄荷酒下，或姜汁磨涂患处；如治牙痛，以少许塞之。" .

<medicine:灵龟散> a ex:Medicine;
  ex:hasFunction "小儿扑坠，内有伤损。";
  ex:hasName "灵龟散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "当归（去芦，洗净）3分，白芷半两，漏芦（去芦）半两。";
  ex:hasUsage "每服1钱，食前温酒调下。" .

<medicine:灵龟散血汤> a ex:Medicine;
  ex:hasFunction "妇人升高坠下，或闪跌受伤，以致恶血下冲，有如血崩。";
  ex:hasName "灵龟散血汤";
  ex:hasPrescription "败龟版1两，生地1两，大黄1钱，丹皮3钱，红花2钱，桃仁14个。";
  ex:hasUsage "水煎服。1剂轻，2剂愈。" .

<medicine:灸疮膏> a ex:Medicine;
  ex:hasFunction "灸疮。";
  ex:hasName "灸疮膏";
  ex:hasPreparation "上药用真麻油1斤半浸3日，熬枯去滓，入铅粉12两收成膏。";
  ex:hasPrescription "当归2两，川芎2两，芍药2两，白芷2两，细辛1两，头发1两。";
  ex:hasUsage "摊贴。" .

<medicine:炉倍油膏> a ex:Medicine;
  ex:hasFunction "湿疹。";
  ex:hasName "炉倍油膏";
  ex:hasPrescription "炉甘石9g，五倍子9g，冰片3g，黄连15g。";
  ex:hasUsage "上为细末，油调成膏。外用。" .

<medicine:炉功眼膏> a ex:Medicine;
  ex:hasFunction "收敛消炎。主各种睑缘炎。";
  ex:hasName "炉功眼膏";
  ex:hasPreparation "十大功劳根茎50g，加水500毫升，煎成浓汁，去滓后加炉甘石粉成为浓糊状，干燥成散剂；然后取此散剂30g，加凡土林60g，羊毛脂10g，调匀成眼膏。";
  ex:hasPrescription "炉甘石、十大功劳。";
  ex:hasUsage "涂于眼缘，1日2次。" .

<medicine:炉峰散> a ex:Medicine;
  ex:hasFunction "痈疽肿毒。";
  ex:hasName "炉峰散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "炉甘石（绿者，10分细）1两，大南星半两，半夏（生）半两，五倍子4钱，赤小豆4钱，片姜黄4钱，直僵蚕4钱，贝母4钱，白及4钱，乳香2钱半。";
  ex:hasUsage "未破者酸醋调敷；已溃者，清蜜调敷；半干湿只掺；若红肿多汁，生地黄研汁调敷，仍煎苦参、桑白皮汤淋。" .

<medicine:炉消散> a ex:Medicine;
  ex:hasFunction "破血散瘀。主睑球粘着，翼状胬肉。";
  ex:hasName "炉消散";
  ex:hasNote "不要涂在黑眼珠上。";
  ex:hasPreparation "上药用纱布包煎，混合两次滤液，浓缩成稠状；另以炉甘石12两、火消1两9钱2分、冰片2钱4分分别研细，再混入煎剂内调匀即得。";
  ex:hasPrescription "羌活7两2钱，黄芩7两2钱，菊花7两2钱，蔓京7两2钱，川芎4两8钱，白芷4两8钱。";
  ex:hasUsage "每次挑药如米粒大小，涂于胬肉或睑球粘着之患处，闭目半小时即可洗去，1日1-2次。" .

<medicine:炉灰膏> a ex:Medicine;
  ex:hasFunction "除瘤点痣。主一切无名肿毒，恶疮及外痔瘰疬，气粟。";
  ex:hasName "炉灰膏";
  ex:hasNote "好肉及眼上忌用。";
  ex:hasPreparation "上前2味以竹箕子盛贮，用滚汤3碗慢慢淋自然汁1碗许，铜锅盛，慢火熬如稀糊，先下巴豆末，次下蟾酥、白丁香末、炒石灰，搅匀再熬如干面糊，取起候冷，以瓷罐盛贮，勿令泄气。";
  ex:hasPrescription "响糖炉内灰1升半，风化石灰1升（炒红），巴豆2钱，蟾酥2钱，白丁香末5分，炒石灰1钱。";
  ex:hasUsage "每用时，以簪头挑少许放指甲上研，口呵气调匀如泥，将患处用针拨开，以药点之，有脓者溃，无脓者就散。" .

<medicine:炉甘丹> a ex:Medicine;
  ex:hasFunction "拔毒止痛。治下疳。";
  ex:hasName "炉甘丹";
  ex:hasPreparation "上药各研极细，和匀，密贮。";
  ex:hasPrescription "上炉甘石（煅，黄连汤淬三四次，拣净，研细，水飞，漂）60克 上血竭15克 海螵蛸（去背）15克 真轻粉12克 乌芋粉60克 漂牡蛎粉30克";
  ex:hasUsage "掺患处。" .

<medicine:炉甘石干眼药> a ex:Medicine;
  ex:hasFunction "诸病眼，翳膜昏痛。";
  ex:hasName "炉甘石干眼药";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "炉甘石（烧3次，红取为末）1两，青盐3钱，黄丹2钱，硇砂1钱，铜绿1钱半，胆矾1钱，轻粉半钱，蕤仁（去皮，取仁研）1钱半，白矾3钱。";
  ex:hasUsage "每点3两箸。" .

<medicine:炉甘石散> a ex:Medicine;
  ex:hasAlias "炉脑散";
  ex:hasFunction "一切目疾，不问得疾之因者。";
  ex:hasName "炉甘石散";
  ex:hasPreparation "上件和匀。";
  ex:hasPrescription "炉甘石半斤（用黄连4两如豆大，于银石器内煮一伏时，去黄连，取石研），脑子（别研）2钱半。";
  ex:hasUsage "炉脑散（《医学入门》卷八）。《医学入门》治下疳疮，为末干掺。" .

<medicine:炉甘石洗剂> a ex:Medicine;
  ex:hasFunction "消炎，清凉，止痒。主各种急性无渗出性炎症，单纯性皮肤搔痒，热痱等。";
  ex:hasName "炉甘石洗剂";
  ex:hasPreparation "冷开水加至100毫升。充分摇匀后，直接外涂，每日多次。";
  ex:hasPrescription "炉甘石15g，氧化锌5g，甘油5ml。";
  ex:hasUsage "临用前根据需要可配入5%硫磺或1-2%冰片，或1%薄荷。" .

<medicine:炉甘石点眼药> a ex:Medicine;
  ex:hasFunction "大小眦破痒痛。";
  ex:hasName "炉甘石点眼药";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "炉甘石4两（烧过，水飞），黄连末2钱，硼砂1钱，青盐半钱，乳香半钱，黄丹3钱，轻粉，硇砂少许，麝香少许（并研如粉）。";
  ex:hasUsage "柱子点之。" .

<medicine:炉甘石膏> a ex:Medicine;
  ex:hasFunction "眼目昏花，视物不明。";
  ex:hasName "炉甘石膏";
  ex:hasPreparation "上为细末，入黄连水再(石禹)至千万余下，却以蜜炼去白沫，入末同熬成膏；柳条搅不住手，滤净入后膏子和剂；再以黄连研末1两，入水于铜锅煎熬成膏，滤去滓，取净入前蜜药，瓷碗盛放汤瓶口上蒸炖成膏，槐、柳枝一顺搅不住手，互换枝条搅尽，滤净出火毒。";
  ex:hasPrescription "炉甘石1两，代赭石1两，黄丹1两，冬蜜8两，诃子2枚（取末），槐枝49条，柳枝49条。";
  ex:hasUsage "点眼，又以热汤泡化洗眼。" .

<medicine:炉茶散> a ex:Medicine;
  ex:hasFunction "治沿皮蛀疮，以及耳内生瘰，出滋水。";
  ex:hasName "炉茶散";
  ex:hasPreparation "上药共研极细。";
  ex:hasPrescription "煅制炉甘石（童便煅七次）9克 儿茶9克冰片0.3克";
  ex:hasUsage "吹患处。" .

<medicine:炉赤洗剂> a ex:Medicine;
  ex:hasFunction "治药物性皮炎。";
  ex:hasName "炉赤洗剂";
  ex:hasPreparation "上药加水合成100毫升。";
  ex:hasPrescription "炉甘石（黄连水飞）15克 赤石脂粉15克 甘油15毫升";
  ex:hasUsage "外搽患处。" .

<medicine:炊帚散> a ex:Medicine;
  ex:hasFunction "疬疡风，面及项忽生白驳，状如白癣。";
  ex:hasName "炊帚散";
  ex:hasPreparation "上以月蚀夜，伺候正蚀时，都烧之成灰，研令细。";
  ex:hasPrescription "故炊帚半两，甑带半两，履底半两，蛇蜕皮半两。";
  ex:hasUsage "每服，不拘时候，以温酒调服2钱，仍以醋调药如膏，以涂傅驳上即消。" .

<medicine:炊饼丸> a ex:Medicine;
  ex:hasFunction "退实热虚劳湿痰。主积痰。";
  ex:hasName "炊饼丸";
  ex:hasPreparation "炊饼为丸。";
  ex:hasPrescription "鳖甲、龟板、侧柏叶、半夏、瓜蒌仁、黄连、黄柏。" .

<medicine:炒使君子> a ex:Medicine;
  ex:hasFunction "杀虫，消积，健脾。适用于小儿晓虫病，也可用于小儿蛔虫病。";
  ex:hasName "炒使君子";
  ex:hasPreparation "选择个大、颗粒饱满、种仁色黄、味香而带油性的使君子250粒，去壳，取其使君子仁，放入锅内，炒至香脆备用。";
  ex:hasPrescription "使君子250粒";
  ex:hasUsage "用于治疗小儿晓虫，每日6～15粒，分3次于饭前半小时。" .

<medicine:炒姜丸> a ex:Medicine;
  ex:hasFunction "主妊娠两胁胀闷，腹中疼痛，呕逆，不思饮食。";
  ex:hasName "炒姜丸";
  ex:hasPreparation "上药捣罗为末，汤浸蒸饼为丸，如小弹子大。";
  ex:hasPrescription "干姜（炮）桂（去粗皮）木香 沉香 当归（切，焙）甘草（炙）白豆蔻（去皮）白茯苓（去黑皮）青橘皮（汤浸，去白，焙）各15克 芍药（锉）30克 干木瓜 姜黄各15克";
  ex:hasUsage "每服1丸，空腹时细嚼，温酒下。" .

<medicine:炒栀散> a ex:Medicine;
  ex:hasFunction "主胆移热于脑，传为鼻血、汗血，眼目视物不明。";
  ex:hasName "炒栀散";
  ex:hasPreparation "上药炒黑，研为细末。";
  ex:hasPrescription "炒山栀";
  ex:hasUsage "每次6克，白滚水调下。" .

<medicine:炒桃仁方> a ex:Medicine;
  ex:hasFunction "大辟山岚毒气。主治山岚气。";
  ex:hasName "炒桃仁方";
  ex:hasPreparation "上药。同入锅内炒，候桃仁熟为度，以瓷瓶贮密封，7日后取出，去茱萸并盐，只将桃仁去皮尖。";
  ex:hasPrescription "桃仁1斤，吴茱萸4两，青盐4两。";
  ex:hasUsage "时嚼10-20枚。" .

<medicine:炒狼汤> a ex:Medicine;
  ex:hasFunction "暖五脏，温中。主";
  ex:hasName "炒狼汤";
  ex:hasPrescription "狼肉1脚子（卸成事件），草果3个，胡椒5钱，哈昔泥1钱，荜茇2钱，缩砂2钱，姜黄2钱，咱夫兰1钱。";
  ex:hasUsage "上件熬成汤，用葱、酱、盐、醋一同调和服。" .

<medicine:炒米汤> a ex:Medicine;
  ex:hasFunction "除湿，益胃，止烦渴。主";
  ex:hasName "炒米汤";
  ex:hasPrescription "粳米。";
  ex:hasUsage "炒焦，作汤。" .

<medicine:炒米面> a ex:Medicine;
  ex:hasFunction "脾泻，水泻。";
  ex:hasName "炒米面";
  ex:hasPreparation "下锅炒脆，研筛细末。";
  ex:hasPrescription "陈腊炒米。";
  ex:hasUsage "黑糖调吃，候饥时热吃。不可稀，亦不可饮汤水，茶亦不可吃太饱，本日即愈。" .

<medicine:炒粉丸> a ex:Medicine;
  ex:hasFunction "积聚涎块，结于心腹之间，致令心腹刺痛，日久不愈，或干呕减食。";
  ex:hasName "炒粉丸";
  ex:hasPreparation "上同炒令赤，去巴豆不用，只以醋丸其粉，如梧桐子大。";
  ex:hasPrescription "蚌粉1两，巴豆7粒（去壳及膜）。";
  ex:hasUsage "每服20丸，丈夫脐腹痛，炒茴香酒吞下；妇人血气，炒姜酒送下；败血冲心，童子小便和当归酒服；常服，姜酒送下。" .

<medicine:炒糯丸> a ex:Medicine;
  ex:hasFunction "下胎。主";
  ex:hasName "炒糯丸";
  ex:hasPreparation "先用7个同米炒改色去蝥，再用7个同炒令米色黄再去蝥，又用7个同炒令起烟复去之。复用鸡胞肠1个将炒过蝥同煮烂去蝥，同米研捣作丸。";
  ex:hasPrescription "糯米1合，斑蝥21个（去翅足）。";
  ex:hasUsage "分3服，用牛膝、红花酒送下。服后腹痛胎落即止。服后若未下，3日尽3服，无不下者。" .

<medicine:炒面> a ex:Medicine;
  ex:hasFunction "诸虚百损，痨嗽痰喘。";
  ex:hasName "炒面";
  ex:hasPreparation "上搽成一处。";
  ex:hasPrescription "白茯苓4两，莲肉（去心）1斤，鸡头米1斤（共为细末），红枣4斤（煮熟去皮核），新鲜小米1斗（炒熟磨末），蜂蜜1斤，白沙糖1斤。";
  ex:hasUsage "本方方名，《仙拈集》引作“七仙炒面”。" .

<medicine:炒面粥> a ex:Medicine;
  ex:hasFunction "温中止痢。用于寒湿下痢腹部冷痛，兼强气力，补五脏。";
  ex:hasName "炒面粥";
  ex:hasPreparation "先煮粳米粥，入炒面，搅匀。";
  ex:hasPrescription "炒面15克 粳米30克";
  ex:hasUsage "空腹食用。" .

<medicine:炒香榧> a ex:Medicine;
  ex:hasFunction "【功效】消积杀虫。适用于小儿钩虫病。";
  ex:hasName "炒香榧";
  ex:hasPreparation "于每年10～11月间香榧子成熟时采摘，除去肉质外皮，取出种子，晒干；再将榧子仁微炒至外表褐黑，内仁黄黑，发出焦香味为度。";
  ex:hasPrescription "香榧子250～500克";
  ex:hasUsage "每日吃香榧子肉10～15克，连吃15～30天。" .

<medicine:炒黄面> a ex:Medicine;
  ex:hasFunction "泄痢肠胃不固。";
  ex:hasName "炒黄面";
  ex:hasPrescription "白面1斤（炒令焦黄）。";
  ex:hasUsage "每服1匙头，空心温水调下。" .

<medicine:炙甘草汤> a ex:Medicine;
  ex:hasAlias "复脉汤（《伤寒论》）。";
  ex:hasClinicalApplication "1.用方要点：炙甘草汤为阴阳气血并补之剂。临床应用以心动悸，脉结代，虚赢少气，舌光少苔为辨证要点。";
  ex:hasFunction "益气养血，滋阴复脉。治气虚血弱，虚羸少气，心悸心慌，虚烦失眠，大便干结，舌质淡红少苔，脉结代；虚劳肺痿，久咳不止，涎唾甚多，咽燥而渴，痰中有血，心悸、心烦，少气，失眠，自汗盗汗，脉虚数。";
  ex:hasName "炙甘草汤";
  ex:hasPrescription "甘草12克（炙）生姜9克（切）人参6克 生地黄30克 桂枝9克（去皮）阿胶6克 麦门冬10克（去心）麻仁10克 大枣30枚（擘）";
  ex:hasUsage "上以清酒七升，水八升，先煮八味，取三升，去滓，内胶烊消尽，温服一升，日三服。现代用法：水煎服，阿胶烊化，冲服。" .

<medicine:炙皂散> a ex:Medicine;
  ex:hasFunction "治风牙疼痛。";
  ex:hasName "炙皂散";
  ex:hasPrescription "不舯皂角500克（去皮）生地黄1千克（取汁）生姜1千克（去皮，取自然汁）";
  ex:hasUsage "上药以皂角蘸汁，慢火炙尽为度。每日早晨以牙刷刷皂角浓汁出，揩牙。旬日后更无一切齿疾。" .

<medicine:炙粉草膏> a ex:Medicine;
  ex:hasFunction "治悬痈已成，服药不得内消，服之未成者即消，已成者即溃，既溃者即敛。";
  ex:hasName "炙粉草膏";
  ex:hasPrescription "大粉草（120克，用长流水浸透，炭火上炙干，再浸再炙，如此三度，切片）90克 当归身90克";
  ex:hasUsage "水750毫升，慢火煎稠，去滓再煎，稠厚为度。每日9克，腹空时用好热酒2帕毫升服。" .

<medicine:炙肝散> a ex:Medicine;
  ex:hasAlias "猪肝散（《普济方》卷二○八）。";
  ex:hasFunction "逐胃中风，益脾进食。治脾泄久不愈，虚弱瘦损，食少倦怠，或大便频泄不止。";
  ex:hasName "炙肝散";
  ex:hasNote "渴，勿吃冷水。";
  ex:hasPrescription "白术 白芍药 山白芷 桔梗各120克";
  ex:hasUsage "上药各为生细末。用不入水豮猪肝150克，作小片子或块子，拌药45克，细切葱白6.6厘米，盐3克，同拌肝令均。以竹签子作串，慢火炙香熟。空腹时吃，用米饮送下，半月安。" .

<medicine:点喉神效方> a ex:Medicine;
  ex:hasFunction "喉间肿痛，或溃烂出血，大发寒热。";
  ex:hasName "点喉神效方";
  ex:hasPrescription "井华水4碗，剔牙松叶1握，人中白3钱。";
  ex:hasUsage "用井华水，入剔牙松叶，煎至3碗，用人中白研细，每碗入1钱调匀。能饮者饮之；不能饮者，取匙渐滴患处。立愈。不论喉间何毒已未成者，点之即效。" .

<medicine:点头散> a ex:Medicine;
  ex:hasFunction "偏正头痛。";
  ex:hasName "点头散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "川芎2两（生），香附子（去毛，炒）4两。";
  ex:hasUsage "每服1钱，好茶清调下。常服可除根。" .

<medicine:点毒丹> a ex:Medicine;
  ex:hasFunction "热疖初起未出头。";
  ex:hasName "点毒丹";
  ex:hasPreparation "上为极细末，入雄猪胆汁调如粘。";
  ex:hasPrescription "黄柏。";
  ex:hasUsage "用少许点疖中间即消。" .

<medicine:点点金丹> a ex:Medicine;
  ex:hasFunction "疔疮发背，无名肿毒。";
  ex:hasName "点点金丹";
  ex:hasPreparation "用雄黄1两，朱砂1两，为细末，入罐内晒之，至端午日取出听用。";
  ex:hasPrescription "虾豚1罐（三月清明收）。";
  ex:hasUsage "如搽疮，用药磨水，点上。立消。" .

<medicine:点烂弦风药> a ex:Medicine;
  ex:hasFunction "烂弦眼。";
  ex:hasName "点烂弦风药";
  ex:hasPreparation "上为末，如烧香状烧之，以碗涂蜜少许于内，覆烟上，取烟尽后，以瓷罐收之。";
  ex:hasPrescription "薄荷、荆芥、细辛。";
  ex:hasUsage "凡眼见风热多泪者，皆可点之。" .

<medicine:点玄丹> a ex:Medicine;
  ex:hasFunction "善去恶毒。主";
  ex:hasName "点玄丹";
  ex:hasPreparation "上为极细末。";
  ex:hasPrescription "明矾1两，金脚信5钱（火煅存性）。" .

<medicine:点生丹> a ex:Medicine;
  ex:hasFunction "时疫急痧。";
  ex:hasName "点生丹";
  ex:hasPreparation "先将雄黄、朱砂等研细，再将荜茇捣碎，同冰片、麝香掺研千余次，末以飞金拂下研匀。";
  ex:hasPrescription "真雄黄1钱，明朱砂1钱，明矾1钱，麝香1分，冰片1分，真飞金12件，火消1钱，荜茇5厘。";
  ex:hasUsage "将簪蘸吐沫粘药少许，点眼角。" .

<medicine:点白还黑丹> a ex:Medicine;
  ex:hasFunction "乌须。主";
  ex:hasName "点白还黑丹";
  ex:hasPreparation "上为末，以瓷器盛之，勿泄气。";
  ex:hasPrescription "三汁膏1两（生地、桑堪、旱莲草各取汁，三汁共享一盂，入铁锅熬之极干，研末听用），母丁香5钱，没石子5钱，真铅粉5钱（炒）。";
  ex:hasUsage "拔去白须，即以笔点记，然后用鲜姜汁调药末少许点孔中。6-7日后即变黑。" .

<medicine:点眼七宝散> a ex:Medicine;
  ex:hasFunction "风热上冲，目赤疼，久不愈。";
  ex:hasName "点眼七宝散";
  ex:hasPreparation "上为极细末。";
  ex:hasPrescription "珊瑚（研细）半两，琥珀（研细）半两，玉屑（研细）半两，曾青（研细）半两，紫贝（研细）半两，朱砂（研细）半两，鸡子壳（去白膜）半两。";
  ex:hasUsage "点时仰卧，以铜箸取如绿豆大点眼，每日3-5次。" .

<medicine:点眼万明膏> a ex:Medicine;
  ex:hasFunction "眼疾。";
  ex:hasName "点眼万明膏";
  ex:hasPreparation "上为极细末听用。雨前茶陈年者4两，甘菊花4两，2味用水2大碗，于净瓦锅中熬45沸，滤去茶、菊，再用重汤熬成膏子1杯，入熊胆5分，溶化，收前药和匀成锭，入瓷器中。";
  ex:hasPrescription "炉甘石3钱（火煅，研细，入人乳浸49日），川黄连5分（乳制），辰砂3钱，硼砂5分，胆矾3分，冰片3分。";
  ex:hasUsage "如遇一切眼疾，收清水化膏少许，用骨簪蘸药点入两眼，闭目片刻，出泪而愈。" .

<medicine:点眼丹> a ex:Medicine;
  ex:hasFunction "一切头痛，心腹绞痛，及绞肠痧，盘肠气痛，疝痛。";
  ex:hasName "点眼丹";
  ex:hasPreparation "上为细末，瓷罐收贮。";
  ex:hasPrescription "牙消2钱，麝香5分，朱砂5分，雄黄5分。";
  ex:hasUsage "临病以银簪蘸药点两眼内。立时取效。" .

<medicine:点眼丹砂散> a ex:Medicine;
  ex:hasFunction "眼疾。";
  ex:hasName "点眼丹砂散";
  ex:hasPreparation "上为细末，瓷瓶收贮。";
  ex:hasPrescription "硼砂1两，海螵蛸（去壳）1两，好炉甘石（童便煅淬7次，飞过）1两，朱砂5钱（用此则不枯）。";
  ex:hasUsage "临用少加冰片研，点。极妙。" .

<medicine:点眼丹砂膏> a ex:Medicine;
  ex:hasFunction "风毒冲目赤痛。";
  ex:hasName "点眼丹砂膏";
  ex:hasPreparation "上合研，以真酥调如膏，再研匀，瓷合盛，勿令泄气。";
  ex:hasPrescription "丹砂（研）半两，蕤仁（去皮）3分，胡粉两棋子大（火上炒）半钱，龙脑（研）半钱。";
  ex:hasUsage "每点黍米许，每日3次。" .

<medicine:点眼仙方> a ex:Medicine;
  ex:hasFunction "远年近日烂弦风眼，翳障青盲，肿痛百病。";
  ex:hasName "点眼仙方";
  ex:hasPreparation "上先称眼药罐，次加蜜，称后入药，搅以上药8味，调匀。";
  ex:hasPrescription "蕤仁3钱（去皮，将竹纸研去油方入药，用笔筒卷纸，将药铺纸上，重层卷研），珍珠2分5厘（生用，绵纸包，打碎研），琥珀2分（生用，纸包，打碎研烂），熊胆1分5厘（生，研碎），牛黄1分（生用），麝香半分（生用），片脑1分5厘（生用），蜂蜜3钱5分（用慢火煨化，滤去滓）。";
  ex:hasUsage "点眼。" .

<medicine:点眼光明丹> a ex:Medicine;
  ex:hasAlias "开明银海丹";
  ex:hasFunction "一切风热上壅，两目赤肿涩痛，风弦烂眼，及内外翳障。";
  ex:hasName "点眼光明丹";
  ex:hasPreparation "上各为极细末，一处和匀，再研1-2日无声，银瓶盛贮，密封口不可令泄气。";
  ex:hasPrescription "白炉甘石1两（以黄连5钱煎浓汁，滤去滓，用炭火煅炉甘石通红，淬黄连汁内，如此者7次，研），辰砂1钱，棚砂2钱，轻粉5分，片脑3分（多至5分），麝香1分。";
  ex:hasUsage "开明银海丹（《卫生鸿宝》卷二）。本方方名，《医统》引作“光明丹”。" .

<medicine:点眼古字钱煎> a ex:Medicine;
  ex:hasAlias "点眼古钱煎";
  ex:hasFunction "积年赤眼胎赤。";
  ex:hasName "点眼古字钱煎";
  ex:hasPreparation "将钱重以食盐末填孔中令满，以5月5日午时，于石上用炭火烧令极赤，然后投醋中，候冷倾向小瓷瓶中盛，用纸39重封瓶口，1日去1重，去尽。";
  ex:hasPrescription "古铜钱30文，食盐末2分，酽醋1升。";
  ex:hasUsage "每以铜箸蘸如黍米大点目眦中。" .

<medicine:点眼圣仙方> a ex:Medicine;
  ex:hasFunction "伤寒大头瘟肿项，疟疾，痘疹。";
  ex:hasName "点眼圣仙方";
  ex:hasPreparation "上为细末，将小枣剖开去核，每一个入药末2分，合上，用针将枣刺遍眼，乌金纸包裹，入阳城罐内封固，打火线香1炷，取出冷定，去枣上皮。每枣连枣称1钱研细，入好片脑3分，为极细末。";
  ex:hasPrescription "人屎1两，猫屎1两，狗屎1两（用黍糠2升炒黄色，入前3味制过，各净用6钱），山茨菰5钱，白犀角（锉）7钱，羚羊角（锉）7钱，火消7钱，黄连（去毛）6钱，血竭5钱，没药5钱。";
  ex:hasUsage "如伤寒，点男左女右大眼眦，汗出即愈；如伤寒12日无汗者，用药吹入男左女右鼻孔，汗出即愈；如阴症瘟疫，头项俱肿者，俱如上点，汗出即愈。" .

<medicine:点眼地黄膏> a ex:Medicine;
  ex:hasFunction "被物撞打，及风热暴赤肿痛，目热泪出。";
  ex:hasName "点眼地黄膏";
  ex:hasPreparation "用地黄捣自然汁和成饼子。";
  ex:hasPrescription "生地1合，黄连1两，黄柏5钱，寒水石5钱。";
  ex:hasUsage "用时衬纸点眼上。" .

<medicine:点眼小黄连膏> a ex:Medicine;
  ex:hasFunction "风毒赤烂，不以年月久近，发歇频并，视物泪出不止。";
  ex:hasName "点眼小黄连膏";
  ex:hasPreparation "先将黄连、芦荟末以新绵裹，用水2盏，于银器中以重火煮取汁，三分减二，即绵滤去药，入龙脑，以瓷瓶子内收。";
  ex:hasPrescription "黄连（去须，捣末）1两，芦荟（研）1两，龙脑（别研）半钱。";
  ex:hasUsage "每日点眼2-3次。" .

<medicine:点眼朱砂煎> a ex:Medicine;
  ex:hasFunction "内障针开后，眼经年热涩痛，及眼障晕。";
  ex:hasName "点眼朱砂煎";
  ex:hasPreparation "上为细末，后用白蜜3两，并滤去滓，入诸药更研令匀，入一竹筒盛，纳重汤煮之半日，着柳枝子时时搅之，候色如紫，以绵再滤过。";
  ex:hasPrescription "朱砂1分（细研），琥珀1分（细研），黄丹1钱，黄柏（生）1分，黄连末1分，蕤仁1分（汤浸，去赤皮，细研），马牙消半两（细研）。";
  ex:hasUsage "每日3-4次，以铜箸取少许点之。" .

<medicine:点眼杏仁膏> a ex:Medicine;
  ex:hasAlias "杏仁膏";
  ex:hasFunction "目生胬肉，风翳障。";
  ex:hasName "点眼杏仁膏";
  ex:hasPreparation "先以水1盏半，煎杏仁、黄连至半盏，滤去滓，入盐及腻粉，更煎5-7沸，入盒中盛候冷。";
  ex:hasPrescription "杏仁（汤浸，去皮尖双仁，研如膏）半两，黄连（去须，锉）半两，青盐半两，腻粉1钱匕。";
  ex:hasUsage "本方方名，《普济方》引作“杏仁膏”。" .

<medicine:点眼枸杞煎> a ex:Medicine;
  ex:hasFunction "眼赤痛，昼夜不开。";
  ex:hasName "点眼枸杞煎";
  ex:hasPreparation "上除枸杞汁外，以新绵裹，纳净瓷盒中，将枸杞汁浸一复时后，绞捩去滓。";
  ex:hasPrescription "枸杞叶半斤（研取汁），杏仁7枚（去皮尖，研），黄连1分（去须，捣罗为末），腻粉1钱，青盐半钱。";
  ex:hasUsage "本方方名，《普济方》引作“枸杞煎”。" .

<medicine:点眼止泪散> a ex:Medicine;
  ex:hasFunction "冲风泪出外障。";
  ex:hasName "点眼止泪散";
  ex:hasPreparation "上为细末如粉面。";
  ex:hasPrescription "雄黄5钱，曾青1两，龙脑、白研灰、细辛、干姜灰各等分。";
  ex:hasUsage "每至夜后点在眼内。立效。" .

<medicine:点眼水膏> a ex:Medicine;
  ex:hasFunction "眼疾。";
  ex:hasName "点眼水膏";
  ex:hasPreparation "上用砂瓶1只，先入梨，次入黄连末，候初冬第一次下雪时，取雪满铺入砂瓶内，油单封口，入地5寸深，候立春日交春时候过了取出。";
  ex:hasPrescription "鹅梨（道按鹅梨，即梨肥大者）1个，鹰爪黄连半两。";
  ex:hasUsage "点眼，或温过洗。妙。" .

<medicine:点眼煎> a ex:Medicine;
  ex:hasFunction "肝实热，目眦热痛。";
  ex:hasName "点眼煎";
  ex:hasPreparation "上前7味锉，以井花水5升，煎取汁1升，去滓，入蜜调匀，瓷器中重汤煮如稀饧。";
  ex:hasPrescription "栀子仁1两，蕤仁（去皮）1两，决明子（微炒）1两，石膏2两（研），竹叶2握（洗），车前叶（切）3合，秦皮（去粗皮）3分，白蜜3两（后入）。";
  ex:hasUsage "每点如大豆许。" .

<medicine:点眼熊胆膏> a ex:Medicine;
  ex:hasFunction "久患瘀肉，睑烂诸疾，及暴赤目风痒。";
  ex:hasName "点眼熊胆膏";
  ex:hasPreparation "前5味，菊花揉碎，黄连以下三物细锉，用水2升，入铜钱，同于银石器中慢火熬至1升，新布滤去滓；铅丹以下10味，细研成粉，入蜜6两，并前药汁和匀，银器内重汤煮6时辰，再以新绵绞滤去滓；硼砂以下13味，并细研罗过，再研如面，入前膏内，再用重汤煮如稀饧。如要丸，即丸如梧桐子大。";
  ex:hasPrescription "古铜钱21文（完用），甘菊花4两，黄连（去须）2两，郁金2两，黄柏（去粗皮，蜜炙）2两，铅丹半两，太阴玄精石半两，井泉石半两，龙骨半两，不灰木半两，芜荑（去皮）半两，代赭半两，滑石1两，乌贼鱼骨（去坚处）1两，蕤仁（去壳）半两，硼砂半两，麒麟竭半两，没药半两，青盐半两，铜青半两，马牙消1分，乳香1分，硇砂1钱半，麝香1钱，龙脑1钱，熊胆1分，雄雀粪7粒，腻粉2钱。";
  ex:hasUsage "每用1丸，水化，以铜箸点两眦。久患瘀睑烂诸疾，点此无不愈者。暴赤目风痒，只点2-3次即愈；有人瘀肉满眼，用此亦消尽，明如未病时。" .

<medicine:点眼猪胆膏> a ex:Medicine;
  ex:hasFunction "飞血赤脉及疼痛。眼生翳膜。";
  ex:hasName "点眼猪胆膏";
  ex:hasPreparation "上入银石器中，慢火熬，以少浆水调如膏。";
  ex:hasPrescription "豮猪胆不拘多少（取汁）。";
  ex:hasUsage "每点少许，每日3-5次。" .

<medicine:点眼玉屑散> a ex:Medicine;
  ex:hasFunction "去冷泪，截赤定痛，截恶眼。主";
  ex:hasName "点眼玉屑散";
  ex:hasPrescription "好净朴消2斗。";
  ex:hasUsage "上用河水2桶，用萝卜2个切作如指厚大片，同下釜内，滚7分，取出萝卜不用，将消脚盆内盛顿，冷定，将清水澄去，次日消定，另纸袋用针遍刺窍，装消在内，悬于通风处，至3月后化开，若白雪，细绢罗过点之。不通道路者，点2个月后明如初。修制依11月、12月盛寒之时。" .

<medicine:点眼白矾粉> a ex:Medicine;
  ex:hasFunction "目热，息肉淫肤，赤白膜。";
  ex:hasName "点眼白矾粉";
  ex:hasPreparation "上研如粉。";
  ex:hasPrescription "白矾（色明净者）。";
  ex:hasUsage "每点如黍米大于翳上。即泪出，以新绵拭之，其病逐泪出。" .

<medicine:点眼白蜜黄连膏> a ex:Medicine;
  ex:hasFunction "风毒攻眼，黑花不见物。";
  ex:hasName "点眼白蜜黄连膏";
  ex:hasPreparation "用水2升，先煎竹叶取1升，去滓；下大枣及黄连、白蜜，煎取3合，去滓，重汤煎如稀饧。";
  ex:hasPrescription "白蜜半合，黄连（去须）1两，大枣5枚，淡竹叶1握（洗）。";
  ex:hasUsage "逐夜取少许，点眼中2-3滴。盖覆勿令尘灰入。" .

<medicine:点眼盐绿膏> a ex:Medicine;
  ex:hasFunction "目胎赤痛。";
  ex:hasName "点眼盐绿膏";
  ex:hasPreparation "上药于蚌蛤壳内相合。";
  ex:hasPrescription "盐绿1分，蜜半两。";
  ex:hasUsage "每夜临卧时于火上炙令暖，点目眦头。立愈。" .

<medicine:点眼真珠散> a ex:Medicine;
  ex:hasFunction "风热，赤脉贯黑睛，及有花翳。";
  ex:hasName "点眼真珠散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "珍珠末1分，琥珀1分，龙脑半分，丹砂半分，硇砂2豆大。";
  ex:hasUsage "每日点眼3-5次。" .

<medicine:点眼真珠煎> a ex:Medicine;
  ex:hasFunction "肝虚寒，茫茫不见物。";
  ex:hasName "点眼真珠煎";
  ex:hasPreparation "上合和铜器中，微火煎取一半，新绵滤过，瓷瓶中盛。";
  ex:hasPrescription "珍珠（细研）1分，鲤鱼胆2枚，白蜜2两。";
  ex:hasUsage "每以铜箸点如黍米大，着目眦。即泪出，频点取愈。" .

<medicine:点眼石胆丸> a ex:Medicine;
  ex:hasFunction "眼赤风泪出，痒烂久积，生翳息肉。";
  ex:hasName "点眼石胆丸";
  ex:hasPreparation "上为末，合和重研，炼蜜为丸，如麻子大。";
  ex:hasPrescription "石胆（研）1分，铜青（研）1分，硇砂（去石，研）1分，干姜（炮）1分，龙脑（研）1分，戎盐（研）1分，石决明（七孔者，刮，洗，焙，捣末）半两，乌贼鱼骨（去甲）半两，秦皮（去粗皮）半两，细辛（去苗叶）半两，鸡舌香半两，决明子（炒）3分，黄连（去须）1两。";
  ex:hasUsage "临卧纳大眦头各1丸。" .

<medicine:点眼石胆散> a ex:Medicine;
  ex:hasFunction "针眼暴肿，痛不得开。";
  ex:hasName "点眼石胆散";
  ex:hasPreparation "上为末，更入乳钵中，重研令极细匀。";
  ex:hasPrescription "石胆（研如粉）1分，黄连（去须，捣）3分，黄柏（去粗皮，捣）3分，蕤仁（去皮，研）半两，铜青（研）半两，芒消半两。";
  ex:hasUsage "每取如黍米大，点目眦头。" .

<medicine:点眼砂> a ex:Medicine;
  ex:hasAlias "人马平安散（《张氏医通》卷十五）、诸葛行军散（《卫生鸿宝》卷一）。";
  ex:hasFunction "主时疫毒气，痧胀腹痛。";
  ex:hasName "点眼砂";
  ex:hasPreparation "共为极细末，瓷瓶收贮。";
  ex:hasPrescription "冰片 麝香 雄黄 朱砂各1.5克 焰消3克";
  ex:hasUsage "男左女右，以少许点目大眦。" .

<medicine:点眼秦皮汤> a ex:Medicine;
  ex:hasFunction "风热上冲，目赤痛，久患不愈。";
  ex:hasName "点眼秦皮汤";
  ex:hasPreparation "上药用水1升半，煎至7合，去滓。";
  ex:hasPrescription "秦皮（锉碎）3两，青五铢钱7文，黄连（去须）1两，蕤仁（去皮）半两，淡竹叶（洗，切）30片。";
  ex:hasUsage "临卧时用净渍，点眼中；或洗眼亦得。" .

<medicine:点眼胡粉膏> a ex:Medicine;
  ex:hasFunction "久患胎赤眼。";
  ex:hasName "点眼胡粉膏";
  ex:hasPreparation "先将蕤仁研令烂，次下胡粉，更研熟，又捣生麻子为烛燃着，别取猪脂肪于烛焰上烧，使脂流下，滴入蕤仁、胡粉中，更同研令匀如饧，以绵缠细杖子头，纳药中。";
  ex:hasPrescription "胡粉1两半，蕤仁（去皮）1两。";
  ex:hasUsage "乘温点目两眦头。药须夜用。如冷，还放烛焰上暖之。" .

<medicine:点眼膏> a ex:Medicine;
  ex:hasAlias "点眼散";
  ex:hasFunction "一切赤白痢，及噤口危急之症。";
  ex:hasName "点眼膏";
  ex:hasPreparation "上为极细末，水调。";
  ex:hasPrescription "初胎粪（炙干）1钱，雄黄5分，黄连4分，片脑少许。";
  ex:hasUsage "点眼散（《玉案》卷三）。" .

<medicine:点眼膏子> a ex:Medicine;
  ex:hasFunction "眼目诸疾。";
  ex:hasName "点眼膏子";
  ex:hasPreparation "入蜜1钱在胆内，线扎定，坩锅内满入水煮熟，冷水内浸，取出候干，顿入角罐内。";
  ex:hasPrescription "羊胆1个。";
  ex:hasUsage "竹箸点眼四角。立效。" .

<medicine:点眼艾熏散> a ex:Medicine;
  ex:hasFunction "眼中胬肉。";
  ex:hasName "点眼艾熏散";
  ex:hasPreparation "上药前3味于乳钵内为细末，稀稠得所，令药着在乳钵底，然后取艾烧令烟出，却将乳钵合烟上熏之，候艾烟出尽，以槐木槌细研，令烟气相入。";
  ex:hasPrescription "蕤仁1分（汤浸，去赤皮），腻粉半钱，黄牛酥1分，熟艾如鸡子大。";
  ex:hasUsage "每用时，取少许，点眼大眦头。极效。" .

<medicine:点眼药> a ex:Medicine;
  ex:hasAlias "保命点眼药";
  ex:hasFunction "除昏退翳，截赤定痛。主";
  ex:hasName "点眼药";
  ex:hasPreparation "上锉，如麻豆大，水1大碗，文武火煎，滴水中不散为度，入炼蜜少许。";
  ex:hasPrescription "当归2钱，黄连2钱，防风1钱5分，细辛5分，甘草1钱。";
  ex:hasUsage "保命点眼药（《保婴撮要》卷四）。" .

<medicine:点眼蕤仁煎> a ex:Medicine;
  ex:hasFunction "风毒坠睛。";
  ex:hasName "点眼蕤仁煎";
  ex:hasPreparation "上以新绵裹6味，安新瓷瓶中，与蜜相和，煮一复时后，以重绵滤去滓令尽，依前安瓶子中，着露地两宿去毒。";
  ex:hasPrescription "蕤仁（去皮，研）2两，黄连（去须，锉）1两，地骨皮（取白者用）1两，曾青（研如粉）1两，青盐1分，古钱10文，蜜2盏。";
  ex:hasUsage "每点黍米大，每日3-5次。" .

<medicine:点眼蕤仁膏> a ex:Medicine;
  ex:hasFunction "风热，目赤生疮。";
  ex:hasName "点眼蕤仁膏";
  ex:hasPreparation "上为末，用乳汁少许调和如膏。";
  ex:hasPrescription "蕤仁（去皮，研如膏）半两，青盐（末）1钱，龙脑少许。";
  ex:hasUsage "每以麻子大点眼，每日3-5次。" .

<medicine:点眼蜗牛浆> a ex:Medicine;
  ex:hasFunction "息肉淫肤，赤白膜。";
  ex:hasName "点眼蜗牛浆";
  ex:hasPrescription "生蜗牛1枚。";
  ex:hasUsage "上药去其掩，纳丹砂末于口中，火上炙沸，以绵注取汁，敷眦中。" .

<medicine:点眼还睛膏> a ex:Medicine;
  ex:hasFunction "翳障。";
  ex:hasName "点眼还睛膏";
  ex:hasPreparation "上除龙脑、铅丹、蜜外，各为末，用井水2盏，及蜜、铅丹搅匀，浸3日后，入银石器内，文武火熬及一半，绵滤去滓，入龙脑成膏，瓷盒子内密封，掘地埋1宿，出火毒。";
  ex:hasPrescription "黄连（去须）1两，铅丹（水飞过）1两，黄柏（去粗皮）半两，桃仁（去皮尖双仁）7粒，杏仁（去皮尖双仁）7粒，龙脑（研）半钱，白沙蜜4两。";
  ex:hasUsage "本方方名，《普济方》引作“还睛膏”。" .

<medicine:点眼金丝膏> a ex:Medicine;
  ex:hasFunction "男子、妇人目疾远年近日，翳膜遮睛，攀睛胬肉，拳毛倒睫，黑花烂弦，迎风羞明冷泪，及赤眼肿痛。";
  ex:hasName "点眼金丝膏";
  ex:hasPreparation "上用好蜜4两，除片脑外和七味，纳入青筀竹筒内，油单纸裹筒口5-7重，紧系定，入汤瓶中，文武火煮一周时，取出劈破，新绵滤去药滓，方下片脑和匀，瓷瓶收贮，再用油单纸5-7重封系瓶口，埋露地内去火毒，候半月取出。";
  ex:hasPrescription "硇砂（研）1钱，晋矾（研）1钱，青盐（研）1钱，乳香（好者，细研）2钱，片脑（研）2钱，当归（锉，净洗）半两，黄丹（研）半两，黄连1两。";
  ex:hasUsage "每用1粟米大点眼。" .

<medicine:点眼金华水> a ex:Medicine;
  ex:hasFunction "肝脏有热，血脉壅滞，津液不荣，目中干涩碜痛。";
  ex:hasName "点眼金华水";
  ex:hasPreparation "上除青古老钱外，为细末，与古老钱入在绵子内，用井华水浸21日后。";
  ex:hasPrescription "黄连末1分，杏仁7枚（去皮尖双仁，细研），硇砂1块（豌豆大，研），乳香1块（黑豆大，研），铜绿1字（煅过），腻粉1钱匕（研），青古老钱3文（与诸药同浸），龙脑半钱匕（研），滑石半钱匕（研），艾灰半钱匕（研）。";
  ex:hasUsage "点目眦头。" .

<medicine:点眼铜绿膏> a ex:Medicine;
  ex:hasFunction "风赤眼及痒痛。";
  ex:hasName "点眼铜绿膏";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "铜绿半两，龙脑半钱，麝香半钱，乌贼鱼骨1分，马牙消1分，蕤仁1分（汤浸，去皮），水银1两（豆大）。";
  ex:hasUsage "每用药1字，入人乳中，调和如膏。每以铜箸头取少许点之，每日3-5次。" .

<medicine:点眼雀粪膏> a ex:Medicine;
  ex:hasAlias "雀乳散";
  ex:hasFunction "息肉淫肤赤白膜。眼热毒，卒生翳。";
  ex:hasName "点眼雀粪膏";
  ex:hasPreparation "上取细直者，以乳汁和研细。";
  ex:hasPrescription "雄雀粪。";
  ex:hasUsage "雀乳散（《奇效良方》卷五十七）。" .

<medicine:点眼雄黄散> a ex:Medicine;
  ex:hasFunction "风毒赤痛，眦烂生疮，冲风有泪。";
  ex:hasName "点眼雄黄散";
  ex:hasPreparation "上为极细末，于瓷器中盛。";
  ex:hasPrescription "雄黄（研）1两半，细辛（去苗叶）3分，黄连（去须）1两半，干姜（炮）3分，黄柏（去粗皮）1两半，菊花1两（3月3日日未出时收之）。";
  ex:hasUsage "每取黍米许点目眦，闭目良久。" .

<medicine:点眼雄黄膏> a ex:Medicine;
  ex:hasFunction "眼暗晕生翳膜，累年不愈，兼干涩痛。";
  ex:hasName "点眼雄黄膏";
  ex:hasPreparation "上用雪水2盏调和，入瓷瓶子内，重汤煮1日，药成候冷，用绵滤过。";
  ex:hasPrescription "雄黄（研）1分，干姜（炮，捣末）1分，黄连（去须，捣末）1分，矾石（烧令汁尽，研）1分，丹砂（研）1分，麝香（研）1钱。";
  ex:hasUsage "点少许于目眦头。" .

<medicine:点眼雪花丸> a ex:Medicine;
  ex:hasAlias "雪花丸";
  ex:hasFunction "风毒赤眼，昏涩痒痛，翳膜瘀肉。";
  ex:hasName "点眼雪花丸";
  ex:hasPreparation "上为末，为丸如黍米大。";
  ex:hasPrescription "杏仁（汤浸，去皮尖双仁，研）49粒，蕤仁（去皮，研）100粒，青盐（皂子大）5块，砂糖弹子大。";
  ex:hasUsage "雪花丸（《普济方》卷七十五）。" .

<medicine:点眼食盐膏> a ex:Medicine;
  ex:hasAlias "石盐膏";
  ex:hasFunction "目中息肉。";
  ex:hasName "点眼食盐膏";
  ex:hasPreparation "上和合，令调。";
  ex:hasPrescription "驴腊、石盐（末）。";
  ex:hasUsage "石盐膏（《普济方》卷八十二）。《圣济总录》本方用食盐一分、驴脂一两。" .

<medicine:点眼香连膏> a ex:Medicine;
  ex:hasFunction "目生翳膜。";
  ex:hasName "点眼香连膏";
  ex:hasPreparation "上除前膏外，将后4味为细末，入在药膏内，用油单封三五重系定。如春、夏、秋合时，即以麻绳子坠在井底7日取出；若冬月合时，即于背阴处封闭14日出之。除打损眼外，并可治。";
  ex:hasPrescription "白沙蜜5两（绢滤去滓），硇砂5钱（通明者，研），乳香（研）1钱，青盐1钱（研），铅丹1钱，黄连3两（去须，为细末。以上6味除蜜外，并用新汲水3大盏于银石器内，同煎至1大盏后入蜜，更用慢火熬成膏，不住手搅，候引之如丝线，以重绵绞去滓，入瓷瓶内盛），水银半钱，轻粉1钱，龙脑1钱，麝香（研）1钱。" .

<medicine:点眼黄连散> a ex:Medicine;
  ex:hasFunction "眼赤风涩隐，肿疼生疮。";
  ex:hasName "点眼黄连散";
  ex:hasPreparation "先将蕤仁去膜，于铜器中用槐木杵为极细末，次入黄连末、胡粉，合和更研，取细为度。";
  ex:hasPrescription "黄连（去须，末）1分，蕤仁（去皮）1分，胡粉1钱。";
  ex:hasUsage "每夜卧点1黍米大在目眦头，不过2-3次愈。" .

<medicine:点眼黄连煎> a ex:Medicine;
  ex:hasAlias "黄连煎";
  ex:hasFunction "肝热目赤，干涩碜痛。";
  ex:hasName "点眼黄连煎";
  ex:hasPreparation "上锉，如麻豆，分作2分，1分瓷器内炒紫色，1分生用，同和；别以木炭灰2钱匕，与黄连同用沸汤半盏浸良久，以细熟绢滤过取汁，瓷器盛，就冷水内，沉令极冷。";
  ex:hasPrescription "黄连（去须）半两。";
  ex:hasUsage "点眼中。或更细研少龙脑相和，尤佳。" .

<medicine:点眼黄连膏> a ex:Medicine;
  ex:hasFunction "风赤眼胬肉痒痛。";
  ex:hasName "点眼黄连膏";
  ex:hasPreparation "上除龙脑、石胆外，为粗末，以水2升，煎至1升，滤去滓，两遍澄清，次下白蜜1两，煎令稀稠得所，后入石胆、龙脑搅匀，纳瓷盒中蜜封。";
  ex:hasPrescription "黄连（去须）1两，黄柏（去粗皮，蜜炙）1两，升麻1两，蕤仁（去皮）1两，细辛（去苗叶）3分，石胆末半钱（研极细），龙脑（研细）1两，蜜1两。";
  ex:hasUsage "本方方名，《普济方》引作“黄连膏”。" .

<medicine:点眼龙脑煎> a ex:Medicine;
  ex:hasFunction "风毒冲目赤痛。";
  ex:hasName "点眼龙脑煎";
  ex:hasPreparation "上药和匀，瓷瓶内密封，重汤煮一炊时，取出。";
  ex:hasPrescription "龙脑（研）半钱，铅丹（罗）半两，白蜜（绵滤）2两。";
  ex:hasUsage "点目眦。" .

<medicine:点眼龙脑膏> a ex:Medicine;
  ex:hasFunction "肝热冲发于目，赤肿碜痛。";
  ex:hasName "点眼龙脑膏";
  ex:hasPreparation "上除前膏外，将后4味同研令匀，入前膏内，搅令相得，以干瓷器收之。";
  ex:hasPrescription "山栀子（去皮）3钱，甘草6钱（生），生干地黄2两，熟干地黄1两，黄连（去须）8钱，青葙子8钱，当归4钱，决明子1合（以上为粗末），马牙消6钱，青盐4钱，密陀僧半两，朴消1两1钱，石决明1枚（米泔浸3日，刮洗），乳香1钱，硇砂1字，蓬砂2钱，蕤仁2钱（以上为细末），灯心半束（切碎），铅丹1两3分（罗过），大枣30个（去核，切），白蜜3斤（以上同拌匀，入瓷瓶子内，用箬叶叶油纸封定，勿令透气，坐在锅内，重汤煮1日，取出，绢滤去滓），丹砂（研）2钱，龙脑（研）1钱，麝香（成颗者，研）1字，腻粉1字（研）。";
  ex:hasUsage "本方方名，《普济方》引作“龙脑膏”。" .

<medicine:点翳散> a ex:Medicine;
  ex:hasFunction "眼目翳。";
  ex:hasName "点翳散";
  ex:hasPreparation "乳极细无声，收密。";
  ex:hasPrescription "心红1钱，枯矾3分，麝香半分。";
  ex:hasUsage "点翳上。3次即没。" .

<medicine:点舌丹> a ex:Medicine;
  ex:hasFunction "疔毒。";
  ex:hasName "点舌丹";
  ex:hasPreparation "上为细末，用乳浸蟾酥捣为丸，如绿豆大。";
  ex:hasPrescription "真蟾酥3钱（乳浸），真麝3分，蜈蚣3条（炙，去头足），川山甲3钱（土炒成珠），全蝎1钱，僵蚕（炒去丝）1钱，蝉蜕1钱，明雄黄1钱，朱砂1钱，乳香（枯）5分，没药（枯）5分。";
  ex:hasUsage "每服先用2丸，置病人舌下，顷刻口舌觉麻，将葱白3寸，入病口嚼烂，吐在手心，将药3丸包于葱内，用无灰热酒送下。急煎漏芦汤服，外用神灯照之。但疔毒一症，有急疔已走，疔上有红筋1条，或上或下，即于红筋尽头，以针挑破，纳药1丸于针眼上，膏药盖定，其疔自回原处。春、夏、秋急寻菊叶，冬寻菊根同葱捣烂裹吞。" .

<medicine:点药> a ex:Medicine;
  ex:hasFunction "杨梅疮。";
  ex:hasName "点药";
  ex:hasPreparation "上药共研如膏。";
  ex:hasPrescription "大杏仁20个（针刺火上烧透存性），胆矾4分，轻粉1钱。";
  ex:hasUsage "熏洗方：番打麻、雷丸各五钱，朴消、地骨皮各一两，黄芩一两半，用河水五碗煎药味出，先熏后洗。" .

<medicine:点药神效膏> a ex:Medicine;
  ex:hasFunction "翳膜遮障，目风泪出。";
  ex:hasName "点药神效膏";
  ex:hasPreparation "上药并入瓷瓶内和匀，用重汤于锅内煮，候紫色为度，兼不住手搅之，药成，只于瓶内盛贮封角。";
  ex:hasPrescription "铅丹2两，蜜半斤（以绢滤过），硇砂1豆大（明净者），青盐1钱，马牙消3钱，白龙脑1钱，白矾1豆大（烧过），大猪胆2枚（新好者）。";
  ex:hasUsage "本方方名，《普济方》引作“神效膏”。" .

<medicine:点虬丹> a ex:Medicine;
  ex:hasFunction "小儿有粪门边拖出长虫，不肯便下，又不肯进入直肠之内，不痛不痒。";
  ex:hasName "点虬丹";
  ex:hasPreparation "上各为极细末，以不见水银星为度。";
  ex:hasPrescription "水银1钱，冰片1钱，硼砂1分，雄黄3分，樟脑1钱，轻粉3分，白芷1钱，薄荷叶3分。";
  ex:hasUsage "水调少许，点虫头或身上，少刻即尽化为水。不须内服煎药，至奇之方也。" .

<medicine:炼毒丹> a ex:Medicine;
  ex:hasFunction "走马牙疳。";
  ex:hasName "炼毒丹";
  ex:hasPreparation "上为末，都拌匀，用面包好，火煅烟尽为度，又乳极细。";
  ex:hasPrescription "熟石膏1两，白砒2钱。";
  ex:hasUsage "每次用1钱，以滚水冲，用筷子急搅，澄清；候温，取上面清水漱之，先微痛，再换，第2次漱之。即生皮痊愈。" .

<medicine:炼盐散> a ex:Medicine;
  ex:hasFunction "漏精白浊。思虑太过，心肾虚损，真阳不固，溺有余沥，小便白浊，梦寐频泄。";
  ex:hasName "炼盐散";
  ex:hasPreparation "上为末，入盐1两研和；用沸汤浸枣取肉，研，夹炼蜜再为丸，如梧桐子大。";
  ex:hasPrescription "雪白盐（入瓷瓶内筑10分实，以瓦盖顶，黄泥涂封，火煅1日，取出放阴地上1夜，用密器收）1两，白茯苓1两，山药（炒）1两。";
  ex:hasUsage "每服30丸，空心枣汤送下。" .

<medicine:炼真丸> a ex:Medicine;
  ex:hasFunction "治高年体丰有痰，饱饫肥甘，恣情房室，上盛下虚者；或髓脏中多着酒湿，精气不纯，不能生子者。";
  ex:hasName "炼真丸";
  ex:hasPreparation "上药为细末，用干山药细末调糊为丸。";
  ex:hasPrescription "大腹子210克（童便浸，切）茅山苍术（去皮，泔浸，麻油炒）人参茯苓各90克 厚黄柏90克（童便、乳汁、盐水各制30克）鹿茸（大者）1对（酥炙）大茴香（去子）30克 淫羊藿（去刺，羊脂拌炒）泽泻 蛇床子（酒炒）白莲须（酒洗）沉香（另研末，勿见火）五味子各30克 金铃子（即川楝子，酒煮，去皮、核）90克 凤眼草30克（即樗树叶，中有子1粒，形如凤眼。故名。如无，以樗根皮代之。）";
  ex:hasUsage "空腹时淡盐汤送下9～12克，临卧时温酒再服6克。" .

<medicine:炼石丹> a ex:Medicine;
  ex:hasFunction "痧胀。";
  ex:hasName "炼石丹";
  ex:hasPreparation "水为丸，或神曲糊为丸，表热烦躁者，青黛为衣；眩晕心闷者，朱砂为衣。";
  ex:hasPrescription "千年石（即陈石灰，水飞）1两，松根石（即真琥珀）3钱，水骨石（即白滑石，水飞）2钱。";
  ex:hasUsage "每服2钱，垂头芦粟汤送下。" .

<medicine:炼石散> a ex:Medicine;
  ex:hasFunction "胸面部疽毒坚如石碗者，其色不变。";
  ex:hasName "炼石散";
  ex:hasPreparation "上用好醋5升，先烧石通红，淬醋中，再烧再淬，醋尽方止，为末；加二味末，将剩下醋调如泥。";
  ex:hasPrescription "鹿角（烧灰）8两，白蔹3两，粗厉黄石2斤。";
  ex:hasUsage "涂上消软，灸处亦涂之。" .

<medicine:炼石补天> a ex:Medicine;
  ex:hasFunction "咽痛微嗽，口烧而不渴，足心如烙，阴燥，喉久烂者。";
  ex:hasName "炼石补天";
  ex:hasNote "杨梅毒喉禁用。";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "制乳香1钱，赤石脂3钱，制没药1钱，北细辛1分，人中白2钱，白马粪2钱，象皮1钱，人中黄2钱，血竭2钱，上冰片1分，朱砂1钱。";
  ex:hasUsage "吹之。" .

<medicine:炼砂丹> a ex:Medicine;
  ex:hasFunction "心狂。";
  ex:hasName "炼砂丹";
  ex:hasPreparation "上以水1碗，银器内煮，令天仙子芽出，去天仙子不用；将辰砂研令极细，滴水炼蜜为丸，如豌豆大。";
  ex:hasPrescription "辰砂1两，天仙子（择净）1两。";
  ex:hasUsage "每服1丸，空心人参汤送下。" .

<medicine:炼阴丹> a ex:Medicine;
  ex:hasAlias "安息香丸";
  ex:hasFunction "足少阴凝涩气，下坠肿胀，卵核偏，如石游走，疼痛不定。";
  ex:hasName "炼阴丹";
  ex:hasPreparation "先将阿魏以下入酒、醋内熬成膏，放冷，入麝香1钱，再搅匀，和前药为丸，如绿豆大。";
  ex:hasPrescription "玄胡索1两，海藻1两，昆布1两，青橘皮1两，胡芦巴1两，茴香1两，川楝肉1两，马蔺花（醋炒）1两，木香半两，大戟（醋炙）1分，阿魏1分，硇砂1分，安息香1分，酒1分，醋1分。";
  ex:hasUsage "安息香丸（《瑞竹堂方》卷二）。" .

<medicine:炼雄丹> a ex:Medicine;
  ex:hasFunction "暑秽痧邪直犯包络，神明闭塞，昏愦如尸；及霍乱初定，余热未清，骤尔神昏，如醉如寐，身不厥冷，脉至模糊。";
  ex:hasName "炼雄丹";
  ex:hasPreparation "上为细末，同入铜勺内，微火熔化，都拌匀，俟如水时，急滤清者于碗内，粗滓不用，俟其凝定收藏。";
  ex:hasPrescription "极明雄黄1分（研极细），提净牙消6分。";
  ex:hasUsage "《感证辑要》本方用法：用时以木通一钱，通草三钱，腊雪水一碗煎汁去滓，再入腊雪水九碗与药汁和匀；每次用药水一碗磨入犀角汁三分，挑入炼雄三厘。能于三日内服尽十碗药水，必有清痰吐出数碗而愈。" .

<medicine:烂喉痧散> a ex:Medicine;
  ex:hasFunction "烂喉痧。";
  ex:hasName "烂喉痧散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "熟石膏2分，人中黄（煅）2分，煅月石2分，煅儿茶2分，薄荷2分，朱砂2分，冰片2分，麝香5厘，濂珠5厘，琥珀5厘，牛黄5厘。";
  ex:hasUsage "吹口。" .

<medicine:烂弦散> a ex:Medicine;
  ex:hasFunction "烂弦风，红眼眶。";
  ex:hasName "烂弦散";
  ex:hasNote "翳障眼忌用。";
  ex:hasPreparation "将上药熬水冲甘石，澄清，干后以艾叶70个熏之，装瓶内。";
  ex:hasPrescription "炉甘石1两，黄连1钱，黄柏1钱，蔓荆子1钱，菊花1钱。";
  ex:hasUsage "香油调搽，抹眼患处。" .

<medicine:烂泥丸> a ex:Medicine;
  ex:hasFunction "一切无名肿毒或痛或痒。";
  ex:hasName "烂泥丸";
  ex:hasPrescription "生大蒜1枚（如有独蒜更妙）。";
  ex:hasUsage "选多人行走地土上，用口唾沫将蒜在地上磨烂，即以蒜泥涂敷在患处；如已见头，即留出头，涂敷四围。" .

<medicine:烂眼煎> a ex:Medicine;
  ex:hasFunction "赤红烂眼。";
  ex:hasName "烂眼煎";
  ex:hasPreparation "上药用水1碗，放锅内，用纸盖好，蒸1炷香久，取出露1宿。";
  ex:hasPrescription "胆矾1钱，防风1钱，独活1钱，僵蚕1钱，桑皮1钱。";
  ex:hasUsage "洗之。" .

<medicine:烂积丸> a ex:Medicine;
  ex:hasFunction "烂积。主湿热之物蕴积肠胃日久生虫，裹血聚气，胸腹胀痛，面黄肌瘦，食少神倦，溲涩便溏。";
  ex:hasName "烂积丸";
  ex:hasNote "忌葱、韭发物。";
  ex:hasPreparation "上为细末，黄蜡1两4钱熔化为丸，如绿豆大。";
  ex:hasPrescription "芦荟1钱5分，天竺黄3钱，穿山甲（面炒）3钱，白信（煅）7分，巴霜（去油）6钱，硼砂1钱，硇砂1钱。";
  ex:hasUsage "每服5丸，温酒送下。" .

<medicine:烂积片> a ex:Medicine;
  ex:hasFunction "清理肠胃，消积化滞。治消化不良，胸闷胀痛，肚腹瘀痛，恶心嗳气，大便不通。";
  ex:hasName "烂积片";
  ex:hasPreparation "制成片剂。";
  ex:hasPrescription "牵牛子（炒）20千克 枳实（麸炒）20千克 三棱（醋制）20千克 大黄20千克 红曲6.25千克";
  ex:hasUsage "成人每次口服4片，每日2次，小儿减半，温开水送下。" .

<medicine:烂翳散> a ex:Medicine;
  ex:hasFunction "因他病后生翳外障，初患之时，或即赤烂潮生，翳目侵睛，盖定瞳仁，即无所见；翳心若不赤黄，犹见光明。";
  ex:hasName "烂翳散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "朱砂半两，石决明半两，珍珠（末）半两，曾青1分，硇砂1分，龙脑1分。";
  ex:hasUsage "每至干，点眼内。宜钩割熨烙后点之，服细辛散。" .

<medicine:烂耳散> a ex:Medicine;
  ex:hasFunction "清热解毒，敛湿去脓。治耳内流脓，或黄或红，或有臭气。";
  ex:hasName "烂耳散";
  ex:hasPreparation "上药三味，各研极细，混匀。";
  ex:hasPrescription "穿心莲粉0.3克 猪胆汁粉0.3克 枯矾0.6克";
  ex:hasUsage "先以棉签清除耳中脓液，再用本晶少许吹耳内，每日一次。" .

<medicine:烂腿夹纸膏> a ex:Medicine;
  ex:hasFunction "烂腿。";
  ex:hasName "烂腿夹纸膏";
  ex:hasPrescription "梅片4分，煅甘石1两2钱，轻粉5钱，白占3两5钱，菜油1斤（夏天用）。";
  ex:hasUsage "先将菜油煎滚，再入白占化开，再将药3味同煎。" .

<medicine:烂腿膏> a ex:Medicine;
  ex:hasFunction "里外臁疮，血风蚁窠。";
  ex:hasName "烂腿膏";
  ex:hasPreparation "先以麻油、花椒2味同煎至花椒焦黑，捞去，再熬至滚，入各味搅极匀，至滴水成珠不散，离火略冷，用厚皮纸裁成长方，于锅中拖之，线穿，候干。";
  ex:hasPrescription "甘石4两，白蜡10两，黄蜡10两，花椒1两5钱，密陀僧1两，麻油48两。";
  ex:hasUsage "用时贴2日，翻转再贴。" .

<medicine:烂金丸> a ex:Medicine;
  ex:hasFunction "补精血，益诸虚，解劳倦，去骨节间热，宁心强志，安神定魄，固脏腑，进饮食，免生疮疡。主";
  ex:hasName "烂金丸";
  ex:hasNote "热中消渴止后宜服之。";
  ex:hasPreparation "上为末，用猪肚膏搜和得所，膏少则添熟蜜，杵数千下，为丸如梧桐子大。";
  ex:hasPrescription "大猪肚1个，黄连3两，蜜2两，生姜2两（研）先将猪肚净洗，复以葱、面、醋、椒等洗，控干；用药同水酒入银石器内煮半日，漉出黄连，洗去蜜酒令尽，锉，研为细末，再用酒调成膏，入先洗猪肚内，缝定，入银石器内水熬烂，研为膏，搜下项药：人参2两，黄耆4两，五味子2两，山药2两，山茱萸2两，杜仲（去皮，锉，姜汁淹，炒丝断）2两，石斛2两，车前子2两，鳖甲（醋炙）2两，熟地黄2两，新莲肉（去皮）2两，当归2两，槐角子（炒）1两，白茯苓1两，磁石（煅碎）1两，川芎1两，沉香半两（不焙），麝香1钱（别研入），菟丝子（酒浸湿，研）5两，（一法有白术2两，阳起石1两）。";
  ex:hasUsage "每服50丸，食前温酒、糯米汤任下。" .

<medicine:烙脐丸> a ex:Medicine;
  ex:hasAlias "烙脐饼子";
  ex:hasFunction "小儿断脐。";
  ex:hasName "烙脐丸";
  ex:hasPrescription "豆豉1分，黄蜡1分，麝香少许。";
  ex:hasUsage "烙脐饼子（《卫生总微》卷一）。" .

<medicine:烧伤灵酊> a ex:Medicine;
  ex:hasFunction "清热燥湿，解毒消肿，收敛止痛。用于各种原因引起的Ⅰ、Ⅱ度烧伤。";
  ex:hasName "烧伤灵酊";
  ex:hasPrescription "虎杖、黄柏、冰片";
  ex:hasUsage "外用，喷洒于洁净的创面，不需包扎，一日3～4次。" .

<medicine:烧脾散> a ex:Medicine;
  ex:hasFunction "温中祛寒，理气化滞。治饮啖生冷果菜，寒留中焦，心脾冷痛不可忍，及老幼霍乱吐泻。";
  ex:hasName "烧脾散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "干姜（炮）厚朴（姜制，锉，炒）草果仁 缩砂仁 神曲（炒）麦蘖<炒）橘红 高良姜（锉，炒）甘草（炙）各等分";
  ex:hasUsage "每服9克，热盐汤调服，不拘时。" .

<medicine:热六合汤> a ex:Medicine;
  ex:hasFunction "养血清热。治血虚有热，发热而烦，不能睡卧者。";
  ex:hasName "热六合汤";
  ex:hasPrescription "熟地黄 川芎 芍药 当归 黄连 栀子";
  ex:hasUsage "水煎服。" .

<medicine:热炎宁颗粒> a ex:Medicine;
  ex:hasFunction "清热解毒。用于风热感冒，发热，咽喉肿痛，口苦咽干，咳嗽痰黄，尿黄便结；化脓性扁桃体炎，急性咽炎，急性支气管炎，单纯性肺炎。";
  ex:hasName "热炎宁颗粒";
  ex:hasPrescription "蒲公英、虎杖、北败酱、半枝莲";
  ex:hasUsage "开水冲服，一次1～2袋，一日2～4次；或遵医嘱。" .

<medicine:烽烟充斥汤> a ex:Medicine;
  ex:hasFunction "咽痛下利，并见胸满、心烦、肤燥、恶热、不眠诸证。";
  ex:hasName "烽烟充斥汤";
  ex:hasPrescription "玉竹4钱，石膏3钱，猪苓2钱，泽泻2钱，枳壳2钱，桔梗1钱半。";
  ex:hasUsage "上以鸡子白泡服。" .

<medicine:焊肺丹> a ex:Medicine;
  ex:hasAlias "保肺丹";
  ex:hasFunction "护膈膜，不致溃透心肺。主肺痈。";
  ex:hasName "焊肺丹";
  ex:hasPrescription "蜡矾丸。";
  ex:hasUsage "保肺丹（《寿世保元》卷六）。" .

<medicine:焚香透膈散> a ex:Medicine;
  ex:hasFunction "劳嗽，胸膈壅滞痞满。";
  ex:hasName "焚香透膈散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "雄黄、佛耳草、鹅管石、款冬花各等分。";
  ex:hasUsage "每用药1钱，放香炉上焚烧令烟出。开口吸烟在喉中。" .

<medicine:焚香透膈筒> a ex:Medicine;
  ex:hasFunction "风寒冷嗽，胸膈胀满。";
  ex:hasName "焚香透膈筒";
  ex:hasPreparation "各研和匀，纸卷成筒。";
  ex:hasPrescription "鹅管石1两，款冬花7钱，艾叶（搓软）5钱，雄黄5钱。";
  ex:hasUsage "火点，令漏斗于上口，哈烟一口，淡姜汤咽下。" .

<medicine:焦瘤膏> a ex:Medicine;
  ex:hasFunction "一切瘿瘤。";
  ex:hasName "焦瘤膏";
  ex:hasPreparation "上以沸汤淋汁5碗许，澄清，入斑蝥40个，穿山甲5片，乳香、冰片不拘多少（后入），煎作2碗，以瓷器盛之。";
  ex:hasPrescription "桑炭灰2升半，枣木灰2升半，黄荆灰2升半，桐壳灰2升半，荞麦灰（炒）2升半。";
  ex:hasUsage "临用时入新石灰调成膏，敷瘤上，干则以清水润之，其效若神。" .

<medicine:焦鸱散> a ex:Medicine;
  ex:hasFunction "破伤风；兼治男子妇人急头风。";
  ex:hasName "焦鸱散";
  ex:hasPreparation "以鸱浸酒瓶中，用砖盖瓶口，大火煅红为度，破瓶取鸱，研细末，入麝香少许。";
  ex:hasPrescription "腊月活鸱1只，无灰酒1斗。";
  ex:hasUsage "热酒调服。" .

<medicine:煅硼砂> a ex:Medicine;
  ex:hasFunction "据报道，应用本法治疗急性腰扭伤50例，治疗1次后，半小时内症状明显减轻或基本消失者46例，好转及无效者各2例。用药后，可有流泪，稍有刺痛感，但对眼睛无影响和损害，用药后1～3分钟，腰部便感舒适痛快，疼痛减轻。";
  ex:hasName "煅硼砂";
  ex:hasPreparation "研为极细粉末，装瓶备用。";
  ex:hasPrescription "煅硼砂（月石）适量";
  ex:hasUsage "每次用火柴棒（无火柴头）的一端，取药粉少许，点入两眼内、外角处。点后，闭眼，双手叉腰，两足分开站立，作前后左右腰部运动。不能站立者，由他人帮助作双下肢伸屈活动，约20分钟。每日用药3次，连用2～3次，直至痊愈。" .

<medicine:煅落铁屑膏> a ex:Medicine;
  ex:hasFunction "一切漏。";
  ex:hasName "煅落铁屑膏";
  ex:hasPreparation "上为末，以猪膏和。";
  ex:hasPrescription "煅落铁屑、狗颊车连齿骨（炙）、虎粪、鹿皮（合毛烧灰）各等分。";
  ex:hasUsage "纳疮中，须臾易之，1日5-6次。" .

<medicine:煅蒌散> a ex:Medicine;
  ex:hasFunction "痰积腹满，窒碍胸膈。";
  ex:hasName "煅蒌散";
  ex:hasPreparation "将瓜蒌切去盖，倾出其仁，取3钱和前药拌匀，纳瓜蒌中，将原盖盖好，用桑皮纸糊之，以黄泥厚涂作团，用文武火煅至烟将尽，取起俟冷，去泥，将药研细末。";
  ex:hasPrescription "黄瓜蒌1个，苏子3钱，莱菔子3钱，芥子3钱，人中黄2钱。";
  ex:hasUsage "每服2钱，神曲汤调下。" .

<medicine:煅金液丹> a ex:Medicine;
  ex:hasAlias "金液丹、金液散";
  ex:hasFunction "小儿三五岁患无辜，泻痢。";
  ex:hasName "煅金液丹";
  ex:hasPreparation "上药取煅药罐子1个，盛药在内，下盖子了，采狗蹄草1大握（本名石龙芮），木鉴草1大握（稻田中生，1茎4花，如田字，亦名水田草，独茎生），将二草入铁臼内烂捣，更入掬黄土同杵匀如泥（若无上件2草，且只使益母草代之亦可），便将裹药罐子底下，并周匝可厚5-6分，只至口缝不裹，然后置于平地上，四面簇炭5-6斤，上面安熟火1斤以来，烧之，直候火烧药罐子9分来通赤，专看口缝处有碧焰子起，便急手拨炭火，急将柴灰3斗都盖勿令气焰出，直候冷，拨灰取出，刮去泥土。以上是煅一度该也，度度依此煅之。第二度依前法，杵药草裹固煅之如前法。煅五度，若火候得所，煅出如熟鸡子香，即是候也。若急要服，只煅两度亦可服之（煅度数多者为妙）。煅度数足，便于净地上埋炉子1宿出火毒（凡逐度煅了，刮去下面砂石尤妙），又取出炉子，于铫子着水煮10-20沸，然后敲破炉子，取药杵烂，更入乳钵内点，煎水研烂如泥，并无粗者，却研令干，每1两药用蒸饼1两以来，浸握出水了，入药内和合，更与茶臼内杵令匀，如面，为丸如梧桐子大，晒干。";
  ex:hasPrescription "硫黄（一名石葶脂，一名金液）3-5两至10两（并煅，得舶上黄为第一，余黄并使得，但无夹杂为上；碎碾入罐子内，可得8-9分，无妨）。";
  ex:hasUsage "金液丹（《苏沈良方》卷三）、金液散（《普济方》卷三九五）。" .

<medicine:煎猪肪方> a ex:Medicine;
  ex:hasFunction "大虚羸，困极。";
  ex:hasName "煎猪肪方";
  ex:hasPrescription "不中水猪肪1大升，葱白1茎。";
  ex:hasUsage "本方方名，《寿亲养老》引作“煎猪脂方”，《普济方》引作“煎膏”。" .

<medicine:煎膏药方丹> a ex:Medicine;
  ex:hasFunction "一切痈疽，恶毒诸疮。";
  ex:hasName "煎膏药方丹";
  ex:hasPrescription "元参5钱，苦参5钱，黄芩5钱，杏仁5钱，白芷5钱，大黄5钱，金银花5钱，天花粉5钱，连翘5钱，归尾1两，赤芍5钱，丹皮5钱，黄耆5钱。";
  ex:hasUsage "每一料，用真麻油1斤，真粉心半斤，将各药锉片，入油浸2宿，文武火煎，以药纯黑为度，去滓净，然后研细粉心入药，用桃枝不住手搅，滴水成珠不散为度，再加阿魏末1钱，名阿魏膏。" .

<medicine:煎蜜散> a ex:Medicine;
  ex:hasFunction "男子阴疮损烂。";
  ex:hasName "煎蜜散";
  ex:hasPrescription "黄柏。";
  ex:hasUsage "上烂煮，洗局部，又用白蜜涂之；或以蜜炙焦为末，敷于疮上。" .

<medicine:煎金饮> a ex:Medicine;
  ex:hasAlias "代赭石散";
  ex:hasFunction "小儿不拘阴阳证发痫者。";
  ex:hasName "煎金饮";
  ex:hasPreparation "以代赭石为细末，水飞极细，晒干。";
  ex:hasPrescription "代赭石。";
  ex:hasUsage "每服半钱或1钱，用真金煎汤调下，连进3服。" .

<medicine:煎银饮子> a ex:Medicine;
  ex:hasFunction "小儿热渴不止。";
  ex:hasName "煎银饮子";
  ex:hasPrescription "银5两，石膏2两，寒水石2两，蚕蛹茧2两。";
  ex:hasUsage "上以水3升，入银石三味，煎至1升，去银石；次下蛹茧，更煎至7合，去滓，每服半合，温温服之，不拘时候。" .

<medicine:煎附子法> a ex:Medicine;
  ex:hasFunction "补益。主";
  ex:hasName "煎附子法";
  ex:hasPrescription "生大附子1个（重9钱以上者，去皮脐，切片；捶碎亦得），晋枣10枚，生姜（切）2两。";
  ex:hasUsage "本方方名，《普济方》引作“附子煎”。" .

<medicine:煎麦散> a ex:Medicine;
  ex:hasAlias "麦煎汤、麦煎散";
  ex:hasFunction "退劳倦，调顺经络。主营卫不调，夜多盗汗，四肢烦疼，饮食进退，肌瘦面黄。";
  ex:hasName "煎麦散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "大鳖甲2两（醋煮30-50沸后，净去裙襕，另用好醋煮令香），银州柴胡2两（去苗），大川乌头1两（炮制去皮脐），元参3两，干漆1两（炒），干葛1两，秦艽2两（去土），人参1两，茯苓1两。";
  ex:hasUsage "麦煎汤（《圣济总录》卷八十八）、麦煎散（《三因》卷十）。" .

<medicine:照水丹> a ex:Medicine;
  ex:hasAlias "点水丹（《普济方》卷七十八）。";
  ex:hasFunction "治眼翳；赤翳攀睛贯瞳仁。";
  ex:hasName "照水丹";
  ex:hasPreparation "上二味，乳钵内细碾，水飞过，澄取；又用黄蜡少许熔化入药；待要用时，就火旋丸，如萝卜子大。";
  ex:hasPrescription "朱砂15克 海螵蛸3克";
  ex:hasUsage "临睡时用1丸点入眼角，紧合眼睡着，次日用温汤洗下。未全退者，更用一服，极妙。用此药后，或更以所吃药与之，尤妙。" .

<medicine:煨姜圆> a ex:Medicine;
  ex:hasFunction "治本脏虚，饮食不化，或成倂癖，或发心痛。";
  ex:hasName "煨姜圆";
  ex:hasPrescription "附子、木香、生姜。";
  ex:hasUsage "以生姜一块，擘作两片，以药在内，湿纸裹令煨，候姜热，白汤嚼下，空心服。" .

<medicine:煨肾丸> a ex:Medicine;
  ex:hasFunction "补益肝肾。治肾肝损及脾损，纳谷不化，腰痛不起者。";
  ex:hasName "煨肾丸";
  ex:hasPreparation "上为细末，酒煮猪腰子为丸。";
  ex:hasPrescription "牛膝（酒浸）萆薢 杜仲 苁蓉 菟丝子 防风 白蒺藜 胡芦巴 破故纸等分 桂减半";
  ex:hasUsage "每服50～70丸空腹酒下。" .

<medicine:煮肝散> a ex:Medicine;
  ex:hasFunction "治小儿疳积，眼生翳膜；大人雀目。";
  ex:hasName "煮肝散";
  ex:hasPreparation "上药研为细末。";
  ex:hasPrescription "青蛤粉 夜明砂 谷精草各等分";
  ex:hasUsage "每次15～21克，猪肝内煮热，细嚼，用茶清送下。" .

<medicine:煮黄丸> a ex:Medicine;
  ex:hasAlias "煮雄丸（《脉因证治》卷上）。";
  ex:hasFunction "泻结导滞。治内伤饮食，外感风寒，卒发心痛，大便或秘，久而滞闷，心胸高起，按之愈痛，不能饮食者。";
  ex:hasName "煮黄丸";
  ex:hasPreparation "上二味，入白面60克，合和研匀，滴水为丸，如梧桐子大。";
  ex:hasPrescription "雄黄30克（另研）巴豆15克（生用，去皮，研烂）";
  ex:hasUsage "每服时，先煎浆水令沸，下药24丸，煮三十沸，捞人冷浆水中沉冷，一时服1丸，一日24丸，加至微利为度，用浸药水送下。" .

<medicine:熊胆圆> a ex:Medicine;
  ex:hasFunction "杀疳退惊。治壮热昏愦，呕吐痰涎，颊赤面黄，鼻干目涩，有时盗汗，或即虚惊，荏苒不除，乳食不进。";
  ex:hasName "熊胆圆";
  ex:hasPrescription "熊胆（研）、胡黄连（木），各二钱；使君子（麸炮.为末）、天浆子（麸炒），各七个；青黛（研）一钱，寒食面三钱，麝香（研）一分，细墨（烧淬）半钱。";
  ex:hasUsage "每服五圆至七圆，米饮下，不计时候。" .

<medicine:熊胆膏> a ex:Medicine;
  ex:hasFunction "痔漏。";
  ex:hasName "熊胆膏";
  ex:hasNote "药不宜多用。";
  ex:hasPreparation "上五味，研匀，于腊日用豮猪胆1个取汁和药，再将药装入胆囊内，用绵绳系定，揉匀，以松明黑烟熏令遍黑，挂于阴处。";
  ex:hasPrescription "熊胆少许，片脑少许（研细）。";
  ex:hasUsage "用井花水调。以鸡毛搽痔上。" .

<medicine:熊脂膏> a ex:Medicine;
  ex:hasFunction "祛风止痒，润肤杀虫。治鹅掌风。";
  ex:hasName "熊脂膏";
  ex:hasPreparation "上药各为末。";
