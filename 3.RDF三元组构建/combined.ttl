  ex:hasPrescription "香附1两（炙），茯苓4两，琥珀5钱。";
  ex:hasUsage "每服1丸，细嚼，早晚2服，白滚水送下。" .

<medicine:交感丹> a ex:Medicine;
  ex:hasFunction "补虚损，固精气，乌髭发；久服令人有子。主";
  ex:hasName "交感丹";
  ex:hasPreparation "上为末，陈米湖为丸，如梧桐子大。";
  ex:hasPrescription "茅山苍术1斤（刮净，分作4份，用酒、醋、米泔、盐汤各浸7日，晒，研），川椒红4两，小茴香4两。";
  ex:hasUsage "每服40丸，空心温酒送下。" .

<medicine:交感地黄煎丸> a ex:Medicine;
  ex:hasAlias "交感地黄丸";
  ex:hasFunction "妇人产前产后，眼见黑花；或即发狂，如见鬼状；胞衣不下；失音不语，心腹胀满，水谷不化，口干烦渴，寒热往来，口内生疮，咽中肿痛，心虚忪悸，夜不得眠；产后中风，角弓反张，面赤，牙关紧急；崩中下血，如豚肝状，脐腹 (疒丂)痛，血多血少，结为症瘕，恍惚昏迷，四肢肿满；产前胎不安；产后血刺痛。";
  ex:hasName "交感地黄煎丸";
  ex:hasPreparation "上为末，炼蜜为丸，如弹子大。";
  ex:hasPrescription "生地黄（洗净，研，以市裂汁留滓，以生姜汁炒地黄滓，以地黄汁炒生姜滓，各至干，堪为末为度）2斤，生姜（净洗，研烂，以布裂汁留滓）2斤，延胡索（拌糯米，炒赤，去米）1两，当归（去苗）1两，琥珀（别研）1两，蒲黄（炒香）4两。";
  ex:hasUsage "交感地黄丸（《女科百问》卷下）。《女科百问》有小茴香四两。" .

<medicine:交感地黄煎圆> a ex:Medicine;
  ex:hasFunction "治妇人产前、产后眼见黑花，或即发狂，如见鬼状，胞衣不下，失音不语，心腹胀满，水谷不化，口干烦渴，寒热往来，口内生疮，咽中肿痛，心虚忪悸，夜不得眠，产后中风，角弓反张，面赤，牙关紧急，崩中下血，如豚肝状，血多血少，结为症症，恍惚昏迷，四肢肿满，产前胎不安，产后血刺痛，皆治之。";
  ex:hasName "交感地黄煎圆";
  ex:hasPrescription "生地黄（净洗.研.以布裂汁留渣.以生姜汁炒地黄渣.以地黄汁炒生姜渣.，各至干.堪为末为度）、生姜（净洗.烂研.以布裂汁留渣），各二斤；延胡索（拌糯米.炒赤.去米）、当归（去苗）、琥珀（别研），各一两；蒲黄（炒香）四两。";
  ex:hasUsage "当归汤化下一圆，食前服。" .

<medicine:交感汤> a ex:Medicine;
  ex:hasFunction "益气清神，降火升水。主心肾不交，遗泄。";
  ex:hasName "交感汤";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "茯神4两，香附1斤，甘草少许。";
  ex:hasUsage "热汤调服。" .

<medicine:交泰丸> a ex:Medicine;
  ex:hasClinicalApplication "临床主要用于治疗失眠、心律失常、神经症等病症。";
  ex:hasFunction "胸中痞闷嘈杂，大便稀则胸中颇快，大便坚则胸中痞闷难当，不思饮食。";
  ex:hasName "交泰丸";
  ex:hasPreparation "上为细末，姜汁打神曲糊为丸，如绿豆大。";
  ex:hasPrescription "黄连1两（姜汁浸，黄土炒），枳实1两（麸炒），白术（去芦，土炒）1两，吴茱萸（汤泡，微炒）2两，归尾（酒洗）1两3线，大黄（用当归、红花、吴茱萸、干漆各1两煎取，洗大黄1昼夜.功碎晒干，仍以酒拌晒之，9蒸9晒）4两。";
  ex:hasUsage "每服70-80丸，白滚汤送下，不拘时候。" .

<medicine:交泰丹> a ex:Medicine;
  ex:hasFunction "镇坠。主小儿因吐泻之后，变成慢（敬鸟），累服热药，上热下冷，涎鸣气粗，服药虽多，止在膈上，不入中，此药治虚阳潮上，发搐来去。";
  ex:hasName "交泰丹";
  ex:hasPreparation "上为末，姜汁煮糊为丸，如绿豆大。";
  ex:hasPrescription "黑铅1两，硫黄3钱，水银3钱，天浆子21个，蜈蚣1条，朱砂2钱，附子（炮，去皮脐）2钱，铁液粉2钱，全蝎1钱，蛇肉（酒浸，去骨）1钱，麝香半钱，槐枝2寸，柳枝2寸（细细锉，同铅入铫子炭灰上煅，别将槐柳枝各1茎不住手打，旋入硫黄，冷，次入水银煎为沙子为度，地上出火气）。";
  ex:hasUsage "每服3丸，食前米饮汤送下。如病热速，炼蜜和丸，如鸡头子大1丸，薄荷汤化下。" .

<medicine:交泰散> a ex:Medicine;
  ex:hasFunction "咽喉肿痛。";
  ex:hasName "交泰散";
  ex:hasPreparation "上细锉。";
  ex:hasPrescription "大南星。";
  ex:hasUsage "以酽醋磨涂涌泉穴。" .

<medicine:交泰饮> a ex:Medicine;
  ex:hasFunction "滋阴降火，交通心肾。主心肾不交。（神经衰弱）";
  ex:hasName "交泰饮";
  ex:hasPrescription "黄连6克，肉桂6克，玄参10克。";
  ex:hasUsage "水煎服，每日1剂，日服2次。" .

<medicine:交济散> a ex:Medicine;
  ex:hasFunction "血结作痛。";
  ex:hasName "交济散";
  ex:hasPreparation "上药各洗净，同杵，治留一夕，焙干为末。";
  ex:hasPrescription "生地黄半斤，生姜4两。";
  ex:hasUsage "每服2钱，温酒调下；男女血热心烦，或产后伤风，则以荆芥煎汤调下。" .

<medicine:交济汤> a ex:Medicine;
  ex:hasFunction "中风。";
  ex:hasName "交济汤";
  ex:hasPrescription "小续命汤、排风汤、人参顺气汤、乌药顺气散。";
  ex:hasUsage "上4药合和，加槟榔、石菖蒲、生姜，水煎服。" .

<medicine:交肾汤> a ex:Medicine;
  ex:hasFunction "心肾不交，心跳。";
  ex:hasName "交肾汤";
  ex:hasPrescription "熟地、枣皮、山药、茯神、黄连、肉桂。" .

<medicine:交藤丸> a ex:Medicine;
  ex:hasFunction "漏疮。";
  ex:hasName "交藤丸";
  ex:hasNote "忌猪羊肉。";
  ex:hasPreparation "上为细末，醋煮面糊为丸，如梧桐子大。";
  ex:hasPrescription "血竭半两（别研），马蔺根1斤，川乌头（炮，去皮脐）2两，人参（去芦头）2两，黄丹2两（水飞），何首乌4两，甘草2两（炙）。";
  ex:hasUsage "每服30丸，空心、食前盐汤或酒送下。候服药了，用茵陈汤洗之，如疮干无脓血后，用三黄散贴之。" .

<medicine:交解饮> a ex:Medicine;
  ex:hasFunction "治脾胃气弱，阴阳胜复，发为痎疟。（疟疾）";
  ex:hasName "交解饮";
  ex:hasPreparation "上药为散。";
  ex:hasPrescription "肉豆蔻（半生，半面裹煨）草豆蔻（如上法）甘草（半生，半炙）厚朴（半生，半姜制炒）各等分";
  ex:hasUsage "每服12克，用水300毫升，煎至210毫升，去滓，空腹服。" .

<medicine:亥药> a ex:Medicine;
  ex:hasAlias "回生丹";
  ex:hasFunction "开关窍，降痰。主";
  ex:hasName "亥药";
  ex:hasPreparation "每1两矾，加小姜黄末1钱，面糊为丸，如梧桐子大，用雄黄末2钱为衣。";
  ex:hasPrescription "巴豆21粒，生矾1两（入银罐内熔之，看矾枯，去巴豆）。";
  ex:hasUsage "用辰药后可服此丸，重者用之，轻者不用。" .

<medicine:亥骨饮> a ex:Medicine;
  ex:hasFunction "消渴。";
  ex:hasName "亥骨饮";
  ex:hasPrescription "猪脊骨5寸，大枣20枚（劈碎），甘草（微炙，锉）半分，干姜（炮）半分。";
  ex:hasUsage "以水3升，同煎至2升，发时量意加熟水服。" .

<medicine:产(疒颓)土龙汤> a ex:Medicine;
  ex:hasFunction "胎前产后诸疾。";
  ex:hasName "产(疒颓)土龙汤";
  ex:hasPrescription "紫苏、陈皮、川芎、荆芥、厚朴、茯苓、甘草。";
  ex:hasUsage "如有热，可加黄芩。" .

<medicine:产后丸> a ex:Medicine;
  ex:hasAlias "人参回生丹";
  ex:hasFunction "妇人产后恶露未净，小腹胀痛，症瘕。";
  ex:hasName "产后丸";
  ex:hasPreparation "上为细末，用大黄膏擦丸，每粒潮重2钱，蜡壳封护。";
  ex:hasPrescription "人参3钱，蒲黄1两，甘草5钱，白术3钱，赤茯苓1两，川羌活5钱，青皮3钱，桃仁1两，陈皮5钱，木瓜3钱，熟地1两，白芍5钱，当归1两，怀牛膝5钱，良姜4钱，川芎1两，京三棱5钱，乌药2两5钱，元胡索1两，山萸肉5钱，广木香1钱，焦苍术1两，五灵脂5钱，制乳香1钱，制香附1两，地榆5钱，制没药1钱。";
  ex:hasUsage "大黄膏制法：西绵纹大黄一斤（用米醋三斤熬成稠汁），苏木（水煎汁），红花（黄酒煮汁炒）各三两，黑大豆四斤（水浸，取皮约五两，豆煮汁）。将苏木汁、红花酒、黑豆汁加入大黄汁内，共熬成膏。（如黑豆不易购买，可用稆豆衣四斤代替）。" .

<medicine:产后救生丸> a ex:Medicine;
  ex:hasFunction "化滞生新，行瘀止痛。主产后恶露不尽，败血上冲，神昏谵语，不省人事，暴脱下血，脐腹疼痛。";
  ex:hasName "产后救生丸";
  ex:hasNote "孕妇忌服。";
  ex:hasPreparation "上为极细末，炼蜜为丸，2钱重，蜡皮封固。";
  ex:hasPrescription "百草霜4两，川芎5钱，丹参1两，炮姜2两，明天麻1两，飞罗面2两，茯神2两，柴胡5钱，熟地1两，当归2两，阿胶珠1两，麦冬1两，广木香1两，凤眼草1两，京墨5钱，远志2两，红花饼5钱。";
  ex:hasUsage "每服1丸，空心姜汤送下。" .

<medicine:产后理血丹> a ex:Medicine;
  ex:hasFunction "逐瘀血，生新血，消积止痛。主妇女产后恶露不行，胞衣不下，少腹胀痛，恶血上冲，晕迷不醒等症。";
  ex:hasName "产后理血丹";
  ex:hasNote "孕妇忌服，血虚无瘀者禁用。";
  ex:hasPreparation "上为极细末，好醋5两，大黄末1两，同熬成膏，和药为小丸。";
  ex:hasPrescription "附子半两，丹皮1两，干漆1两。";
  ex:hasUsage "每服5分-1钱，温酒冲服。" .

<medicine:产后调理方> a ex:Medicine;
  ex:hasFunction "主妇女产后瘀阻，小腹疼痛，结块拒按。";
  ex:hasName "产后调理方";
  ex:hasNote "产后恶露过多，无儿枕痛者不可用此方。";
  ex:hasPrescription "当归身9克 川芎4.5克 生地6克 赤芍药4.5克 元胡（醋制）6克 牛膝15克 蒲黄4.5克 干姜（炒黑）2.1克 肉桂（火盛者及夏月勿用）2.1克 山楂肉9克 五灵脂（醋炒，去沙）3克 桃仁（去皮、尖）红花各2.4克 黑豆（炒）30克 杜仲（炒去丝）6克 续断6克 益母草15克 泽兰叶3克 荆芥穗（炒）3克";
  ex:hasUsage "水煎，人童便服。" .

<medicine:产复康颗粒> a ex:Medicine;
  ex:hasFunction "补气养血，排瘀生新。用于产后出血过多，气血俱亏，腰腿酸软，倦怠无力等。";
  ex:hasName "产复康颗粒";
  ex:hasPrescription "益母草、当归、人参、黄芪、何首乌、桃仁、蒲黄、熟地黄、香附（醋制）、昆布、白术、黑木耳";
  ex:hasUsage "开水冲服，一次20g，一日3次；5～7天为一疗程；产褥期可长期服用。" .

<medicine:产宝丸> a ex:Medicine;
  ex:hasFunction "逆生难产，胎死腹中，产后诸疾。";
  ex:hasName "产宝丸";
  ex:hasNote "忌铁器、生冷、面食。";
  ex:hasPreparation "上药同黑豆皮俱为末，投入大黄膏内捣千余下，为丸，如龙眼大，带湿重2钱4分；如干难为丸，加酒少许，再捣，以成丸为度；晒干，如阴天以火烘干，新瓷器收贮，忌铁器。";
  ex:hasPrescription "大黄1斤（晒干，为末），苏木3两（劈细，河水5碗，煎汁3碗，去滓存汁），红花3两（略炒黄色，用好短水白酒5碗，煎汁3碗，去滓存汁），黑豆3升（煮熟取汁3碗，并取豆皮晒干存用）将大黄末8醋5宫碗，搅匀，文武火熬成膏，次下豆汁、苏木汁、红花汁，渐渐加下，时时搅动，勿令生焦，候成膏取起听用。当归（酒洗，蒸，晒干）1两，川芎（蒸，晒）1两，香附（醋炒）1两，熟地（晒干）1两，玄胡（生用）1两，苍术（米泔水浸，炒）1两，蒲黄（微炒）1两，赤茯苓（蒸，晒）1两，白茯苓（蒸，晒）1两，桃仁（去皮尖油，晒干）1两，三棱（醋炒）5钱，牛膝（酒浸，蒸，晒干）5钱，地榆（去梢，蒸，晒干）5钱，甘草（生用）5钱，五灵脂（醋炒）5钱，羌活（蒸，晒干）5钱，陈皮（生用）5钱，广木香5钱，赤芍（炒）5钱，山茱萸（去核.炒）5钱，人参（炒）5钱，木瓜（酒浸，晒干）3钱，青皮（生用），白术（土炒）3钱，乳香（炙）2钱，没药（炙）2钱，良姜（生用）4钱，乌药2钱5分（蒸，晒干），饭锅粑9两（焦黄者佳，取锅底下手掌大1块）。";
  ex:hasUsage "每服1丸，照症用引。临产艰难，服之易产，调和经络，诸症不生，产后恶露不尽，再服1丸，以上俱温酒送下，如不善酒，以滚水对酒加童便少许尤妙；或变生异症，或胎死腹中单所不载者，俱以童便、黄酒各半，连服2丸，立效；产后胞衣不下，及逆生难产，甚至经日不下，腹中胀满，心胸闷痛者，炒盐汤送下；临产前后，脐腹作痛，寒热往来如疟状痢疾者，温米汤送下。产后大小便不通，烦燥口苦者，浓煎薄荷汤送下；产后泻血，大枣汤送下；产后崩疾，糯米汤送下；产后赤白带下，煎阿胶、艾叶汤送下；产后咳嗽不止，五味子5粒、苏叶3片，煎酒送下。产后头疼身热、有汗为伤风，桂枝3分，姜、葱煎汤送下；产后头疼、身热、无汗为伤寒，麻黄2分，姜、葱煎汤送下；如症轻者，每丸作2服。" .

<medicine:产宝散> a ex:Medicine;
  ex:hasFunction "妇人产后恶物不出，上攻心痛；子死腹中，母亦将绝。";
  ex:hasName "产宝散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "赤伏龙肝。";
  ex:hasUsage "每服3-5钱，酒调下，泻出恶物立止。" .

<medicine:产宝汤> a ex:Medicine;
  ex:hasFunction "产后血余作痛，兼块者。";
  ex:hasName "产宝汤";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "桂心、姜黄各等分。";
  ex:hasUsage "每服方寸匕，酒调下。" .

<medicine:产灵丹> a ex:Medicine;
