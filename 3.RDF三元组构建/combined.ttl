  ex:hasPrescription "豆浆汁500克 粳米50克 砂糖或细盐适量";
  ex:hasUsage "每日早晚餐，温热食。" .

<medicine:豆花散> a ex:Medicine;
  ex:hasFunction "妇女白崩不止。";
  ex:hasName "豆花散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "白扁豆花（焙干，紫者不用）。";
  ex:hasUsage "炒米煮饮，入烧盐少许，空心数服。" .

