  ex:hasPrescription "苍耳子31g，明矾15g，苦参15g，蛇床子15g，黄柏15g。";
  ex:hasUsage "水煎洗。" .

<medicine:苍耳丸> a ex:Medicine;
  ex:hasAlias "苍耳子丸";
  ex:hasFunction "久疟不愈。";
  ex:hasName "苍耳丸";
  ex:hasPreparation "上锉，焙干，为末，酒煮面糊为丸。";
  ex:hasPrescription "苍耳草子、根、茎皆可用。";
