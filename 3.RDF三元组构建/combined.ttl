  ex:hasUsage "空心米饮下。" .

<medicine:萝藦茶> a ex:Medicine;
  ex:hasFunction "补暖。主风及气。";
  ex:hasName "萝藦茶";
  ex:hasPreparation "每旋取，碾为末。";
