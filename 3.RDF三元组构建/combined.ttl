  ex:hasPrescription "瓜蒌2枚（烧存性），猬皮2个（锉碎，罐内烧存性），鸡冠花（锉，微炒）5两，胡桃仁15个（不油者，入罐内烧存性），白矾（枯）2两，绿矾（枯）2两，白附子（生用）2两，天南星（生用）2两，枳壳（去瓤，麸炒）2两，附子（去皮脐，生用）2两，诃子（煨，去皮）2两，半夏（生）2两。";
  ex:hasUsage "钩肠丸（《疡科选粹》卷五）。《卫生宝鉴》有乱发，无瓜蒌。" .

<medicine:钓肠圆> a ex:Medicine;
  ex:hasFunction "治久新诸痔，肛边肿痛，或生疮痒，时有脓血。";
  ex:hasName "钓肠圆";
  ex:hasPrescription "瓜蒌二枚（烧存性），？皮两个（碎.罐内烧存性），鸡冠花（微炒）五两，胡桃（取仁一十五个.不油者.入罐内烧存性），白矾（枯）、绿矾（枯）、白附子（生用）、天南星（生用）、枳壳（去瓤.麸炒）、附子（去皮.脐.生用）、诃子（煨.去皮）、半夏，各二两。";
  ex:hasUsage "每服二十圆，空心，临卧温酒下，远年不瘥者，服十日见效，久服永除根本。" .

<medicine:钓苓散> a ex:Medicine;
  ex:hasFunction "恶疮，久治不愈。";
  ex:hasName "钓苓散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "井盐1两，无心草2两，干姜2两，钓苓根3两。";
  ex:hasUsage "本方方名，《普济方》引作“钩苓散”。" .

<medicine:钓藤丸> a ex:Medicine;
  ex:hasAlias "钩藤丸";
  ex:hasFunction "小儿风痫，时发时止，经年累月不休。";
  ex:hasName "钓藤丸";
  ex:hasPreparation "上为细末（除另研者外），软饭为丸，如黄米大。";
  ex:hasPrescription "钓藤半两，川升麻半两，乌犀（镑）半两，黄芩（去黑心并皮）半两，玄参半两，茯神半两，防风（去芦头）半两，秦艽半两，槟榔半两，黄连半两，大黄半两，地骨皮半两，天竺黄半两，甘草（炙）半两，牙消半两，麦门冬（去心）半两，龙齿半两，琥珀半两，青黛半两，珍珠（另研）半两，麝香半两，牛黄半两，丹砂（另研）半两，龙胆半两，蜣螂（去头足翅）3个，蝉（去头足翅，生用）3个，人参1两，金箔40片，银箔40片（同研），虎睛1对（酒浸，焙干）。";
  ex:hasUsage "每1岁儿服20-30丸，人参汤或薄荷汤送下。" .

<medicine:钓藤大黄汤> a ex:Medicine;
  ex:hasFunction "小儿伤寒不解，发惊妄语，狂躁潮热；以及小儿伤食，作惊发痫，不吃乳食，发热啼哭。";
  ex:hasName "钓藤大黄汤";
  ex:hasPreparation "上为粗末。";
  ex:hasPrescription "钓藤皮半两，当归半两，甘草（炙）半两，芍药半两，大黄3分。";
  ex:hasUsage "每服3钱，水1盏，煎至6分，温服。以利为度，难利者，间服茵陈丸。" .

<medicine:钓藤散> a ex:Medicine;
  ex:hasAlias "钩藤散";
  ex:hasFunction "小儿急惊风。";
  ex:hasName "钓藤散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "钓藤、天竺黄、犀角屑、蝉退、甘遂（煨）、甘草（炙）各等分。";
  ex:hasUsage "每服半钱，金银薄荷煎汤调下，1日4次。" .

<medicine:钓藤汤> a ex:Medicine;
  ex:hasAlias "钩藤饮子、钩藤散、钩藤汤";
  ex:hasFunction "传尸痨，瘦羸骨蒸，复连殗殜，命在须臾，精神尚爽。";
  ex:hasName "钓藤汤";
  ex:hasNote "乳母忌海藻、菘菜等。";
  ex:hasPreparation "上为粗末。";
  ex:hasPrescription "钓藤1两，黄芩（去黑心）1两，升麻1两，甘草（炙令赤色，锉）1两，鳖甲（去裙襕，醋浸，炙令黄色）半两，丁香半两，大黄（锉，微炒）4两。";
  ex:hasUsage "每服5钱匕，水1盏半，煎至1盏，去滓，每日食后分温2服，相去如人行7-8里，再服之。" .

<medicine:钓藤煎> a ex:Medicine;
  ex:hasFunction "小儿虚风。";
  ex:hasName "钓藤煎";
  ex:hasPreparation "上为细末，炼蜜和成煎。";
  ex:hasPrescription "钓藤1分，防风（去叉）1分，芎1分，天麻（酒浸，切，焙）1分，麻黄（去根节）1分，荆芥穗半两，蝉蜕（去土）半两，蝎梢（炒）半两，白僵蚕14枚（炒），薄荷心26枚（酒浸，焙），龙脑1字，麝香1字（研）。";
  ex:hasUsage "每服皂子大，荆芥、紫参煎汤化下。" .

<medicine:钓藤紫草散> a ex:Medicine;
  ex:hasFunction "令疹出快。主小儿斑疹、疮疹。";
  ex:hasName "钓藤紫草散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "钓藤钩子、紫草茸各等分。";
  ex:hasUsage "每服1字至半钱，温酒调下，不拘时候。" .

<medicine:钓藤膏> a ex:Medicine;
  ex:hasFunction "小儿禀受虚怯，邪干心痛，以及内吊夜啼，面唇青冷。";
  ex:hasName "钓藤膏";
  ex:hasPreparation "上为末，炼蜜为丸，如豌豆大。";
  ex:hasPrescription "乳香（用灯心研末）1两，五灵脂1两，没药1两，当归1两，麝香1字。";
  ex:hasUsage "小儿百日内1丸，1岁2丸，3岁3丸，钓藤煎汤化下，或乳香煎汤化下，不拘时候。" .

<medicine:钓藤饮> a ex:Medicine;
  ex:hasAlias "钩藤饮";
  ex:hasFunction "小儿吐泻，体虚发搐，遂作慢脾风，鱼口，目直视，睡不醒，或目不开。";
  ex:hasName "钓藤饮";
  ex:hasNote "乳母需忌口，不得再惊。";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "钓藤1分，防风1分，麝1分，麻黄（净）1分，蝎梢半分，蝉壳半分。";
  ex:hasUsage "本方方名，原书人卫本作“钩藤饮子”。" .

<medicine:钓藤饮子> a ex:Medicine;
  ex:hasAlias "钩藤饮、钩藤饮子、蝉壳饮";
  ex:hasFunction "小儿阴痫，多睡，手足冷，时瘈疭，目直视，乳食不进。";
  ex:hasName "钓藤饮子";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "钓藤钩子3分，白僵蚕（去丝嘴，炒）1分，川芎1分，蝉蜕（去头翅足，炙）1分，蛇蜕（炙）1分，甘草（炙）1分，蜣螂（去头翅足，炙）3枚。";
  ex:hasUsage "钩藤饮（《旅舍》）、钩藤饮子（《卫生总微》卷五）、蝉壳饮（《普济方》卷三七一引《卫生家宝》）。" .

<medicine:钓虫丸> a ex:Medicine;
  ex:hasFunction "传尸痨病，痿羸，两脸常赤，咳嗽喘急，心胸满闷，四肢无力，梦与鬼交。";
  ex:hasName "钓虫丸";
  ex:hasPreparation "上为细末，以黄蜡4两为丸，如梧桐子大。";
  ex:hasPrescription "磁石（细研，生用）2两，硇砂（汤熬令熟）2两，龙骨3两，腻粉半两，麝香（取末）7两。";
  ex:hasUsage "用线5-7寸长，一头系钱1文，一头穿药丸，令患者空心新水吞药丸，钱留在口外，候恶心时以手拽线，吐出药丸，其上有虫，急用油将虫炸死。" .

<medicine:钓虫神功夺命散> a ex:Medicine;
  ex:hasFunction "传尸痨。";
  ex:hasName "钓虫神功夺命散";
  ex:hasPreparation "上为细末，蜡为丸，如绿豆大。";
  ex:hasPrescription "石燕1个（火煅，醋淬7次），母丁香1钱半，酒蜡半两，鳖甲1个，水磨硫黄2钱。";
  ex:hasUsage "本方方名，据剂型，当作“钓虫神功夺命丸”。" .

<medicine:钓虫黑白丸> a ex:Medicine;
  ex:hasFunction "虫病，肚腹作痛，以及肺窍失声者。";
  ex:hasName "钓虫黑白丸";
  ex:hasNote "须用极高山顶上泉水，或武当回龙水煮糊为丸，方不化。";
  ex:hasPrescription "白丸子：磁石、云母石、蛇含石、甘草各等分（上为未，糯米糊为丸，如黄豆大。），黑丸子：针砂、青黛、枯矾、甘遂各等分（上为末，醋煮糯米糊为丸，如龙眼核大。）。";
  ex:hasUsage "先以灯心煎汤，送下白丸子1丸；后以粗线1条穿住黑丸子，仍以灯心煎汤送下，待病者作呕；若不呕，再喝乌梅水1口，又含冷水1口，方为病者捶打胸背，并略抽动其线，令病人吐去冷水，仍作呕声，如此3-4次，则黑白丸子挟病根瘀血俱吐泻，吐后须随各经病调治。" .

<medicine:钓钩藤散> a ex:Medicine;
  ex:hasFunction "马（疒其）肿疡病后，筋脉拘急。";
  ex:hasName "钓钩藤散";
  ex:hasPrescription "钓钩藤、伸筋藤、石南藤、羊带归根、天灯心、狗骨子根、珍珠帘根、豨莶草根。";
  ex:hasUsage "水煎，入酒和服。" .

<medicine:钓骨丸> a ex:Medicine;
  ex:hasFunction "骨梗咽喉。";
  ex:hasName "钓骨丸";
  ex:hasPreparation "上捣为丸，如梧桐子大。";
  ex:hasPrescription "栗子肉上皮半两（为末），鲇鱼肝1个，乳香2钱5分。";
  ex:hasUsage "视骨梗远近，以线系绵裹1丸，水润吞下，提线钓骨出之。" .

<medicine:钓鳌丸> a ex:Medicine;
  ex:hasFunction "骨梗咽喉，不能吞吐，势急者。";
  ex:hasName "钓鳌丸";
  ex:hasPreparation "用酽醋浸2日，晒干为末，醋糊为丸，如梧桐子大。";
  ex:hasPrescription "威灵仙根不拘多少。";
  ex:hasUsage "每服1-2丸，半茶半汤送下。如觉要吐，用砂糖、铜青为末，共半匙，滴油1-2点，以茶汤调服，即可吐出原物；如药性来迟，令患者两手伏地，用清水1盆，鹅翎搅乱即吐出。" .

<medicine:钟乳丸> a ex:Medicine;
  ex:hasFunction "治小儿解颅囟大，身有痼热，头汗出，腹胀，咳嗽上气，肩息胫蹇，年已三岁尚不能行。";
  ex:hasName "钟乳丸";
  ex:hasPreparation "上药捣罗为末，入研了药，更研令匀，以犬脑髓和丸，如麻子大。";
  ex:hasPrescription "钟乳粉7.5克 防风7.5克（去芦头）熟干地黄15克 牛黄7.5克（细研）甘草7.5克（炙微赤，锉）漆花7.5克";
  ex:hasUsage "每次以粥饮送下3丸，早晨、午间、日晚各一次。" .

<medicine:钟乳健脾圆> a ex:Medicine;
  ex:hasFunction "治男子、妇人虚损羸瘦，身体沉重，脾胃泠弱，饮食不消，腹胀雷鸣，泄泻不止。";
  ex:hasName "钟乳健脾圆";
  ex:hasPrescription "肉桂（去粗皮）、人参、黄连（去须）、干姜（炮）、龙骨、当归（去芦）、石斛（去根）、大麦蘖（炒）、茯苓（去皮）、细辛（去苗土）、神僸（碎炒）、赤石脂（煅），各二两；蜀椒（去目及闭口者.微炒出汗）六两，附子（炮.去皮.脐）一两，钟乳粉三两。";
  ex:hasUsage "每服三十圆，温米饮下，食前，日三服。" .

<medicine:钟乳泽兰圆> a ex:Medicine;
  ex:hasFunction "补虚羸，益血气。治冲任虚损，月水不调，腰腿沉重，四肢倦怠，百节酸痛，心忪恍惚，忧恚不乐，面少光泽，饮食无味。除下脏风冷，治带下三十六疾，崩中漏下五色，子宫久冷无子，及数堕胎，或因产劳损，冲任血气虚羸，肌瘦嗜卧。久服补暖元脏，润泽肌肤，长发去僢，除头风，令人有子。";
  ex:hasName "钟乳泽兰圆";
  ex:hasPrescription "钟乳粉三两，泽兰二两二钱半，芜荑（炒）半两，麦门冬（去心.焙）一两半，山茱萸一两二钱半，艾叶（醋炒）七钱半，防风一两七钱半，柏子仁（炒.别捣）、人参（去芦）、石膏（研飞）、石斛（去根）、熟干地黄（酒蒸），各一两半；川芎、甘草（微炙赤）、牛膝（去芦.酒浸.焙）、白芷、山药、当归（去芦.炒）、细辛（去苗.不见火）、肉桂（去粗皮），各一两。";
  ex:hasUsage "每服三十圆至五十圆，温酒或米饮下，空心，食前，日二服。" .

<medicine:钟乳白泽圆> a ex:Medicine;
  ex:hasFunction "治丈夫诸虚百损，五劳七伤，真气不足，元脏不固，神志俱耗，筋力顿衰，头目眩晕，耳内虚鸣，心腹急痛，气逆呕吐，痰嗽喘促，胸膈胀闷，脾泄下痢，遗精便浊，厥冷自汗，脉微欲绝。";
  ex:hasName "钟乳白泽圆";
  ex:hasPrescription "白檀香（取末）、滴乳香（别研），各一两；阳起石（煅令通红.研）、附子（炮.去皮.脐），各一两；半钟乳粉二两，麝香（别研）一钱。";
  ex:hasUsage "每服一圆，水一盏，煎化及七分盏，空心热服，如急病，不拘时。" .

<medicine:钟乳补肺汤> a ex:Medicine;
  ex:hasFunction "治肺气不足，咳嗽上气，胸满上迫，喉咽闭塞，短气喘乏，连唾不已，寒从背起，口中如含霜雪，语无音声，甚者唾血腥臭，干呕心烦，耳闻风雨声，皮毛瘁，面色白。";
  ex:hasName "钟乳补肺汤";
  ex:hasPrescription "钟乳（碎如米粒）、桑白皮、麦门冬（去心），各三两；白石英（碎如米粒）、人参（去芦）、五味子（拣）、款冬花（去梗）、肉桂（去粗皮）、紫菀（洗去土），各二两。";
  ex:hasUsage "每服四钱，水二盏，入生姜五片，大枣一枚擘破，粳米三十馀粒，同煎至一盏，用绵滤去滓，温服，食后。" .

<medicine:钩军汤> a ex:Medicine;
  ex:hasFunction "平肝化痰，泻实通腑。主肝阳挟热上犯。";
  ex:hasName "钩军汤";
  ex:hasPrescription "钩藤15克（后下），牡蛎30克（先煎），生石决明30克，生川军4.5克（后下），枳实12克，茯苓12克，黄芩9克，天竺黄9克，丹皮9克，炒槐花9克。";
  ex:hasUsage "水煎服，每日1剂，日服2次。" .

<medicine:钩藤丸> a ex:Medicine;
  ex:hasFunction "小儿天钓，身体壮热，筋脉拘急，时时抽掣。";
  ex:hasName "钩藤丸";
  ex:hasPreparation "上为末，用槐胶为丸，如绿豆大。";
  ex:hasPrescription "钩藤半两，天竹黄1分（研细），牛黄1分（研细），胡黄连半两，天麻1分，白附子1分（炮裂），干蝎1分（微炒），朱砂1分（研细），米粉1分，麝香半分（研细）。";
  ex:hasUsage "于囟门上津调摩1丸，荆芥汤送下1丸。2岁以上加之。" .

<medicine:钩藤大黄汤> a ex:Medicine;
  ex:hasFunction "小儿伤寒，里不解，发惊妄语，狂躁潮热。";
  ex:hasName "钩藤大黄汤";
  ex:hasPreparation "上为粗末。";
  ex:hasPrescription "钩藤皮半两，当归半两，甘草（炙）半两，芍药半两，大黄3分。";
  ex:hasUsage "每服3钱，以水1盏，煎6分，温服。以利为度。" .

<medicine:钩藤子芩汤> a ex:Medicine;
  ex:hasFunction "小儿惊痫体虚者。";
  ex:hasName "钩藤子芩汤";
  ex:hasPreparation "上为粗末。";
