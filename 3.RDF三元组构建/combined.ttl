  ex:hasName "冰片粉";
  ex:hasPrescription "冰片少许。" .

<medicine:冰片鸡蛋油> a ex:Medicine;
  ex:hasFunction "消肿止痛，固皮生肌。主慢性溃疡，烫伤疮面。";
