  ex:hasPreparation "上为末，炼蜜为丸，如鸡头子大。";
  ex:hasPrescription "沙参、丹砂（研）、硇砂（研）、人参、玄参、丹参等分。";
  ex:hasUsage "食后、临卧含1丸化之。" .

<medicine:二砂散> a ex:Medicine;
  ex:hasFunction "小儿惊痫。";
  ex:hasName "二砂散";
  ex:hasPreparation "上为散。";
