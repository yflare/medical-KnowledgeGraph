  ex:hasName "陵鲤甲散";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "陵鲤1头（取甲爪，炙），桂心3分，当归2分。";
  ex:hasUsage "每服方寸匕，日3次，酒进。" .

<medicine:陵鲤甲汤> a ex:Medicine;
  ex:hasFunction "山瘴疾。南方山岭溪源瘴气毒作，寒热发作无时，痿黄肿满，四肢痹弱。";
  ex:hasName "陵鲤甲汤";
  ex:hasNote "忌苋菜、生葱、生菜、猪肉。";
  ex:hasPreparation "上切，以酒3升，渍之1夕。";
