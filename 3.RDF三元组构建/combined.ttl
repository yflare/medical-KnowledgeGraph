  ex:hasFunction "活血祛瘀，行气止痛。主血瘀气滞。";
  ex:hasName "膈下逐瘀肠";
  ex:hasPrescription "五灵脂（炒）6克，当归9克，川芎6克，桃仁（研泥）9克，丹皮6克，赤芍6克，乌药76克，玄胡素3克，甘草9克，香附4.5克，红花9克，枳壳4.5克。";
  ex:hasUsage "水煎服，痛轻者少服，病重者多服，病去药止。" .

<medicine:膈噎汤> a ex:Medicine;
  ex:hasFunction "膈噎。";
  ex:hasName "膈噎汤";
  ex:hasPrescription "熟地2钱，当归1钱，天冬2钱，阿胶2钱，柿饼1钱，元参1钱，贝母1钱，桔梗6分。";
  ex:hasUsage "水煎服。" .

<medicine:膈噎膏> a ex:Medicine;
  ex:hasAlias "噎膈膏";
  ex:hasFunction "润燥。主噎膈。";
  ex:hasName "膈噎膏";
  ex:hasPreparation "熬膏，蜜收。";
  ex:hasPrescription "人参、牛乳、蔗汁、梨汁、芦根汁、龙眼肉汁、姜汁、人乳。";
  ex:hasUsage "噎膈膏（《冷庐医话》卷三）。" .

<medicine:膈毒丸> a ex:Medicine;
  ex:hasFunction "伤寒结胸，心下坚痛。";
  ex:hasName "膈毒丸";
  ex:hasPreparation "上为末，同研匀，用白面糊为丸，如梧桐子大。";
  ex:hasPrescription "郁李仁（去皮）1分，黑牵牛（炒）1分，大戟1分，甘遂1分，牛黄（研）1钱，乳香（研）1钱，麝香（研）半钱，龙脑（研）半钱。";
  ex:hasUsage "每服7丸，临卧煎灯心，小麦汤送下。" .

<medicine:膈气丸> a ex:Medicine;
  ex:hasFunction "痰膈。";
  ex:hasName "膈气丸";
  ex:hasPreparation "上将五灵脂研末，阿魏炖烊，入猪胆汁和丸晒干，叫童子吐涎，润湿透，再晒再吐润，如此8-9次晒干。";
  ex:hasPrescription "五灵脂3钱，阿魏3钱，猪胆汁3个。";
  ex:hasUsage "方中重子涎，可用竹沥代之。" .

<medicine:膈气散> a ex:Medicine;
  ex:hasFunction "常服顺气宽中，消痃癖积聚，散惊忧恚气。主五种膈气。三焦痞塞，胸膈满闷，背膂引疼，心腹膨胀，胁肋刺痛，食饮不下，噎塞不通，呕吐痰逆，口苦吞酸，羸瘦少力，短气烦闷。";
  ex:hasName "膈气散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "肉豆蔻仁5两，木香5两，干姜5两，厚朴（去粗皮，生姜汁制，炒）5两，青皮（去白）5两，甘草（爁）5两，三棱（炮）10两，益智仁10两，莪荗（炮）10两，肉桂（去粗皮）10两，陈皮（去瓤）10两，槟榔10两，枳壳（去瓤，麸炒）10两。";
  ex:hasUsage "每服2钱，水1盏，入生姜2片，大枣半个，同煎7分，和滓热服；如不及煎，入盐少许，沸汤点服亦得，不拘时候。" .

<medicine:膈汤> a ex:Medicine;
  ex:hasAlias "真汤";
  ex:hasFunction "四时不正之气，及伤寒未分证候，疮疹欲出未出；及脾寒似疟，潮热往来，壮热如蒸，两耳黯，唇青，面色黛黑，口苦舌干，四肢倦怠，饮食无味。";
  ex:hasName "膈汤";
  ex:hasPreparation "上为粗末。";
  ex:hasPrescription "苦桔梗、荆芥穗、薄荷叶、干葛、甘草节、栝蒌根、牛蒡子各等分。";
  ex:hasUsage "真汤（原书同卷引《简易方》）。" .

<medicine:膏子药> a ex:Medicine;
  ex:hasAlias "蜜调药、膏滋药";
  ex:hasFunction "喉痈、喉癣、喉菌。";
  ex:hasName "膏子药";
  ex:hasPreparation "先将玉丹、百草霜研和匀后，入灯草灰再研，入薄荷、甘草、贝母，研极细，方入冰片，再研和。";
  ex:hasPrescription "薄荷、玉丹、川贝母、灯草灰、甘草、冰片、百草霜。";
  ex:hasUsage "蜜调药（原书）、膏滋药（《疡医大全》卷十七）。本方方名，《杂病源流犀烛》引作“胶子蜜调药”。" .

<medicine:膏淋汤> a ex:Medicine;
  ex:hasClinicalApplication "临床主要用于治疗乳糜尿等病症。";
  ex:hasFunction "膏淋之证，小便溷浊，更兼稠粘，便时淋涩作疼。";
  ex:hasName "膏淋汤";
  ex:hasPrescription "生山药1两，生芡实6钱，生龙骨（捣细）6钱，生牡蛎（捣细）6钱，大生地（切片）6钱，潞党参3钱，生杭芍3钱。";
  ex:hasUsage "水煎服。" .

<medicine:膏药> a ex:Medicine;
  ex:hasFunction "裙边疮。";
  ex:hasName "膏药";
  ex:hasPreparation "上为末，用麻油4两，蒸滚，先放松香2两，熬至滴水成珠，入铅粉2钱，黄丹1两，取起。";
  ex:hasPrescription "蒺藜4钱，冰片1分，麝香1分，乳香（去油）1钱，没药（去油）1钱，轻粉1钱，青龙骨2钱，象皮2钱。";
  ex:hasUsage "贴患处。" .

<medicine:膏蜜汤> a ex:Medicine;
  ex:hasFunction "产后余血冲心，痛急欲死。";
  ex:hasName "膏蜜汤";
  ex:hasPreparation "用猪膏煎地黄赤色，出之，纳蜜和之令调。";
  ex:hasPrescription "猪膏2分，白蜜1升，生地黄（切）1升。";
  ex:hasUsage "分5服，日3次。" .

<medicine:膏髓酒> a ex:Medicine;
  ex:hasFunction "癖、羸瘠。";
  ex:hasName "膏髓酒";
  ex:hasNote "忌生葱、芜荑。";
  ex:hasPreparation "上药九味为散；取膏、髓等五种汁，加水1斗同煎，取水并药汁俱尽，但余膏在，停小冷，下散，搅令调，火上煎三上三下，燥器贮凝，冷为饼。";
  ex:hasPrescription "猪肪膏3升，牛髓2升，油5升，姜汁3升，生地黄汁3升，当归4分，蜀椒4分（汗），吴茱萸5合，桂心5分，人参5分，五味子7分，芎5分，干地黄7分，远志皮5分。";
  ex:hasUsage "每取方寸，以清酒1升暖下，昼2服，夜1服。" .

<medicine:臁疮拔毒方> a ex:Medicine;
  ex:hasFunction "臁疮；并治坐板流脓疮。";
  ex:hasName "臁疮拔毒方";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "沥青4两，矾红2两。";
  ex:hasUsage "香油调搽。须忍痛则疮内出其毒，可拔毒水尽，再用收口药。" .

<medicine:臁疮收口方> a ex:Medicine;
  ex:hasFunction "臁疮，并治诸毒疮不敛。";
  ex:hasName "臁疮收口方";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "冰片3分，石决明2钱（煅），川连1钱，血竭5分，琥珀末1钱，寒水石3钱（煅），乳香1钱（去油），黄柏末5钱。";
  ex:hasUsage "凡毒尽后疮不起，边肉有红色，先将温苦茶洗1次，敷药1次，不数日收口。" .

<medicine:臁疮方> a ex:Medicine;
  ex:hasFunction "臁疮。";
  ex:hasName "臁疮方";
  ex:hasPreparation "共打成膏。";
  ex:hasPrescription "松香1两，轻粉3钱，乳香5钱，细茶5钱。";
  ex:hasUsage "先将葱头、花椒煎浓汤，熏洗净，用布摊膏，厚贴患处，以绢缚定，黄水流尽，烂肉生肌。" .

<medicine:臁疮膏> a ex:Medicine;
  ex:hasFunction "臁疮（衤军）口风。";
  ex:hasName "臁疮膏";
  ex:hasNote "忌食辛辣刺激食品，忌房事2～3月。";
  ex:hasPreparation "用铜器将香油入内，以火煨热，下蜡慢火熬，如桐油色，入粉末，以箸频搅沫起，熬至沫落，搅视微清，沫不粘箸，将纸剪成方，用纸钉定了后，入锅内蘸干油，去火毒2-3日。";
  ex:hasPrescription "香油半斤，黄蜡1两（夏加5分），定粉1两6钱（研细末），桑皮纸（厚者）2半张。";
  ex:hasUsage "将疮用葱、椒、槐条、茄根煎汤净洗，用绢拭干，将药纸贴患处，上用油单纸栓盖着疮处，药贴日，揭去1张，不10张疾愈矣。" .

<medicine:臁疮药方> a ex:Medicine;
  ex:hasFunction "臁疮。";
  ex:hasName "臁疮药方";
  ex:hasPreparation "上用猪胆1个，针刺7孔，滴下胆汁于盏内，将药调和。";
  ex:hasPrescription "轻粉1钱，黄连末2钱。";
  ex:hasUsage "摊满疮口上，用白纸数层盖药，以无粉青绢紧紧栓住，过10日再换药，如法紧栓。" .

<medicine:臁疮阡张膏> a ex:Medicine;
  ex:hasFunction "臁疮远近烂见骨者。";
  ex:hasName "臁疮阡张膏";
  ex:hasPreparation "先将香油熬将熟，入发熬化；次下杉木灰、白占熔化，后将余药投入滚化搅匀，以吁张纸入油内，收尽为度。";
  ex:hasPrescription "香油4饭碗，乱头发4两，杉木皮3两（烧灰，研末），白占2两，麝香5分（研细）。";
  ex:hasUsage "贴3日，翻1面，7日痊愈；无论远近烂见骨者，半月收功。" .

<medicine:臁疮隔纸膏> a ex:Medicine;
  ex:hasAlias "臁疮夹纸膏";
  ex:hasFunction "臁疮。";
  ex:hasName "臁疮隔纸膏";
  ex:hasPreparation "先将占、油煎5-6沸，下乳、没再2-3沸，下轻粉，随下丹、粉，槐、柳枝搅10余沸，取起冷定后，下冰片搅匀，瓶盛，浸水中1宿，出火毒。";
  ex:hasPrescription "黄占5两，飞丹4两，铅粉4两，轻粉2钱，乳香2钱，没药2钱，冰片3分，麻油（春、夏2两，秋、冬3两）。";
  ex:hasUsage "臁疮夹纸膏（《青囊秘传》）。" .

<medicine:臌症神效散> a ex:Medicine;
  ex:hasFunction "水肿胀满。";
  ex:hasName "臌症神效散";
  ex:hasNote "忌盐、醋百日。";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "炒麦芽1钱，槟榔1钱，甘遂1钱。";
  ex:hasUsage "每服5分，黄酒冲服。到80天买猪肝1付，去净白皮，以竹刀切片，放沙锅内焙干，为细末，开水冲服；至100天吃鲫鱼补之，而调料不忌矣。" .

<medicine:臌胀串> a ex:Medicine;
  ex:hasFunction "水肿。";
  ex:hasName "臌胀串";
  ex:hasPreparation "上为末，醋糊为丸，如绿豆大。";
  ex:hasPrescription "三棱3钱，莪术3钱，苍术3钱，青皮3钱，陈皮3钱，商陆2钱，泽泻2钱，甘遂2钱，木通2钱，赤茯苓2钱，胡椒2两，黑丑头末2两，桑皮5钱。";
  ex:hasUsage "每服15-20丸，要在五更服。2-3夜3服，第1服，葱汤下；第2服，陈皮、桑皮汤下；第3服，射干汤下或姜汤下。" .

<medicine:臌胀丸> a ex:Medicine;
  ex:hasFunction "臌胀。";
  ex:hasName "臌胀丸";
  ex:hasPreparation "上为末，水泛为丸。";
  ex:hasPrescription "黄牛粪不拘多少（煅炭）、六神曲各等分。";
  ex:hasUsage "口服。" .

<medicine:自然铜散> a ex:Medicine;
  ex:hasFunction "治头风疼痛至甚。（头痛）";
  ex:hasName "自然铜散";
  ex:hasPreparation "上药生为细末。";
  ex:hasPrescription "黄柏15克（厚者）自然铜15克 细辛（去叶、土）7.5克 胡椒49粒";
  ex:hasUsage "每遇头疼、头风发时，先含水一口，后用药0.5克搐鼻中，左疼左搐，右疼右搐，搐罢吐去水，口咬筷头，沥涎出为度。" .

<medicine:自生饮> a ex:Medicine;
  ex:hasFunction "治临产生育艰难。（难产）";
  ex:hasName "自生饮";
  ex:hasPrescription "当归9克 川芎6克 枳壳（炒）6克 益母草3克 白芷1.8克 火麻仁（炒，去壳）3克";
  ex:hasUsage "上锉一剂。水煎，空腹时温服。" .

<medicine:臭梧桐洗剂> a ex:Medicine;
  ex:hasFunction "慢性湿疹。";
  ex:hasName "臭梧桐洗剂";
  ex:hasPrescription "臭梧桐31g，野菊花31g，地肤子31g，明矾10g。";
  ex:hasUsage "水煎。熏洗。" .

<medicine:臭椿皮散> a ex:Medicine;
  ex:hasFunction "积年肠风泻血，谷食不消，肌体黄瘦。";
  ex:hasName "臭椿皮散";
  ex:hasPreparation "上为细散。";
  ex:hasPrescription "臭椿树白皮2两（微炙，锉），干姜3分（炮裂，锉），甘草3分（炙微赤，锉），鸡冠花1两（炙微黄），附子1两，（炮裂，去皮脐），槐鹅1两（炙令黄）。";
  ex:hasUsage "每服2钱，食前以枳壳汤调下。" .

<medicine:臭樗皮散> a ex:Medicine;
  ex:hasFunction "痔痿，下脓血不止。";
  ex:hasName "臭樗皮散";
  ex:hasPreparation "上为细散。";
  ex:hasPrescription "臭樗皮1两（微炙，锉），酸石榴皮1两，地榆1两（锉），黄连1两（去须），艾叶3分（微炒），阿胶1两（捣碎，炒令黄燥）。";
  ex:hasUsage "每服2钱，食前以粥饮调下。" .

<medicine:臭橘散> a ex:Medicine;
  ex:hasFunction "痔疾。";
  ex:hasName "臭橘散";
  ex:hasPreparation "上药用瓷瓶子1枚，纸数重，砖1片压口，次用炭火笼作火炉烧臭橘，候烟去九分存性，只置瓶内，急以纸并砖子压口，候冷，为细散。";
  ex:hasPrescription "臭橘不拘多少。";
  ex:hasUsage "每服2钱匕，麝香温酒或陈米饮调下。" .

<medicine:臭橙饮> a ex:Medicine;
  ex:hasFunction "疝瘕偏坠，腰胁挛急。";
  ex:hasName "臭橙饮";
  ex:hasPrescription "臭橙皮2钱，芍药2钱，茴香1钱，吴茱萸1钱，附子1钱，桂枝1钱，甘草5分，大枣5分。";
  ex:hasUsage "水煎服。" .

<medicine:臭灵丹> a ex:Medicine;
  ex:hasFunction "破伤风，及金疮、跌打。";
  ex:hasName "臭灵丹";
  ex:hasNote "孕妇忌服。";
  ex:hasPreparation "上为细末，再加上糯米，打糊为锭，大者7分重，小者3分5厘重，赤金为衣包装，瓷坛存贮。";
  ex:hasPrescription "大蒜1升（捣），黄酒4升。";
  ex:hasUsage "煮1升，服之。须臾汗出立止。" .

<medicine:臭科散> a ex:Medicine;
  ex:hasFunction "接骨。主";
  ex:hasName "臭科散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "臭科子（一名锁地风草。用条上嫩皮，焙干）。";
  ex:hasUsage "每服2钱，空心酒调下。" .

<medicine:臭黄膏> a ex:Medicine;
  ex:hasFunction "小儿胎中受风，长后或身体生疥，瘙痒不止。";
  ex:hasName "臭黄膏";
  ex:hasPreparation "上为细末，用青油1两，入锅子内，熬令熟，下小件蜡及葱白，次下硫黄、臭黄搅令匀，膏成，以瓷盘中盛。";
  ex:hasPrescription "臭黄2分，硫黄1分，葱白1茎（细切）。";
  ex:hasUsage "旋旋涂之。" .

<medicine:至圣一醉膏> a ex:Medicine;
  ex:hasFunction "治瘫缓风。";
  ex:hasName "至圣一醉膏";
  ex:hasNote "此疾五十日已上方治。若发直者，不在治限。";
  ex:hasPrescription "天麻（一分） 没药（半两） 黄明滴乳香（半两） 附子（一两.炮制.去皮脐） 安息香（一分） 麻黄（去根节.四两） 片脑（少许）";
  ex:hasUsage "每服四大钱，用法酒一升，于银石器内熬成膏后，去出分在四盏内，别用法酒，看病人吃酒多少，渐调膏子，服尽为度。令枕病处卧，以衣被盖，或汗出，或似虫行即效。次日在吃一服。" .

<medicine:至圣丹> a ex:Medicine;
  ex:hasFunction "治一切惊风天吊，目睛上视，手足搐搦，状候多端。";
  ex:hasName "至圣丹";
  ex:hasNote "常忌毒鱼、大蒜、鸡、鸭、猪肉等。";
  ex:hasPrescription "熊胆（用温水化入药）、芦荟（研）、腻粉（同水银研）、朱砂（干飞），各一分；麝香（研）半分，蟾酥（研者.酒浸一宿）、龙脑（研）、铅霜（研），各一字；雄黄（研飞）、青黛（研）、胡黄连（末），各半两；白附子（炮）二钱，水银一钱（与腻粉同研.不见米星）。";
  ex:hasUsage "用药一圆，用温水化，滴鼻中令喷嚏三、五次，更用薄荷汤下二圆即愈。" .

<medicine:至圣保命丹> a ex:Medicine;
  ex:hasFunction "治小儿胎惊内吊，腹肚坚硬，目睛上视，手足抽掣，角弓反张。但是涎痰壅盛，一切急慢惊风，悉皆治之。";
