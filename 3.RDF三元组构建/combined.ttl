  ex:hasUsage "草果饮（《保命集》卷下）。" .

<medicine:草果柴平汤> a ex:Medicine;
  ex:hasFunction "因食而病疟，痞闷，噫气，恶食。";
  ex:hasName "草果柴平汤";
  ex:hasPrescription "小柴胡合平胃散加草果。" .

<medicine:草果熟水> a ex:Medicine;
  ex:hasFunction "消暑止渴。主";
  ex:hasName "草果熟水";
  ex:hasPrescription "乌梅3两，草果1两，干葛1两，白茯苓1两，甘草1两（炙），干姜1两半，缩砂仁半两。";
  ex:hasUsage "上（口父）咀。每服半两，水2碗，煎1碗，去滓，冷、热任意服。" .

<medicine:草果知母汤> a ex:Medicine;
  ex:hasFunction "背寒，胸中痞结，疟来日晏，邪渐入阴。";
  ex:hasName "草果知母汤";
  ex:hasPrescription "草果1钱5分，知母2钱，半夏3钱，厚朴2钱，黄芩1钱5分，乌梅1钱5分，花粉1钱5分，姜汁5匙（冲）。";
  ex:hasUsage "水5杯，煮取2杯，分2次温服。" .

<medicine:草果茵陈汤> a ex:Medicine;
  ex:hasFunction "足太阴寒湿，舌灰滑，中焦滞痞。";
  ex:hasName "草果茵陈汤";
  ex:hasPrescription "草果1钱，茵陈3钱，茯苓皮3钱，厚朴2钱，广皮1钱5分，猪苓2钱，大腹皮2钱，泽泻1钱5分。";
  ex:hasUsage "水5杯，煮取2杯，分2次服。" .

<medicine:草果饮> a ex:Medicine;
  ex:hasAlias "草果汤";
  ex:hasFunction "疟疾，脾胃有郁痰伏涎者。";
  ex:hasName "草果饮";
  ex:hasNote "元气强壮者可用，虚者莫用。";
  ex:hasPreparation "上为粗末。";
  ex:hasPrescription "草果、常山、知母、乌梅、槟榔、穿山甲。";
  ex:hasUsage "草果汤（《普济方》卷二一一）。" .

<medicine:草果饮子> a ex:Medicine;
  ex:hasFunction "疟疾。寒热往来，烦渴头痛，或但寒但热。";
  ex:hasName "草果饮子";
  ex:hasPrescription "草果子仁4枚，人参（去芦头）半钱，半夏13枚（中样者，沸汤浸洗7次），甘草（炙）半钱，大枣3枚，乌梅3枚，生姜（3寸）1块。";
  ex:hasUsage "上（口父）咀。用水1大碗，煎至半碗，去滓，食前温服。" .

<medicine:草灰散> a ex:Medicine;
  ex:hasFunction "痘溃烂。";
  ex:hasName "草灰散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "荔枝壳（微燎存性）、草纸（烧灰存性）、多年陈茅草（晒干）。";
  ex:hasUsage "掺于烂处，即收水结痂。" .

<medicine:草灵丹> a ex:Medicine;
  ex:hasAlias "天然透邪丹";
  ex:hasFunction "延年益寿，添精补髓，乌须发，固齿牙，强筋骨，壮气血，聪耳明目，返老还童。主老人阳气偏虚，便溺不禁，脾胃两亏，内挟寒湿。";
  ex:hasName "草灵丹";
  ex:hasNote "忌黑羊肉、鹁、鸽、桃李果子，恐减药力；服药者，不可赖此频行房事。";
  ex:hasPreparation "上为细末，炼蜜为丸，如梧桐子大。";
  ex:hasPrescription "真川椒4两（去子，炒出汗），白茯苓1两（去皮，炒），川乌1两（去皮脐），茴香2两（盐炒），苍术4两（酒浸，焙干），甘草2两（粉者，去皮，炙），熟地3两（酒浸），山药3两。";
  ex:hasUsage "每服30-50丸，空心温酒送下，以干物压之。服之1月，乃见其效。冬月服之，手足腮面如噀红，行步轻飞，70老人，健若少年。老年人服之10日，便不夜起。" .

<medicine:草灵宝丹> a ex:Medicine;
  ex:hasFunction "中风，及八风五痹，瘫痪亸曳，口眼斜，眉角牵引，项背拘强，牙关紧急，心中悸闷，神情如醉，遍身发热，骨节烦疼，肌肉麻木，腰膝沉重，皮肤瞤动，状若虫行；阳虚头痛，风寒入脑，目旋晕转，似在舟船，耳内蝉鸣，有如风雨之声应；风寒湿痹，脚气缓急，及打扑伤于筋骨，或遇天明，一身尽痛，不得睡卧。";
  ex:hasName "草灵宝丹";
  ex:hasPreparation "上除研者药外，并为细末，再入研者药末和匀，炼蜜为丸，每两作5丸，朱、麝香为衣。";
  ex:hasPrescription "川芎4两，天麻（酒浸，去苗）4两，当归（洗）4两，白芍药4两，细辛（去土叶）4两，荆芥穗4两，川楝子肉（炒）4两，麻黄（去根节）4两，五加皮4两，白鲜皮4两，何首乌（酒浸）4两，自然铜（火烧7遍，醋浸7遍）4两，菊花4两，枳壳（炒，去瓤）4两，白术（炒）4两，薄荷叶4两，石斛（去根，炒）4两，威灵仙（去土）4两，枸杞子4两，木香4两，川乌头（炮，去皮脐尖）4两，甘草（炒）4两，附子（炮，去皮脐）4两，草乌头（炮，去皮脐尖）4两，香附子（炒）4两，车前子（酒浸）4两，金毛狗脊（去毛）4两，没药（别研）4两，人参（去芦头）4两，地骨皮（去土）4两，防风（去芦头）4两，羌活（去芦头）4两，香白芷4两，柴胡（去苗）4两，升麻4两，白牵牛（炒）4两，乌药4两，地龙（去土，炒）4两，乌梢蛇（酒浸，去皮骨，取肉）4两，槐角子（炒）4两，大黄（炒）4两，风梢蛇（酒浸，去皮骨，取肉）4两，白花蛇（酒浸，去皮骨，取肉）4两，麝香1两（别研一半为衣），乳香2两（别研），乌鸦2只（腊月者，泥固济，炭火煅令泥红取出），朱砂2两（研，同麝香为衣）。";
  ex:hasUsage "每服半丸或1丸，热酒化下，不拘时候。" .

<medicine:草灵散> a ex:Medicine;
  ex:hasFunction "蟹叉。";
  ex:hasName "草灵散";
  ex:hasPreparation "上砍烂，酒炒。";
  ex:hasPrescription "薢叉草（又名薢叉秽）。";
  ex:hasUsage "敷之。" .

<medicine:草牛散> a ex:Medicine;
  ex:hasFunction "癞头胎毒。";
  ex:hasName "草牛散";
  ex:hasPreparation "上为末，火焙干。";
  ex:hasPrescription "蜗牛10枚（捣烂），生甘草末5钱。";
  ex:hasUsage "麻油调敷头上。" .

<medicine:草矾膏> a ex:Medicine;
  ex:hasFunction "眼丹。";
  ex:hasName "草矾膏";
  ex:hasPrescription "粉草2两，皂矾5钱。";
  ex:hasUsage "水煎浓汁，滤净滓，再煎浓，加冰片。以鸡翎蘸膏频扫肿处。" .

<medicine:草神丹> a ex:Medicine;
  ex:hasFunction "大补脾肾。主阴毒伤寒，阴疽痔漏，水肿臌胀，中风半身不遂，脾泄暴注久痢，黄黑疽，虚劳发热，咳嗽咯血，两胁连心痛，胸膈痞闷，胁中如流水声；童子骨蒸，小儿急慢惊风，痘疹变黑缩陷；气厥卒仆；双目内障；吞酸逆气，痞积血块，大小便不禁；奔豚疝气；附骨疽，两足少力，虚汗不止；男子遗精、梦泄，砂石淋，溺血；妇人血崩血淋；暑月伤食、腹痛，呕吐痰涎。";
  ex:hasName "草神丹";
  ex:hasPreparation "先将前3味为细末，后入琥珀、辰砂、麝香3味，共研极匀，蒸饼为丸，如梧桐子大。";
  ex:hasPrescription "川附子（制）5两，吴茱萸（泡）2两，肉桂2两，琥珀5钱（用柏子煮过另研），辰砂5钱（另研），麝香2钱（另研）。";
  ex:hasUsage "每服50丸，米饮送下。小儿每服10丸。" .

<medicine:草粉丸子> a ex:Medicine;
  ex:hasFunction "妇人积聚气，久不散，心腹疼痛。";
  ex:hasName "草粉丸子";
  ex:hasPreparation "上为末，以糯米饭为丸，如梧桐子大。";
  ex:hasPrescription "飞天白6分（雄雀粪是，冬月者佳，炒令极热，为末），麝香半分（细研），巴豆3分（去皮心，纸裹压去油）。";
  ex:hasUsage "每服2丸，空心以生姜汤送下。" .

<medicine:草粉散> a ex:Medicine;
  ex:hasFunction "妇人久积食症，腹中结块，面身浮肿。";
  ex:hasName "草粉散";
  ex:hasPreparation "上以溲了面一鸡子大相和，捣作饼子，煿熟候干，捣细罗为散。";
  ex:hasPrescription "雄雀粪半两（微炒，细研），腻粉半两。";
  ex:hasUsage "每服1钱，五更初以温酒调服。以利恶物为效。" .

<medicine:草罂饮> a ex:Medicine;
  ex:hasFunction "小儿久新痢疾，不食身热。";
  ex:hasName "草罂饮";
  ex:hasPrescription "木瓜草1两（一方用马齿苋），罂粟壳半两，甘草半两。";
  ex:hasUsage "上（口父）咀。3岁每服1钱，水半盏，煎3分，去滓，食前服。" .

<medicine:草膏> a ex:Medicine;
  ex:hasFunction "瘰疬。";
  ex:hasName "草膏";
  ex:hasPreparation "煎浓汁，去滓，再熬成膏。";
  ex:hasPrescription "荔枝草（一名长青草，又名雪里青）。";
  ex:hasUsage "摊贴患处，不拘已穿未穿，俱效；若未穿，将先起的疮灸1艾，然后贴之；若已穿者，不必灸。" .

<medicine:草节丸> a ex:Medicine;
  ex:hasFunction "小儿冷痢，或下青白，或下瘀黑，或如凝脂。";
  ex:hasName "草节丸";
  ex:hasPreparation "上为末，醋煮面糊为丸，如黍米大。";
  ex:hasPrescription "乌头（炮裂，去皮脐）1钱，黄连（去须）1钱，吴茱萸（汤洗，焙炒）1钱，干姜（焙）1钱。";
  ex:hasUsage "每服7丸，草节汤送下。" .

<medicine:草节散> a ex:Medicine;
  ex:hasFunction "解酒毒。主";
  ex:hasName "草节散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "赤马粪中草节不拘多少（略沉，晒干）。";
  ex:hasUsage "每服2钱，米饮调下。" .

<medicine:草节汤> a ex:Medicine;
  ex:hasFunction "小儿冷热不调下泻。";
  ex:hasName "草节汤";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "胡黄连半两，绵姜1两（炮熟）。";
  ex:hasUsage "每服半钱，食前草节汤调下。" .

<medicine:草花汤> a ex:Medicine;
  ex:hasFunction "冬月伤寒8-9日，腹痛下利，便脓血，喉中作痛，心内时烦。";
  ex:hasName "草花汤";
  ex:hasPrescription "甘草2钱，赤石脂2钱，糯米1提。";
  ex:hasUsage "水煎服。1剂而腹痛除，2剂而喉痛止，3剂而利亦愈，烦自安。" .

<medicine:草花膏> a ex:Medicine;
  ex:hasFunction "目赤肿痛。";
  ex:hasName "草花膏";
  ex:hasPrescription "羊胆1具，蜂蜜2钱。";
  ex:hasUsage "蜜入胆内搅匀，点两眼角，或研冰片1分加入。" .

<medicine:草蔻丸> a ex:Medicine;
  ex:hasFunction "小儿洞泄不止。";
  ex:hasName "草蔻丸";
  ex:hasPreparation "上为末，生姜汁煮面糊为丸，如绿豆大。";
  ex:hasPrescription "草豆蔻3枚（去皮），乌头3枚（盐水浸少时，炒），益智（去壳）1分，青橘皮（汤浸，焙，去白）1分。";
  ex:hasUsage "每服7丸，乳食前煎木瓜汤或生姜汤送下。" .

<medicine:草蔻大顺饮> a ex:Medicine;
  ex:hasFunction "食积呕吐属寒者。";
  ex:hasName "草蔻大顺饮";
  ex:hasPrescription "草蔻、炮姜、广皮、半夏、厚朴、甘草。" .

<medicine:草蔻汤> a ex:Medicine;
  ex:hasFunction "脐腹虚寒疼痛。";
  ex:hasName "草蔻汤";
  ex:hasPrescription "泽泻1钱，木香3分，神曲4分，半夏（制）5分，枳实（麸炒）5分，草豆蔻5分，黄耆5分，益智仁5分，甘草（炙）5分，青皮6分，陈皮6分，川归7分，茯苓7分。";
  ex:hasUsage "上（口父）咀。加生姜3片，黑枣1个，水煎服。" .

<medicine:草蜜汤> a ex:Medicine;
  ex:hasFunction "心肾有热，小便不通。";
  ex:hasName "草蜜汤";
  ex:hasPrescription "生车前草捣取自然汁半盏，蜜1匙。";
  ex:hasUsage "调服。" .

<medicine:草豆汤> a ex:Medicine;
  ex:hasAlias "草豆饮";
  ex:hasFunction "砂石淋。";
  ex:hasName "草豆汤";
  ex:hasPrescription "黑豆120粒，甘草1寸（生，锉）。";
  ex:hasUsage "草豆饮（《明医指掌》卷七）。" .

<medicine:草豆蔻丸> a ex:Medicine;
  ex:hasFunction "心脾蕴热，随气上熏，发为口臭。";
  ex:hasName "草豆蔻丸";
  ex:hasPreparation "上为末，炼蜜为丸，如鸡头子大。";
  ex:hasPrescription "草豆蔻仁1两，丁香1两，麝香1分，藿香叶半两，桂（去粗皮）半两，零陵香半两，莎草根（去毛）半两，木香半两，白芷半两，当归（切，焙）半两，槟榔（锉）半两。";
  ex:hasUsage "每含化1丸，咽津液，日3丸。" .

<medicine:草豆蔻拔刀> a ex:Medicine;
  ex:hasFunction "脾胃气虚弱，呕逆，不能饮食。";
  ex:hasName "草豆蔻拔刀";
  ex:hasPrescription "草豆蔻2枚（去皮），高良姜半两，生姜汁半合。";
  ex:hasUsage "上药，前2味锉细，以水1中盏，煮取2合，并生姜汁溲白面4两，为拨刀，以羊肉臛汁内煮令熟，空腹食之。" .

<medicine:草豆蔻散> a ex:Medicine;
  ex:hasAlias "常山饮子";
  ex:hasFunction "妇人脾胃虚冷气，胸膈不利，食即呕吐。";
  ex:hasName "草豆蔻散";
  ex:hasNote "忌生冷、油腻、饴糖。";
  ex:hasPreparation "上为散。";
  ex:hasPrescription "草豆蔻1两（去壳），沉香半两，白豆蔻半两（去皮），诃黎勒皮半两，白术半两，桂心半两，丁香母半两，甘草1分（炙微赤，锉）。";
  ex:hasUsage "每服1钱，以生姜汤调下，不拘时候。" .

<medicine:草豆蔻汤> a ex:Medicine;
  ex:hasAlias "豆蔻散";
  ex:hasFunction "客寒犯胃，或过食生冷，中脘疼痛，手足厥逆，脉见弦紧。";
  ex:hasName "草豆蔻汤";
  ex:hasNote "非脉实症寒者，勿轻用。";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "草豆蔻（煨）5分，高良姜5分，广皮5分，陈神曲（炒）5分，吴茱萸（汤泡）5分，茯苓1钱，半夏1钱，炙甘草3分。";
  ex:hasUsage "加煨姜1片，水煎服。" .

<medicine:草豆蔻饮> a ex:Medicine;
  ex:hasFunction "令山岚瘴气不着人。主";
  ex:hasName "草豆蔻饮";
  ex:hasPreparation "上为粉末。";
  ex:hasPrescription "草豆蔻（去皮）半两，高良姜半两，甘草（炙）半两。";
  ex:hasUsage "每服5钱匕，煎作熟水，频饮之。" .

<medicine:草豆饮> a ex:Medicine;
  ex:hasFunction "益肾通淋。主砂淋涩痛，脉沉涩。";
  ex:hasName "草豆饮";
  ex:hasPrescription "黑豆100粒，生草梢3钱，秋石5钱。";
  ex:hasUsage "水煎，去滓，入滑石末3钱，温服。" .

<medicine:草还丹> a ex:Medicine;
  ex:hasAlias "青蒿丸";
  ex:hasFunction "阴虚骨蒸。";
  ex:hasName "草还丹";
  ex:hasPreparation "文武火熬，约童便减至2斗，去蒿，再熬至1升，入猪胆7个，再熬数沸，用甘草末收和为丸，如梧桐子大。";
  ex:hasPrescription "赤蒿1斗5升，童便3斗。";
  ex:hasUsage "青蒿丸（《不居集》下集卷四）。" .

<medicine:草还丹加减> a ex:Medicine;
  ex:hasFunction "清热凉血，滋肾乌发。血热内蕴，水不涵木，肝旺血燥，血热偏盛，毛发失养。";
  ex:hasName "草还丹加减";
  ex:hasPrescription "菟丝子15克，枸杞子15克，桑椹子15克，生地12克，赤芍12克，桑叶12克，丹皮10克，杭菊花10克，白芷6克。";
  ex:hasUsage "水煎服，每日1剂，日服2次。" .

<medicine:草金散> a ex:Medicine;
  ex:hasFunction "小儿吐逆。";
  ex:hasName "草金散";
  ex:hasPreparation "上同藏于小瓶内，用泥固济烧，烟尽取出，研细。";
  ex:hasPrescription "烂大栀子3个，草乌头1个。";
  ex:hasUsage "每服1字，生姜汁调下。" .

<medicine:草钟乳丸> a ex:Medicine;
  ex:hasAlias "曹公草钟乳丸、曹公钟乳丸";
  ex:hasFunction "安五脏，补肠胃，下气消食，长肌和中,潜补。主五劳七伤损肺，气急，丈夫衰老阳气绝，手足冷，心中少气，髓虚腰疼，脚痹身烦，口干不能食;脚气久虚，脉来沉细。";
  ex:hasName "草钟乳丸";
  ex:hasNote "不得闻见尸秽等气，亦不用食粗臭陈恶食；初服7日，不可为房事，过7日后任性，然亦不宜伤多。";
  ex:hasPreparation "上为末，炼蜜为丸，如梧桐子大。";
  ex:hasPrescription "钟乳2两（别研令细），菟丝子1两（酒浸1宿，别捣），石斛1两，吴茱萸半两。";
  ex:hasUsage "曹公草钟乳丸（《外台》卷三十七）。曹公钟乳丸（《圣济总录》卷八十一）。" .

<medicine:草霜散> a ex:Medicine;
  ex:hasFunction "走马牙疳。";
  ex:hasName "草霜散";
  ex:hasPreparation "上同入细青竹筒内，黄泥包固，麦穗火煨之一周时，去泥竹筒，将药研细，每1钱加冰片2分。";
  ex:hasPrescription "灯草、壁钱。" .

<medicine:草香散> a ex:Medicine;
  ex:hasFunction "目疾，至夜则甚，或点苦寒反重者，及肝虚冷泪，怕日羞明。";
  ex:hasName "草香散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "夏枯草4两，香附子4两，甘草8钱。";
  ex:hasUsage "每服1钱5分，清汤送下。" .

<medicine:草龙胆散> a ex:Medicine;
  ex:hasAlias "龙胆草散（《普济方》卷七十四）。";
  ex:hasFunction "上焦受于风热，气毒攻冲眼目暴赤，碜涩羞明，肿痛多眵，迎风有泪，翳膜攀睛，胬肉隐痛。";
  ex:hasName "草龙胆散";
  ex:hasPreparation "上为细末。";
  ex:hasPrescription "龙胆草（洗，去头）2两，菊花（去梗）2两，木贼（洗净，去节）2两，草决明（微炒）2两，甘草（炙）2两，香附子（炒，去毛）4两，川芎（不见火）4两。";
  ex:hasUsage "每服2钱，用麦门冬熟水，入砂糖少许同调，食后服；或米泔调下亦得。" .

<medicine:荔壳汤> a ex:Medicine;
  ex:hasFunction "痘疮6-7日尚不灌脓。";
  ex:hasName "荔壳汤";
  ex:hasPrescription "荔壳、木香、丁香、甘草、白芍、人参、当归、陈皮、茯苓、厚朴。" .

<medicine:荔奴丹> a ex:Medicine;
  ex:hasFunction "杨梅结毒，大麻风。";
  ex:hasName "荔奴丹";
  ex:hasNote "服药后，大便要在空地深坑之处，以厚土掩之，勿令毒气传人。";
  ex:hasPreparation "上为细末，不见星，用银罐7-8个，将药分贮罐内，约有3-4分深，放风炉上，文火熔化结胎。先要将各罐口磨平俱覆于银盆上，外用水1大盆座铜盆于上，加炭火勿露罐；先文后武，1炷香即退火取药，当时饭研为丸，如黍米大。";
  ex:hasPrescription "人言3分，水银3钱，火消6钱，皂矾6钱，明矾6钱，雄黄1钱，铜绿5分，食盐1两2钱。";
  ex:hasUsage "每服1丸或2丸，龙眼肉包住，外加豆腐皮裹之，盐汤送下。饿1日，药行遍身，方可饮食。" .

<medicine:荔奴散> a ex:Medicine;
  ex:hasFunction "一切金疮跌磕。";
  ex:hasName "荔奴散";
  ex:hasPreparation "上为细末，收贮。";
  ex:hasPrescription "龙眼核不拘多少（烧存性）。";
  ex:hasUsage "敷伤处。立愈。" .

<medicine:荔枝干大枣> a ex:Medicine;
  ex:hasFunction "补气血。适用于失血性贫血。";
  ex:hasName "荔枝干大枣";
  ex:hasPrescription "荔枝干 大枣各7枚";
  ex:hasUsage "每日1剂，分2次服。" .

<medicine:荔枝散> a ex:Medicine;
  ex:hasFunction "呃逆不止。";
  ex:hasName "荔枝散";
  ex:hasPreparation "上为末。";
  ex:hasPrescription "荔枝7个（连皮烧存性）。";
  ex:hasUsage "白滚汤下。" .

<medicine:荔枝橘核汤> a ex:Medicine;
  ex:hasFunction "（疒贵）疝。";
  ex:hasName "荔枝橘核汤";
  ex:hasPrescription "荔枝、橘核、桃仁、甘草、茯苓、白术、枳壳、山楂、延胡索。";
  ex:hasUsage "清水煎服。" .

<medicine:荔枝汤> a ex:Medicine;
  ex:hasFunction "生津止渴。主";
  ex:hasName "荔枝汤";
  ex:hasPreparation "上为细末。";
