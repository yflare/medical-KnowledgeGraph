  ex:hasUsage "水煎服。" .

<medicine:回音饮> a ex:Medicine;
  ex:hasFunction "治音哑。";
  ex:hasName "回音饮";
  ex:hasPrescription "甘草 桔梗 乌梅 乌药各等分";
  ex:hasUsage "水煎服。" .

<medicine:回风养脏汤> a ex:Medicine;
  ex:hasFunction "培土化热，熄风。主风阳外烁，肺热移于大肠，咳而遗屎。";
  ex:hasName "回风养脏汤";
  ex:hasPrescription "沙参4钱，苏子1钱半，枳壳1钱，前胡1钱，桑叶1钱，茯苓2钱，白术1钱，苡仁4钱，橘红1钱，贝母2钱，荷叶蒂1枚。" .

<medicine:回风外解汤> a ex:Medicine;
  ex:hasFunction "感风下利，身热脉微弦。";
  ex:hasName "回风外解汤";
  ex:hasPrescription "柴胡1钱，薄荷1钱，前胡1钱，桔梗1钱，枳壳1钱，葛根2钱，豆豉3钱，广皮1钱，茯苓2钱，白术1钱，姜皮6分，荷叶1角。" .

<medicine:回首散> a ex:Medicine;
  ex:hasAlias "回头散";
  ex:hasFunction "头项强急，筋痛，或挫枕，转项不得者。";
  ex:hasName "回首散";
  ex:hasPrescription "乌药顺气散加羌活、独活、木瓜。";
  ex:hasUsage "回头散（《金匮翼》卷五）。" .

<medicine:回香草散> a ex:Medicine;
  ex:hasFunction "鼻痔。";
