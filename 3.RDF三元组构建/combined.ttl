  ex:hasUsage "未溃者，以冷茶调涂，即可消退；已溃者掺之，即可收功。" .

<medicine:白灵药> a ex:Medicine;
  ex:hasFunction "一切无名肿毒。";
  ex:hasName "白灵药";
  ex:hasPreparation "上为细末。";
