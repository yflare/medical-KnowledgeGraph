  ex:hasUsage "加竹沥3茶匙，冲服。1剂不效，再服1剂。" .

<medicine:钩藤皮汤> a ex:Medicine;
  ex:hasAlias "钩藤饮";
  ex:hasFunction "救急疗痫。主小儿癫痫。";
