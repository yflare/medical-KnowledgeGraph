@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix ex: <http://example.com/> .
@prefix ann: <http://example.org/annotation/> .
 
ex:DrugMapping a rr:TriplesMap ;
 rml:logicalSource [
   rml:source "medical_ner_entities.json";
   rml:referenceFormulation ql:JSONPath;
   rml:iterator "$[*]"
 ];
 
 rr:subjectMap [
   rr:template "http://example.com/drug/{id}";
   rr:class ex:Drug
 ];
 
 rr:predicateObjectMap [
   rr:predicate ex:hasId;
   rr:objectMap [ rml:reference "id" ]
 ];
 
 rr:predicateObjectMap [
   rr:predicate ex:hasText;
   rr:objectMap [ rml:reference "text" ]
 ];
 
 rr:predicateObjectMap [
   rr:predicate ex:hasAnnotation;
   rr:objectMap [
     rr:parentTriplesMap ex:AnnotationMapping;
     rr:joinCondition [
       rr:child "id" ;
       rr:parent "id" ;
     ] ;
   ]
 ].
 
ex:AnnotationMapping a rr:TriplesMap ;
 rml:logicalSource [
   rml:source "medical_ner_entities.json";
   rml:referenceFormulation ql:JSONPath;
   rml:iterator "$[*].annotations[*]"
 ];
 
 rr:subjectMap [
   rr:template "http://example.org/annotation/{entity}";
   rr:class ex:Annotation
 ];
 
 rr:predicateObjectMap [
   rr:predicate ex:hasLabel;
   rr:objectMap [ rml:reference "label" ]
 ];
 
 rr:predicateObjectMap [
   rr:predicate ex:hasStartOffset;
   rr:objectMap [ rml:reference "start_offset" ]
 ];
 
 rr:predicateObjectMap [
   rr:predicate ex:hasEndOffset;
   rr:objectMap [ rml:reference "end_offset" ]
 ];
 
 rr:predicateObjectMap [
   rr:predicate ex:hasEntity;
   rr:objectMap [ rml:reference "entity" ]
 ].