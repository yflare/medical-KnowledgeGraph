@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix ex: <http://example.com/> .
@prefix medicine: <http://example.org/medicine/> .

ex:DrugMapping a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "merged_data.json";
    rml:referenceFormulation ql:JSONPath;
    rml:iterator "$[*]"
  ];

  rr:subjectMap [
    rr:template "http://example.org/medicine/{name}";
    rr:class ex:Medicine
  ];

  rr:predicateObjectMap [
    rr:predicate ex:hasName;
    rr:objectMap [ rml:reference "name" ]
  ];

  rr:predicateObjectMap [
    rr:predicate ex:hasFunction;
    rr:objectMap [ rml:reference "function" ]
  ];

  rr:predicateObjectMap [
    rr:predicate ex:hasUsage;
    rr:objectMap [ rml:reference "usage" ]
  ];

  rr:predicateObjectMap [
    rr:predicate ex:hasNote;
    rr:objectMap [ rml:reference "note" ]
  ];

  rr:predicateObjectMap [
    rr:predicate ex:hasAlias;
    rr:objectMap [ rml:reference "alias" ]
  ];

  rr:predicateObjectMap [
    rr:predicate ex:hasPreparation;
    rr:objectMap [ rml:reference "preparation" ]
  ];

  rr:predicateObjectMap [
    rr:predicate ex:hasClinicalApplication;
    rr:objectMap [ rml:reference "clinical_application" ]
  ];

  rr:predicateObjectMap [
    rr:predicate ex:hasPrescription;
    rr:objectMap [ rml:reference "prescription" ]
  ].
